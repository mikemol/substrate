# ── sourced: the ⟡ladder's tier-0 — <Mod>.sourced : <Mod>.agdai ──
sourced: $(SOURCED)
$(BUILD)/%.sourced: $(BUILD)/%.agdai
	@$(MEMBUDGET) run auto ingest-source -- python3 $(SCRIPTS)/sppf_db.py --ingest-source $< --live --apply
	@touch $@
# ── ingest: SPPF internment as a DEPENDENCY — <Mod>.ingested : <Mod>.agdai ──
ingest: $(INGESTED)
$(BUILD)/%.ingested: $(BUILD)/%.agdai
	@$(MEMBUDGET) run auto ingest-core -- python3 $(SCRIPTS)/sppf_db.py --ingest-core $< --live --apply
	@touch $@
# ── promote: the packing fold as a DEPENDENCY — <Mod>.promoted : <Mod>.ingested ──
promote: $(PROMOTED)
$(BUILD)/%.promoted: $(BUILD)/%.ingested
	@$(MEMBUDGET) run auto promote-core -- python3 $(SCRIPTS)/sppf_db.py --promote-core $(@:.promoted=.agdai) --live --apply
	@touch $@
# ── drain: the retire as a DEPENDENCY — <Mod>.drained : <Mod>.promoted ──
drain: $(DRAINED)
$(BUILD)/%.drained: $(BUILD)/%.promoted
	@$(MEMBUDGET) run auto drain-core -- python3 $(SCRIPTS)/sppf_db.py --drain-core $(@:.drained=.agdai) --live --apply
	@touch $@
reconcile:
	@$(MEMBUDGET) run 256 reconcile-stamps -- python3 $(SCRIPTS)/sppf_db.py --reconcile-stamps $(BUILD)
