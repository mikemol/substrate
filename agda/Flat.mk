AGDAI := $(patsubst %,$(BUILD)/%.agdai,$(subst .,/,$(MODULES)))
ITARGETS := $(MODULES:%=i/%)

.PHONY: all check-sync ingest clean $(MODULES:%=m/%) $(ITARGETS)

all: check-sync $(AGDAI)

# Blow up if the on-disk .agda set differs from the generated MODULES (new/removed file →
# regenerate). Both sides normalised through newline-list + drop-empties + sort.
check-sync:
	@disk=`find Substrate -name '*.agda' | sed 's#/#.#g; s#\.agda$$##' | sort`; \
	 listed=`printf '%s\n' $(MODULES) | tr ' ' '\n' | sed '/^$$/d' | sort`; \
	 if [ "$$disk" != "$$listed" ]; then \
	   echo 'ERROR: on-disk .agda set differs from Flat.mk MODULES.'; \
	   echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	 fi

# ── compile: <Mod>.agdai : <Mod>.agda + <direct-import>.agdai ─ real file; touch aligns mtime ──
