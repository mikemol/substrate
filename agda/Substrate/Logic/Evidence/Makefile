# GENERATED by scripts/gen_build_makefiles.py — do not edit by hand.
# Per-file, memory-confined Agda check for this directory.
# make = dispatcher only: it ALWAYS invokes agda per file; agda
# decides cached-vs-recheck (transitively correct). FILES and
# SUBDIRS are listed explicitly — a tree/makefile mismatch fails
# loudly (re-run scripts/gen_build_makefiles.py).

# membudget agda-shim → make is the controlled+instrumented build path (RAM-budgeted + proof-cost
# profiled). Idempotent (findstring); exported to recipes + sub-makes. MEMBUDGET_NOPROFILE=1 to skip
# profiling; `make AGDA=…` to pin a different agda.
SHIM_DIR := /home/mikemol/github/substrate/scripts/agda-shim
ifeq (,$(findstring $(SHIM_DIR),$(PATH)))
export PATH := $(SHIM_DIR):$(PATH)
endif

AGDA ?= agda
AGDA_FLAGS ?= --safe --without-K
MEM_CAP ?= 1024m
AGDA_ROOT := ../../..
SCRIPTS := ../../../../scripts

FILES := Atlas.agda DualRail.agda ElAtlas.agda GValueAsQ.agda GValueLSpace.agda Graded.agda NedgeBridge.agda SWP.agda Verdict.agda Warrant.agda
SUBDIRS := Atlas ElAtlas GValueLSpace Graded Verdict Warrant

.PHONY: all files subdirs $(SUBDIRS) ingest ingest-files ingest-subdirs $(SUBDIRS:%=%.ingest) check-sync clean

all: check-sync subdirs files

# Blow up if the directory's actual contents differ from this
# generated listing (new/removed file or subdir → regenerate).
check-sync:
	@disk_files=`ls *.agda 2>/dev/null | sort`; \
	 listed=`printf '%s\n' $(FILES) | sed '/^$$/d' | sort`; \
	 if [ "$$disk_files" != "$$listed" ]; then \
	   echo 'ERROR: $(CURDIR): .agda files differ from generated FILES list.'; \
	   echo '  on disk : '"`echo $$disk_files | tr '\n' ' '`"; \
	   echo '  listed  : '"`echo $$listed | tr '\n' ' '`"; \
	   echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	 fi

# One agda process PER FILE, RTS heap-capped, invoked from agda/
# so the .agda-lib / _build resolve. Always runs; agda no-ops if
# the interface is already current.
files:
	@for f in $(FILES); do \
	  echo "  check $(CURDIR)/$$f"; \
	  $(AGDA) $(AGDA_FLAGS) +RTS -M$(MEM_CAP) -RTS -i $(AGDA_ROOT) $(CURDIR)/$$f || exit 1; \
	done

subdirs: $(SUBDIRS)

Atlas:
	@if [ ! -f $@/Makefile ]; then \
	  echo 'ERROR: $(CURDIR)/$@ has no generated Makefile (new directory?).'; \
	  echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	fi
	@$(MAKE) -C $@

ElAtlas:
	@if [ ! -f $@/Makefile ]; then \
	  echo 'ERROR: $(CURDIR)/$@ has no generated Makefile (new directory?).'; \
	  echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	fi
	@$(MAKE) -C $@

GValueLSpace:
	@if [ ! -f $@/Makefile ]; then \
	  echo 'ERROR: $(CURDIR)/$@ has no generated Makefile (new directory?).'; \
	  echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	fi
	@$(MAKE) -C $@

Graded:
	@if [ ! -f $@/Makefile ]; then \
	  echo 'ERROR: $(CURDIR)/$@ has no generated Makefile (new directory?).'; \
	  echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	fi
	@$(MAKE) -C $@

Verdict:
	@if [ ! -f $@/Makefile ]; then \
	  echo 'ERROR: $(CURDIR)/$@ has no generated Makefile (new directory?).'; \
	  echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	fi
	@$(MAKE) -C $@

Warrant:
	@if [ ! -f $@/Makefile ]; then \
	  echo 'ERROR: $(CURDIR)/$@ has no generated Makefile (new directory?).'; \
	  echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	fi
	@$(MAKE) -C $@

ingest: ingest-files ingest-subdirs
ingest-files:
	@for f in $(FILES); do \
	  python3 $(SCRIPTS)/sppf_db.py --ingest-core $(CURDIR)/$$f || exit 1; \
	done
ingest-subdirs: Atlas.ingest ElAtlas.ingest GValueLSpace.ingest Graded.ingest Verdict.ingest Warrant.ingest
Atlas.ingest:
	@$(MAKE) -C Atlas ingest
ElAtlas.ingest:
	@$(MAKE) -C ElAtlas ingest
GValueLSpace.ingest:
	@$(MAKE) -C GValueLSpace ingest
Graded.ingest:
	@$(MAKE) -C Graded ingest
Verdict.ingest:
	@$(MAKE) -C Verdict ingest
Warrant.ingest:
	@$(MAKE) -C Warrant ingest

clean:
	@$(MAKE) -C Atlas clean 2>/dev/null || true
	@$(MAKE) -C ElAtlas clean 2>/dev/null || true
	@$(MAKE) -C GValueLSpace clean 2>/dev/null || true
	@$(MAKE) -C Graded clean 2>/dev/null || true
	@$(MAKE) -C Verdict clean 2>/dev/null || true
	@$(MAKE) -C Warrant clean 2>/dev/null || true
	@true
