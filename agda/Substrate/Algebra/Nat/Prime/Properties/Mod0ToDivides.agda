------------------------------------------------------------------------
-- 1. The wedge with remainder 0: a zero remainder IS divisibility, the
--    quotient (the wedge residue) the cofactor.
------------------------------------------------------------------------

mod0→∣ : (n d : ℕ) → n mod-suc d ≡ 0 → suc d ∣ n
mod0→∣ n d eq =
  divides (n div-suc d)
    (trans (div-mod-eq n d)
           (cong (λ r → r ℕ+ (n div-suc d) * suc d) eq))
