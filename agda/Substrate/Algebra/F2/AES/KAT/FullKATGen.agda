il-step : Byte → State × State → State × State
il-step rc (k , s) = nextRoundKey rc k , round (nextRoundKey rc k) s

mids : _
mids = rc1 ∷ rc2 ∷ rc3 ∷ rc4 ∷ rc5 ∷ rc6 ∷ rc7 ∷ rc8 ∷ rc9 ∷ []

il-run : State → State → State
il-run key pt =
  final-round (nextRoundKey rc10 (proj₁ (fold il-step mids (key , addKey key pt))))
              (proj₂ (fold il-step mids (key , addKey key pt)))

data ILChain : ∀ {m} → Vec Byte m → State × State → State × State → Set where
  nil  : ∀ {p} → ILChain [] p p
  cons : ∀ {m rc} {rcs : Vec Byte m} {p p' q}
       → il-step rc p ≡ p' → ILChain rcs p' q → ILChain (rc ∷ rcs) p q

opaque
  il-chain-sound : ∀ {m} {rcs : Vec Byte m} {p q}
                 → ILChain rcs p q → fold il-step rcs p ≡ q
  il-chain-sound nil                     = refl
  il-chain-sound (cons {rcs = rcs} st r) = trans (cong (fold il-step rcs) st) (il-chain-sound r)

module Assemble
  (mk spt sct s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 k1 k2 k3 k4 k5 k6 k7 k8 k9 k10 : State)
  (kp1 : nextRoundKey rc1 mk ≡ k1)
  (kp2 : nextRoundKey rc2 k1 ≡ k2)
  (kp3 : nextRoundKey rc3 k2 ≡ k3)
  (kp4 : nextRoundKey rc4 k3 ≡ k4)
  (kp5 : nextRoundKey rc5 k4 ≡ k5)
  (kp6 : nextRoundKey rc6 k5 ≡ k6)
  (kp7 : nextRoundKey rc7 k6 ≡ k7)
  (kp8 : nextRoundKey rc8 k7 ≡ k8)
  (kp9 : nextRoundKey rc9 k8 ≡ k9)
  (kp10 : nextRoundKey rc10 k9 ≡ k10)
  (p  : addKey mk spt ≡ s0)
  (e1 : round k1 s0 ≡ s1)
  (e2 : round k2 s1 ≡ s2)
  (e3 : round k3 s2 ≡ s3)
  (e4 : round k4 s3 ≡ s4)
  (e5 : round k5 s4 ≡ s5)
  (e6 : round k6 s5 ≡ s6)
  (e7 : round k7 s6 ≡ s7)
  (e8 : round k8 s7 ≡ s8)
  (e9 : round k9 s8 ≡ s9)
  (f  : final-round k10 s9 ≡ sct)
  where

  st1 : il-step rc1 (mk , s0) ≡ (k1 , s1)
  st1 = cong₂ _,_ kp1 (trans (cong (λ k → round k s0) kp1) e1)
  st2 : il-step rc2 (k1 , s1) ≡ (k2 , s2)
  st2 = cong₂ _,_ kp2 (trans (cong (λ k → round k s1) kp2) e2)
  st3 : il-step rc3 (k2 , s2) ≡ (k3 , s3)
  st3 = cong₂ _,_ kp3 (trans (cong (λ k → round k s2) kp3) e3)
  st4 : il-step rc4 (k3 , s3) ≡ (k4 , s4)
  st4 = cong₂ _,_ kp4 (trans (cong (λ k → round k s3) kp4) e4)
  st5 : il-step rc5 (k4 , s4) ≡ (k5 , s5)
  st5 = cong₂ _,_ kp5 (trans (cong (λ k → round k s4) kp5) e5)
  st6 : il-step rc6 (k5 , s5) ≡ (k6 , s6)
  st6 = cong₂ _,_ kp6 (trans (cong (λ k → round k s5) kp6) e6)
  st7 : il-step rc7 (k6 , s6) ≡ (k7 , s7)
  st7 = cong₂ _,_ kp7 (trans (cong (λ k → round k s6) kp7) e7)
  st8 : il-step rc8 (k7 , s7) ≡ (k8 , s8)
  st8 = cong₂ _,_ kp8 (trans (cong (λ k → round k s7) kp8) e8)
  st9 : il-step rc9 (k8 , s8) ≡ (k9 , s9)
  st9 = cong₂ _,_ kp9 (trans (cong (λ k → round k s8) kp9) e9)

  chain : ILChain mids (mk , s0) (k9 , s9)
  chain = cons st1 (cons st2 (cons st3 (cons st4 (cons st5 (cons st6 (cons st7 (cons st8 (cons st9 nil))))))))

  p9-eq : fold il-step mids (mk , addKey mk spt) ≡ (k9 , s9)
  p9-eq = trans (cong (λ x → fold il-step mids (mk , x)) p) (il-chain-sound chain)

  kat : il-run mk spt ≡ sct
  kat = trans (cong₂ final-round
                (trans (cong (λ pr → nextRoundKey rc10 (proj₁ pr)) p9-eq) kp10)
                (cong proj₂ p9-eq))
              f

