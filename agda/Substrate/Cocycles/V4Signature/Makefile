clean:
	@$(MAKE) -C Chirality clean 2>/dev/null || true
	@$(MAKE) -C Codeword clean 2>/dev/null || true
	@$(MAKE) -C OrbitKey clean 2>/dev/null || true
	@$(MAKE) -C OrbitKey-S3 clean 2>/dev/null || true
	@$(MAKE) -C Pairing clean 2>/dev/null || true
	@$(MAKE) -C S4Iso clean 2>/dev/null || true
	@true
