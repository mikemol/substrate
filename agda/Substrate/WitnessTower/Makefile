# GENERATED by scripts/gen_build_makefiles.py — do not edit by hand.
# Per-file, memory-confined Agda check for this directory.
# make = dispatcher only: it ALWAYS invokes agda per file; agda
# decides cached-vs-recheck (transitively correct). FILES and
# SUBDIRS are listed explicitly — a tree/makefile mismatch fails
# loudly (re-run scripts/gen_build_makefiles.py).

# membudget agda-shim → make is the controlled+instrumented build path (RAM-budgeted + proof-cost
# profiled). Idempotent (findstring); exported to recipes + sub-makes. MEMBUDGET_NOPROFILE=1 to skip
# profiling; `make AGDA=…` to pin a different agda.
SHIM_DIR := /home/mikemol/github/substrate/scripts/agda-shim
ifeq (,$(findstring $(SHIM_DIR),$(PATH)))
export PATH := $(SHIM_DIR):$(PATH)
endif

AGDA ?= agda
AGDA_FLAGS ?= --safe --without-K
MEM_CAP ?= 1024m
AGDA_ROOT := ../..
SCRIPTS := ../../../scripts

FILES := AbelBetaCollapse.agda AlgebraLadder.agda B3Split.agda Codeword.agda CodewordCountTies.agda CodewordSignEqualsStabParity.agda CodewordSignStep.agda CofreeDual.agda CommutatorSubgroup.agda Complete.agda Core.agda Counting.agda CycleType.agda CyclicCollapse.agda CyclicGrounding.agda Decompose.agda DetectorSignCrossing.agda Diagonal.agda DuplicateFree.agda EEAFoldTable.agda EEATower.agda EEAUnitBezout.agda Enumerate.agda EvenInComm.agda FaceCount.agda FaceSet.agda FaceSetStabilizes.agda FactorisationApex.agda FaithfulnessApex.agda FaithfulnessBridge.agda FamilyWitness.agda FamilyWitnessAmbient.agda FirstAppearance.agda GradeMapInvariant.agda Hodge.agda HodgeGradeInvolution.agda InsertionParity.agda IsPermutation.agda KleinCensus.agda LehmerPath.agda LehmerTowerMorphism.agda LehmerTowerMorphismDischarged.agda LeibnizDet.agda LeibnizDetPerm.agda LeibnizMonomial.agda LeibnizMonomialDirect.agda Link.agda M40Action.agda M40Closure.agda M40Contrast.agda M40Gauge.agda M40Group.agda M40Groupoid.agda M40Iso.agda M40NoIso.agda ParityCoordIsoApex.agda PermMatrixDet.agda PhiMultiplicity.agda Puncture.agda ResidueBridge.agda SharedMiddle.agda SignAbelianization.agda SignCommutator.agda SignEmbedVEven.agda SignFactorsThroughStab.agda SignGrade2Generated.agda SignStabTotal.agda SignStepCocycle.agda SignUniqueCharacter.agda SignZ2Coordinates.agda SimplicialBoundary.agda Sn.agda SnAbCharacterBridge.agda SnGroup.agda SnVersusTwoPow.agda SnVersusTwoPowTowers.agda SupportGrading.agda Surjective.agda SymBridge.agda TowerCocycleGraded.agda TowerFamilyApex.agda TowerLiftSplit.agda UniquenessBridge.agda V4Grounding.agda VecBoolCardinality.agda WedgeStep.agda WholeTower.agda WhyThreeV2.agda
SUBDIRS := EvenInComm Wedge

.PHONY: all files subdirs $(SUBDIRS) ingest ingest-files ingest-subdirs $(SUBDIRS:%=%.ingest) check-sync clean

all: check-sync subdirs files

# Blow up if the directory's actual contents differ from this
# generated listing (new/removed file or subdir → regenerate).
check-sync:
	@disk_files=`ls *.agda 2>/dev/null | sort`; \
	 listed=`printf '%s\n' $(FILES) | sed '/^$$/d' | sort`; \
	 if [ "$$disk_files" != "$$listed" ]; then \
	   echo 'ERROR: $(CURDIR): .agda files differ from generated FILES list.'; \
	   echo '  on disk : '"`echo $$disk_files | tr '\n' ' '`"; \
	   echo '  listed  : '"`echo $$listed | tr '\n' ' '`"; \
	   echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	 fi

# One agda process PER FILE, RTS heap-capped, invoked from agda/
# so the .agda-lib / _build resolve. Always runs; agda no-ops if
# the interface is already current.
files:
	@for f in $(FILES); do \
	  echo "  check $(CURDIR)/$$f"; \
	  $(AGDA) $(AGDA_FLAGS) +RTS -M$(MEM_CAP) -RTS -i $(AGDA_ROOT) $(CURDIR)/$$f || exit 1; \
	done

subdirs: $(SUBDIRS)

EvenInComm:
	@if [ ! -f $@/Makefile ]; then \
	  echo 'ERROR: $(CURDIR)/$@ has no generated Makefile (new directory?).'; \
	  echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	fi
	@$(MAKE) -C $@

Wedge:
	@if [ ! -f $@/Makefile ]; then \
	  echo 'ERROR: $(CURDIR)/$@ has no generated Makefile (new directory?).'; \
	  echo '  Run scripts/gen_build_makefiles.py.'; exit 1; \
	fi
	@$(MAKE) -C $@

ingest: ingest-files ingest-subdirs
ingest-files:
	@for f in $(FILES); do \
	  python3 $(SCRIPTS)/sppf_db.py --ingest-core $(CURDIR)/$$f || exit 1; \
	done
ingest-subdirs: EvenInComm.ingest Wedge.ingest
EvenInComm.ingest:
	@$(MAKE) -C EvenInComm ingest
Wedge.ingest:
	@$(MAKE) -C Wedge ingest

clean:
	@$(MAKE) -C EvenInComm clean 2>/dev/null || true
	@$(MAKE) -C Wedge clean 2>/dev/null || true
	@true
