# GENERATED by scripts/gen_build_makefiles.py — do not edit by hand.
# Top-level entry: per-file, memory-confined Agda build.
# `make` checks the whole Substrate tree, one agda process per file.
# Correctness is Agda's (re-checks stale deps transitively); make only
# bounds RAM and provides parallelism (-jN). See
# scripts/gen_build_makefiles.py.

# membudget agda-shim → make is the controlled+instrumented build path (RAM-budgeted + proof-cost
# profiled). Idempotent (findstring); exported to recipes + sub-makes. MEMBUDGET_NOPROFILE=1 to skip
# profiling; `make AGDA=…` to pin a different agda.
SHIM_DIR := /home/mikemol/github/substrate/scripts/agda-shim
ifeq (,$(findstring $(SHIM_DIR),$(PATH)))
export PATH := $(SHIM_DIR):$(PATH)
endif

.PHONY: all clean shim catalog check check-makefiles check-defproof check-vacuity check-index check-import check-decltag check-carrier check-apex advise
all:
	@$(MAKE) -C Substrate
clean:
	@$(MAKE) -C Substrate clean
# ⟡gqs-catalog-engine: (re)build the .agdai shim (iff agdai_shim.hs changed) + catalog.db from the
# interned SPPF. `catalog` = the BATCHED controller/actuator build (sppf_db ""): ONE process models the
# topology once, then rides the decode-parallelism roofline INTERNALLY — per window it co-reads the LIVE
# contention and decodes via a ThreadPool of shim subprocesses sized to the free CPU (interner+DB insert
# serial → NO python-spawn tax), self-skipping unchanged cores. Cheaper than per-core `make -j ingest`
# for the common incremental case (no spawn tax) and it self-parallelizes the full rebuild. The per-core
# `ingest` targets below remain for parallel-to-compile ingest (run alongside `make -j`).
shim:
	@$(MAKE) -C ../jea/metalanguage shim
catalog: shim
	@python3 ../scripts/sppf_db.py "" --argperm
# Aggregate invariant GATE (same checks the pre-commit hook runs):
# def/proof separation + makefile-tree sync + UP non-vacuity + shape index. Blocking.
check: check-defproof check-makefiles check-vacuity check-index check-import check-decltag check-carrier check-apex
	@echo 'all invariant checks passed.'
# Verify the makefile tree is in sync with the source tree.
check-makefiles:
	@python3 ../scripts/gen_build_makefiles.py --check
# Verify def/proof separation (definition-providers import no proof modules).
check-defproof:
	@../scripts/check_def_proof_separation.sh
# Verify no vacuous (⊤-collapse) universal properties outside the sanctioned two.
check-vacuity:
	@../scripts/check_up_nonvacuity.sh
# Verify the shape-node collision index is current (names→shapes, visible).
check-index:
	@python3 ../scripts/sppf_node_index.py --check
# Ratchet: no NEW bare imports of genuinely-ambiguous names (specialize by shape).
check-import:
	@python3 ../scripts/check_import_shape.py --quiet
# Every genuinely-ambiguous declaration carries a visible shape tag.
check-decltag:
	@python3 ../scripts/decl_shape_tag.py
# Canonical operators live in their carrier's home, one-per-file (no forks/buckets).
check-carrier:
	@python3 ../scripts/check_carrier_locality.py --quiet
# Apex gate: every relational law-motif (≥3 instances) must have a parametric
# apex (a parameterizable module, NOT an index). No baseline — build the apex.
check-apex:
	@python3 ../scripts/law_motif_apex.py --check
# ADVISORY (non-blocking): judgment reports, deliberately NOT in `check` /
# the hook (each has real false positives, so they inform, never gate):
#   * theorem-per-file pressure (signature counts)
#   * categorical grounding (domain algebraic modules w/ no Category dep)
advise:
	@../scripts/check_file_sizes.sh
	@../scripts/check_categorical_grounding.sh
