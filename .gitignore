# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local artifacts
files*.zip

# Agda build artefacts
*.agdai
agda/_build/

# Local codec state (SQLite caches, etc.)
scratch/eliza/state/

# Claude Code session configuration
.claude/


# local marker: mtime of the last green full build (pre-commit weekly gate)
.full-build-stamp

# uv-managed virtualenv (binary; deps tracked in requirements.txt)
.venv/
scratch/.venv/

# local hardware/DMI dump (do-not-commit machine probe data)
dmi.data

# jea/metalanguage Haskell shim build artifacts (source agdai_shim.hs is tracked; binary is not)
jea/metalanguage/agdai_shim
jea/metalanguage/*.hi
jea/metalanguage/*.o

# genlop-style per-dir build-time ledgers (machine-specific timing, parallel to the makefiles)
.agda-times.tsv
**/.agda-times.tsv
.decode-cost.tsv
scripts/.decode-cost.tsv
.build-times.json
.agda-profile.tsv
**/.agda-profile.tsv

# reuse catalog relational store (Ⓓ.catalog-db; derived from the .agdai cores, regenerated
# by scripts/gen_catalog.py — the markdown renders are committed, the .db binary is not)
catalog/catalog.db
