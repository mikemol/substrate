{
  "env": {
    "STRUCT_HOOK_BLOCK": "1",
    "NOCHAIN_HOOK_BLOCK": "1",
    "PYCHECK_HOOK_BLOCK": "1",
    "SHELLCHECK_HOOK_BLOCK": "1",
    "NOVERIFY_HOOK_BLOCK": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "STRUCT_HOOK_BLOCK=1 \"$CLAUDE_PROJECT_DIR/.venv/bin/mikemol-hook-structural-query\""
          },
          {
            "type": "command",
            "command": "NOCHAIN_HOOK_BLOCK=1 \"$CLAUDE_PROJECT_DIR/.venv/bin/mikemol-hook-no-chaining\""
          },
          {
            "type": "command",
            "command": "NOVERIFY_HOOK_BLOCK=1 \"$CLAUDE_PROJECT_DIR/.venv/bin/mikemol-hook-no-verify\""
          },
          {
            "type": "command",
            "command": "SHELLCHECK_HOOK_BLOCK=1 \"$CLAUDE_PROJECT_DIR/.venv/bin/mikemol-hook-shellcheck\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "SHELLCHECK_HOOK_BLOCK=1 \"$CLAUDE_PROJECT_DIR/.venv/bin/mikemol-hook-shellcheck\""
          },
          {
            "type": "command",
            "command": "PYCHECK_HOOK_BLOCK=1 \"$CLAUDE_PROJECT_DIR/.venv/bin/mikemol-hook-pycheck\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/mikemol-hook-inbound-asks\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/mikemol-hook-nemik-check\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/mikemol-hook-inbound-asks\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/bin/mikemol-hook-nemik-check\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Skill(decomposable-by-entailment)",
      "Skill(decomposable-by-entailment:*)",
      "Bash(git mv *)",
      "Bash(PYTHONPATH=\"scratch:.\" .venv/bin/python scratch/verify_meta_protocol.py)",
      "Bash(PYTHONPATH=\"scratch:.\" .venv/bin/python scratch/verify_s4_structure.py)",
      "Bash(PYTHONPATH=\"scratch:.\" .venv/bin/python verify_applied_grammar.py)",
      "Bash(PYTHONPATH=\"scratch:.\" .venv/bin/python scratch/audit_inhabitation.py)",
      "Bash(PYTHONPATH=\"scratch:.\" .venv/bin/python scratch/verify_cell_inhabitation.py)",
      "Read(//home/mikemol/.agda/**)",
      "Bash(apt-cache search *)",
      "Read(//usr/share/**)",
      "Skill(shadow-architecture)",
      "Skill(shadow-architecture:*)",
      "Bash(python3 scratch/pycodemod.py *)"
    ]
  }
}
