% transcript-miner findings — what dispatches to the transcript miner PAID to learn.
%
% ⚑ THIS LEDGER IS ABOUT THE INSTRUMENT, NOT THE CORPUS. A fact about what the transcripts SAY
% belongs in the oracle ledger of whichever surface it concerns; what earns an entry HERE is a
% measured property of the MINING — a detector's recall, a join key that does not hold, a cue
% class the corpus supplies and the design lacks.
%
% ⚑⚑ AND THE CHARACTERISTIC ERROR ON THIS SURFACE IS READING A SAMPLE PROPERTY AS AN OPERATOR
% PROPERTY. A detector measured only where its mechanism works reports perfect precision and
% says nothing about reach. Every entry here states the population it was measured over.
%
% File with `bibstruct --add ... --bib .claude/agents/transcript-miner.bib --apply`.

@misc{tmi-F1-revision-recall-is-30-not-precision-100,
  section  = {finding},
  claim    = {The revision-detection operator's recall is 30 percent, and its measured 100 percent precision is a property of the sample rather than of the operator.},
  check    = {standing},
  note     = {kind=finding by=transcript-miner. Measured 2026-08-23 over 28df5f75-745e-4963-ae8a-1431f7ace5ab.jsonl — 796 of 796 envelopes, 246 text blocks, turns 0-712 substantive (713-795 are API-529 boilerplate). 30 revisions hand-labelled (27 certain, 3 uncertain) BEFORE the detector ran; ordering is the validity of the measurement, since running the detector first bounds the search to what it finds. 9 detected. ⚑ ALL NINE SIT ON ONE CHAIN — the --holes/Fin/Literals thread, whose vocabulary is a PROPER NOUN that survives paraphrase. Precision 9/9 therefore measures the case where the mechanism works and is blind to the rest. Cue set alone ceilings at 70 percent (21/30). STANDING. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): recall 30% (9/30 hand-labelled) against precision 9/9 — and the 100% is a SAMPLE property: all 9 sat on the one chain whose vocabulary is a proper noun}
}

@misc{tmi-F2-recurrence-conjunct-costs-more-than-the-cues,
  section  = {finding},
  claim    = {The phrase-recurrence conjunct loses more revisions than the cue set does, because a revision paraphrases into the reviser's register instead of re-quoting the claim.},
  check    = {standing},
  unification = {entailed},
  axis     = {010},
  note     = {kind=finding by=transcript-miner. Of 30 labelled revisions, 9 carry no cue and 12 carry a cue but are killed at recurrence — so the conjunct is the dominant loss, which inverts the design's assumption that the cue list was the ceiling. WITNESS: turn 383 "the N <= 3 cap is a memory-and-bandwidth ruling" is revised at 396 by "the fold doesn't lease from it" — shared content, near-disjoint token sets. ⚑ THE FIX IS ALREADY IN THE DESIGN'S OTHER HALF: section 1.4 establishes ARTEFACT REFERENCE as the join key for warrant, measured there against adjacency (only 24 percent of claim-bearing sentences invoke their named tool in the same exchange). Section 7 lists recall and the recurrence test as two independent unknowns; they are one. STANDING until the operator is rebuilt on the artefact-reference join and re-measured against this same 30-revision ground truth. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): 12 of 21 losses are at phrase-recurrence, 9 at the cue set; a revision paraphrases into the reviser's register, so token overlap is the wrong join — §1.4's artefact-reference join is the fix, and the design already holds it}
}

@misc{tmi-F3-contrastive-negation-and-self-quotation-are-cues,
  section  = {finding},
  claim    = {Contrastive negation and self-quotation-in-quotes are revision signals in their own right, carrying no cue word at all.},
  check    = {standing},
  note     = {kind=finding by=transcript-miner. Six of the nine cue-less misses are contrastive negations — "not abandoned" (143 to 149), "two spillers, not one" (466 to 518), "the straw, not the load" (453 to 466), and "The runs aren't dying — they're orphaning backends" (638 to 709), the largest diagnostic reversal in the session. ⚑ The design names "not X but Y" in section 6.4(d) but only for PRESERVING both sides of a recovered phrase; it is not wired into the revision operator. ⚑⚑ AND THE DIAGNOSTIC CASE IS TURN 670, which self-quotes its own earlier "silent death" in scare quotes: the recurrence half fires perfectly and the cue half fails. An actor re-quoting their own earlier phrasing is almost always about to qualify it — a cue the corpus supplies and the design does not have. Cheapest adjacent fix: relax the first-person "i was wrong" to "was wrong", recovering turns 240 and 340. STANDING. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): 6 of 9 cue-less misses are 'not X but Y' (aren't dying — they're orphaning); and a self-quotation in scare quotes is a revision signal with no cue word at all}
}

@misc{tmi-F4-audit-cannot-see-unimplemented-intent,
  section  = {finding},
  claim    = {An audit against the implemented system cannot see an unimplemented intent, and will confidently recommend closing the gap in the WRONG direction — deleting the installed half of an unfinished design.},
  check    = {standing},
  note     = {kind=finding by=cotype-review of=memory-apparatus-design.md. MEASURED ON THE REVIEWER'S OWN OUTPUT, which is what makes it evidence rather than a caution. Section 3.3 called gauge=set(vocab) the single highest-leverage measurement available, and section 8.2 withdrew it — the SVD mode value IS the term-to-generator map the chamber walk needs, so the differential would have confirmed the equivalence and LICENSED THE AMPUTATION. The blind spot is structural rather than careless. A clean-room study from code defines a gap as 'no derivation recorded anywhere I could find', so design intent living outside the code is invisible to it by construction. THE SHAPE IS THE DOCSTRING-AS-PROXY BOUNDARY RUNNING THE OTHER DIRECTION — there prose was a stale proxy for code, here CODE IS A LOSSY PROXY FOR DESIGN, and the loss sits in the same place, at a boundary, unwitnessed. Same family as tmi-F1, where a mechanism measured only where it works reported a property of the sample. STANDING. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): an audit against the implemented system cannot see an unimplemented intent and recommends closing the gap in the WRONG direction — deleting the installed half of an unfinished design; measured on the reviewer's own withdrawn recommendation}
}

@misc{tmi-F5-uses-fanin-breadth-are-one-structure,
  section  = {finding},
  claim    = {Sequitur rule-uses, SPPF node fan-in, and apex band-breadth are one statistic read through three instruments, which recasts disabling rule utility as measuring fan-in rather than enforcing it.},
  check    = {standing},
  axis     = {010},
  note     = {kind=finding by=cotype-review of=memory-apparatus-design.md section 9.2. THE OBJECT IS A DAG NODE SHARED BY TWO-OR-MORE PARENTS, READ ALONG THE SHARING AXIS. Three idioms: a Sequitur rule and its uses count, an SPPF or hash-consed IR node and its fan-in, a phrase in the graded curve and its breadth. Sequitur's rule-utility invariant IS the SPPF sharing condition — uses at least 2 is fan-in at least 2 — so disabling utility is choosing to MEASURE fan-in and stratify by it rather than ENFORCE it and delete below the line. The apex bands are a fan-in histogram. ⚑ WHY THIS IS A REUSE-SEARCH HIT AND NOT AN ANALOGY: it is the never-discard-residue and interning-is-recon argument of Substrate.Lifecycle.Reflection reached INDEPENDENTLY from the grammar side, which is corroboration rather than repetition. It also supersedes the reviewer's own order-covariance objection, since hash-consing interns by structure so a shared sub-path is one node wherever it occurs. TESTABLE: compare the SPPF fan-in distribution against the apex band histogram over one cluster — if they are the same distribution read through two instruments the identity is structural. STANDING. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Sequitur rule-uses, SPPF node fan-in, and apex band-breadth are ONE statistic read through three instruments — a DAG node shared by two-or-more parents, read along the sharing axis. Reached independently from the grammar side, and it recasts disabling rule utility as MEASURING fan-in and stratifying by it rather than ENFORCING fan-in at least 2 and deleting below.},
  unification = {entailed}
}

@misc{tmi-F6-ground-truth-reduced-to-count-before-externalised,
  section  = {finding},
  claim    = {The 30-revision ground truth was reduced to a count before externalisation, so only 14 of 30 have recoverable turn labels and recall against 30 is uncomputable.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer. Measured 2026-08-24. The hand-label reported 30 as 27 certain plus 3 uncertain and named turns only for the ones it discussed. 16 were counted and discarded. This is tmi-F1's own error class -- an aggregate quoted where a population was needed -- committed by the measurement that found tmi-F1. Ground truth now lives inline in scratch/tmi_status.py GROUND_TRUTH with WHY_INCOMPLETE stating the gap, and --score refuses to report a recall against 30. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The 30-revision ground truth was reduced to a COUNT before it was externalised: 27 certain + 3 uncertain, with individual turns named only for the ones the report discussed. 14 of 30 have recoverable turn labels; 16 were counted and discarded. A recall figure against 30 is therefore uncomputable, and any tool reporting one is reading the count as if it were the labels -- the tmi-F1 error (aggregate quoted where a population was needed) committed by the measurement that FOUND tmi-F1. Ground truth now lives inline in scratch/tmi_status.py GROUND_TRUTH with WHY_INCOMPLETE stating the gap.}
}

@misc{tmi-F7-reviser-recall-alone-hid-a-degenerate-detector,
  section  = {finding},
  claim    = {Reviser-recall on a positives-only ground truth is unfalsifiable and scored 100 percent on a detector firing at 48 percent that backlinked nearly every revision to the session opener.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer. Measured 2026-08-24 on 28df5f75. The first cut of the widened cue set took bare 'not' as a contrastive cue and ran quote-detection over the whole unit body including tool traffic. The cue census named both causes -- 572 hits on bare 'not', and 95/88/42 selfquote hits on the tool_use argument NAMES description, command and file_path. Fixes: contrast fires only on the two contrast FRAMES, and self-quotation is restricted to assistant prose. Firing fell from 48 percent to 14 percent with recall held at 14 of 14 recoverable. A firing rate now prints beside every recall figure and an ANTECEDENT SPREAD census beside that, because a revision link is a PAIR and scoring only the recorded end measures half of it. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Reviser-recall on a positives-only ground truth is unfalsifiable and hid a degenerate detector. A first cut of the widened cue set (bare 'not' as a contrastive cue, quote-detection over the whole unit body including tool traffic) scored recall 14/14 while firing on 242 of 507 units (48%) and backlinking almost every revision to turn 11, the session opener. The census named both causes: 572 hits on bare 'not', and 95/88/42 selfquote hits on the tool_use argument NAMES description/command/file_path. Fixes: contrast fires only on the two contrast FRAMES; self-quotation is restricted to assistant prose. Firing dropped to 14% with recall held. A firing rate is now printed beside every recall figure and an ANTECEDENT SPREAD census beside that -- a revision link is a PAIR and scoring only the recorded end measures half of it.}
}

@misc{tmi-F8-artefact-join-does-not-subsume-overlap,
  section  = {finding},
  rests-on = {tmi-F5-uses-fanin-breadth-are-one-structure},
  claim    = {The artefact-reference join does not subsume token overlap -- the two have complementary blind spots and coverage is their union.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer. Measured 2026-08-24. Ⓘ3 proposed replacing overlap with the design section 1.4 artefact join, on the witness of turn 383 revised at 396. The artefact join MISSES exactly that pair. The referents 396 shares with 383 are membudget -- present in 63 turns, universal, correctly rejected by the df cap -- and 'N <= 3', a QUANTITY NAME matched by no file, flag or symbol pattern. work_mem does match but links to turns 40, 108 and 110. The shared referent is a DISCOURSE referent, which is a phrase, which is what the phrase mode catches. Separately, joining on mere artefact co-occurrence is degenerate: fan-in is a join key only where it is LOW, mirroring the apex machinery's graded universal-shallow to pairwise-deep reading of tmi-F5. Rarity weighting plus nearest-antecedent cut top-antecedent concentration to 3 percent over 105 distinct antecedents. The shipping mode is union. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The artefact-reference join does NOT subsume token overlap; the two have complementary blind spots and coverage is their UNION. Ⓘ3 proposed replacing overlap with the design section 1.4 artefact join, on the witness of turn 383 ('the N <= 3 cap is a memory-and-bandwidth ruling') revised at 396 ('the fold doesn't lease from it'). Measured: the artefact join MISSES exactly that pair. The referents 396 shares with 383 are membudget (63 turns -- universal, correctly rejected by the df cap) and 'N <= 3', a QUANTITY NAME matched by no file/flag/symbol pattern; work_mem does match but links to turns 40/108/110. The shared referent is a DISCOURSE referent, which is a phrase, which is what the phrase mode catches. Separately, joining on mere artefact co-occurrence is degenerate: fan-in is a join key only where it is LOW, mirroring the apex machinery's graded universal-shallow-to-pairwise-deep reading (tmi-F5). Rarity weighting plus nearest-antecedent cut top-antecedent concentration to 3% over 105 distinct antecedents.}
}

@misc{tmi-F9-indexer-withheld-on-validation-gap-not-recall,
  section  = {finding},
  rests-on = {tmi-F6-ground-truth-reduced-to-count-before-externalised},
  claim    = {The four-module indexer is withheld because the linker is validated against 47 percent of its ground truth, not because recall is poor.},
  check    = {unwitnessed},
  note     = {kind=finding by=transcript-indexer. Decided 2026-08-24. The revision operator scores 14 of 14 recoverable ground-truth revisers at a 15 percent firing rate with 105 distinct antecedents, which passes the stated Ⓘ5 gate. It is withheld on a ground the gate did not name -- 16 of 30 labels are unrecoverable per tmi-F6, and tmi-F7 showed on this exact corpus that a 100 percent recall figure coexisted with a detector firing at 48 percent that backlinked everything to the session opener. Building tmi_units, tmi_threads and tmi_index on that would stack three modules on the one risk already measured. What shipped is scratch/tmi_status.py, the component design section 6.2 calls the part with no prior art, standalone and read-only with ground truth and score harness inline. Unblocked by a second hand pass recovering the 16 missing labels. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Ⓘ5 (build the four-module indexer per design section 6) is WITHHELD, not blocked on poor recall. The revision operator now scores 14/14 recoverable ground-truth revisers at a 15 percent firing rate with 105 distinct antecedents, which passes the stated gate. It is withheld on a different ground the gate did not name: 16 of 30 ground-truth labels are unrecoverable (tmi-F6), so the linker is validated against 47 percent of its own ground truth, and tmi-F7 demonstrated on this exact corpus that a 100 percent recall figure coexisted with a detector firing at 48 percent and backlinking everything to the session opener. Shipping tmi_units/tmi_threads/tmi_index on a linker with that validation gap would build three modules on the one risk already measured here. What shipped instead is scratch/tmi_status.py -- the component design section 6.2 calls 'the part with no prior art' -- standalone, read-only, with the ground truth and score harness inline. UNBLOCKED BY: a second hand pass recovering the 16 missing labels.}
}

@misc{tmi-F10-count-was-an-estimate,
