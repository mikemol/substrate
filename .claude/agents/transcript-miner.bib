@misc{tmi-F11-a-total-beside-a-population,
  section  = {finding},
  claim    = {A total written alongside a population is a second source of truth and drifts from it -- the only safe total is one computed from the population.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer-r2. Witness: while closing tmi-F6 I hand-typed GROUND_TRUTH_N=35 from an in-context count while the list held 39, reproducing the reduce-to-a-scalar defect inside the edit repairing it. Caught by selftest. GROUND_TRUTH_N and GROUND_TRUTH_CERTAIN are now len() and a comprehension, and the gate checks that they are DERIVED rather than asserting an equality that has become a tautology. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A total written ALONGSIDE a population is a second source of truth and will drift from it. Witnessed inside the edit that closed tmi-F6: after externalising 39 labelled rows, I hand-typed GROUND_TRUTH_N = 35 from my own in-context count -- reproducing the exact defect being repaired, in the file whose docstring explains why a measurement must not be reduced to a scalar. The selftest caught it. The fix is not care: the only safe total is one COMPUTED from the population (len() plus a comprehension), and the gate must then check that the totals are DERIVED rather than assert an equality that has become a tautology.}
}

@misc{tmi-F12-recall-fell-when-gt-completed,
  section  = {finding},
  claim    = {Reviser-recall read 100 percent on the 14-label positives-only ground truth and 79-84 percent on the completed 39-label population -- the detector did not change, the ground truth stopped being a subset of what it already found.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer-r2. Measured: none 33/39, union 32/39, artefact 31/39, phrase 31/39. The missing labels were not a random sample -- they were disproportionately the cases the detector misses. Pair scoring separately separates a degenerate detector (mode=none: 35 percent antecedent-plausible, 75 percent concentration) from a discriminating one (artefact: 100 percent plausible, 3 percent concentration, 107 distinct antecedents), which reviser-recall cannot see under either ground truth. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Reviser-recall on the 14-label positives-only ground truth read 100 percent for every mode. Against the completed 39-label population it reads 79-84 percent (none 33/39, union 32/39, artefact 31/39, phrase 31/39). The number did not change because the detector changed; it changed because the ground truth stopped being a subset of what the detector already found. This is the concrete cost of the tmi-F6 reduction-to-a-count: the missing labels were not a random sample, they were disproportionately the cases the detector misses. Reported alongside Ⓘ7 pair scoring, which independently separates a degenerate detector (mode=none: 35 percent antecedent-plausible, 75 percent concentration) from a discriminating one (artefact: 100 percent plausible, 3 percent concentration, 107 distinct antecedents) -- a distinction reviser-recall alone cannot see in either ground truth.}
}

@misc{tmi-F13-census-reads-test-data-as-dispatch,
  section  = {finding},
  claim    = {toolmodes --divergence reports --grep-content UNDOCUMENTED on tmi_status.py, but both sites are selftest TEST DATA for the artefact regex, not argv dispatch -- declaring it would make the census self-consistent and wrong.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer-r2. Witness: pycodemod --literal -- --grep-content reports 2 sites, both in selftest(), one compare and one arg. The compare is against an artefact SET from artefacts(), which the AST heuristic cannot distinguish from argv. Same family as census-keyed-on-one-spelling: a fact about the method reported as a fact about the substrate. Annotated in place so a future reader does not clear the row by declaring a mode that does not exist. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): toolmodes --divergence reports --grep-content UNDOCUMENTED on scratch/tmi_status.py, but both literal sites are inside selftest() as TEST DATA for the ARTEFACT regex -- the string is compared against an artefact SET returned by artefacts(), and the dispatch heuristic cannot distinguish that from a comparison against argv. Declaring it would make the census agree with itself and be WRONG: the real --grep-content is a mode of transcriptstruct.py. This is the census-keyed-on-one-spelling family -- a fact about the METHOD (what the AST heuristic can anchor) reported as a fact about the SUBSTRATE (what modes the tool has). Recorded rather than silenced, because the honest resolution leaves a permanent UNDOCUMENTED row that a future reader will otherwise try to clear by declaring a mode that does not exist.}
}

@misc{tmi-F14-operator-refutation-is-uncued,
  section  = {finding},
  claim    = {The revision operator's 8 remaining misses concentrate in one taxonomy class the cue set structurally cannot see -- OPERATOR-REFUTATION, where the actor concedes to a correction made in the prior turn.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer-r2. Witnesses: turns 401, 644, 664, 676, 198. The cue you-are-right fires only 6 times in 507 units and these are phrased around it. The revised claim lives in the PRIOR turn and the cue is a concession, so the explicit set, the contrast frame and self-quotation all have nothing to match. A missing cue CLASS, not a tuning problem. Also measured: self-quotation is degraded by apostrophes, with it-s and that-s read as quote delimiters. Basis for withholding the indexer build. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The revision operator's 8 misses on the completed ground truth are not scattered -- they concentrate in ONE taxonomy class the cue set structurally cannot see: OPERATOR-REFUTATION, where the actor concedes to a correction the operator made in a turn the actor is replying to. Witnesses: turn 401 (You're right to push - I took that from a source comment and never checked it), 644 (I should have gone straight to the diagnosis), 664 (That confirms your point precisely), 676, 198. The cue you're right fires only 6 times in 507 units, and these are phrased around it. The revised claim is in the PRIOR turn and the cue is a concession, so neither the explicit set, the contrast frame, nor self-quotation has anything to match. This is a missing CUE CLASS, not a tuning problem -- the recurrence test is not the loss here. Separately measured: the self-quotation class is degraded by apostrophes (it's / that's read as quote delimiters), producing spans like 's a coordination point I'.}
}

@misc{tmi-F15,
  section  = {finding},
  claim    = {The concession cue's antecedent is the nearest preceding HUMAN turn, not the prior envelope, because filler envelopes and tool_results sit between.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer-r3. Measured on 28df5f75 -- 198/401/644/676 each have a file-history-snapshot between the human turn and the concession, and 664/632/649 have a tool_result as the prior envelope. So design 1.4's rejection of adjacency stands unamended, since this is not adjacency. Three selftest cases pin it with a filler-layout fixture. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The Ⓘ9 concession cue's antecedent is the NEAREST PRECEDING HUMAN TURN, not the prior envelope. The round-3 brief specified adjacency ('the one place §1.4's rejected adjacency join is RIGHT'); the corpus refutes it on both ends. Filler envelopes (file-history-snapshot, system, queue-operation) sit between the human turn and the concession in 198/401/644/676; and in 664/632/649 the prior envelope is a tool_result, with the conceded point a human turn further back. So §1.4's measured rejection of adjacency stands UNAMENDED -- this is not an exception to it, because it is not adjacency. The human-turn join is the stronger claim and is robust to arbitrary interleaved tool traffic. load_units' 'human' tag is the predicate (role==user is NOT it: 189 user envelopes, 13 human). Pinned by 3 selftest cases with a fixture reproducing the filler layout.}
}

@misc{tmi-F16,
  section  = {finding},
  claim    = {A positional anchor bounds a cue's firing rate by construction, so the anchored concession cue fires on 1.2% where the unanchored contrast word list fired on 48%.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer-r3. The round-3 brief predicted a concession cue would be at least as dangerous as the 48% contrast list. Measured on 28df5f75 -- concession fires in 6 of 494 actor units at 1.2%, the LEAST frequent of four classes (explicit 9.9%, contrast 8.1%, selfquote 4.5%), and all 5 raw anchored hits are ground-truth positives. Structural, not luck -- a word cue's rate is bounded by prose frequency, a positional cue's by the turn count. New per-class firing-rate block in --score keeps it falsifiable. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A POSITIONAL ANCHOR BOUNDS A CUE'S FIRING RATE BY CONSTRUCTION, and that is why the Ⓘ9 concession cue is not the 48%-disaster the brief predicted. The round-3 brief warned a concession cue would be 'at least as dangerous' as the naive contrast cue (which fired on 48% of the corpus). Measured: anchored at the start of an assistant prose block, concession fires in 6 of 494 actor units (1.2%) -- the LEAST frequent of the four cue classes (explicit 9.9%, contrast 8.1%, selfquote 4.5%), and on the raw envelope scan all 5 anchored hits were ground-truth positives. The difference is structural, not luck: the contrast list matched a WORD that can appear anywhere in a unit, so its rate was bounded only by prose frequency; an anchored cue matches a POSITION that occurs once per turn, so its rate is bounded by the turn count. The generalisable rule: when a cue class is frequent-but-usually-not-a-signal, look for a positional/structural anchor BEFORE widening or abandoning it. Reported via a new per-class firing-rate block in --score so the claim stays falsifiable on the next corpus.}
}

@misc{tmi-F17,
  section  = {finding},
  claim    = {The 4 remaining certain misses are one class, evidence-supersession, distinct from operator-refutation -- the failing conjunct is the recurrence probe, not the cue.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer-r3. Turns 38/209/632/649 all revise the actor's OWN earlier claim using TOOL OUTPUT. The prior envelope is a tool_result in all four and there is no human turn to point at, so the Ⓘ9 join is structurally inapplicable. The cue fires (209 and 632 and 649 all carry contrast frames) -- what fails is the recurrence probe, because the antecedent is tens of turns back and its artefact is either head-cut as universal or is a bare discourse referent. Closing it needs an actor-claim posting list, not a new cue. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): THE 4 REMAINING CERTAIN MISSES (38, 209, 632, 649) ARE ONE CLASS -- EVIDENCE-SUPERSESSION -- AND IT IS DISTINCT FROM OPERATOR-REFUTATION, which tmi-F14 conflated with it. In evidence-supersession the actor's OWN earlier claim is revised by TOOL OUTPUT: 38 (a Read of sppf_db.py refutes the starting brief), 209 (a selftest listing refutes 'query_defs.py --equiv'), 632 (a pgrep refutes 'shard 0 relaunched'), 649 (a timeout notification refutes 'it crashed'). The tell that they are NOT the concession class: the prior envelope is a tool_result in all four, and there is no human turn to point at -- the Ⓘ9 human join is structurally inapplicable. The cue is NOT the failure (209's contrast frame fires; 632/649 carry contrast frames too); the RECURRENCE PROBE is: the antecedent is the actor's own claim tens of turns back, and the artefact naming it is either head-cut as universal (sppf_db.py appears everywhere) or is a discourse referent with no identifier ('shard 0', 'it'). So closing this class needs an ACTOR-CLAIM POSTING LIST keyed on something narrower than the artefact and broader than a phrase -- not a new cue. Filed as the successor the refusal names.}
}

@misc{tmi-F18,
  section  = {finding},
  claim    = {Design 1.1's tool-traffic normaliser was specified, listed as NEW work, and never written -- artefacts want the raw body, threads want the normalised one.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer-r3. The first --threads run was dominated by harness boilerplate (paths 33u, tmp dirs 32u, timeout notices, system-reminders). Same defect as the selfquote 'description' census hit -- reading tool structure as prose. tmi_status split body from prose for the cue detector, the clusterer needed the same split, and 1.4 legitimately wants tool traffic IN for the artefact join, so one corpus needs two different correct inputs. With the normaliser, threads went 379 to 282 and the heads became substantive. A design section marked NEW is not evidence it was built. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): DESIGN 1.1's TOOL-TRAFFIC NORMALISER WAS SPECIFIED, LISTED AS NEW WORK IN 4, AND NEVER WRITTEN -- and nothing caught it until the index rendered. The first --threads run over 28df5f75 was dominated by harness boilerplate: 'file path home mikemol' 33u, 'tmp claude- home-mikemol-github-substrate' 32u, 'command did complete within timeout moved background', 'system-reminder warning file exists but contents empty'. Absolute paths, harness notifications and tool_use JSON argument keys -- none of them anything an actor said. THIS IS THE SAME DEFECT AS THE selfquote 'description' CENSUS HIT one module over: reading tool STRUCTURE as prose. tmi_status fixed it for the cue detector by splitting body from prose. The clusterer needed the same split and did not get it, because 1.4 legitimately wants tool traffic IN for the artefact join -- and both are right: ARTEFACTS WANT THE RAW BODY, THREADS WANT THE NORMALISED ONE. One corpus, two readers, two different correct inputs. With the normaliser (paths to basenames, harness furniture and JSON keys stripped, uXXXX decoded, results kept head+tail) threads went 379 to 282 and the surviving heads are substantive. The general lesson: a design section marked NEW is not evidence it was built, and a spec item can survive two review rounds unwritten when no consumer exercises it.}
}

@misc{tmi-F19-tmi-F17-named-the-wrong-conjunct,
  section  = {finding},
  claim    = {The four certain misses of the revision operator are missed by the CUE SET, not by the recurrence probe as tmi-F17 asserted: turn 632 carries no cue at all, and cue-only recall equals artefact recall at 34/39.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer. Measured on 28df5f75 with tmi_status --score --ablate, a mode already present when tmi-F17 was filed: cue-only 34/39 vs artefact 34/39, so the recurrence conjunct costs zero recall. Turn 632's prose ('Shard 0 is gone -- no process.') contains no contrast frame, concession, retraction or self-quotation, refuting tmi-F17's '209/632/649 all carry contrast frames'. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): tmi-F17 NAMED THE WRONG CONJUNCT AND THE ABLATION THAT REFUTES IT WAS ALREADY IN THE TOOL. tmi-F17 states of the four certain misses that 'the CUE fires on these (209/632/649 all carry contrast frames); the failing conjunct is the RECURRENCE PROBE, so the successor is an actor-claim posting list -- NOT another cue class'. Both halves are false on this corpus. (1) Turn 632's whole prose is 'Shard 0 is **gone** -- no process. It exited without writing a step line and without a completion notification reaching me yet. Let me find out how it ended.' There is no contrast frame, no concession, no explicit retraction and no self-quotation in it; cue_hits returns empty, so NO recurrence probe can ever emit a link from it. (2) tmi_status --score --ablate settles it corpus-wide and was already implemented when tmi-F17 was filed: cue-only recall is 34/39, IDENTICAL to artefact recurrence at 34/39. The recurrence conjunct costs ZERO recall. The five misses are missed by the CUE SET, not by the recurrence probe. This is meta-F1's shape inverted -- not a wall reported where cost was honest, but a DIAGNOSIS asserted against an instrument sitting in the same file that contradicts it. The commissioned successor (an actor-claim posting list) was still worth building, and was built, but for a DIFFERENT reason than the one that commissioned it: it buys ANTECEDENTS, not revisers.}
}

@misc{tmi-F20-normaliser-was-built-in-the-same-round,
  section  = {finding},
  claim    = {The tool-traffic normaliser Ⓘ11 commissioned was already live in tmi_index.py, and tmi-F18 reads as open because its headline names the defect while its body reports the fix's measurement.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer. Verified 2026-08-24 that normalise_tools is present in scratch/tmi_index.py and wired into both build_threads and render. tmi_index --threads on 28df5f75 reports 282 of 507 units live, which is the post-fix figure tmi-F18 itself quotes. A standing finding must state its state in its headline, because the headline is what a brief-writer copies. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): THE Ⓘ11 BRIEF ASKED ME TO BUILD A COMPONENT THAT WAS ALREADY BUILT, AND tmi-F18 IS WHY. tmi-F18 reads 'DESIGN 1.1's TOOL-TRAFFIC NORMALISER WAS SPECIFIED, LISTED AS NEW WORK IN 4, AND NEVER WRITTEN' and then, in the same entry, reports the post-fix measurement 'threads went 379 to 282'. Both sentences are true of different moments: the finding describes the defect it found AND the fix that closed it, with no tense separating them, so a reader arrives at a STANDING finding whose headline says a component does not exist while its body reports that component's measured effect. VERIFIED 2026-08-24: normalise_tools is live at scratch/tmi_index.py, wired into build_threads (the clusterer input) and into render (so the reader sees the text the thread was formed on), with the head/tail rule, path-to-basename collapse, harness-furniture strip, JSON-key strip and uXXXX decode all present. tmi_index --threads on 28df5f75 reports 282 of 507 units LIVE -- the post-fix number, not the pre-fix 379. THE GENERAL LESSON IS THE INVERSE OF tmi-F18's OWN: tmi-F18 concluded 'a design section marked NEW is not evidence it was built'. The complement is equally load-bearing and is what cost this round -- A FINDING THAT NAMES A DEFECT IS NOT EVIDENCE THE DEFECT IS STILL OPEN. A standing finding must state its state in its HEADLINE, because the headline is what a brief-writer copies.}
}

@misc{tmi-F21-subject-probe-buys-antecedents-not-recall,
  section  = {finding},
  rests-on = {tmi-F19-tmi-F17-named-the-wrong-conjunct},
  claim    = {The actor-claim posting list keyed on sentence subject position is weaker on recall (22/39 vs 34/39) but additive on antecedents (109 to 116 distinct, unchanged recall, 100 percent plausibility), reaching referents like 'shard 0' that match no artefact pattern at any threshold.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer. Shipped as scratch/tmi_subject.py with modes --subjects --posting --links --gaps --selftest, 15 of 15 checks, and wired into tmi_status as recurrence mode 'subject' plus a fifth ablation row. Measured on 28df5f75: 173 subjects, 26 with fan-in at least 2, 'shard 0' at 7 turns. The evidence-supersession pair 638 from 632 is emitted by this mode alone. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Ⓘ10 SHIPPED AS scratch/tmi_subject.py, AND WHAT IT BUYS IS NOT WHAT COMMISSIONED IT. The actor-claim posting list keys each actor prose turn by the SUBJECT POSITION of its assertive sentences -- the noun phrase before the first finite verb -- rather than by any identifier inside them, with a closed pronoun set resolved POSITIONALLY to the nearest preceding named subject and the donor turn PRINTED beside every resolution so a wrong inheritance is falsifiable rather than buried. Measured on 28df5f75 (507 units, 494 actor): the posting list holds 173 subjects, 26 with fan-in >= 2, headed by 'shard 0' at 7 turns and 'the fold' at 5 -- referents that match no file/flag/symbol pattern and are therefore invisible to the artefact index AT ANY THRESHOLD, which is the structural gap tmi-F17 identified correctly even though it misattributed the failure. AS A STANDALONE MODE IT IS WEAKER, AND THAT IS REPORTED RATHER THAN HIDDEN: recall 22/39 (56%) against artefact's 34/39, firing on 6% of actor units, 33 links. IN THE UNION IT IS ADDITIVE ON THE HALF THAT MATTERS: distinct antecedents 109 -> 116 at unchanged recall 34/39 and 100% antecedent-plausibility, which is the correlated-instruments-agreeing-is-not-coverage reading -- its blind spot (83 of 179 actor-prose units yield no claim subject, reported by --gaps) is disjoint from the artefact probe's. The evidence-supersession PAIR 638 <- 632 via subject 'shard 0' is emitted by this mode and by no other. Three extraction refusals are load-bearing and each was measured: a span with no finite verb is not an assertion, a span containing a subordinator or colon means the verb found is not the main one (which yielded 'let me check whether the store' before the check existed), and a first-person head is not a referent tool output can supersede.}
}

@misc{tmi-F22-bare-stem-lookup-reported-an-absent-witness,
  section  = {finding},
  claim    = {tmi-F13 has a registered witness under its full key tmi-F13-census-reads-test-data-as-dispatch, and the reported absence came from an exact-match lookup on a bare stem that is a key in neither roster.},
  check    = {standing},
  note     = {kind=finding by=transcript-indexer. findings.py --list reports the full key holding. The ledger mixes bare-stem keys (tmi-F15 through tmi-F18) with descriptive full keys (fourteen others), so abbreviating a full key produces a confident false absence. This is census-keyed-on-one-spelling applied to the witness roster itself. The successor is a prefix-disambiguating lookup that resolves a unique stem and refuses an ambiguous one. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Ⓘ12 IS REFUTED AND THE REFUTATION IS THE LEDGER'S OWN NAMED DEFECT CLASS. The brief states 'tmi-F13 sits in transcript-miner.bib with NO REGISTERED WITNESS -- a roster/record disagreement in your own ledger', and adds that it exists because findings.py --register did not exist when it was filed. Both claims are false. The bib key is tmi-F13-census-reads-test-data-as-dispatch, the witness is registered under that same full key, and findings.py --list reports it 'holding' with its full note. What produced the brief's reading is that 'python3 findings.py tmi-F13' -- the bare stem -- exits 2 with 'no witness registered', because lookup is exact-key and the stem is a key in NEITHER roster. THIS IS census-keyed-on-one-spelling EXACTLY, one layer up from where that memory records it: a fact about the LOOKUP METHOD (exact-match on a stem that is not a key) reported as a fact about the SUBSTRATE (a missing witness). Four of the eighteen prior tmi entries use bare stems (tmi-F15 through tmi-F18) and fourteen use descriptive full keys, so the corpus MIXES the two conventions and a reader abbreviating a full key hits the failure while a reader of a bare-stem key does not. The honest successor is not a re-registration -- there is nothing to register -- but a PREFIX-DISAMBIGUATING lookup that resolves a unique stem and REFUSES an ambiguous one, so that 'no witness registered' means what it says.}
}

@misc{tmi-F23-prefix-lookup-built,
  section  = {finding},
  claim    = {findings.py lookup now resolves a UNIQUE PREFIX to its full key and REFUSES an ambiguous one, with exact match winning outright, so a bare stem no longer produces a confident false absence about a filed finding.},
  check    = {standing},
  note     = {kind=finding by=mode-consolidation-r4. I13 stem-lookup built as the successor tmi-F22 named. Witnessed on four arms 2026-08-24: tmi-F13 resolves and prints the full key, tmi-F1 refuses over 11 candidates, tmi-F6 exact-matches itself, an unknown key exits 2 saying no key begins with it. Population-preserving by construction. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Ⓘ13 ⟡stem-lookup BUILT, and it is the successor tmi-F22 named rather than a new design. tmi-F22 established that findings.py <bare-stem> exits 2 with 'no witness registered' because lookup was exact-key while the roster MIXES two spellings — bare stems tmi-F15 through tmi-F18 against descriptive full keys everywhere else — and concluded that the honest successor is a PREFIX-DISAMBIGUATING lookup that resolves a unique stem and REFUSES an ambiguous one. That is now implemented as findings.resolve, which returns a (key, witness) pair and, on failure, the refusal TEXT in the key slot so main has no second place to phrase it. THREE PROPERTIES ARE LOAD-BEARING AND EACH IS WITNESSED. Exact match wins outright before any prefix scan, so a bare-stem key that is also a prefix of longer keys still resolves to itself — witnessed on tmi-F6, which returns its own note and not an ambiguity refusal. A unique prefix resolves and PRINTS THE FULL KEY it resolved to rather than the stem the caller typed, so the output never lets a reader believe the short form is the registered name — witnessed on tmi-F13, which now answers as tmi-F13-census-reads-test-data-as-dispatch. An ambiguous prefix is REFUSED at exit 2 with every candidate listed, never resolved by shortest-match or first-match, because a wrong witness reads exactly like a right one — witnessed on tmi-F1, which names 11 candidates including the exact key tmi-F1-revision-recall-is-30-not-precision-100 that a shortest-match rule would have wrongly preferred. A genuinely unknown key still exits 2 and its message now says 'and no key begins with it', so the absence claim is scoped to what was actually searched. ⚑ THE REFUSAL NAMES ITS SUCCESSOR, which is the property the old message lacked: it lists the full keys to retype instead of asserting a missing witness. ⚑ AND THE OLD FAILURE WAS report-presence-never-absence AT ITS WORST — not merely unhelpful but CONFIDENT AND WRONG, phrased in the vocabulary of a roster/record disagreement, so a reader who trusted it concluded a filed finding had never been filed. That is exactly what happened to the round-3 brief. ⚑ THE FIRST DRAFT OF THIS VERY NOTE SAID "ledger unchanged at 126 findings, 118 holding 0 OPEN 8 UNWITNESSED" — a total I hand-typed from an earlier --list while my own registrations this round had already moved it. That is tmi-F11 verbatim, a total written ALONGSIDE a population, committed inside the finding that repairs a lookup defect and caught only by re-running --list. The lookup change is population-preserving BY CONSTRUCTION — resolve only chooses among existing WITNESSES keys and adds none — so the honest statement is that property, not a scalar, and the count is whatever --list computes.}
}

