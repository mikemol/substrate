@misc{meta-F16-proxy-boundedness-is-the-second-axis,
  section  = {finding},
  claim    = {Subject-versus-proxy alone cannot classify a keying defect, because the same token is a proxy at one boundary and the displaced witness at another, so boundedness of the failure mode is the required second axis.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. Three witnesses that the one-axis question under-determines. An exit code stands in for git state in one incident and is what a grep-FAIL proxy displaced in another. A DECLARED census is rightly preferred over the live tenant, since a gate that flips between a sandbox and the live store is not a gate. An obs count is a sound proxy for ranking ingestion work and unsound for a decomposition decision. A twelve-row proxy ledger self-corrected on this ground, recording that it had presented twelve proxies as twelve lapses when a proxy that has never diverged from its witness in production is a working proxy. Without the second axis a proxy census reports every abstraction as debt. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): subject-vs-proxy alone cannot classify a keying defect: the same token is proxy at one boundary and displaced witness at another (an exit code stands in for git state in one incident and is what grep-FAIL displaced in another), a declaration is rightly preferred over the live tree because a gate that flips between tenants is not a gate, and one count is sound for ranking while unsound for decomposition. Boundedness of the failure mode, and whether anything re-gates it, is the required second axis or a census reports every abstraction as debt}
}

@misc{tmi-transcriptstruct-has-no-timestamp-mode,
  section  = {finding},
  claim    = {transcriptstruct exposes no timestamp mode and silently ignores --timestamps, so substrate's directive census cannot be ordered against three peers' UTC records.},
  check    = {unwitnessed},
  note     = {kind=finding by=transcript-miner via substrate. VERIFIED by running the tool bare: the usage block lists --messages, --grep-content, --human, --extract, --context, --stats and --prose, and none reports a time. ⚑ The consequence is cross-repo: three peers filed OPERATOR-DIRECTIVES files in mtools keyed on UTC, so substrate's must fall back to turn index — and the operator is compiling those four records precisely to compare what each delegate was told, so the aligning axis is the one substrate cannot produce. ⚑⚑ A missing mode is WORK not a finding — the envelopes carry the data and nothing reads it out. The silently-ignored flag is the worse half: exit 0 and plausible output means the gap presents as a successful run rather than an absence. ⚑ Second bound, the agent's measurement and not re-run by me: --prose --role attachment returns zero and --messages reports every attachment as 0B, so attachment bodies may be undecodable. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): transcriptstruct.py exposes NO mode that prints an envelope timestamp, and --timestamps is silently accepted and ignored rather than refused. VERIFIED by running the tool bare: the usage block lists --messages, --grep-content, --human, --extract, --context, --stats and --prose, and no mode among them reports a time. ⚑ THE CONSEQUENCE IS CROSS-REPO RATHER THAN LOCAL. Three peer repos filed OPERATOR-DIRECTIVES files in mtools whose entries are keyed on UTC timestamps, so substrate's equivalent cannot be ordered against theirs and must fall back to turn index. The operator is compiling those files to learn what each delegate was told for one survey, which means the ONE axis that would align four independent records is the axis substrate cannot produce. ⚑⚑ AND IT IS A MISSING MODE, WHICH IS WORK RATHER THAN A FINDING — the envelopes carry the data, nothing reads it out. A silently-ignored flag is the worse half: a caller passing --timestamps gets exit 0 and output that looks answered, so the gap presents as a successful run rather than as an absence. ⚑ A SECOND BOUND FOUND IN THE SAME DISPATCH, unverified by me and reported as the agent's: --prose --role attachment returns zero over the corpus and --messages --role attachment reports every attachment as 0B, so attachment bodies may be undecodable by this reader. Stated as the agent's measurement rather than mine.}
}

@misc{tmi-a-broadcast-is-four-different-messages,
  section  = {finding},
  from     = {tmi-transcriptstruct-has-no-timestamp-mode},
  claim    = {The four delegates did not receive the same directive set, because a broadcast in this harness is the operator re-typing per delegate rather than fanning one message out.},
  check    = {unwitnessed},
  note     = {kind=finding by=substrate. OPERATOR-DIRECTIVES-substrate.md filed. Peers documented a TIMESTAMP divergence over one broadcast. Substrate's record shows worse: seven of paperkit's fifteen directives are absent from substrate's 1.48 GB corpus, each verified with a denominator. ⚑⚑ The word pullback never appears in a human turn anywhere in substrate's corpus — the peers call that correction the one that inverted every arrow, and substrate wrote its third-order filing never having been told it computed a limit. ⚑ The first-order filing order is also absent: substrate.md was SELF-AUTHORISED off a general grant plus a peer convention, with substrate asking MTOOLS rather than the operator for placement. The base filing has no directive behind it. ⚑⚑⚑ The cause is in the kickoff — substrate's and paperkit's are DIFFERENT TEXT, paperkit's naming all four repos and substrate's naming one. Typed per-delegate, not fanned out. ⚑ The repair channel was the shared directory: the third-order order was re-issued byte-identically 167 turns later with nothing between them in substrate's transcript, so any pushout-correctness came from the reconcile-with-all order rather than an instruction. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): OPERATOR-DIRECTIVES-substrate.md is filed. THE FINDING IS NOT THE LIST, IT IS THE DIVERGENCE. Three peers filed directive censuses documenting a TIMESTAMP divergence — four delegates holding four receipt times for one broadcast. Substrate's record establishes something worse: THE FOUR DELEGATES DID NOT RECEIVE THE SAME EVENTS. Seven of paperkit's fifteen directives are absent from substrate's 1.48 GB corpus, each verified with a denominator rather than assumed. ⚑⚑ THE WORD pullback NEVER APPEARS IN A HUMAN TURN ANYWHERE IN SUBSTRATE'S CORPUS. The peers call that correction the one that inverted every arrow and the reason the third-order filings were rewritten. Substrate wrote substrate-third-order.md never having been told it computed a limit. ⚑ AND THE FIRST-ORDER FILING ORDER IS ALSO ABSENT: substrate.md was SELF-AUTHORISED, off a general grant plus a peer-established convention, with substrate asking MTOOLS rather than the operator where to put it. The base filing anchoring the whole census has no directive behind it. ⚑⚑⚑ THE GENERATIVE CAUSE IS VISIBLE IN THE KICKOFF. Substrate's kickoff and paperkit's are DIFFERENT TEXT — paperkit's enumerates all four repos, substrate's names only cassian-observability. These were typed per-delegate, not fanned out. A broadcast in this harness is the operator re-typing an instruction per delegate, and re-typing drifts. ⚑ THE REPAIR CHANNEL WAS THE SHARED DIRECTORY, NOT THE INSTRUCTION. The third-order order was re-issued byte-identically 167 turns later with nothing between the two in substrate's transcript, so from inside it the repeat is inexplicable. Whatever pushout-correctness substrate's filing has arrived through the reconcile-with-all-findings order — a shared artifact carrying what an edit could not.}
}
