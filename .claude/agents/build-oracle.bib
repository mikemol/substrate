@misc{gate-G427-log-freshness-cut-5-predicate-inputs-supplied-origin-index-order-nondeterministic,
  section  = {finding},
  claim    = {substrate/log_freshness.py decides whether a build log describes today's tree from a supplied DAG, log index and mtime reader, pinning every verdict shape including the unsafe-stale one, and its by-path differential shows the origin's log index picks among duplicate hash dirs in filesystem order.},
