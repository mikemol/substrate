@misc{build-F1-cap-and-lease-are-different-kinds,
  section  = {finding},
  claim    = {A memory CAP and a memory LEASE are different kinds, and the asymmetry between them INVERTS — so reading the lease as a ceiling gets the safe direction backwards.},
  check    = {standing},
  note     = {kind=finding by=build-oracle. MEM_CAP is a GATE: the GHC heap cap enforced per module, where exceeding it is a FAILURE and the module must seal its heavy neutrals opaque or import a cheaper proof. Wrong-LARGE is the danger, which is exactly what makes it a forcing function. AGDA_MB is a FITTING PARAMETER: a cgroup MemoryMax over the whole process that AUTOSIZES — on an OOM kill membudget releases and re-enters at the next power-of-two bucket until it fits. So AGDA_MB_MAX is the top of a SEARCH, not a bound the lease must respect, and a too-small first guess costs one retry and self-corrects while a too-large one wastes pool. STANDING witness: this is a measured contract, not a defect awaiting repair. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEM_CAP is a GATE where wrong-large silently admits debt; AGDA_MB is a FITTING PARAMETER that autosizes on OOM, so AGDA_MB_MAX is the top of a search}
}

@misc{build-O9,
  section  = {finding},
  claim    = {build_census.py's bare-run usage banner is not a complete mode census — --gates dispatches and works while appearing in no usage line, so 'no such mode' inferred from the banner reports the banner rather than the tool.},
  check    = {selftest:python3,/home/mikemol/github/substrate/scripts/build_census.py,--gates},
  note     = {kind=finding by=build-oracle. MEASURED — a bare run of scripts/build_census.py prints modes --sync/--check/--selftest and exits 2. --caps also exits 2 with that same banner (genuinely absent). But --gates prints the full declared gate roster by phase and exits 0. An absent mode and an undocumented-but-live mode are INDISTINGUISHABLE from the banner, so each candidate must be TRIED rather than inferred. The witness runs --gates, exit 0 meaning the mode is live. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): kind=finding by=build-oracle. build_census.py has a WORKING --gates mode that its own bare-run usage banner does not list (the banner names only --sync/--check/--selftest). A reader who runs the tool bare to discover its modes concludes the capability is absent -- a fact about the BANNER reported as a fact about the tool -- and an unlisted --caps really does exit 2, so the two are indistinguishable without trying each. The hazard: on this toolkit a bare run is NOT a complete mode census, so 'no such mode' must never be inferred from the banner alone. Witness: the command runs and exits 0.}
}

@misc{build-oracle-top-level-module-outside-every-enumeration-root,
  section  = {finding},
  claim    = {The tree's declared top-level Agda module file sits at the include root, not under the package directory, so it is outside the enumeration domain of the build generator, the def-index and the public ratchet simultaneously -- all three walk the package subdir.},
  check    = {standing},
  note     = {kind=finding by=build-oracle. The witness: gen_build_makefiles.parse_tree does os.walk(SRC) with SRC = os.path.join(AGDA_DIR, 'Substrate'), and it has exactly ONE call site feeding both flat_text and root_text -- so the whole generated build shares that one root. agda_defs.py --provides on the top-level module name exits 2 'NOT A MODULE IN THE INDEX' while a package-qualified sibling resolves, and the tool correctly calls that a fact about the QUERY. The three instruments are CORRELATED: their agreement is not coverage, which is why a wholesale public re-export in that file has never appeared in any ratchet baseline. Report the ROOT, never a module count -- a count cannot distinguish 'none present' from 'walked the wrong root'. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A module whose file sits at the INCLUDE ROOT rather than under the package directory is invisible to every enumerator in this repo at once: the build generator, the def-index and the public ratchet all walk the PACKAGE SUBDIRECTORY, not the include root. Those three instruments are therefore CORRELATED and their agreement carries no coverage. Contract: such a file is tracked, is a legal Agda module, and is compiled by NOTHING in the gated build, so a policy its content violates cannot fire and no gate reports the gap -- the gap is in the shared domain, not in any gate's logic. Re-derive the root from gen_build_makefiles.parse_tree's os.walk(SRC), never from a count.}
}

@misc{bo-F1,
  section  = {finding},
  claim    = {A selftest lease is a fixed default whose retry ladder is inert, because membudget retries only when MEMBUDGET_RETRY_OOM is set and suite_command never sets it, so roster leases fail closed like a gate rather than self-correcting like a lease.},
  check    = {standing},
  note     = {kind=finding by=build-oracle. The single authority is substrate/suite_command.py DEFAULT_SUITE_MB, overridable by the SELFTEST_MB env var, used ONLY to build the selftest label argv. It is disjoint from AGDA_MB and AGDA_MB_DEFAULT, so changing it cannot touch agda compiles. Witness, read scripts/membudget cmd_run retry guard which requires MEMBUDGET_RETRY_OOM non-empty, plus the census of every site setting that flag (agda-shim, compile_recipe, gate_status), none of which is a selftest path. Corroborated independently by catalog/worklist/roster-read-2026-09-01.md which files it as the open item retry-in-selftest-mk. Consequence, the wrong-small-costs-one-retry asymmetry is a property of the FLAG, not of leases as a kind. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): kind=finding by=build-oracle. A per-suite lease is a FIXED default and membudget's retry ladder is INERT for it: the retry guard at cmd_run requires MEMBUDGET_RETRY_OOM non-empty, and suite_command.command() builds the argv without it. So a selftest lease has the LEASE's wrong-small-self-corrects asymmetry only where the shim sets the flag; for the roster it fails closed like a gate. Witness: grep of every MEMBUDGET_RETRY_OOM site (agda-shim, compile_recipe, gate_status) shows no selftest path.}
}

@misc{gate-G400-check-sync-overflows-the-kernel-argument-limit,
  section  = {finding},
  claim    = {Flat.mk's check-sync recipe expands all 3598 MODULES into a single shell argument and fails with Argument list too long, so make all cannot start on any host, and no store-free typecheck target exists.},
  check    = {refuses:make,-C,agda,-f,Flat.mk,check-sync},
  note     = {kind=finding by=paths-forward-loop tick 14. The witness: exit 127 at Flat.mk check-sync on luthen, while the same invariant passes through gen_build_makefiles --check. The root all target also runs reconcile first, which needs the SPPF store at 127.0.0.1:30432, absent here. W14 built with a scratchpad aggregate over the .agdai targets alone, which the generator should emit as a typecheck target. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): first build on luthen: make -f Flat.mk all dies at check-sync with /bin/sh: Argument list too long (exit 127). The recipe expands MODULES (3598 names) inline into ONE sh -c string, exceeding MAX_ARG_STRLEN (128 KiB per argument) on any Linux host. The invariant it guards is already gated by gen_build_makefiles --check (OK, 3598 modules), so the recipe is a second, now-broken spelling of that check. Repair belongs in gen_build_makefiles: have check-sync call the generator's --check, or write MODULES to a file. Also: the root all target runs reconcile FIRST, which needs the SPPF store at 127.0.0.1:30432 — absent on this host — so there is NO store-free typecheck target; W14 used a scratchpad typecheck: $(AGDAI) aggregate, which the generator should emit}
}

