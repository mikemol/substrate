@misc{gate-O12,
  section  = {finding},
  claim    = {No census mode partitions the gate roster by git-coupling, so any make-to-bazel portability partition is derived by reading the hook by eye rather than by a program.},
  check    = {unwitnessed},
  note     = {kind=finding by=gate-oracle. UNWITNESSED deliberately -- no command distinguishes a git-coupled gate from a pure-tree one. build_census.py --gates reports PHASE only and gate_census.py --check reports blocking/kind/baseline, and neither reads whether a gate invokes git or consumes the staged index. Measured for N141 by reading .githooks/pre-commit directly. Closes when a --git-coupling or --portable mode exists on either census tool. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): kind=finding by=gate-oracle. No mode in the toolkit partitions the gate roster by GIT-COUPLING. build_census.py --gates reports phase only, and gate_census.py reports blocking/kind/baseline but neither reads whether a gate calls git or consumes the index. The bazel-portability partition for Ⓝ141 was derived by READING .githooks/pre-commit by eye, which is exactly the judgement-in-the-turn this repo forbids. Closes when a --git-coupling or --portable mode exists on one of the two census tools.},
  addendum = {RESOLVED 2026-09-04. The reader now exists: substrate/gate_coupling.py classifies every git-touching hook line as TRIGGERED (a staged-path regex selecting whether a gate runs) or READS_GIT (a git invocation in the hook's own plumbing), with a CLI beside it and twelve cases. The partition this finding recorded as read-by-eye is re-derivable on demand. AND THE MEASURED RESULT DIFFERS FROM THE HAND READING: every git-coupled line attributes to THE HOOK ITSELF rather than to a gate script, so the coupling lives in the hook's plumbing — the staged-tree export, the report tee — and not in the gate bodies. The hand reading had attributed coupling to the conditional gates, which is the weaker claim, since a triggered gate is portable behind a non-portable dispatch: a build system selects by dependency rather than by a staged-path regex. THE READER STATES ITS OWN BLIND SPOT IN ITS OUTPUT: it reads the HOOK, not the gates, so a gate whose own body shells out to git is invisible to it — a fact about the reader rather than an absence, and without that line the count would read as complete. It also had to FORK the trigger extraction rather than import it, because the census that already owns that pattern carries hundreds of its own findings and cannot take an edit; the fork is declared in the module docstring rather than silent, including why the pattern accepts either quoting.}
}

@misc{gate-F33-toolmodes-cannot-import-the-structural-hook,
  section  = {finding},
  claim    = {toolmodes.py cannot be run at all because it imports hook_structural_query, which imports a linux_sources package that is not installed in this environment.},
  check    = {unwitnessed},
  note     = {kind=finding by=substrate-session. Measured 2026-09-04, CAUSE SETTLED BY linux-sources the same day and it was none of the three I hypothesised. Their rename of their own top-level scripts package to linux_sources ran over git ls-files using Path.read_text/write_text, WHICH FOLLOW SYMLINKS — and their four adopted hooks are symlinks into substrate's scripts/, so the rewrite resolved through them and edited substrate's files, 20 occurrences across four hooks. Reverted by them, confirmed here independently: toolmodes enumerates 613 modes over 100 tools again, and a literal sweep for linux_sources returns 0 sites in 0 of 1213 files. THE ASYMMETRY I RECORDED AS UNEXPLAINED IS ALSO SETTLED: the hook kept firing because PreToolUse dispatches through linux-sources' venv where linux_sources was mid-rename and half-resolved, while toolmodes runs in substrate's env where it does not exist and failed cleanly. Same file, two spellings, two environments, invisible from either side alone. The general form worth carrying: a tree-wide rewrite over a FILE LIST silently acquires whatever those files point at, because the list is a proxy for files-this-repo-owns and a symlink is exactly where that proxy diverges from its subject. is_symlink() is the re-gate, added on their side. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): scratch/toolmodes.py fails at import with ModuleNotFoundError: No module named 'linux_sources' because scripts/hook_structural_query.py:79 does 'from linux_sources import hook_cmdparse' — the vendored tokenizer under a PACKAGE spelling that is not installed in this environment. The hook itself still fires from PreToolUse, so the dispatch path resolves it differently than a direct import; only readers that IMPORT the hook break. Both files are untracked, so no census that reads staged paths can see either the module or the break}
}

@misc{gate-F34-private-ratchet-punishes-its-own-paydown,
  section  = {finding},
  claim    = {The private ratchet refuses the exact paydown its own refuse_hint demands, because it does not forward key_move and so scores an extraction as one paydown plus one genuine addition.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by running the gate. Live verdict BROKEN on 2 NEW keys under OrientationRigCatPerm/Private.agda, whose SAME NAMES appear among the paydowns under OrientationRigCatPerm.agda — one extraction, scored as growth. rule() withholds the baseline write while any addition stands, so 166 genuine paydowns cannot record behind those 2, and the baseline would drop from 226 to 62. The sibling check_public_ratchet already carries the fix and a comment recording 139 paydowns blocked behind ~100 relocation pairs, and both gates use the same relpath-name key grammar, so the lambda transfers verbatim. The one-argument repair is BLOCKED because check_private_ratchet.py carries 98 pycheck findings and the per-file gate refuses every edit to it. Measured population: 1 of 21 set_ratchet call sites forwards key_move. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04: check_private_ratchet does not forward key_move to set_ratchet, so an extraction scores as one paydown plus one genuine addition, and rule() withholds the baseline write while any addition stands. Live verdict: BROKEN on 2 NEW keys at OrientationRigCatPerm/Private.agda::lookup-swPerm and ::lookup-gamma, whose SAME NAMES appear among the paydowns at OrientationRigCatPerm.agda — one extraction, scored as growth. 166 genuine paydowns cannot record behind those 2, and the baseline would drop 226 to 62. The gate's own refuse_hint DEMANDS this exact paydown (EXTRACT it to its own file), so the gate refuses the compliance it asks for. check_public_ratchet already carries the fix as key_move=lambda k: k.split(colon-colon, 1)[1] with a comment recording 139 paydowns blocked behind ~100 pairs. Same key grammar relpath-colon-colon-name in both. The one-argument repair is BLOCKED: check_private_ratchet.py carries 98 pycheck findings, so the per-file gate refuses any edit to it}
}

@misc{gate-F35-syspath-replacement-exists-with-zero-reach,
  section  = {finding},
  claim    = {The non-toxic replacement for sys.path.insert already exists and is witnessed in substrate, but has zero adopters among the 313 files that carry the 492 inserts, so the gap is adoption rather than capability.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04. sys.path.insert mutates process-global state at import time — order-dependent, invisible at the call site that suffers, outliving the module that caused it. That is why two repos both claiming top-level scripts collided SILENTLY: first insert wins, no error either side. drain_leverage reports 492 inserts over 313 files and cannot attribute 157 of them, so the ranking itself covers about two thirds of its subject. substrate/scratch_module.py loads a scratch tool by name without touching the import path, with a selftest case named loading_does_not_touch_sys_path. module_importers reports 7 adopters, all inside substrate/. Two populations are mixed in the ranking and want different fixes: inserts reaching third-party packages such as numpy sympy cupy matplotlib networkx libcst are an INSTALL problem, while inserts reaching sibling repo modules are a DRAIN problem. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04. sys.path.insert mutates PROCESS-GLOBAL state at IMPORT time, so its effect is order-dependent, invisible at the call site that suffers from it, and outlives the module that caused it — this is what made the two-repo top-level scripts collision SILENT, since whoever inserted first won and neither side got an error. Population: drain_leverage reports 492 inserts across 313 files, of which it CANNOT ATTRIBUTE 157 (opaque-target), so even the ranking covers about two thirds. The non-toxic replacement ALREADY EXISTS and is witnessed: substrate/scratch_module.py loads a scratch tool by name without touching the import path, and its selftest case is named loading_does_not_touch_sys_path with the docstring THE WHOLE POINT. But module_importers reports 7 adopters, ALL of them inside substrate/ — zero reach into the 313 files carrying the inserts. So the gap is ADOPTION, not capability, and better measurement of the toxic form is worth less than the replacement path that is already built. NOTE ALSO the ranking mixes two populations with different fixes: inserts reaching THIRD-PARTY packages (numpy, sympy, cupy, matplotlib, networkx, libcst all appear as drain candidates — an install problem) and inserts reaching SIBLING REPO MODULES (a drain problem)}
}

@misc{gate-F36-undeclared-third-party-reached-by-path-surgery,
  section  = {finding},
  claim    = {Several third-party packages are reached by sys.path surgery while the manifest declares none of them, so the install-versus-drain split reports them as drain and no discriminator can rescue them.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by drain_leverage --kinds, then CORRECTED the same day by a reader that already owned the question. The split partitions every bare name reached under an insert into stdlib, install and drain, and its install column holds exactly the declared dependencies while several unmistakably third-party packages land in DRAIN because the manifest declares none of them. Adding a declared-dependency check to the reader changed the partition not at all, which is what makes this a manifest gap rather than a reader gap. ⚑ BUT THE POPULATION IS LARGER THAN THAT SPLIT COULD SEE, and substrate/import_manifest.py reports it directly: its MISSING list is substantially longer, and its largest members are reached from many files each, including plotting and TUI stacks that the insert-keyed reader never surfaced because those files reach them without a sys.path insert. So the split answers WHICH NAMES REACHED UNDER AN INSERT ARE UNDECLARED, and import_manifest answers WHICH IMPORTS ARE UNDECLARED AT ALL — the second is the question the manifest gap actually poses. Same instrument-selection lesson as sql-F28: the owning reader existed and was one call away. The measurement also refutes the hypothesis that install-reach dominated the drain ranking and would substantially resize the arc. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 via drain_leverage --kinds, which partitions every bare name reached under a sys.path insert by whether it is stdlib, an install problem or a drain problem. The split reports 173 drain, 9 install, 55 stdlib over 237 names. THE 9 INSTALL NAMES ARE THE DECLARED ONES (cupy, libcst, networkx, numpy, panflute, psycopg, sqlalchemy, sympy, valkey). But matplotlib, bpy, bmesh, mathutils and zstandard also appear, and they land in the DRAIN column — they are unmistakably third-party (three are Blender's) yet the manifest declares none of them, so no discriminator can rescue them. Adding the declared-dependency check changed the partition NOT AT ALL, which is the finding: this is a manifest gap, not a reader gap. A file reaches those packages by path surgery and the project never declares the dependency, so an adopter installing this distribution gets neither the import nor an error naming what is missing. ALSO REFUTED: the hypothesis that install-reach dominated the ranking and would substantially resize the drain arc. It is 9 names of 237, and the drain population is the overwhelming majority}
}

@misc{gate-F37-the-drain-has-no-reachable-first-move,
  section  = {finding},
  claim    = {The claim that the drain has no reachable first move was REFUTED the next turn: promote_frontier reports a large promotable set, and the conclusion had been drawn from a single candidate's three consumers.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. FILED 2026-09-04 and REFUTED the same day, kept as residue because the error is the lesson. The original claim: every adoption site is a file the per-file gate refuses, so the drain cannot start. The evidence was reuse_catalog, the only uncontested drain candidate, whose three consumers all carry findings — the most favourable case on the board, blocked. THE REFUTATION: scripts/promote_frontier.py already answers this question and reports a large PROMOTABLE set alongside a larger dirty backlog, including all five hook modules. It also carries a three-state split the original framing lacked, where BLOCKED means clean-but-waiting-on-a-dirty-callee and is neither promotable nor a paydown target. TWO ERRORS, NOT ONE. A conclusion about a population was drawn from a single candidate, which is the sample-of-one shape. And a reader that owned the question already existed, found by toolmodes --find frontier in one call, so the census was rebuilt in prose rather than asked for. What SURVIVES is narrower and still true: reuse_catalog specifically cannot be drained yet, because its three consumers are all dirty. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04. The sys.path drain arc has an EXIT and no reachable ENTRY. Both loaders exist and are sound: substrate/scratch_module.py loads a scratch tool via a meta-path finder scoped to that directory and removed when the load returns, and substrate/gate_module.py loads a scripts/ module via spec_from_file_location, its docstring explicitly refusing sys.path as the repair. So the earlier framing that the replacement has zero reach was scoped to scratch/ only. THE BLOCKER IS THE ADOPTION SITE, NOT THE MECHANISM. drain_leverage reports reuse_catalog as the ONLY uncontested candidate (retires 3, contested 0) with three consumers, all in scripts/, all importing it bare. pycodemod --types reports findings in all three, so the zero-tolerance per-file gate refuses an edit to every one of them — and gen_reuse_index carries just a single misc finding, so even the most favourable case on the entire board is blocked. A drain therefore cannot take its first step without a file being drained first, which is the same shape as the frozen-monolith family reaching the arc that was supposed to escape it}
}

@misc{gate-F38-the-hook-family-is-extractable-and-its-boundary-is-measured,
  section  = {finding},
  claim    = {The PreToolUse hook family is extractable into an installed package: all five modules are promotable, the family is stdlib-only, and its one real config seam and one local divergence are both identified.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04. EDITABILITY: promote_frontier lists all five hook modules as promotable, correcting an earlier assumption that they might be frozen. DEPENDENCIES: stdlib only, zero substrate imports, with one already-designed optional seam where hook_structural_query degrades to no-retirement-verdict when substrate is absent. INTERNAL EDGES: hook_cmdparse has three consumers, all dotted rather than bare, so they already resolve for an adopter importing the wheel. CONFIG SEAM: hook_structural_query computes a routing-table path under .claude/skills, which two adopting repos insist must stay a real local file, so a package exposes it as per-repo config. The one genuine local divergence is hook_pycheck, whose lint profile is repo-specific by design and stays local. WHAT A MOVE BREAKS: check_hook_set._on_disk globs a hardcoded hook directory and asserts set equality against a hardcoded roster, so relocating any file fails that gate immediately, and the roster includes two probe modules that are not themselves PreToolUse hooks. An adopter also recorded that replacing a symlink with a real file blocked Bash entirely, because a configured hook whose file is momentarily absent is a hard error, so migration ordering matters. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04, the preconditions for extracting the PreToolUse hooks into an installed package. EDITABILITY: promote_frontier lists all five hook modules as PROMOTABLE (clean, every transitive callee clean), so the per-file gate is not an obstacle — this corrects the earlier assumption that they might be frozen. DEPENDENCIES: the family imports stdlib only, zero substrate imports, with one already-designed optional seam (hook_structural_query degrades to no-retirement-verdict when substrate is absent, by construction and with a comment saying so). INTERNAL EDGES: module_importers reports scripts.hook_cmdparse with three consumers — hook_no_chaining, hook_structural_query, _payload_probe — all DOTTED rather than bare, so they already resolve for an adopter importing the wheel. CONFIG SEAM: hook_structural_query computes a routing-table path under .claude/skills/, which two adopting repos' settings insist must stay a real local file, so a package must expose that as per-repo config rather than carrying it. THE ONE GENUINE LOCAL DIVERGENCE IS hook_pycheck, whose lint profile is repo-specific by design — it stays local and is not part of the extraction. WHAT A MOVE BREAKS: check_hook_set._on_disk globs a hardcoded _HOOK_DIR and asserts SET EQUALITY against a hardcoded roster, so relocating any file fails that gate immediately, and the roster includes hook_fire_probe and hook_fire_run which are not PreToolUse hooks but probes of them. Also recorded from an adopter: replacing a symlink with a real file BLOCKED BASH ENTIRELY, because a configured hook whose file is momentarily absent is a hard error — so ordering matters in any migration}
}

@misc{gate-F39-the-hook-gate-enforces-the-construct-being-removed,
  section  = {finding},
  claim    = {The hook-set gate's green verdict asserts that every sibling-importing hook repairs sys.path, so a passing gate is enforcing the construct the operator has ruled toxic.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by running the gate, whose verdict names the prelude as a thing it requires. Arm 2 is right under the current arrangement: a hook symlinked into a repo whose scripts directory is not a package raises ModuleNotFoundError at module load, and the harness reads a hook's empty stdout as ALLOW, so the hook denies nothing while reading as armed. The prelude is an escape hatch for a hazard the symlinking creates, not a discipline anyone chose. The dependency chain is exact: hooks are symlinked into other repos, so a hook imports siblings across a repo boundary, but the borrowing repo may have no package there, so sys.path is repaired at import time. An installed hooks package breaks every link and the arm's precondition becomes unreachable rather than exempted. ALSO CORRECTED HERE: a proposal to decouple the roster as the first landable step was misdiagnosed — the roster is already a declared list whose comments reason explicitly about why the two probe modules belong in it, since arm 1 is a set equality over the filename prefix rather than a judgement about what a file does. What a move actually needs is for the hook directory to be derivable rather than fixed. The gate's own docstring already states its limit: it asserts the prelude exists, not that it is correct, and the arm that would catch a wrong root needs a live fire probe from outside the repo. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by running scripts/check_hook_set.py, whose green verdict reads: roster and tree agree, every sibling-importing hook repairs sys.path. THAT SECOND CLAUSE IS A GREEN FOR THE CONSTRUCT THE OPERATOR HAS RULED TOXIC. Arm 2 asserts a hook that imports a scripts sibling UNGUARDED must also mutate sys.path, and it is RIGHT to under the current arrangement: a hook symlinked into a repo whose scripts/ is not a package raises ModuleNotFoundError AT MODULE LOAD, and the harness reads a hook's empty stdout as ALLOW — so the hook denies nothing while reading as armed. The prelude is an escape hatch for a hazard the symlinking creates, not a discipline anyone chose. THE DEPENDENCY CHAIN IS EXACT: hooks are symlinked into other repos, so a hook must import its siblings across a repo boundary, but the borrowing repo's scripts/ may not be a package, so sys.path gets repaired at import time. Making the hooks an installed package breaks every link and the arm's PRECONDITION VANISHES — the condition is unreachable rather than exempted. ALSO CORRECTED: I proposed decoupling the roster as the first landable step, and the roster is ALREADY a declared list whose comments reason explicitly about why the two hook_fire_* probes belong in it (arm 1 is a set equality over hook_*.py, not a judgement about what a file does, and a prefix exception would reintroduce a naming-convention-keyed population). There is nothing to decouple. What a move needs is for the hook DIRECTORY to be derivable rather than fixed, which is smaller and different. ⚑ AND THE GATE'S OWN DOCSTRING ALREADY STATES THE LIMIT: it asserts the prelude EXISTS, not that it is CORRECT — a prelude computing the wrong root passes here and fails in adoption, and the arm that would catch that needs a live fire probe from outside the repo}
}

@misc{gate-F40-the-unattributable-remainder-is-a-runtime-attribute,
  section  = {finding},
  claim    = {The inserts drain_leverage still cannot attribute are one idiom whose target is a runtime attribute on an imported module, so the unknown verdict is correct and the remainder is a floor rather than a gap.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by reading the surviving sites rather than inferring their shape. After three resolver improvements the remainder concentrates in wg_order, worklist_gate and wg_dispatch, and every one spells sys.path.insert with a module attribute as its target, reaching the paperkit library directory so that a sibling can be imported bare inside a function body. No static reader can name that directory without importing the module that holds the attribute. Two deliberate refusals compound here: path_binding collects only module-level assignments, because a name rebound inside a function is not a stable fact about the module. The honest instrument for these is the dynamic reader import_effects, which executes the import and reports the paths a module actually added — a different population that legitimately disagrees with the static one, as drain_leverage's own header states. The opening hypothesis was half right: inserts inside functions, yes, but the binding shape was the harder half and reading one site settled what two rounds of inference had not. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by reading the surviving sites rather than inferring their shape. Three successive resolver improvements took drain_leverage's unattributable count down substantially, and the remainder concentrates in wg_order, worklist_gate and wg_dispatch. THE IDIOM IS ONE PATTERN: sys.path.insert(0, wg_engine.LIBRARY) — the target is an ATTRIBUTE ON AN IMPORTED MODULE, resolved at runtime from another file, used to reach the paperkit library directory so that figures or items can be imported bare inside a function body. NO STATIC READER CAN NAME THAT DIRECTORY without importing wg_engine, so this is not a resolver gap and the UNKNOWN verdict is CORRECT. It is also two refusals compounding, both deliberate: path_binding collects only MODULE-LEVEL assignments, because a name rebound inside a function is not a stable fact about the module and treating it as one would attribute an insert to whichever branch parsed last. THIS IS THEREFORE A FLOOR TO RECORD, NOT A GAP TO CLOSE. The honest way to attribute these is the dynamic reader import_effects, which executes the import and reports the paths a module ACTUALLY added — a different population that legitimately disagrees with the static one, as drain_leverage's own header already states. ⚑ AND THE HYPOTHESIS I OPENED WITH WAS ONLY HALF RIGHT: I predicted inserts inside functions, which is true, but the binding shape is the harder half and reading one site settled what two rounds of inference had not}
}

@misc{gate-F41-the-hooks-package-needs-a-name-and-a-home,
  section  = {finding},
  claim    = {Every measurable precondition for extracting the hooks into a package is met, and what remains is a naming and siting decision that belongs to the operator rather than to a reader.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04. Preconditions recorded across gate-F38 and gate-F39: all five hook modules are promotable, the family is stdlib-only, hook_cmdparse's consumers are dotted so they already resolve for an adopter, the routing-table path is the single config seam, hook_pycheck stays local because its lint profile is repo-specific, and check_hook_set's hook directory now derives from the gate's own location rather than naming one. What remains is what the package is called, where it lives, and whether it ships with this distribution or separately. That is outward-facing: it lands in four repos' settings and retires symlinks across ten, and the operator has already ruled on the adjacent question that scripts should not be a package at all but a directory of thin entrypoints calling packages. ⚑ The ordering constraint is hard and was recorded by an adopting repo: replacing a symlink with a real file blocked Bash entirely, because a configured hook whose file is momentarily absent is a hard error. The destination must exist and import cleanly before any file moves, and no step may leave a registered hook path unresolvable even briefly. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04, the one thing blocking the hooks extraction that is not a measurement. Preconditions are all met and recorded: all five hook modules are promotable, the family is stdlib-only, hook_cmdparse's three consumers are dotted so they already resolve for an adopter, the routing-table path is the single config seam, hook_pycheck stays local by design, and check_hook_set's hook directory is now DERIVED from the gate's own location rather than naming a directory. WHAT REMAINS IS A NAMING AND SITING DECISION, and it is the operator's rather than a measurement: what the package is called, where it lives in this tree, and whether it ships as part of this distribution or as its own. That choice is outward-facing — it lands in four repos' settings and retires symlinks across ten — and the operator has already ruled on the adjacent question that scripts should not be a package at all, a directory of thin entrypoints that call packages. ⚑ AND THE ORDERING CONSTRAINT IS A HARD ONE, recorded by an adopting repo: replacing a symlink with a real file BLOCKED BASH ENTIRELY, because a configured hook whose file is momentarily absent is a hard error. So the destination must exist and import cleanly BEFORE any file moves, and no step may leave a registered hook path unresolvable even briefly}
}

@misc{gate-F42-the-missing-imports-split-three-ways-and-two-are-decisions,
  section  = {finding},
  claim    = {The unaccounted imports hold three different remedies, so declaring them as one population would make the manifest assert something false about the Blender family and hide a classifier gap behind two others.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by reading substrate/import_manifest.py, which already owns this question and publishes the split. First remedy: bpy, bmesh and mathutils ship inside Blender's embedded interpreter and cannot be pip dependencies, so declaring them would make the manifest assert something false and the correct remedy is an environment-provided carve-out. Second: matplotlib, scipy, pyvista, textual, mpl_toolkits, bs4, html2text and clang are real optional dependencies wanting an optional-dependency group rather than a blanket add, since none is needed to run the gates. Third: applied_grammar and jea resolve in-tree under a spelling the classifier's first-party test did not match, so the remedy is a classifier fix and declaring them would be wrong. The origin's carve-out is already paid down and the docstring records why: it read a table that does not exist, falling back to an empty set, so the successful parse produced exactly what the failure produced — a carve-out reading as active policy while subtracting nothing. A literal sweep confirms the key now appears only in prose describing that retirement. What remains is two operator decisions rather than measurements: whether to reinstate an environment-provided declaration for the Blender family, and which optional-dependency groups the rest belong in. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by reading substrate/import_manifest.py, which already owns the undeclared-import question and publishes the split Ⓝ152 was opened to derive. ITS MISSING SET HOLDS AT LEAST THREE REMEDIES AND A SINGLE COUNT OVER THEM TELLS AN OPERATOR TO DO NOTHING IN PARTICULAR. First, bpy, bmesh and mathutils ship inside Blender's embedded interpreter and CANNOT be pip dependencies — declaring them would make the manifest assert something false, so the remedy is an environment-provided carve-out, not a declaration. Second, matplotlib, scipy, pyvista, textual, mpl_toolkits, bs4, html2text and clang are real optional dependencies, and the remedy is an optional-dependency group rather than a blanket add, since none is needed to run the gates. Third, applied_grammar and jea resolve IN-TREE under a spelling the classifier's first-party test did not match, so the remedy is a classifier fix and declaring them would be wrong. ⚑ THE ORIGIN'S CARVE-OUT IS ALREADY PAID DOWN AND THE DOCSTRING RECORDS IT: it read a tool.substrate.environment-provided table that DOES NOT EXIST, falling back to an empty set, so the successful parse produced exactly what the failure produced — a carve-out reading as active policy while subtracting nothing. A literal sweep confirms the key now appears only in prose describing the retirement, so the branch was removed rather than left dangling. WHAT REMAINS IS TWO OPERATOR DECISIONS, not measurements: whether to reinstate an environment-provided declaration for the Blender family, and which optional-dependency groups the rest belong in}
}

@misc{gate-F43-no-writer-exists-for-a-markdown-table-row,
  section  = {finding},
  claim    = {No tool writes a markdown table row, so a new worklist shard cannot be routed into the index that would make its concern findable.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04. mdstruct owns markdown structurally and its table modes are both readers: one reports each table's header and size, the other reports the cells. Its write modes operate on sections and are explicitly a line splice rather than an AST render, so neither can add a row. A toolkit-wide search for a row writer returns readers and unrelated senses of the word. The gap is real rather than a spelling missed, and it matters because the routing table is how a concern becomes findable — a shard the index cannot name is one nobody can decide is too large, which is the defect recorded when an earlier arc sat buried in a shard whose title did not name it. The index's own user-decisions section is prose backed by citation keys rather than a freeform list, so appending an unwarranted paragraph there would break the worklist gate's citation contract, which is the second reason this could not be routed by the writers that exist. The honest remedy is a bounded table-row writer in the tool that owns markdown, carrying the same refusal discipline its section writers already have: an ambiguous table refuses, a row whose column count disagrees with the header refuses, and the write is a line splice so a one-row edit is a one-line diff. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04. A new worklist shard could not be routed into the index because the routing structure is a TABLE and nothing writes a table row. mdstruct owns markdown structurally and has --tables and --rows, both READERS: --tables reports each table's header and size, --rows reports the cells. Its WRITE modes are --replace-section and --append-section, which operate on SECTIONS and are explicitly a LINE SPLICE rather than an AST render, so neither can add a row to a table. toolmodes --find row over the whole toolkit returns readers and unrelated senses of the word, no writer. THE GAP IS REAL RATHER THAN A SPELLING I MISSED, and it matters because the routing table is how a concern becomes findable: a shard the index cannot name is one nobody can decide is too large, which is the defect Ⓝ133a recorded when an arc sat buried in a shard whose title did not name it. ⚑ AND THE INDEX'S OWN User decisions SECTION IS PROSE BACKED BY CITATION KEYS, not a freeform list, so appending an unwarranted paragraph there would break the worklist gate's citation contract — the second reason this could not be routed by the writers that do exist. The honest remedy is a bounded table-row writer in the tool that owns markdown, with the same refusal discipline its section writers carry: an ambiguous table refuses, a row whose column count disagrees with the header refuses, and the write is a line splice so a one-row edit is a one-line diff}
}

@misc{gate-F44-the-symbol-vocabulary-is-quote-shaped-in-shell,
  section  = {finding},
  claim    = {This repo's work-item labels disambiguate with primes, which shellcheck reads as quote characters, so a symbol name reaching a shell unquoted is refused.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by hitting it while routing a worklist row. A symbol gains a prime each time it is refined, so the live queue carries many such spellings, and shellcheck refuses an unquoted one with SC1111 unicode quote. The refusal is correct: a shell handed an unbalanced quote-like glyph in an operand cannot tokenize it as the author intends. The hazard is structural rather than incidental because the labelling scheme GENERATES these spellings — every refinement mints another primed name, so the population grows monotonically with the work — and it is not confined to shell, since the same glyphs are quote-shaped to any tokenizer that special-cases quotes, including this repo's own command parser. The remedy is single-quoting at every shell boundary, and forgetting costs a refused command rather than a wrong one, so the failure is loud. ⚑ Recorded because the tempting alternative is wrong: adding these codepoints to the shellcheck gate's exclude list would silence a correct diagnostic to accommodate a naming convention, which is the suppression path this repo refuses by design. The convention bends, not the gate. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by hitting it. This repo's work-item labels disambiguate with PRIMES — a symbol gains a prime or double-prime each time it is refined, so the live queue carries many such spellings. SHELLCHECK READS THOSE AS QUOTE CHARACTERS and refuses the command with SC1111 unicode quote, delete and retype it. An unquoted argument naming such a symbol therefore cannot reach a tool, and the refusal is CORRECT: a shell that sees an unbalanced quote-like glyph in an operand is being handed something it cannot tokenize the way the author intends. THE HAZARD IS STRUCTURAL RATHER THAN INCIDENTAL, because the labelling scheme GENERATES these spellings: every refinement of a symbol mints another primed name, so the population grows monotonically with the work. It is not confined to shell either — the same glyphs are quote-shaped to any tokenizer that special-cases quotes, which includes this repo's own command parser. THE REMEDY IS SINGLE-QUOTING AT EVERY SHELL BOUNDARY, and the cost of forgetting is a refused command rather than a wrong one, so the failure is loud. ⚑ WORTH RECORDING BECAUSE THE ALTERNATIVE IS TEMPTING AND WRONG: adding these codepoints to the shellcheck gate's EXCLUDE would silence a correct diagnostic to accommodate a naming convention, which is the suppression path this repo refuses by design. The convention bends, not the gate}
}

@misc{gate-F45-a-pending-decision-is-not-a-warrant,
  section  = {finding},
  claim    = {A pending operator decision cannot be filed as a warrant, because every warrant claims a falsifiable end-state and carries a runnable witness, and a decision nobody has made yet has neither.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by reading the warrant register before writing into it. Every claim in it is an end-state the tree can falsify, and every check is an item witness the engine executes. Even the single existing user-decision entry claims that a guard blocks a destructive git operation, which is a fact about the tree rather than a request for a ruling. A pending decision has no such form: choosing a package name cannot be falsified by the tree, so a warrant filed for it would carry a witness that can never pass or fail — the vacuous-witness shape the findings ledger reserves a separate unwitnessed kind for, precisely because a finding whose truth nobody can check must not read as either closed or open. So the decisions belong where they already are, as standing findings naming what was measured and what remains a ruling, and the warrant is owed only after a decision lands, at which point the claim becomes the end-state that decision produces and the witness becomes checkable. Filing the warrant first would invert that: a claim asserting an outcome nobody has chosen. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by reading the warrant register before writing into it. A plan to route three operator-blocked decisions into the worklist as warranted entries was MISFRAMED, and the register says why. Every warrant's claim is a FALSIFIABLE END-STATE — the ban additions are paid down, no module elaborates over the cap, every CLI mode is exercised by a case — and every warrant's check is an item: witness, a runnable predicate in the concepts library that the engine executes. Even the one existing user-decision entry claims that A GUARD BLOCKS a destructive git operation, which is a checkable fact about the tree, not a request for a ruling. A PENDING DECISION HAS NO SUCH FORM: choose a package name cannot be falsified by the tree, so a warrant filed for it would carry a witness that can never pass or fail — the vacuous-witness shape this repo's own findings ledger reserves a separate UNWITNESSED kind for precisely because a finding whose truth nobody can check must not read as either closed or open. ⚑ SO THE DECISIONS BELONG WHERE THEY ALREADY ARE, in the findings ledger as standing entries naming what was measured and what remains a ruling, and the warrant is owed only AFTER a decision lands — at which point the claim becomes the end-state that decision produces and the witness becomes checkable. Filing the warrant first would invert that: a claim asserting an outcome nobody has chosen yet}
}

@misc{gate-F46-retire-count-ranks-the-hardest-drains-first,
  section  = {finding},
  claim    = {Ranking drain candidates by inserts retired selects the hardest drains first, because a name retires many inserts precisely when many files reach it and every one must be rewired.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by joining the drain ranking against consumer counts, which nothing had done. Retire-count is the right measure of VALUE and close to the inverse of TRACTABILITY. On the ranking's second-place candidate, module_importers reports ninety-one import sites across fifty-eight files, every one bare: the ranking calls it fifteen retired inserts, the edit is fifty-eight files. A candidate that retires nothing on its own has one site in one file, and that file is on the promotable list, so the drain is a single edit to an editable file — invisible to the ranking and startable today. The two numbers answer different questions and neither is wrong: retire-count answers what draining this finishes, consumer-count answers what it costs. Reading the first as a work queue is the defect, and it is the same shape as the finding-count ordering the ranking's own header retired — a measure that looks authoritative because it measures something real, aimed at the wrong decision. The ordering a drain plan wants is consumers ascending, filtered to candidates whose consumers are all promotable, with retire-count as the tie-break rather than the key. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by joining the drain ranking against consumer counts, which nothing had done. drain_leverage ranks a candidate by the sys.path inserts draining it would RETIRE, and that is the right measure of VALUE. It is close to the inverse of TRACTABILITY. A name retires many inserts precisely because many files reach it, and every one of those files must be rewired for the drain to land — so the ranking's head is systematically the hardest work on the board. Measured on its second-place candidate: module_importers reports it at 91 import sites across 58 files, every one BARE. The ranking calls it fifteen retired inserts; the edit is 58 files. Meanwhile a candidate that retires nothing on its own has ONE site in ONE file, and that file is on promote_frontier's promotable list, so the drain is a single edit to an editable file — invisible to the ranking and startable today. ⚑ THE TWO NUMBERS ANSWER DIFFERENT QUESTIONS AND NEITHER IS WRONG: retire-count answers what does draining this finish, consumer-count answers what does draining this cost. Reading the first as a work queue is the defect, and it is the same shape as the finding-count ordering this module's own header retired — a ranking that looks authoritative because it is measuring something real, aimed at the wrong decision. THE ORDERING A DRAIN PLAN WANTS is consumers ascending, filtered to those whose consumers are all promotable, with retire-count as the tie-break rather than the key}
}

@misc{gate-F47-a-caller-timeout-below-the-callee-guard-hides-it,
  section  = {finding},
  claim    = {A caller timeout shorter than the callee's own guard replaces the callee's failure taxonomy with one opaque kill, so a carefully-distinguished failure mode never gets to report.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by hitting it. The drain-plan CLI runs a corpus-wide mypy census whose reader carries its own timeout and a three-outcome contract — absent checker, ran-and-failed, or a census — built precisely so a failed run cannot read as a clean one. Invoking it under a shell timeout shorter than that internal bound killed the process before its guard could fire, so the distinction never reported and the observable result was a bare exit 124 saying nothing about whether the checker was absent, slow, or broken. The defect is the ordering of two bounds, not either bound: a callee that distinguishes its failure modes can only do so if allowed to reach them, and an outer bound below the inner one collapses every inner verdict into one undifferentiated kill. Same shape as a guard degrading to measuring nothing, one layer out — the instrument is sound and the harness around it prevented the measurement. The rule: when invoking something that owns a timeout, the caller's bound must exceed it, or the caller has silently replaced the callee's taxonomy. Worth stating because the tempting reading of a timeout kill is that the tool is too slow, which is a claim about the tool derived from a limit the caller chose. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by hitting it. drain_plan runs the corpus-wide mypy census through mypy_census.type_errors, which carries its OWN timeout and a documented three-outcome contract: it returns None when mypy is absent, a dict carrying the UNRUNNABLE sentinel when mypy ran and could not complete, and the census otherwise. That contract exists so a failed run cannot read as a clean one. I invoked the CLI under a SHELL timeout SHORTER than the census's internal one, and the shell killed the process before the census's own guard could fire — so the carefully-built three-outcome distinction never got the chance to report anything, and the observable result was a bare exit 124 saying nothing about whether mypy was absent, slow, or broken. ⚑ THE DEFECT IS THE ORDERING OF TWO BOUNDS, NOT EITHER BOUND. A callee that distinguishes its failure modes can only do so if it is allowed to reach them, and an outer bound below the inner one converts every inner verdict into one undifferentiated kill. This is the same shape as a guard that degrades to measuring nothing, one layer out: the instrument is sound and the harness around it prevented the measurement. ⚑⚑ THE RULE THAT FALLS OUT: when invoking something that owns a timeout, the caller's bound must EXCEED it, or the caller has silently replaced the callee's failure taxonomy with a single opaque one. Worth stating because the tempting reading of exit 124 is that the tool is too slow, which is a claim about the tool derived from a limit the caller chose}
}

@misc{gate-F48-a-few-dirty-files-gate-many-cheap-drains,
  section  = {finding},
  claim    = {The drain population is a small set of dirty files gating many one-site drains, so the highest-leverage move is paying down the file that blocks the most drains rather than draining the name that retires the most inserts.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by the cost-ordered queue. Its head is a long run of one-file one-site drains, each blocked by a single named consumer, and the blockers repeat — one gate file blocks four of the first ten shown, one codemod file blocks two. So the population is not many independent walls, and cleaning one blocker unblocks several cheap drains at once. That inverts the plan a value ranking suggests. This also partly rehabilitates the earlier claim that the drain has no reachable first move, which was refuted for being drawn from a single candidate. The refutation stands, since a large promotable set exists, but being promotable and being a drain CONSUMER are different populations, and among consumers the startable count is currently zero. The honest statement is narrower than either — no drain is startable today, and the reason is a handful of shared blockers rather than a property of the drains. Measurement caveat. This run predates a fix to the caller's name resolution, which under-resolved bare candidate names, so the consumer counts are floors. The repeated-blocker shape does not depend on those counts and is what is claimed. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by drain_plan --all, the cost-ordered queue. The head of the queue is a long run of ONE-FILE ONE-SITE drains, each blocked by a SINGLE named consumer, and THE BLOCKERS REPEAT: scripts/gate_preflight.py blocks four of the first ten, scratch/pycodemod.py blocks two. So the drain population is not many independent walls but A SMALL SET OF DIRTY FILES GATING MANY CHEAP DRAINS, and cleaning one blocker unblocks several one-site drains at once. THAT IS THE ACTIONABLE STRUCTURE the arc was built to find, and it inverts the plan a value ranking suggests: the highest-leverage move is not draining the name that retires the most inserts, it is paying down the FILE that blocks the most drains. ⚑ THIS ALSO PARTLY REHABILITATES gate-F37, which claimed the drain has no reachable first move and was refuted for being drawn from a single candidate. The refutation stands — promote_frontier reports a large promotable set — but the queue shows that being promotable and being a drain CONSUMER are different populations, and among consumers the startable count is currently zero. The honest statement is narrower than either: no drain is startable today, and the reason is a handful of shared blockers rather than a property of the drains. ⚑⚑ MEASUREMENT CAVEAT: this run predates a fix to the caller's name resolution, which under-resolved bare candidate names, so the consumer counts are FLOORS. The repeated-blocker SHAPE does not depend on those counts and is what is claimed here}
}

@misc{gate-F49-the-blocker-ranking-names-a-first-move,
  section  = {finding},
  claim    = {One file solely blocks seven one-site drains, so the drain arc has a concrete first move, and a large majority of drains wait on several dirty files and are released by no single paydown.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by the inverted queue. A metalanguage gate file solely blocks seven one-site drains, so paying it down makes seven drains startable at once. A split-pipeline file and a gate-preflight file follow at four each, an sppf file at three. That is the plan a value ranking could not produce and a cost ranking could only produce as zero-startable. The honest half is the footer. A large majority of drains wait on SEVERAL dirty files and appear under no blocker, so cleaning any one of their consumers releases none of them, and the sole-blockers cover a minority of the population. A reader taking the ranking as a complete plan would expect the whole arc to fall out of a few dozen paydowns when most of it will not. The sole-blocker rule is deliberately pessimistic for exactly this reason, reporting what a single paydown definitely releases rather than what it might, and the jointly-blocked count sits beside it so the ranking's silence about those drains cannot read as absence. The three orderings are now complete and none replaces another. What draining a name retires selects the hardest work, what it costs selects what could begin, and what cleaning a file unblocks is the only one naming an action available when the startable count is zero, which is the measured state. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by drain_plan --blockers, the inverted queue. THE ARC NOW NAMES A CONCRETE FIRST MOVE: jea/metalanguage/jea_metalanguage_gate.py SOLELY blocks seven one-site drains, so paying down that one file makes seven drains startable at once. scratch/split_pipeline.py and scripts/gate_preflight.py follow at four each, scripts/sppf_db.py at three. That is the plan a value ranking could not produce and a cost ranking could only produce as zero-startable. ⚑⚑ AND THE HONEST HALF IS THE FOOTER: 126 drains wait on SEVERAL dirty files and appear under NO blocker, so cleaning any one of their consumers releases none of them. The 34 sole-blockers therefore cover a MINORITY of the population, and a reader taking the ranking as a complete plan would expect the whole drain arc to fall out of thirty-four paydowns when most of it will not. The sole-blocker rule is deliberately pessimistic for exactly this reason — it reports what a single paydown DEFINITELY releases rather than what it might — and the jointly-blocked count is reported beside it so the ranking's silence about those drains cannot read as absence. ⚑ THE THREE ORDERINGS ARE NOW COMPLETE AND NONE REPLACES ANOTHER: what draining a name RETIRES selects the hardest work, what it COSTS selects what could begin, and what cleaning a file UNBLOCKS is the only one that names an action available when the startable count is zero, which is the measured state}
}

@misc{gate-F50-the-top-blockers-are-monoliths-by-construction,
  section  = {finding},
  claim    = {The files that block the most drains are monoliths by construction, because a file becomes a blocker by accumulating bare imports and accumulates them by being large, so the blocker ranking keeps nominating files that cannot take an edit.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by checking the blocker ranking's head before acting on it. The top-ranked sole blocker carries three hundred and seven own messages and the third carries two hundred and nineteen, both entirely OWN with zero closure-induced, so neither waits on a callee's paydown and both are genuine monoliths the per-file gate refuses outright. The first move the ranking names is therefore not available, and the drain each gates is a single import line. The correlation is structural rather than incidental, which is what makes it worth filing rather than treating as a wall. A file becomes a blocker by importing several bare names, and accumulates several bare imports by being large and doing many things, which is the same property that gives it a large untyped surface. So the blocker ranking and the frozen-monolith population are correlated by construction. The reader is owed a third column carrying each blocker's own finding count, so a row that cannot be acted on is visible as such rather than discovered one call later. Ranked by drains-unblocked among blockers that can themselves be edited is the ordering an operator can act on, and it is a different list from the one currently printed. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by checking the blocker ranking's head against type_scope before acting on it. The top-ranked sole blocker carries 307 own messages and the third carries 219, BOTH entirely OWN with zero closure-induced — so neither is a file waiting on a callee's paydown, and both are genuine monoliths the per-file gate refuses outright. THE FIRST MOVE THE RANKING NAMES IS THEREFORE NOT AVAILABLE, and the drain each gates is a single import line. ⚑⚑ AND THE CORRELATION IS STRUCTURAL RATHER THAN INCIDENTAL, which is what makes this worth filing over a wall. A file becomes a BLOCKER by importing several bare names, and a file accumulates several bare imports by being large and doing many things — the same property that gives it a large untyped surface and makes it unfixable under a zero-tolerance per-file gate. So the blocker ranking and the frozen-monolith population are correlated BY CONSTRUCTION, and a plan that ranks blockers by drains-unblocked without checking editability will keep nominating files that cannot take an edit. ⚑ THE READER IS OWED A THIRD COLUMN: the blocker ranking should carry each blocker's own finding count, so a row that cannot be acted on is visible as such rather than discovered one type_scope call later. Ranked by drains-unblocked AMONG BLOCKERS THAT CAN THEMSELVES BE EDITED is the ordering an operator can act on, and it is a different list from the one currently printed}
}

@misc{gate-F51-no-blocker-is-payable-and-the-arc-terminates-here,
  section  = {finding},
  claim    = {No sole blocker is editable today, so the sys.path drain arc terminates in a measured wall and is downstream of the monolith decomposition rather than parallel to it.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by the blocker ranking carrying its editability column. Zero of thirty-four sole blockers are editable, and every one carries its own findings heavily — the top-gating file in the hundreds, others in the high hundreds and thousands, and the smallest on the visible page still non-zero while gating one drain. So the earlier two-sample prediction is now measured across the whole population, and it sharpens. Blockers are not merely dirty but heavily dirty, because blocking and being frozen are the same property: a file gates drains by importing several bare names, and accumulates bare imports by being large enough to carry hundreds of findings. The arc therefore terminates in an honest wall. No drain is startable because every drain's sole consumer is frozen, and no blocker is payable because every blocker is a monolith. All three orderings are complete and all three return nothing actionable, which is a result rather than a failure of the readers: what it names is that the drain cannot begin until the monolith population is decomposed. A large majority of drains also wait on several dirty files and appear under no blocker at all, so even a complete sweep of the sole blockers would leave most untouched, and that count is reported beside the ranking so its silence cannot read as absence. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by the blocker ranking carrying its editability column. ZERO OF THIRTY-FOUR SOLE BLOCKERS ARE EDITABLE TODAY. Every one carries its own findings, and heavily: the top-gating file carries 307, the next 856, then 219, then 1296, then 1545. The smallest on the visible page carries 48 and gates one drain. So gate-F50's prediction is now measured across the whole population rather than two samples, and it sharpens: blockers are not merely dirty, they are HEAVILY dirty, because blocking and being frozen are the same property — a file gates drains by importing several bare names, and accumulates bare imports by being large enough to have hundreds of findings. ⚑⚑ THE DRAIN ARC THEREFORE TERMINATES IN A MEASURED WALL RATHER THAN A QUEUE, and the wall is honest: no drain is startable because every drain's sole consumer is frozen, and no blocker is payable because every blocker is a monolith. The three orderings are complete and all three now return nothing actionable — which is a RESULT, not a failure of the readers. What it names is that the sys.path drain cannot begin until the monolith population is decomposed, so the drain arc is DOWNSTREAM of the decomposition arc rather than parallel to it. ⚑ AND 126 DRAINS WAIT ON SEVERAL DIRTY FILES, appearing under no blocker at all, so even a complete sweep of the thirty-four would leave the majority untouched. Reported beside the ranking so its silence about them cannot read as absence}
}

@misc{gate-F52-the-key-move-partition-is-three-kinds-not-a-sweep,
  section  = {finding},
  claim    = {The ratchets that do not forward key_move are three different key grammars, not one population, so a blanket repair would credit a wrong move at one shape and be meaningless at another.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by reading three ratchets' key grammars rather than inferring them from call sites. First shape, relocation-bearing with the identity second: the public and private ratchets key relpath then name, so a definition extracted to a new file keeps its name and the identity is the segment after the separator. That is the one site forwarding key_move today and the one needing it most. Second shape, relocation-bearing with the identity FIRST: the sumtype ratchet keys name then relpath, reversed, because its subject is a duplicated type name and the file is the qualifier. The same lambda applied there would take the relpath as the identity and credit a move whenever two different names shared a file, which is a wrong crediting rather than a missing one. Third shape, no relocation grammar at all: the carrier-locality ratchet censuses a set of sanctioned exemption names with no compound key, so nothing can relocate while denoting the same thing and forwarding key_move would be meaningless rather than harmful. So the work is a partition and the question is per grammar — can a key here relocate while denoting the same thing, and if so which segment is the identity. Three sites gave three answers, so the rest must be read rather than assumed. The two-segment order is the trap: both relocation-bearing shapes use the same separator, so a reader keying on the separator alone cannot tell them apart. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by reading three ratchets' key grammars rather than inferring them from the call sites. THE TWENTY NON-FORWARDING SITES ARE NOT ONE POPULATION and a blanket repair would be wrong at two of the three shapes sampled. FIRST SHAPE, relocation-bearing with the identity SECOND: the public and private ratchets both key {relpath}::{name}, so a definition extracted to a new file moves A.agda::foo to B.agda::foo and the identity is the segment after the separator. That is the one site that forwards key_move today and the one that needs it most. SECOND SHAPE, relocation-bearing with the identity FIRST: the sumtype ratchet keys {name}::{relpath} — REVERSED — because its subject is a duplicated type name and the file is the qualifier. The same lambda applied here would take the RELPATH as the identity and credit a move whenever two different names happened to share a file, which is a wrong crediting rather than a missing one. THIRD SHAPE, no relocation grammar at all: the carrier-locality ratchet censuses a set of sanctioned exemption NAMES with no compound key, so nothing can relocate while denoting the same thing — an exemption exists or it does not, and forwarding key_move there would be meaningless rather than harmful. ⚑⚑ SO THE WORK IS A PARTITION, NOT A SWEEP, and the question is per grammar: can a key here relocate while denoting the same thing, and if so WHICH SEGMENT is the identity? Three sites gave three answers, so the remaining seventeen must be read rather than assumed. ⚑ AND THE TWO-SEGMENT ORDER IS THE TRAP: both relocation-bearing shapes spell a compound key with the same separator, so a reader keying on the separator alone cannot tell them apart},
  addendum = {SUPERSEDED 2026-09-04 by reading scripts/gate_keys.py, which DECLARES the key schema this finding and its successor re-derived by hand. It carries a KeySpec per gate with an explicit path_field index and arity, and its docstring states the reversal I recorded as a discovery — that the sumtype census emits name-then-relpath, and that reading field zero as the path there would treat every duplicate NAME as a path and every path as an identity, exactly backwards. It also names the reason the whole partition matters, in the same terms the drain arc reached independently: a decomposition is content-preserving but KEY-changing, the old key retires while a byte-identical line mints a new one, and because set_ratchet returns on added BEFORE its paydown branch the churn also BLOCKS real paydown from recording. ⚑ SO THE FINDING'S CONTENT IS RIGHT AND ITS FRAMING WAS WRONG: the work is not to read every census and derive a partition, it is to EXTEND AN EXISTING SCHEMA to the gates it does not yet cover. The schema declares five gates, and the census of non-forwarding call sites is far larger, so the gap is coverage rather than knowledge. ⚑⚑ AND THE LESSON IS THE ONE THIS SESSION KEEPS PAYING FOR: I read three censuses, then four more, and filed two findings, when one look at the module that owns key parsing would have answered it. The reuse-search fires on structural QUESTIONS, not only on build-plans.}
}

@misc{gate-F53-five-key-grammars-across-seven-ratchets,
  section  = {finding},
  claim    = {Seven ratchets carry five distinct key grammars, so neither the separator count nor the segment count discriminates which part of a key is its identity — only reading the census that mints it does.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 across eleven ratchets, extending the key-move partition and then CORRECTING one of its own claims. The grammars found: identity as the trailing segment (public and private), identity FIRST with the file as qualifier (sumtype, discharge), no compound key at all so nothing can relocate (carrier-locality, cap), three segments where the identity is everything after the first (ban), three segments where a segment is a VERDICT rather than an identity (mode-contracts, claims), and a deliberately relocation-REFUSING key (clause-audit, whose docstring states the line is included so a moved clause reads as paydown-plus-new-debt rather than silently swapping one key for another). ⚑⚑ THE CORRECTION: I filed line-number keying as an unrecognised key-stability defect, and the rederive ratchet had ALREADY DIAGNOSED AND FIXED IT — its docstring records that keying relpath-colon-line made any edit above a site read as retire-plus-add, that adding lines moved a byte-identical site and the gate refused reporting a NEW derivation that was the same site, and that a gate firing on every unrelated edit trains reflexive re-baselining until the ratchet is worthless. Its repair is an ORDINAL per motif per file, stable under edits elsewhere while still moving when a site is genuinely added or removed. So the remaining line-keyed census is not an unrecognised defect but an unadopted repair, and the fix already exists one file away. ⚑ NEITHER THE SEPARATOR COUNT NOR THE SEGMENT COUNT DISCRIMINATES: three-segment keys appear with the identity as tail, as middle, and as everything-after-the-first, two-segment keys appear in both orders, and one key mixes separators deliberately. Only reading the census that mints the key answers it. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04, extending the key-move partition from three sites to seven. FIVE DISTINCT GRAMMARS, and the two new ones break the two-segment assumption entirely. FOURTH SHAPE, three segments where the identity is EVERYTHING AFTER THE FIRST: the ban ratchet keys relpath then module then directive, so a file moving carries module-and-directive together as its identity. A two-segment lambda would take the module alone and credit a move whenever a file's DIRECTIVE changed, which is a wrong crediting. FIFTH SHAPE, three segments where a MIDDLE OR TRAILING SEGMENT IS A VERDICT RATHER THAN AN IDENTITY: the mode-contracts ratchet keys tool then flag then KIND, and kind is the diagnosis of the disagreement — a flag whose disagreement changes kind is the same contract newly diagnosed, so treating the whole tail as identity would refuse to credit a real move. The claims ratchet has the same shape with its middle segment discriminating two claim types. ⚑⚑ AND ONE SITE KEYS ON A LINE NUMBER: the sorted-order ratchet keys relpath colon line colon function with SINGLE colons, so its keys churn on any edit above the site. That is separately recorded elsewhere as a measured defect — a sibling ratchet keyed on line number would have fired on nearly every commit — so this one is not a key_move candidate at all but a key-stability finding of its own. ⚑ THE SEPARATOR COUNT IS NOT THE DISCRIMINATOR AND NEITHER IS THE SEGMENT COUNT. Three-segment keys appear with the identity as the tail, as the middle, and as everything-after-the-first, and a two-segment key appears in both orders. Only reading the census that MINTS the key answers it}
}

@misc{gate-F54-the-order-carrier-is-unreachable-from-the-package,
  section  = {finding},
  claim    = {A gate fired on three modules written this session and its prescribed repair is unreachable, because the order-carrying type sits behind the same unpackaged boundary the drain arc cannot cross.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 after the sorted-order ratchet fired on three modules written this session, each returning a bare sorted list so a caller cannot tell the order was paid for and re-sorts defensively. The gate is right and its prescribed fix is currently unreachable from where the defect is. The refusal names the remedy — carry the order on the value, whose combinators then refuse a mismatch instead of re-sorting, which is how the requirement reaches the producer that must satisfy it. But the carrier lives under the metalanguage tree and has exactly one consumer reaching it by a BARE import, resolvable only under a path insert. So a package module adopting it would need either that insert, which is the construct this arc exists to remove, or a cross-package import that is not declared. This is the drain arc's wall arriving from the other direction: one finding recorded that the drain cannot begin because every blocker is frozen, and this records that a gate's prescribed repair cannot be adopted because the capability sits behind the same unpackaged boundary. Capability and consumer are separated by a boundary only the path insert currently crosses. The gate file itself also carries dozens of its own findings, so the ordinal-keying repair its sibling already proved cannot be ported into it either. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 after the sorted-order ratchet fired on three modules written THIS SESSION — drain_blockers.blockers, drain_order.ordered and drain_plan.candidates all return a bare sorted list, so a caller cannot tell the order was paid for and re-sorts defensively. THE GATE IS RIGHT AND ITS PRESCRIBED FIX IS CURRENTLY UNREACHABLE FROM WHERE THE DEFECT IS. The refusal names the remedy: carry the order ON the value via Sorted and SortKey, whose combinators then REFUSE a mismatch instead of re-sorting, which is how the requirement reaches the producer that must satisfy it. But the carrier lives under jea/metalanguage/ and module_importers reports exactly ONE consumer reaching it by a BARE import — resolvable only under a sys.path insert. So a substrate/ module adopting it would need either that insert, which is the construct this entire arc exists to remove, or a cross-package import that is not declared. ⚑⚑ THIS IS THE DRAIN ARC'S WALL ARRIVING FROM THE OTHER DIRECTION. gate-F51 recorded that the drain cannot begin because every blocker is frozen; this records that a GATE'S PRESCRIBED REPAIR cannot be adopted because the capability sits behind the same unpackaged boundary. The two are the same structural fact seen from opposite ends: capability and consumer are separated by a boundary only sys.path currently crosses. ⚑ AND THE GATE FILE ITSELF CANNOT TAKE AN EDIT — 51 own findings — so the ordinal-keying repair its sibling already proved cannot be ported into it either. Three walls, one cause},
  addendum = {CORRECTED 2026-09-04 the same day. The sorted-order ratchet's baseline is EMPTY, which the gate census names as ZERO-TOLERANCE and THE STRONGEST SETTING, NEVER A DEFECT — the empty set as baseline, so every offender is a NEW key and nothing is grandfathered. So its firing is not debt newly discovered but debt deliberately never banked, and the three modules written this session are not a regression I introduced into a previously-clean gate. What survives unchanged is the substantive half: the gate is right that a bare sorted list loses the order its callers then re-pay for, and its prescribed remedy remains unreachable because the order carrier sits under the metalanguage tree with one bare-import consumer. The correction matters because reading an EMPTY baseline as a broken gate is the inverse of the ABSENT-baseline error recorded elsewhere in this ledger — there a missing baseline made a gate exit zero while measuring nothing, here an empty one makes a gate report everything, and only the census column distinguishes them.}
}

@misc{gate-O13-churn-is-most-of-the-ban-ratchets-red,
  section  = {finding},
  claim    = {A majority of the ban ratchet's added keys are decomposition churn rather than new debt, so its red is substantially an artefact of draining and it is withholding a very large paydown.},
  check    = {standing},
  note     = {kind=finding by=substrate-session. MEASURED 2026-09-04 by the promoted churn classifier run across every gate with a baseline. The ban ratchet reports hundreds of added keys of which a majority are churn — the same violation at a new path, each pairing naming the old path as evidence, including a graded-polynomial monolith split into its own directory, an extrude module split into a directory of leaves, and an embedding module split into eight. Against thousands of paid keys that cannot record while any addition stands. The sumtype gate reports a minority as churn and the rest genuine. The discharge gate reports all four as genuine. The private gate reports both additions as churn, so it has no genuinely-new debt at all. So the red on these gates is substantially an artefact of decomposition, which is the drain arc's central claim now measured rather than argued: draining a monolith makes its gates read as growth, and because the ratchet returns on additions before its paydown branch, the credit the drain earned is withheld. Two gates could not be measured and both reasons are actionable. The public gate fails to import the shared ratchet module, which is reached by thirty bare sites across thirty files — the largest bare-import cluster in the tree — so a package-clean loader cannot resolve it. The carrier-locality gate has no census function, its census being a live-exemption set returned from a judge call, so it needs an adapter rather than a script entry. Neither reads as clean, which is the contract the reader was built to hold. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MEASURED 2026-09-04 by substrate/churn_report.py, the promoted churn classifier, run across every gate with a baseline. THE BAN RATCHET REPORTS 375 ADDED KEYS AND 198 OF THEM ARE DECOMPOSITION CHURN — the same violation at a new path, each pairing naming the old path as evidence: Graded.agda into Graded/FromCommRing.agda, ExtrudeCoEmitViaTrace.agda into its own directory, S4-Iso/Embedding.agda into eight leaves, FUSepQConfluence and FUSepQNf and FUSepQCyc likewise. Against 8516 PAID keys that cannot record while any addition stands. Sumtype reports 26 added of which 4 are churn and 22 genuine. Discharge reports 4 added, all genuine. Private reports 2 added, BOTH churn, so it has zero genuinely-new debt at all. ⚑⚑ SO THE RED ON THESE GATES IS SUBSTANTIALLY AN ARTEFACT OF DECOMPOSITION, and the paydown blocked behind it is very large. That is the drain arc's central claim, now measured rather than argued: draining a monolith makes its gates read as growth, and because set_ratchet returns on added before its paydown branch, the credit the drain earned is withheld. ⚑ TWO GATES COULD NOT BE MEASURED AND BOTH REASONS ARE ACTIONABLE. The public gate fails with ModuleNotFoundError for the ratchet module, because module_importers reports scripts.ratchet reached by 30 BARE sites across 30 files — the largest bare-import cluster in the tree — so a package-clean loader cannot resolve it. The carrier-locality gate has no census function at all: its census is judge()[4], a live-exemption set, so it needs an adapter rather than a script entry. Neither reads as clean, which is the contract the reader was built to hold}
}

@misc{gate-exit2-collision,
  section  = {finding},
  claim    = {A gate cannot distinguish an unknown flag from an unmeasurable census, because check_argv and gate_main both exit 2.},
  check    = {refuses:python3,substrate/private_gate.py,--queit},
  note     = {kind=finding by=claude. Measured - private_gate.py --queit returns 2 from check_argv unknown-flag, and a gate whose census raises Unmeasurable also returns 2 from gate_main._CANNOT_MEASURE. gate_main argues in its own comment that 1 and 2 must differ because they demand different responses (a site fix versus an environment fix). The same argument applies to these two and is unmet. Found by a private_gate_selftest case that asserted the distinction and failed. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): check_argv returns exit 2 for an unknown flag and gate_main returns exit 2 for a census it could not take. Two conditions, one code: a caller reading 2 cannot tell whether to fix their command line or install a missing tool. gate_main's own comment argues 1 and 2 must differ BECAUSE they demand different responses (site fix vs environment fix); by that argument a typo and a blind census must differ too. Found by a private_gate_selftest case that asserted the distinction and failed.}
}

@misc{private-baseline-shared-by-two-gates,
  section  = {finding},
  claim    = {Two gates declare one paydown-only ledger with identical censuses, so which one is wired decides whether 164 paydowns record.},
  check    = {selftest:python3,substrate/baseline_health_selftest.py},
  note     = {kind=finding by=claude. CORRECTED after measuring what each gate would WRITE, not merely what each reports. The two censuses are IDENTICAL (62 keys). The origin refuses (2 relocations read as growth, no key_move) and therefore writes NOTHING - a refusing ratchet is inert against its ledger, so there is no write conflict and no lost-update hazard. The migrated gate credits both as moves, passes, and would write 62 keys, dropping ZERO keys the origin still censuses. The residual issue is narrower than filed: two gates DECLARE one ledger, so whichever is wired into the hook decides whether 164 paydowns record, and a future edit to one census silently changes the other gate's verdict. Retirement is a correctness cleanup, not a race. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): substrate/private_gate.py and scripts/check_private_ratchet.py both declare private_ratchet_baseline.txt, so two gates write one paydown-only ledger. Whichever runs records for both, and they disagree - the origin refuses the current tree while the migrated gate passes and would lower 226 to 62. A scripts-scoped census cannot express this because it never holds both rows at once. Surfaced by the widened baseline_health table.}
}

@misc{shared-ledger-is-not-a-write-conflict,
  section  = {finding},
  claim    = {A refusing ratchet is inert against its ledger, so two gates sharing one paydown-only baseline is a verdict difference and not a write conflict.},
  check    = {selftest:python3,substrate/private_equivalence_selftest.py},
