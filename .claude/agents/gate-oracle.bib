@misc{gate-G300-substrate-mdstruct-sites-are-all-reads,
  section  = {finding},
  claim    = {An equal site count carries an unequal migration cost, because a site that READS a tool path as an identity has a target the moment the path changes while a site that INVOKES a write has no target until the replacement grows one},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. A peer corrected their own scope — mtools' eleven modes are all READERS and replace_section and append_to_section are library-only with no CLI, so their one read site plus a write path has no migration target. They flagged that my three might be writes and told me rather than asking me to check. Read all three: check_mode_contracts ADOPTED is a gate roster, concept_bindings _MODE_TOOLS is a mode roster whose sibling _WRITE_TOOLS deliberately omits mdstruct, and finding_mode_selftest is a differential fixture naming --budget. ⚑ ALL READS, so substrate has no write-path blocker where the peer does. ⚑⚑ AND THE PEER'S OWN SHARPENING IS THE TRANSFERABLE HALF — a tool name inside a docstring or a finding is a FACT ABOUT THE PAST that no path grep can distinguish from an invocation, so a repository that records its history well is adversarial to a name-keyed census. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): All three executable sites naming scratch/mdstruct.py are READS of the path as an identity — a gate roster in check_mode_contracts, a mode roster in concept_bindings whose _WRITE_TOOLS deliberately excludes mdstruct, and a suite fixture — so substrate has no write-path migration blocker where a peer consuming --append-section does, and the same three-site count carries a different migration cost on each side}
}

@misc{gate-G301-a-census-for-orphans-orphaned-by-its-own-cost,
  section  = {finding},
  claim    = {A tool whose cost makes it unrunnable is orphaned by construction rather than by neglect, so a green from it would be a fact about the invocation rather than about the tree},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. Built substrate/proof_only to census modules whose only consumer is their own suite — the class gate-G299 named. It is gate-clean and correct and DOES NOT FINISH: it asks module_importers one module at a time while that reader re-parses 1593 files per question, so roughly 700 candidates is 700 full corpus parses. Two runs killed at 120s. ⚑ THE RECURSION IS THE FINDING, and a peer named it before I did — a census for modules nothing calls, whose own only consumer would be a run nobody completes. ⚑⚑ STAGED WITH THE COST NAMED RATHER THAN HIDDEN BEHIND A NARROWER PREFIX, because a prefix that fits the timeout would report a real population over an invented denominator and read as a clean bill. The repair is to ask the reader ONCE for the whole corpus rather than once per candidate, which is a different reader shape and not this tick's work. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): substrate/proof_only asks module_importers one module at a time and that reader re-parses the whole corpus per question, so roughly 700 candidates is 700 full corpus parses and two runs were killed at 120s — an instrument that cannot be run is orphaned by construction rather than by neglect, which is the class it was built to find arriving one level up in the tool built to find it}
}

@misc{gate-G302-i-guessed-the-cost-three-times-and-measured-once,
  section  = {finding},
  claim    = {Three real repairs to a timeout left the timeout in place, because each was diagnosed by reasoning about the code rather than by varying one input and watching the cost move},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. proof_only did not finish and I diagnosed it three times without measuring — per-candidate parsing, then the twin unresolved call beside it, then a bulk reader I had built and left unwired which is the built-then-orphaned shape the module exists to census committed inside it. Every repair was genuine and the run still died at 120s. ⚑ ONE NARROW-PREFIX RUN SETTLED IT IN SECONDS: --proof-only substrate/md_h returns instantly and finds md_hkey, so the cost scales with CANDIDATES rather than files — all_sites loops the requested names INSIDE the node walk, which moved the parse and kept the multiplication. ⚑⚑ THE BULK READERS ARE CORRECT REGARDLESS, both differentials against their per-module twins pass on the live corpus at 14 of 14, and the census now answers for a narrow prefix where it answered for nothing before. The remaining term is named and unfixed. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): I diagnosed the census timeout three times without measuring — first as per-candidate parsing, then as the twin unresolved call, then as a bulk reader built and left unwired — and each repair was real while the timeout persisted, because the actual term is CANDIDATES looping inside the AST walk rather than parses, which one narrow-prefix run established in seconds}
}

@misc{gate-G303-most-of-the-package-being-purged-is-proof-only,
  section  = {finding},
  claim    = {Over half the package slated for migration has no consumer but its own suite, which turns a migration question into a scope question — carrying an inert module to a new owner reproduces its inertness there},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. proof_only --proof-only substrate/md reports 15 proof-only of 26 scanned, returned in seconds where the corpus-wide run still stalls. Spot-checked md_grep against module_importers independently — one import site, its own suite — and the case is sharp because md_grep CONSUMES md_spans while nothing consumes md_grep, which is the distinction the census draws. ⚑ THE PURGE SCOPE SHRINKS RATHER THAN THE WORK GROWING: what migrates to mtools should be what substrate actually uses, and an inert module is cargo that arrives already orphaned. ⚑⚑ OPERATOR RULED FILE THE RESULT AND LEAVE THE SCALE — the corpus-wide census is slow because all_sites loops candidates inside the node walk, and inverting the name-DIRECTED predicate would mean a second resolver beside the first. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Fifteen of twenty-six substrate md_ modules have no consumer but their own suite, so over half the package slated for migration to mtools is inert in this tree — which changes the purge from a migration question into a scope question, since carrying an inert module to a new owner reproduces its inertness there}
}

@misc{gate-G304-my-coinage-reached-a-third-party-as-theirs,
  section  = {finding},
  claim    = {A paraphrase can acquire a word and the word can acquire an owner, so a term reaches a third party attributed to a peer whose artifacts do not contain it — and only the peer can detect that, from absence},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. mtools-19 asked whether proof-only means something here because their operator suspected I was reading it into their work, and they measured ZERO occurrences across all four distributions, findings, skills and commit prose before asking. ⚑ IT IS MINE — the name of substrate/proof_only.py, coined this session. What I took from linux-sources-94 was the FRAMING, an instrument whose only caller is its own proof, and proof-only is my compression of it. Neither the term nor the module is mtools'. ⚑⚑ THIS IS THE LAUNDERING SHAPE THE ARC HAS BEEN CORRECTING, produced by me one hop further out: a peer laundered a hand-found site into a sweep result, I absorbed a peer's count rather than attributing it, and here a coinage crossed two relays and arrived owned by someone who never said it. The detector was a third party measuring their own tree for a word. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A term I coined this session reached a third repo attributed to a peer who had never used it — proof-only is my compression of linux-sources' phrasing an instrument whose only caller is its own proof, and mtools measured zero occurrences across their whole tree before asking, so a paraphrase acquired a word and the word acquired an owner in a three-way relay}
}

@misc{gate-G305-i-searched-the-name-not-the-capability,
  section  = {finding},
  claim    = {Answering a capability question by searching the asker's WORD rather than their described capability reports the reader's blind spot as a fact about the tree, and a peer's operator was the discriminator},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. mtools-19 asked broadly what CLI machinery substrate has. I searched for cli, found climode, measured it properly and reported no dispatcher. Their operator said substrate has a generic dispatcher, and toolmodes --find dispatch surfaces substrate/bib_modes on the first run — dispatch, known, operand_of, accepts, unbound — built THIS SESSION during the bibstruct drain. ⚑ THE REPLY WAS ABOUT AVOIDING A DUPLICATED CAPABILITY AND WAS ITSELF KEYED ON ONE SPELLING, which is the defect CLAUDE.md records as the --calls emit census that missed _emit_one. ⚑⚑ AND THE COUPLING IS WORSE THAN CLIMODE'S: dispatch is generic in the HANDLER type, with a docstring recording that a first cut pinned Callable and failed against its own roster, but it reads a module-level MODES global, so it is a dispatcher for one tool wearing a generic signature. ⚑ THE PEER ALSO REFUTED A COUPLING I ASSERTED — I called climode's writes vocabulary a port cost and mtools already carries the struct-tools table and parses it, so they measured what I assumed. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Asked broadly what CLI machinery exists I searched for the word cli, found climode, and reported no dispatcher — while toolmodes --find dispatch surfaces substrate/bib_modes immediately, a generic dispatcher built this same session, so a reply about avoiding duplicated capability was itself keyed on one spelling and reported its own blind spot as a fact about the tree}
}

@misc{gate-G306-md-write-cannot-address-a-dash-leading-heading,
  section  = {finding},
  claim    = {A writer with no end-of-options terminator cannot address a dash-leading heading, and whether that is unsafe or merely unaddressable depends entirely on whether the vanished operand leaves a VALID arity behind},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. mtools-19 measured mdstruct stripping every dash-leading token including a bare double-dash, and named the write consequence: a vanished needle leaves a valid two-element shape so the FILE lands in the needle slot and the write proceeds against a target nobody typed, defeating exact= one layer below it. Asked whether substrate/md_write has the same shape. ⚑ MEASURED WITH A CONTROL FIRST — an ordinary heading writes into lines 7 to 11, a dash-leading heading is REFUSED by the arity check. Same missing terminator, different outcome: md_write consumes the --body-file value explicitly so the operand count drops to one rather than staying at two. Unaddressable, not unsafe. ⚑⚑ AND THE PEER'S SHARPER POINT STANDS REGARDLESS — a proof-only module's ENTRY POINT is unexercised even where its core is well tested, because the proof calls the core directly and never goes through argv. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): substrate/md_write has no end-of-options terminator and filters every argv token starting with a double dash out of its positionals, so a heading beginning with dashes vanishes and the write is REFUSED by the arity check rather than mis-targeted — unaddressable, not unsafe, which is a materially weaker version of the class a peer measured in mdstruct where a vanished needle leaves a valid positional shape and the file lands in the needle slot}
}

@misc{gate-G307-env-C-does-not-redirect-a-shell-redirect,
  section  = {finding},
  claim    = {A fixture that was never created reads as a measurement of the subject, because the tool under test fails for a reason that resembles the defect being probed},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. Probing md_write for a peer's dash-leading-heading class I built two fixtures with env -C DIR printf redirected to a file, and neither file existed — the redirect is performed by the invoking shell in ITS directory, not the one env changes to. ⚑ THE FIRST RUN THEN REFUSED AND I READ IT AS CONFIRMATION. It was a FileNotFoundError on the body file, which is a fact about my fixture. ⚑⚑ WHAT CAUGHT IT WAS LISTING THE DIRECTORY RATHER THAN TRUSTING THE EXIT CODE, and then running an ordinary-heading CONTROL through the same path before believing the negative — the control wrote into lines 7 to 11, which is what made the second reading trustworthy. Nearly reported a write-safety confirmation to a peer on the strength of an absent file. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): I built two probe files with env -C DIR printf ... > file and neither file was created, because the redirect resolves in the invoking shell's directory rather than the one env changes to — so my first dash-leading-heading measurement was actually reading a missing body file, and I nearly reported a write-safety confirmation to a peer on the strength of a FileNotFoundError}
}

@misc{gate-G308-md-write-documents-a-flag-it-never-reads,
  section  = {finding},
  claim    = {A hand-written usage string is a second spelling of the flag set that no roster-versus-handler check can see, and it drifted — one documented flag is never dispatched and an unknown flag is accepted in silence},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. Popped because I told mtools-19 this shape was unmeasured here after they found the same drift in their own banner. MEASURED: _USAGE names --append as a mode and main tests only for --replace, so --append is documented and undispatched — passing --append --replace together is accepted silently and --replace wins. An unrecognised flag is also accepted, because every dash token is filtered out of operands and nothing validates the remainder. ⚑ THE DANGEROUS DIRECTION HOLDS — a typo'd --dryrun leaves neither intent stated and the XOR refuses, so a mistyped flag cannot turn a preview into a write. ⚑⚑ AND THIS IS THE DRIFT unbound CANNOT SEE BY CONSTRUCTION, because it compares roster against handlers and a usage string is prose — the peer's point, confirmed on my own module rather than accepted as advice. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): md_write's hand-written _USAGE names --append as a mode and main never tests for it, so --append is documented and undispatched while --replace wins by being the only branch read — and an unknown flag is accepted silently because every dash token is filtered out of operands and nothing validates the remainder, which is exactly the roster-versus-prose drift unbound cannot see}
}

@misc{gate-G309-the-drift-was-two-populations-with-a-schema-signal,
  section  = {finding},
  claim    = {A stable drift figure was two distinct populations rather than one backlog, and the halves need opposite work — transcription for witnesses missing an entry, judgement for entries missing a witness},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. TRUE DRIFT held at 20 across every tick this session while roughly fourteen new findings were filed beside it, each paired same-turn under the standing rule — so the number was stable because the rule stops NEW drift and does nothing about old. Spot-checked rows on both sides were substantive rather than stale. ⚑ OPERATOR RULED PAIR THE WITNESS-ONLY FOURTEEN, each claim transcribed from the witness's own text rather than invented, and the drift moved 20 to 15 to 6 with zero witness-only rows remaining. ⚑⚑ THE REMAINING SIX SHARE A SCHEMA SIGNAL, which is the lead for whoever takes them: three proc rows carry NO section field where 42 of 45 entries do, and four agda rows use section=cycle detection where every other entry says finding. A filing process that skipped the schema plausibly skipped the registration too. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The pairing drift held at 20 for the whole session and was two distinct populations rather than one backlog — 14 witnesses never given a bib entry, now paired, and 6 bib entries whose witness was never registered, which remain and share a schema anomaly: three carry no section field at all and four use section=cycle-detection where every other entry says finding}
}

@misc{gate-G310-the-schema-signal-named-two-dispatch-batches,
  section  = {finding},
  claim    = {A schema anomaly in a record is evidence about the PROCESS that wrote it, so an odd field shape identifies the batch whose convention omitted a step rather than being noise in the record},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=momentum. The six unpaired entries split by their by= field into two dispatch batches, each with a distinct convention and each omitting registration — three read by=process-hygiene and carry NO section where every process-hygiene-r2 sibling has both a section and a witness, and four read by=agda-oracle with an of=function field no paired row uses. ⚑ THE ANOMALY WAS THE LEAD RATHER THAN THE DEFECT, noticed one tick earlier while reading the bib for something else and followed this tick. ⚑⚑ AND PREFIX RESOLUTION HID IT ONCE — asking the ledger for proc-F1 returns the REGISTERED sibling rather than reporting the target absent, so a reader checking by prefix would conclude the witness exists. TRUE DRIFT 20 to 0 over two ticks, 704 witnesses against 704 entries. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The six unpaired bib entries were two dispatch batches whose filing conventions each omitted registration — three carry by=process-hygiene with no section field while every process-hygiene-r2 sibling has both, and four carry by=agda-oracle with an of=function field no paired row uses — so a schema anomaly in a record is evidence about the PROCESS that wrote it rather than about the record}
}

@misc{gate-G311-the-unknown-flag-refusal-exists-and-the-writer-skips-it,
  section  = {finding},
  claim    = {A defect reported as missing machinery was a module standing outside a convention the tree already runs — the unknown-flag refusal exists, 21 gates call it, and the writer that accepts anything simply does not},
  check    = {standing},
  note     = {kind=standing by=momentum. mtools-19 found my accepts-unrecognised-flags finding present in their tool too and repaired it by splitting operands from options. Checking whether substrate had a second instance, --calls check_argv reports 44 calls across 21 gates plus gate_main, module_layout, module_outline and pid_ownership — and ratchet_flags.check_argv's own docstring reads call this FIRST in every gate's main. ⚑ SO md_write IS OUTSIDE AN ESTABLISHED DISCIPLINE RATHER THAN AHEAD OF A MISSING ONE, which reframes gate-G308 from a one-off into an unadopted convention. ⚑⚑ AND attr_reads REPORTED ONE CALLER where pycodemod --calls reports 44, because the packaged reader cannot see bare-name imports from scripts — a floor read as a total would have made the convention look absent. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): substrate already owns the repair a peer built for the same defect — ratchet_flags.check_argv refuses an unrecognised flag and its docstring says call this FIRST in every gate's main, with 21 gates and 4 packaged modules calling it — so md_write accepting --nonsense-flag is not a missing capability but a WRITER standing outside a convention every gate follows}
}

@misc{gate-G312-a-per-tool-flag-set-admits-a-mode-owned-flag,
  section  = {finding},
  claim    = {A flag set declared per TOOL rather than per MODE admits a mode-owned modifier on every other mode, so the flag passes validation and is then silently ignored — the looks-like-it-ran defect the refusal exists to prevent, one argument over},
  check    = {standing},
  note     = {kind=standing by=momentum. mtools-19 named the per-mode-versus-union distinction while repairing their own unknown-flag defect and observed that a union would admit a lint-owned flag on a spans invocation. I said substrate had the same shape one level coarser and named it UNMEASURED. ⚑ MEASURED THIS TICK: check_argv takes one flat known set, and check_mode_contracts passes modes and modifiers together — where, list, quiet, selftest. Running --where --quiet is ACCEPTED and cmd_where returns before reading quiet, so the caller gets full output and exit 0. ⚑⚑ THE DOCSTRING ARGUES AGAINST THIS IN ITS OWN WORDS — a silently ignored --quiet is a gate that looks like it ran — and that is exactly what the tool now does for a flag the same function admitted. ⚑ climode.Mode.opts already models per-mode ownership and contract_rows already reads it, so the vocabulary for the repair exists and check_argv does not consume it. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): check_argv takes ONE flat flag set per tool rather than per mode, so a modifier owned by one mode is admitted on every other — measured on check_mode_contracts --where --quiet, which passes the flag check and then returns from cmd_where without ever reading --quiet, producing full output and exit 0 for a caller who asked for silence}
}

@misc{gate-G313-the-existing-collision-reader-answers-a-different-question,
  section  = {finding},
  claim    = {A reuse-search hit that answers an adjacent question is more useful for its DISCRIMINATOR than for its coverage — the existing collision reader cannot see the per-tool flat set, and its harm test is what makes the new instances judgeable},
  check    = {standing},
  note     = {kind=standing by=momentum. Operator ruled census the population before editing a 44-caller function. Reuse-search found pycodemod.opt_key_collisions, which reports flags that are BOTH a mode key and an opt inside ONE declared roster — it presumes per-mode opts exist, so it is blind to the flat per-tool set gate-G312 names. ⚑ ITS DISCRIMINATOR TRANSFERS AND SHARPENED MY OWN FINDING: a collision is a defect only when the two roles MEAN different things, and a nullary mode colliding with a nullary modifier is the SAME request at two scopes. ⚑⚑ MEASURED AGAINST THAT TEST: check_mode_contracts --quiet is a LIVE capability on the default mode and unread by --where and --list, so it is a real capability on one mode and a no-op on another rather than one request at two scopes — not benign. ⚑ AND A SECOND GATE SHOWS IT — check_sorted_order --list --quiet printed 130 rows in full. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): pycodemod.opt_key_collisions reads flags that are BOTH a mode key and an opt within one declared roster and presumes per-mode opts already exist, so it cannot see the per-tool flat set gate-G312 is about — but its harm discriminator transfers: a collision is a defect only when the two roles MEAN different things, and quiet being a live capability on the default mode while unread by --where and --list is exactly that}
}

@misc{gate-G314-sixteen-partial-flags-and-the-pattern-is-selftest,
  section  = {finding},
  claim    = {Sizing the population turned a two-instance defect into a mostly-benign pattern plus one real phantom, which is the opposite of what the instances alone suggested},
  check    = {standing},
  note     = {kind=standing by=momentum. Operator ruled census before editing a 44-caller function. Built substrate/flag_ownership, which reports 16 partial flags over 19 declaring tools. ⚑ THE FIRST RUN SAID 38 AND WAS WRONG — it treated every top-level if in main as a mode, including the refusal's own if rc is not None early exit, so nearly every tool gained a phantom row. Reading one site rather than trusting the figure caught it. 38 to 16 once guards are excluded by requiring a mode branch to test a flag spelling. ⚑⚑ AND THE DOMINANT PATTERN IS BENIGN BY THE BORROWED DISCRIMINATOR — quiet and list ignored by selftest and where, modes whose entire output is a suite result or one query, so wiring quiet into them would be ceremony. ⚑⚑⚑ THE ONE REAL DEFECT IS check_mypy_ratchet --check, declared and dispatched by NO branch: running it produces the default census, so a caller gets a full run for a flag they meant as a query. The census calls it PARTIAL because the default span still contains the mode spans — a mislabel in the kind, not in the finding. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The per-mode flag census sizes gate-G312 at 16 partial flags over 19 declaring tools, and the dominant pattern is benign by the borrowed discriminator — quiet and list ignored by selftest and where modes that have nothing to quieten — while check_mypy_ratchet --check is declared, accepted, and dispatched by no branch at all, which is a PHANTOM the census mislabels PARTIAL because the default span still contains the mode spans}
}

@misc{gate-G315-the-declaration-is-not-a-read,
  section  = {finding},
  claim    = {A flag census that scans a branch span for a flag spelling counts the flag's own declaration as a read when the declaring call sits inside that span, making PHANTOM unreachable},
  check    = {standing},
  note     = {kind=finding by=substrate. Measured — a fixture gate declaring --check and dispatching it nowhere read PARTIAL rather than PHANTOM. The cause is the check_argv call inside main, NOT leftover mode spans as gate-G314 recorded, and those spans were already subtracted. Fixed by cutting the call's own line range from the default span. Suite 19/19 and two live phantoms became visible, one of which is a reader blind spot rather than a defect. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): flag_ownership counted a flag's own check_argv declaration as a read so PHANTOM was unreachable and every phantom reported PARTIAL — gate-G314 blamed leftover mode spans which were already subtracted, a cause reasoned rather than read}
}

@misc{gate-G316-sole-not-total-ranks-the-blocker,
  section  = {finding},
  claim    = {A blocker census ranked by how many members carry a blocker picks the blocker whose payment releases nothing, because a member held by several is freed by none of them alone},
  check    = {standing},
  note     = {kind=finding by=substrate. Measured — intake_manifest --sole reported no-header at 87 SOLE of 887 TOTAL and not-promotable at 0 SOLE of 800 TOTAL. Paying no-header moved readiness 707 to 796, and the +89 exceeded the 87 predicted, so SOLE is itself a FLOOR rather than an exact release count. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): ranking intake blockers by TOTAL picks one that releases nothing — no-header held 887 total but 87 sole while not-promotable held 800 total and ZERO sole, so paying the larger blocker alone frees no module}
}

@misc{gate-G317-not-promotable-means-dirty,
