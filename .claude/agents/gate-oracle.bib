}

@misc{gate-G275-my-fixture-invented-a-label-family-the-grammar-does-not-admit,
  section  = {finding},
  from     = {gate-G274-two-of-my-undrained-list-were-already-drained},
  rests-on = {gate-G272-md-lint-drained-and-my-fence-case-asserted-a-rule-the-origin-never-had},
  claim    = {A fixture written in a notation the subject's grammar does not admit fails loudly in a way that looks like a defect in the subject, so the first move on a failing arm is to read the grammar rather than the code under test.},
  check    = {selftest:python3,-m,substrate.md_coherence_selftest},
  note     = {kind=selftest by=substrate. The witness: md_coherence_selftest 17 of 17 after replacing circled-glyph-plus-digits fixtures with the ASCII shape. md_labels.ITEM_RE matches a single enclosed character with no digits after it, so both fixtures collapsed to the same bare glyph and five arms failed together. The module takes the worklist labels as a caller-supplied set, which is the gate-F59 repair as a calling convention. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): substrate/md_coherence.py replaces mdstruct.coherence taking the plan as LINES and the worklist's labels as a SET the caller assembles — which is the gate-F59 repair expressed as a calling convention rather than a better reader, since reading one worklist while the tree holds six ledgers made every label registered elsewhere read as unwitnessed. 17 of 17 including a live-plan arm. THE PREDICTION THAT FAILED: my fixtures wrote Ⓝ100 and Ⓝ101 and five arms failed at once because md_labels.ITEM_RE reads BOTH as the bare glyph Ⓝ — its enclosed branch matches a SINGLE character in the range with no digits after it, so the two fixtures collided into one label. Reading the binding settled it: the grammar has no such alternative and the plan already records the sibling defect that bare symbol prefixes read as items. The module was right and my fixture invented a family, which is the second consecutive tick where a case asserted something its subject never claimed.}
}

@misc{gate-G276-the-same-any-leak-refused-me-three-times-in-one-arc,
  section  = {finding},
  from     = {gate-G275-my-fixture-invented-a-label-family-the-grammar-does-not-admit},
  claim    = {A lesson written into the docstring of the module that learned it reaches whoever reads that module and not the next thing its author writes, so the same defect can be documented and repeated in consecutive units of one drain.},
  check    = {selftest:python3,-m,substrate.md_superseded_selftest},
  note     = {kind=selftest by=substrate. The witness: md_superseded_selftest 19 of 19 with arms for all three of the origin's recorded failed predicates. The unannotated sort key leaked Any and refused the write in borrowed_root_census then md_lint then here, and md_lint carries a named _order helper whose docstring states the reason. The replacement takes lines with the noun roster and ratio as parameters so the frozen-roster weakness is testable. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): substrate/md_superseded.py replaces mdstruct.superseded taking LINES with the noun roster and magnitude ratio as parameters — 19 of 19 including a live-plan arm. The origin records three failed predicates and all three are now suite arms: a bare-noun key reporting twelve nouns of noise, a no-space filter that discarded the very phrase the motivating supersession produces so the tool reported NOTHING, and the pair no phrasing rule separates since 589-vs-1322 leaves and 2-vs-2941 files are structurally identical. THE SELF-DIRECTED FINDING: the unannotated sort lambda leaked Any and refused the write for the THIRD time in this arc — borrowed_root_census, then md_lint, now here. I wrote the named _order fix into md_lint two ticks ago, documented WHY in its docstring, and still did not carry it forward. A recorded lesson in a module docstring reaches whoever reads that module, which is not the same as reaching the next thing I write.}
}

@misc{gate-G277-a-preservation-check-needs-the-false-positive-arm-more-than-the-damage-arm,
  section  = {finding},
  from     = {gate-G276-the-same-any-leak-refused-me-three-times-in-one-arc},
  rests-on = {gate-G273-the-untestable-seam-is-why-two-termination-rules-survived},
  claim    = {A preservation check earns its keep from the arm proving it stays silent on notation the document always wrote, because a check that fires on the corpus's own conventions is skimmed and then the real damage passes under it.},
  check    = {selftest:python3,-m,substrate.md_damage_selftest},
  note     = {kind=selftest by=substrate. The witness: md_damage_selftest 20 of 20 with a damage arm and a pre-existing arm for each of frontmatter-dropped escape-in-code wikilink-escaped and smart-quotes, plus a composite arm proving all four run rather than short-circuiting. The measured incident is a memory file that converged clean while escaping its code and links, smart-quoting its prose and dropping its frontmatter. The frontmatter predicate composes md_frontmatter.split rather than the origin's local one, and a case pins the unterminated-fence difference. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): substrate/md_damage.py replaces mdstruct.semantic_damage — 20 of 20, every check in BOTH directions. The origin records the incident it exists for: a memory file converged to output that escaped inline code making a PSI selector wrong as written, escaped every wikilink which are mesh edges, smart-quoted its prose, and DROPPED ITS YAML FRONTMATTER — its name and type and provenance — and both gates passed it because a fixpoint check asks whether normalization converges and never whether the converged text still means the same thing. THE ARM THAT MATTERS IS THE SECOND ONE. Each of the four checks needs a damage arm and a PRE-EXISTING arm, and the second is what keeps the check from reporting the corpus's own notation as damage on every run — which is the cries-wolf shape that produced the original blindness. And the frontmatter predicate is md_frontmatter's rather than re-derived: the origin's local version calls an unterminated fence frontmatter where the owner reads it as a document whose first line is a rule, so a case pins that difference. re.findall leaked Any in the same family as the sort-key leak.}
}

@misc{gate-G278-half-drained-reads-as-drained-when-the-roster-counts-modules,
  section  = {finding},
  from     = {gate-G277-a-preservation-check-needs-the-false-positive-arm-more-than-the-damage-arm},
