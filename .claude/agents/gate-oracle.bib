@misc{gate-G271-eleven-of-28-drained-was-a-category-error,
  section  = {finding},
  from     = {gate-G270-the-gate-side-population-was-one-site-not-eighteen},
  claim    = {A progress count that measures replacements BUILT while being read as origin definitions REMOVED overstates completion by the entire swap, and the two numbers coincide only after the swap that has not happened.},
