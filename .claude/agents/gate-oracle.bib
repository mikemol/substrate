@misc{gate-G256-a-parameter-keyed-predicate-cannot-see-a-parameterless-crash,
  section  = {finding},
  from     = {gate-G255-four-borrowed-root-crashes-repaired-and-a-fifth-spelling-found},
  rests-on = {gate-G252-borrowed-root-census-half-false-positive},
  claim    = {A predicate keyed on a function's parameter list cannot express a function that never had the parameter, so the crash it was built to census was invisible in exactly the shape that cannot be rescued by any caller.},
  check    = {selftest:python3,-m,substrate.borrowed_root_selftest},
  note     = {kind=selftest by=substrate. The witness: borrowed_root_selftest 21 of 21 with a global-origin arm and an UNTRACED third outcome, and type_census_summary raising ValueError under env -C ~/github/summit as predicted. The new reading is 23 LIVE and 33 latent over 1557 files, and syspath_census ran clean, so 23 is a floor with its own false-positive rate. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The borrowed-root predicate asked whether a root-shaped PARAMETER carries a default, so it was structurally blind to a function with no root parameter at all. type_census_summary.census reaches corpus.ROOT as a module global while corpus.py_files walks the caller's cwd, and it raises ValueError from a borrowing checkout — predicted from the shape and CONFIRMED BY EXECUTION before the predicate was changed. Rekeyed on where the labelling root ORIGINATES: global, defaulted, received, guarded, or UNTRACED as a third outcome. The census moves from 13 LIVE to 23 LIVE and 33 latent over 1557 files, and syspath_census then ran clean from a borrowing checkout, so 23 is a new floor with its own nonzero false-positive rate rather than a verified roster.}
}

@misc{gate-G257-the-rewritten-predicate-is-also-a-floor-and-a-bare-run-cannot-witness-every-row,
  section  = {finding},
  from     = {gate-G256-a-parameter-keyed-predicate-cannot-see-a-parameterless-crash},
  rests-on = {gate-G252-borrowed-root-census-half-false-positive},
  claim    = {Executing a shape census row by row is itself a method with a coverage gap — a module that prints usage without operands never reaches the call under test, so bare-run silence is neither a confirmation nor a refutation and must be carried as a third outcome.},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=substrate. The witness: env -C ~/github/summit python3 substrate/MOD.py per row. CONFIRMED file_mode:254 type_gate:103 promote_agree:164 with type_census_summary:130 already held. REFUTED syspath_census prose_numbers private_census public_census gate_population gen_selftest_mk-via-driver. UNMEASURABLE module_trim record_migrate gen_selftest_mk-bare. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Executing nine of the 23 rows the rewritten borrowed-root predicate reports LIVE: CONFIRMED file_mode:254, type_gate:103, promote_agree:164, plus type_census_summary:130 already confirmed. REFUTED syspath_census, prose_numbers, private_census, public_census, gate_population, gen_selftest_mk via its driver. And three rows are UNMEASURABLE BY THIS METHOD rather than either — module_trim and record_migrate print usage without operands and gen_selftest_mk refuses to have a CLI at all, so a bare run never reaches the labelling call. The verification method has its own coverage gap, and reading a usage block as a pass would bank a false negative exactly where the census is least checkable.}
}

@misc{gate-G258-a-gate-edit-belongs-to-the-reserved-step-even-when-it-is-a-crash-fix,
  section  = {decide},
  from     = {gate-G257-the-rewritten-predicate-is-also-a-floor-and-a-bare-run-cannot-witness-every-row},
  claim    = {Which lane a repair enters is decided by the object it touches and not by the size or severity of the change, so a one-line crash fix to a commit-path gate waits for the gate review while the identical fix elsewhere lands immediately.},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=substrate. Operator ruling, asked because type_gate:103 was confirmed crashing under env -C ~/github/summit and appears in gate_population --gates. Hold it for root-the-gates. The non-gate confirmed sites file_mode:254 promote_agree:164 type_census_summary:130 stay in the crash-repair lane. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Operator ruling: type_gate:103 crashes from a borrowing checkout and its repair is the same one-line tolerant-label change as the four already landed, but type_gate is one of the 18 pre-commit gates and every edit to a gate belongs to the reserved root-the-gates step rather than the crash-repair lane. The discriminator is the OBJECT touched, not the size or kind of the change — a one-line fix to a commit-path gate still lands with the gate review. So the confirmed population splits by gate membership rather than by severity, and gate_population --gates is the authority that decides which lane a repair enters.}
}

@misc{gate-G259-a-repair-can-move-a-crash-one-frame-down-and-that-is-the-census-working,
  section  = {finding},
  from     = {gate-G257-the-rewritten-predicate-is-also-a-floor-and-a-bare-run-cannot-witness-every-row},
  claim    = {A guard testing whether a path is absolute admits precisely the borrowing-checkout path that raises and excludes only the paths that never could, so it reads as protection while providing none — measured in three separate modules.},
  check    = {selftest:python3,-m,substrate.mypy_census_selftest},
  note     = {kind=selftest by=substrate. The witness: repairing type_census_summary moved its ValueError into mypy_census:117 under env -C ~/github/summit, both then repaired and the full census runs. mypy_census_selftest 4 of 4 and tree_root_selftest 23 of 23. The useless guard appeared in promote_agree:164 mypy_census:117 and module_size. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Repairing type_census_summary:137 did not make it run — it moved the ValueError one frame downstream into mypy_census:117, a seventh spelling of the labelling rule carrying the same useless is_absolute guard. That is the census being RIGHT rather than a new site, because mypy_census was already reported LIVE as a defaulted origin. Two consequences. A per-site repair verified only by that site's own execution is incomplete when the labelling is chained across a call. And the is_absolute guard has now been measured useless three times in three modules — promote_agree:164, mypy_census:117 and the earlier module_size — because a path from a borrowing checkout IS absolute, so the guard admits exactly the shape that raises and excludes only the shapes that cannot.}
}

@misc{gate-G260-the-live-roster-fell-by-exactly-the-repairs-and-nine-more-rows-refuted,
  section  = {finding},
  from     = {gate-G259-a-repair-can-move-a-crash-one-frame-down-and-that-is-the-census-working},
  rests-on = {gate-G256-a-parameter-keyed-predicate-cannot-see-a-parameterless-crash},
  claim    = {A predicate that matches a global root name anywhere in a body and a relative_to anywhere in the same body reports a site whose two roots are provably the same expression, so its false positives are structural rather than incidental.},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=substrate. The witness: borrowed_root_census --live reads 19 LIVE and 33 latent over 1557 files after four repairs, down from 23 by exactly those four. Ten rows executed under env -C ~/github/summit and all ten refuted — walk_scope audit_type_load_bearing check_capstone_shape check_ban_ratchet record_cascade octave_check ban_census_selftest run_selftests_selftest uparrow_refactor_path and corpus.py_files via walk_scope. corpus.py:190 measures against base from the same resolve_root call as its walk. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The census re-derived after the four repairs reports 19 LIVE and 33 latent over 1557 files, down from 23 — the roster fell by exactly the repaired sites, which corroborates them independently of my own execution checks. Nine further rows executed from a borrowing checkout and ALL NINE REFUTED: walk_scope, audit_type_load_bearing, check_capstone_shape, check_ban_ratchet, record_cascade, octave_check, ban_census_selftest, run_selftests_selftest, and corpus.py_files through walk_scope. And reading corpus.py:190 explains a whole false-positive class the predicate cannot see: its relative_to measures against base, which is derived from the SAME resolve_root call as the walk, so the two roots cannot disagree. The predicate matches a global root name anywhere in the body and a relative_to anywhere in the body without checking they are the same root.}
}

@misc{gate-G261-my-prediction-failed-and-a-root-derived-through-a-call-is-the-third-outcome,
  section  = {finding},
  from     = {gate-G260-the-live-roster-fell-by-exactly-the-repairs-and-nine-more-rows-refuted},
  claim    = {When a static shape admits a divergence that every observed run denies, neither instrument overrules the other and the honest verdict carries the disagreement rather than picking whichever instrument ran last.},
  check    = {selftest:python3,-m,substrate.borrowed_root_selftest},
  note     = {kind=selftest by=substrate. The witness: borrowed_root_selftest 22 of 22 with a case pinning that a root bound through a call reads UNTRACED, and borrowed_root_census --live moving to 15 LIVE and 37 latent over 1557 files. My prediction that corpus.py_files would drop under binding-tracing FAILED — py_files defaults root to ROOT so the trace reaches a default first, and resolve_root prefers the caller cwd so the shape genuinely admits divergence while walk_scope ran clean. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): I predicted that tracing the measured root's binding would drop corpus.py_files from LIVE. It did not — reading resolve_root showed why: py_files takes root defaulting to ROOT and binds base from resolve_root(r, root), so the trace reaches a default before any call signal. The prediction failing is the finding. And the case is genuinely undecidable rather than merely misclassified: resolve_root prefers the caller's cwd, so the SHAPE admits a divergence between the walked root and the labelling root, while every observed run denied it — walk_scope ran clean from a borrowing checkout. Operator ruling: report UNTRACED, because LIVE banks a false positive and latent banks a false negative and neither instrument overrules the other. The census moves to 15 LIVE and 37 latent over 1557 files.}
}

@misc{gate-G262-three-wrong-cuts-before-reading-the-tree-and-the-ruling-does-not-yet-reach-its-case,
  section  = {finding},
  from     = {gate-G261-my-prediction-failed-and-a-root-derived-through-a-call-is-the-third-outcome},
  claim    = {Three successive guesses about an AST shape each acquitted the exact fixture the census exists to catch, and one ten-line probe printing the nodes settled it — so a reader that filters a tree must print what it sees before it filters.},
  check    = {selftest:python3,-m,substrate.borrowed_root_selftest},
  note     = {kind=selftest by=substrate. The witness: borrowed_root_selftest 22 of 22 after the probe, having failed 20 of 22 on each of three guesses. borrowed_root_census --live reads 14 LIVE and 38 latent over 1557 files. The ruling does not yet reach public_census because its walk root is an expression built from a local spelled root while the tracer matches the spelled global. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Operator ruled that a site is LIVE only when the labelling root and the WALK's root are independently derived, because public_census labels against corpus.ROOT and walks agda_files(str(root slash agda)) so every path is under the labelling root by construction. Implementing it cost three wrong cuts, each a guess about AST shape: excluding nothing, then excluding the relative_to call, then filtering the argument subtree. All three acquitted the global fixture — the census absolving the one shape it exists to find — and the suite caught every one. A ten-line probe printing the calls and their args settled it in a single run: the labelling call's args are corpus.ROOT and its relative_to lives on the FUNC, so an argument-subtree filter could never see it. And the ruling does NOT yet reach its motivating case: public_census remains LIVE because its walk root is str(root slash agda) where the local is spelled root, while the tracer matches the spelled global. Reported rather than guessed a fourth time.}
}

@misc{gate-G263-the-fixture-was-not-modelling-the-crash-it-was-named-for,
  section  = {finding},
  from     = {gate-G262-three-wrong-cuts-before-reading-the-tree-and-the-ruling-does-not-yet-reach-its-case},
  claim    = {A fixture can carry a defect's name while modelling a shape that cannot exhibit it, so the suite passes on both the broken and the repaired predicate and the arm proves only that the reader is self-consistent.},
  check    = {selftest:python3,-m,substrate.borrowed_root_selftest},
  note     = {kind=selftest by=substrate. The witness: borrowed_root_selftest 22 of 22 with DEFAULTED_SRC rewritten to corpus.py_files(root=where), and borrowed_root_census --live reading 11 LIVE and 41 latent over 1557 files down from 14 with public_census private_census syspath_census all dropping. A probe printing the calls and their args located the local-versus-global spelling in one run where three guesses had failed. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Reading the tree FIRST this time closed gate-G262's gap in one edit: in public_census the measured root is the LOCAL root bound from corpus.ROOT, and the walk is handed str(root slash agda), so walk_reaches under the measured NAME is True while under the global's spelling it is False. Asking about the global could never find the acquitting evidence because the body stops spelling it that way at line one. The extension then made the DEFAULTED fixture read received, and the fixture turned out to be the wrong artifact: it walked a bare walk(where), which returns paths under where BY CONSTRUCTION and therefore models a shape that cannot crash. The modules it was named for called corpus.py_files(root=where), whose resolve_root prefers the caller CWD and can return paths outside where. Operator ruled the fixture wrong. A suite can pass for years while its fixture models a clean shape under a defect's name.}
}

@misc{gate-G264-the-unmeasurable-verdict-was-about-the-invocation-not-the-site,
  section  = {finding},
  from     = {gate-G263-the-fixture-was-not-modelling-the-crash-it-was-named-for},
  rests-on = {gate-G257-the-rewritten-predicate-is-also-a-floor-and-a-bare-run-cannot-witness-every-row},
