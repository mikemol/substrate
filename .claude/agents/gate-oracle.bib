}

@misc{gate-G361,
  section  = {finding},
  claim    = {A gate measured FRESH at 46s twice was reported UNMEASURABLE by the same reader under contention, because a timeout renders identically to a crash and a fact about the MACHINE reads as a verdict about the tree},
  check    = {standing},
  note     = {kind=finding by=momentum. MEASURED — commit_refusal --sync reported the apex gate no answer within 120s, while sync_verdict run directly read it FRESH at 46.0s and again at 46.4s against the same per-gate _TIMEOUT_S of 120 with no budget in play. The crossing happened while heavy work was in flight. ⚑ REPAIRED by splitting UNREACHED into a distinct TIMED-OUT state, operator ruling — the reader already carried per-gate seconds from gate-F63, so the cause was known and only the vocabulary was missing. commit_refusal maps both to UNMEASURABLE deliberately, since the distinction rides in the detail. ⚑ AND THE ROSTER-AGREEMENT ARM IN commit_refusal_selftest CAUGHT THE HALF-DONE CHANGE — adding the state to the fold without adding it to sync_verdict failed that arm, which is the arm working. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A gate measured FRESH at 46s twice was reported UNMEASURABLE by the same reader under contention — a timeout renders identically to a crash, so a fact about the MACHINE reads as a verdict about the tree}
}

@misc{gate-G362,
  section  = {finding},
  from     = {gate-G361},
  claim    = {A branch reachable only by spending a timeout has no cheap input, so a suite cannot pin its routing and an arm that looks like a negative control may measure a path that never reaches the branch},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. MEASURED — replacing ask's discriminator with a bare state assignment left sync_verdict_selftest at full marks twice, once before the arms were added and once after. The branch fires only when _run returns a None code, and the two causes are a real _TIMEOUT_S wait and an OS-level launch failure. A missing script is NEITHER, because python starts and exits non-zero, so the absent-gate case I wrote as a control never reaches the branch at all. ⚑ THE SUITE NOW ASSERTS THE VOCABULARY AND SAYS SO — a distinct state that does not refuse, which the fold and the render depend on — and records in its own comment that the routing is unpinned. UNWITNESSED because no registered kind distinguishes a branch nothing can drive from one nobody has driven, and the discriminating quantity is whether a seam exists that fires without spending the ceiling. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A branch reachable only by spending a timeout has no cheap input, so a suite cannot pin its routing — replacing the discriminator with a constant left the suite at full marks, and the arm that looked like a negative control was measuring a path that never reaches the branch}
}

@misc{gate-G363,
