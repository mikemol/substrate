@misc{drain-does-not-concentrate,
  section  = {finding},
  rests-on = {drainable-set-is-three-of-492},
  claim    = {The sys.path drain does not concentrate, so ranking blockers by sites-released is not a strategy for it.},
  check    = {selftest:python3,substrate/drain_ranking_selftest.py},
  note     = {kind=finding by=claude. Measured over 257 dirty files holding 325 mechanical sites - top 1 releases 3 sites (0 percent), top 5 release 15 (4 percent), top 10 release 28 (8 percent), top 25 release 58 (17 percent) against roughly twelve thousand findings. No file holds more than 3 sites, and the tail is 232 mostly single-site files. The cheapest blocker anywhere in the population is scratch/dangling_probe.py at 30 findings for 2 sites, still a full-file rewrite. A ranking earns its keep when the head concentrates the work. Here each file cleaned converts to one or two drained sites throughout, so the ranking is honest and the strategy it would serve is not available. This is a fact about the DISTRIBUTION rather than about the ranker - the ranker was built, pinned at 12 of 12, and its own output is what refutes the plan that motivated it. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Ranking the drain's blockers by sites-released shows it does NOT concentrate, so ranking is not a strategy here. Measured over 257 dirty files holding 325 mechanical sites: the top file releases 3 sites (0 percent), top 5 release 15 (4 percent), top 10 release 28 (8 percent), top 25 release 58 (17 percent) at a cost of roughly twelve thousand findings. No file holds more than 3 sites. The cheapest blocker in the entire population is scratch/dangling_probe.py at 30 findings for 2 sites, and it is still a full-file rewrite. A ranking is worth following when its head concentrates the work; this one has a 232-file tail of mostly single-site files, so cleaning files one at a time converts roughly one file rewrite into one or two drained sites throughout. The lever is not file-by-file paydown.}
}

@misc{blocker-population-contains-generated-cohorts,
  section  = {finding},
  rests-on = {drain-does-not-concentrate},
  claim    = {The drain's blocker population contains generated cohorts, so a per-file count over it counts one decision many times.},
  check    = {selftest:python3,substrate/template_cohort_selftest.py},
  note     = {kind=finding by=claude. Measured by substrate/template_cohort over the 14 cotype check scripts - 9 share one constant-erased AST skeleton, 2 share another, 3 stand alone. Each member is a 23-line harness differing only in a witness module name, a claim slug and a gold filename, at roughly 51 findings apiece, so the blocker ranking showed eleven rows for two decisions. I had guessed eleven near-identical from filenames alone and the structural grouping is 9 plus 2, with three files I would have swept into a batch fix turning out distinct - the guess was close enough to act on and wrong enough to break something. The comparison must be over the normalised AST because a textual diff reports instantiations as unrelated, and jea_pysim is not the reader here because it interns FUNCTIONS and these scripts define none. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The drain's blocker population contains generated cohorts, so per-file counts over it overstate the work. Measured by substrate/template_cohort over the 14 cotype check scripts: 9 files share one structural skeleton and 2 share another, with 3 standing alone - two templates, not fourteen files. Each is a 23-line harness differing only in a witness module name, a claim slug and a gold filename, carrying about 51 findings apiece, so the ranking showed eleven separate rows for two decisions. I had guessed eleven near-identical from filenames; the structural grouping is 9 plus 2, and three files I would have swept into a batch fix are genuinely distinct. The comparison is over the constant-erased AST because a textual diff reports instantiations as unrelated and jea_pysim interns FUNCTIONS, so a flat script with no def contributes nothing to it (measured - pointing it at this directory returned clusters from a sibling module and nothing from the scripts).}
}

@misc{bare-name-imports-hide-the-dependency-graph,
  section  = {finding},
  rests-on = {drain-does-not-concentrate},
  claim    = {The blocker population's dependency graph reads as nearly empty because bare-name imports under a path insert cannot be resolved, not because the files are independent.},
  check    = {selftest:python3,substrate/module_paths_selftest.py},
  note     = {kind=finding by=claude. Measured over 257 dirty blockers - exactly 1 file has any in-population module-scope edge, 1 edge in total. The largest blocker scratch/toolmodes.py resolves ZERO repo imports, against a positive control (substrate/module_paths.py resolves 3) confirming the reader works. These files import siblings by BARE NAME under a sys.path insert, so a dotted resolver has nothing to match. The decomposition ordering therefore reports every file startable with no cycles, which is honest for the graph it was handed and would be badly misread as a claim that the files are independent. The circularity is the point - draining the inserts is what would make the real dependency graph visible, so the measurement and the repair are the same act in that order. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The blocker population's dependency graph is nearly empty, and that is a consequence of the defect being drained rather than a fact about the tree. Measured over 257 dirty blockers: 1 file has any in-population module-scope edge, 1 edge total. scratch/toolmodes.py, the largest blocker, resolves ZERO repo imports (positive control - substrate/module_paths.py resolves 3, so the reader works). The cause is that these files import siblings by BARE NAME under a sys.path insert (import vfs, not import scratch.vfs), and a dotted resolver cannot map a bare name to a repo file. So the decomposition ordering reports every file startable and no cycles, which is honest for the graph it was given and would be badly misread as 'these files are independent'. Draining the inserts is what would make the real graph visible - the measurement and the repair are the same act, in that order.}
}

@misc{modelling-the-antipattern-populated-the-dag,
