@misc{gate-G237,
  section  = {finding},
  claim    = {The bazel-intake plan's premise that no bazel is installed is FALSE — bazel 8.7.0 is present and 9.8G of local cache exists across fourteen output bases — while its no-workspace half holds for this repo, so the fleet purge directive binds the machine but not substrate.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum, directive relayed by paperkit after a k3s DiskPressure eviction of 57 pods. The witness: which bazel resolves to the mise install, du reads 9.8G under the local cache, and find over this repo returns no .bazelrc or WORKSPACE or MODULE.bazel or BUILD.bazel. Three of the fourteen output bases were modified within the hour, so they are other repos' live sessions on a shared machine and purging them would destroy peer working state — the action is operator-scoped rather than delegate-scoped. The directive's third clause is unsatisfiable by the relayer's own measurement: the buildbuddy service OBJECT is gone rather than endpoint-less, so reconfiguring to the sanctioned endpoint would point at nothing. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): paperkit relayed a fleet-wide operator directive to purge local bazel caches after a k3s node hit DiskPressure and evicted 57 pods. Verified it binds here and found the plan's premise is FALSE on both halves. The bazel-intake plan states no workspace and no bazel installed. Measured: bazel 8.7.0 IS installed at the mise path, and du reads 9.8G under the local cache across FOURTEEN output bases, three modified within the hour. ⚑ BUT NONE OF IT IS SUBSTRATE'S — find over this repo returns no .bazelrc, no WORKSPACE, no MODULE.bazel, no BUILD.bazel, so the workspace half of the premise holds for THIS repo while the installed half is simply wrong. The 9.8G belongs to other repos' sessions on a shared machine and purging it would destroy peer working state, which makes the directive's action operator-scoped rather than mine. ⚑⚑ AND THE THIRD CLAUSE IS UNSATISFIABLE BY THEIR OWN MEASUREMENT — the buildbuddy service object is gone, not merely endpoint-less, so reconfiguring to the sanctioned remote endpoint would point at nothing.}
}

@misc{gate-G238,
  section  = {finding},
  from     = {gate-G237},
  claim    = {False-green risk from a shared build cache is a property of the KEYING, not of sharing — a correctly-keyed entry cannot serve a wrong artifact, and an incorrectly-keyed one collides against itself on one machine with no peer required.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum, operator ruling correcting a caution relayed by paperkit. Their .bazelrc argues the remote config must stay opt-in because an unproven cache converts a build failure into a false green, and advises adopting only the fallback flag. The operator's correction relocates the property: sharing does not create that failure mode, it widens an existing one, so declining to share buys nothing while forfeiting the coordination the directive exists for. Everyone adopts, no fallback. Executed here: 4.6G under _bazel_mikemol across fourteen output bases purged to 4.0K, seven of them carrying DO_NOT_BUILD_HERE markers naming mtools and paperkit and linux-sources and three tmp clone-probes. Removal required chmod u+w on DIRECTORIES rather than files, since bazel checks external repos out read-only and marks one sandbox helper dir mode-000 by design. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Operator ruled purge everything and corrected the reasoning I was about to relay. paperkit cautioned that an unproven shared cache converts a build failure into a false GREEN and advised adopting the fallback flag while leaving remote endpoints opt-in. Operator: there is no false-green risk if the cache keys are constructed properly, and if they are not constructed properly the risk does not depend on peers to cause the collision. Everyone adopts. No fallback. ⚑ THAT RELOCATES THE PROPERTY. False-green is a fact about the KEYING, not about who shares the cache — a correctly-keyed entry cannot serve a wrong artifact and an incorrectly-keyed one collides against itself on a single machine with no peer required. So sharing does not create the failure mode, it only widens an existing one, and declining to share buys nothing while forfeiting the coordination the directive exists for. ⚑⚑ EXECUTED: 4.6G under _bazel_mikemol across fourteen output bases, now 4.0K. Seven carried DO_NOT_BUILD_HERE markers naming mtools, paperkit, linux-sources and three tmp clone-probes. The removal needed chmod u+w on directories rather than files, since bazel checks external repos out read-only and marks one sandbox helper dir mode-000 by design.}
}

@misc{gate-G239,
  section  = {finding},
  claim    = {A section-edit case caught my own wrong assertion rather than a defect: replacing a body with an empty string leaves one blank line, not nothing, and that is correct markdown because a heading followed immediately by another loses its block separation.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum, drain unit five. The witness: the suite read 22 of 23 and printed the actual result, so the failing label carried its own components and the repair was to the CASE. Python's empty-string split yields a single empty element. The unit also repairs two origin defects in transit — its three verbs each took a path and each re-ran pandoc through the resolver, costing three reads and three conversions per edit with no fixture-testable surface, and its not-found refusal asserted a fact about the QUERY while pointing at a listing mode that was itself dropping headings, so a reader whose heading was lost was told their spelling was wrong. The replacement takes spans and lines, and samples the headings it did see. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Drain unit five landed and a case I wrote caught my own wrong assertion rather than a defect. I asserted that replacing a section body with an empty string clears it to nothing — the suite read 22 of 23 and printed the actual result, one blank line. Python's empty-string split yields a single empty element, so the section empties to one blank row, and that is CORRECT markdown because a heading immediately followed by another heading loses its block separation. The case now pins the real behaviour. ⚑ THE ORIGIN'S THREE VERBS EACH TOOK A PATH and each called a resolver that re-ran pandoc, so one edit cost three file reads and three conversions and could not be tested without a document on disk. section_edit takes SPANS and LINES, so the caller reads once and the suite runs on fixtures. ⚑⚑ AND THE NOT-FOUND REFUSAL IS REPAIRED IN TRANSIT: the origin said the needle names nothing and pointed the reader at a listing mode that was itself dropping headings, so a reader whose heading had been LOST was told their spelling was at fault. The replacement samples the headings it did see and names the reader as a possible cause, which is the discriminator between two different repairs.}
}

@misc{gate-G240,
  section  = {finding},
  from     = {gate-G230},
  claim    = {A third silence in mdstruct, same shape as the heading drop: tables() swallows a header-read failure in a bare except-pass and reports ZERO COLUMNS, indistinguishable from a table that declares no header.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum, drain unit six. The witness: the origin's header read is wrapped in except-Exception-pass, so an unreadable head and an absent head produce the same zero-width result and a reader cannot tell its own limit from a fact about the document. table_read gives header None when unreadable and an empty tuple when absent. The type checker also refused the obvious field name — a NamedTuple inherits tuple.index so a field called index shadows a method — which the origin never met because it returned bare tuples where a positional slot has no name to collide with. The cell join uses a separator no cell can contain, and the sensitivity arm computes what a space join WOULD answer to prove that choice is load-bearing rather than incidental. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Drain unit six found a THIRD silence in the origin, and it is the same shape as the heading drop. tables() wraps its header read in a bare except-Exception-pass, so a table whose head cannot be parsed reports ZERO COLUMNS — indistinguishable from a table that genuinely declares no header. A reader that cannot say UNREADABLE reports its own limit as a fact about the document. table_read makes header None when unreadable and an empty tuple when absent, so the two are different values and a caller may collapse them deliberately rather than by accident. ⚑ AND THE TYPE CHECKER REFUSED THE OBVIOUS FIELD NAME: a NamedTuple inherits tuple.index, so a field called index shadows a method and the annotation collides. Renamed to position. The origin never met this because it returned BARE TUPLES, where a positional slot has no name to collide with — a real cost of the shape it used rather than a quirk of the replacement. ⚑⚑ THE CELL JOIN IS BOUNDARY-SAFE AND THE SENSITIVITY ARM PROVES IT MATTERS: joining on a space lets the needle alpha-one match a row whose cells are alpha and one, a false positive nothing downstream can detect because the row really is in the table. The arm computes what a space join WOULD answer and asserts it differs.}
}

@misc{gate-G241,
  section  = {finding},
  claim    = {mdstruct --table-style's entire reported population on the live plan is false: all four hits are DELIMITER rows, which have no space beside their interior pipes and are canonical, because the spacing rule governs content rows.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum, drain unit seven. The witness: --table-style on the session plan reports four non-canonical pipe rows, every one of the form pipe-dashes-pipe, so the scan flags exactly the rows that cannot violate the rule it names. table_syntax excludes delimiter rows and an arm pins the class so it cannot return. The estimate is also made honest — the origin divided a dashed-rule count by three and returned the quotient as a table count, so a headerless or truncated multiline table shifted the figure silently, and the rule count now travels beside the quotient with a non-zero remainder signalling that the grouping assumption did not hold. Two of my own cases were also wrong in the same run, a fixture slice taking one rule where I wrote two and an expectation naming the cell's side rather than the pipe's, both readable from the failing labels because each carried its components. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): mdstruct --table-style reports a population that is ENTIRELY FALSE POSITIVES on the live plan, and the suite caught it because a canonical fixture failed its own check. Measured: the origin reports four non-canonical pipe rows on the session plan, every one of them a DELIMITER row of the form pipe-dashes-pipe. A delimiter row has no space beside its interior pipes and is canonical markdown — the MD060 spacing rule governs CONTENT rows — so the scan flags exactly the rows that cannot violate it. table_syntax excludes delimiter rows and an arm pins the class. ⚑ THE ESTIMATE IS ALSO NOW HONEST: the origin divided a dashed-rule count by three and returned the quotient as a table COUNT, so a headerless or truncated multiline table shifted the figure silently. The rule count now travels beside the quotient and a non-zero remainder says the grouping assumption did not hold. ⚑⚑ AND TWO OF MY OWN CASES WERE WRONG IN THE SAME RUN — a fixture slice that took one rule where I wrote two, and an expectation that a cramped cell reports RIGHT when the offending PIPE lacks a space on its LEFT. Both were readable from the failing labels because each carried its components.}
}

@misc{gate-G242,
  section  = {finding},
  claim    = {bibstruct --entries exits 0 on a nonexistent path and prints 0 of 0 entries, so a caller pointing it at a moved or misspelled bib is told the file is EMPTY rather than ABSENT — and the reader cannot serve as a behavioural capability check.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum, found deciding summit's presence-check ask. The witness: --entries on a path under /nonexistent returns 0 of 0 and exit 0, which is the negative control a check must pass and this reader does not. It is also the zero-denominator shape already filed here, where a zero over zero means the probe read nothing yet renders identically to a total read that found nothing. --selftest is declared with no handler and exits 2 saying so, a correct refusal that removes the obvious alternative route. The two records summit asked about decide DIFFERENTLY — membudget status exits 0 with live totals while an unknown mode exits 2, so it is upgradeable — which is the argument against asking one party about a class they hold a small share of. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): bibstruct --entries exits 0 on a NONEXISTENT path and prints 0 of 0 entries, so it cannot serve as a behavioural capability check and it is a live defect in its own right. Found while deciding summit's presence-check ask: the negative control a check needs — a bad operand must fail — is exactly the control this reader does not pass. It is also the zero-denominator shape this repo already files against, where 0 of 0 means the probe READ NOTHING and is rendered indistinguishable from a total read that found nothing. A caller pointing --entries at a moved or misspelled bib is told the file is empty rather than absent. ⚑ AND --selftest IS DECLARED WITHOUT A HANDLER: running it exits 2 saying the roster names it and no handler runs it, which is a correct refusal and means the obvious behavioural route is unavailable. ⚑⚑ THE TWO RECORDS SUMMIT ASKED ABOUT DECIDE DIFFERENTLY, which is the argument against asking one party about a class. membudget passes both directions — status exits 0 with live totals and an unknown mode exits 2 — so it is upgradeable. bibstruct is not, until a read verb refuses a path it cannot read.}
}

@misc{gate-G243,
  section  = {finding},
  from     = {gate-G242},
  claim    = {bibstruct --entries now REFUSES an absent bib with exit 2 and a message naming the path, so a read verb passes the negative control a behavioural capability check requires.},
  check    = {refuses:python3,scratch/bibstruct.py,--entries,/nonexistent/path/no-such.bib},
  note     = {kind=finding by=momentum, repairing gate-G242 under an operator ruling to fix before upgrading. The witness: --entries on a nonexistent path exits 2 with a refusal naming the path as ABSENT, while --orphans on the live gate bib still reads 486 entries and reports two real dangling edges. bib_parse.read's own docstring had argued for exactly this distinction while returning an empty map for both cases — prose that is right and unimplemented is the harder half to notice because nothing contradicts it. The first fix produced a traceback, which bib_cli's docstring forbids in the sentence saying a refusal is a result and not an exception, so the raise is caught at the dispatch boundary. And the suite had pinned the defect faithfully, asserting that an absent file reads as no entries, so a green suite said nothing about the collapse. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): gate-G242 is REPAIRED and bibstruct --entries is now usable as a behavioural check. A missing bib refuses with exit 2 and a legible message naming the path as ABSENT rather than printing 0 of 0 and exiting 0. Positive control holds: --orphans on the live gate bib reads 486 entries and reports two real dangling edges. ⚑ THE DOCSTRING HAD ARGUED FOR THE DISTINCTION WHILE THE CODE COLLAPSED IT — bib_parse.read's own prose said a caller pointed at a typo'd path deserves a different report from one whose bib was deleted, and then returned an empty map for both. Prose that is right and unimplemented is the harder half to notice because nothing contradicts it. ⚑⚑ AND THE FIRST FIX PRODUCED A TRACEBACK, which bib_cli's own docstring forbids in the sentence A REFUSAL IS A RESULT NOT AN EXCEPTION — so the raise is caught at the dispatch boundary and returned as a refusal. ⚑⚑⚑ THE SUITE HAD PINNED THE DEFECT FAITHFULLY: a case asserted an absent file reads as no entries, which is what the code did, so a green suite said nothing about the collapse.}
}

@misc{gate-G244,
  section  = {finding},
  from     = {gate-G243},
  claim    = {gate-G243's repair gave an absent-path refusal exit 2, which already means unknown-mode in the same tool — so two different repairs now share one code, and the fork in paperkit uses 1 for the same refusal.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum, divergence measured by summit-74 and reproduced here. The witness: substrate's bibstruct on a nonexistent path exits 2 while paperkit's fork exits 1, both naming ABSENT as distinct from empty, and substrate's own --no-such-mode also exits 2 with usage. A caller scripting against the tool cannot tell I-do-not-know-that-verb from your-file-is-not-there. paperkit's routes.py argues the alphabet directly, that a missing tool must exit 1 and never 2 because reading 2 as not-mine lets a gate skip it silently — and an absent path the caller explicitly named is a failure to do the named work rather than a claim the work belongs elsewhere. The capability record says transfer to paperkit is accepted and not yet effective, so whichever code ships publicly becomes the contract. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): summit-74 measured a fork divergence in gate-G243's repair and it reproduces: substrate's bibstruct exits 2 on an absent path while paperkit's fork exits 1, both refusing with the same ABSENT-not-empty distinction. Re-ran both before reporting. ⚑ AND THE COLLISION IS WORSE INSIDE MY OWN FORK THAN ACROSS THE TWO. bibstruct --no-such-mode ALSO exits 2 with usage, so my repair made an absent-path refusal indistinguishable from an unknown-mode refusal — two different repairs behind one code, in a tool whose main job is refusing. A caller scripting against it cannot tell I-do-not-know-that-verb from your-file-is-not-there. ⚑⚑ PAPERKIT'S ROUTES.PY ARGUES THE ALPHABET DIRECTLY: a MISSING TOOL must exit 1 FAILED and never 2, because reading 2 as not-mine lets a gate skip it silently. An absent path the caller EXPLICITLY NAMED is a failure to do the named work, not a declaration that the work belongs elsewhere. ⚑⚑⚑ THE RELOCATION MAKES IT CONSEQUENTIAL: the capability record says transfer to paperkit is accepted and not yet effective, so whichever code ships publicly becomes the contract, and settling it after the move is settling it on an external interface.}
}

@misc{gate-G245,
  section  = {finding},
  claim    = {attr_reads crashed from a borrowing checkout because its walk correctly returned the caller's files while its label computation measured them against substrate's root — two correct functions whose composition was not.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum, reported by summit-74 and reproduced here. The witness: running with cwd in another repo raised ValueError from relative_to, because corpus.resolve_root resolves CWD FIRST by design — its docstring records that a peer once nearly recorded substrate's census as their own — so the walk yields the borrower's tree and the label then measures against the wrong root. Narrowing the resolver would restore the wrong-repo answer it exists to prevent and forcing the walk under substrate's root would make the tool unable to answer about a borrower at all, so the repair is at the composition and a path outside the root keeps its absolute form rather than being dropped. Verified both directions. The routing chain is what makes it costly: the retired attribute mode in pycodemod refuses correctly and names this successor, but cites a path a borrower cannot resolve and the successor then died on a borrower's population, so a router is only as good as its landing. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): attr_reads crashed from a BORROWING checkout, and the two functions involved were each correct while their composition was not. Reproduced summit-74's report: running it with cwd in another repo raised ValueError because population computed relative_to against substrate's ROOT on paths the walk had legitimately returned from the caller's tree. ⚑ corpus.resolve_root RESOLVES CWD FIRST ON PURPOSE — its docstring records that this tooling is symlinked into other checkouts and a peer once nearly recorded substrate's census as their own. So from summit the walk correctly yields summit's files, and the label computation then killed the run. Narrowing the resolver would reintroduce the wrong-repo answer it exists to prevent, and forcing the walk under substrate's root would make the tool unable to answer about a borrower's tree at all, so the fix belongs at the composition. ⚑⚑ A PATH OUTSIDE THE ROOT NOW KEEPS ITS ABSOLUTE FORM rather than being dropped — dropping it would silently shrink the population, which is the census-green shape. Verified both directions: from summit the run completes with summit's three files carrying absolute labels beside substrate's relative ones, and from substrate every label is relative as before. ⚑⚑⚑ THE ROUTING CHAIN IS WHAT MAKES THIS COSTLY: pycodemod --attr is RETIRED and refuses correctly, naming attr_reads as its successor, but the refusal cites a path a borrower cannot resolve and the successor then died on a borrower's population. A router is only as good as its landing.}
}

@misc{gate-G246,
  section  = {finding},
  from     = {gate-G244},
  claim    = {The bibstruct exit-code divergence inverts on measurement: substrate's 3 is the value paperkit's own engine declares as CANNOT_RUN, while paperkit's 1 is Python's default for a non-integer SystemExit rather than a chosen code.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum, inversion raised by summit-74 and verified here rather than relayed. The witness: paperkit tools/eval.py:45 binds CANNOT_RUN to 3, and tools/bibstruct.py:425-429 preserves the SystemExit contract because call sites expect a raise while saying nothing about the value. So substrate speaks the engine alphabet and paperkit emits an artifact, the opposite of what gate-G244 recorded from a relayed figure. The split-the-codes ruling reached the engine's value by reasoning about which repair each state needs rather than by copying, which is what distinguishes agreement by contract from agreement by coincidence. gate-G244 states my fork exits 2 and that entry stays wrong on purpose, because retracting in place would delete the evidence that a wrong digit selects a different governing rule rather than merely a different number. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The exit-code divergence INVERTS on measurement and gate-G244's reasoning was built on a wrong premise. Verified both claims in paperkit's tree rather than taking the relay: tools/eval.py:45 declares CANNOT_RUN = 3, so 3 is the ENGINE'S OWN value for a check that could not run — which is what an unreadable operand is. And tools/bibstruct.py:425-429 says the SystemExit contract is preserved because call sites expect a raise, saying NOTHING about the value, so their 1 is Python's default for a non-integer SystemExit argument rather than a chosen code. ⚑ SO SUBSTRATE IS SPEAKING THE ALPHABET AND PAPERKIT IS EMITTING AN ARTIFACT, which is the opposite of what gate-G244 recorded. That entry cites paperkit's routes.py rule that 2 must not mean not-mine — true, and it never reached 3. My operator's split-the-codes ruling landed on the engine's value by reasoning about repairs rather than by copying, which is the outcome a coincidence cannot be credited for. ⚑⚑ AND gate-G244 SAYS MY FORK EXITS 2, WHICH IS WRONG AND STAYS. A peer measured 2 twice from a harness report rather than the process status, I filed on their figure, and the split had already made it 3. Retracting in place would delete the evidence that the reasoning ran on a bad input — the finding is that a wrong digit selects a different governing rule, not merely a different number.}
}

@misc{gate-G247,
  section  = {finding},
  claim    = {A drain unit shipped WITHOUT its suite and only a count moving by the wrong increment caught it — intake rose by one module where every previous unit raised it by two, and the module read 0 importers in 0 of 1551 files.},
