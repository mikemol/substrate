@misc{gate-F82-hkey-apostrophe-confirmed-by-control,
  section  = {finding},
  claim    = {mdstruct loses every section from the first apostrophe-bearing heading onward, because _hkey strips markup characters but not the apostrophe pandoc itself rewrites to U+2019.},
  check    = {unwitnessed},
  note     = {kind=finding by=substrate. CONTROL: --spans 'the only non-mechanical step' resolves 50-85. CASE: the same mode returns 0 sections for an apostrophe-bearing heading that exists in the same file. spans() is a forward cursor, so the loss cascades to every following section. Supersedes gate-F75, which blamed smart-quoting in the SOURCE — the source is ASCII and pandoc introduces the divergence. Same class _hkey's own docstring records for backticks, with the repair applied to markup and not to the punctuation pandoc also transforms. NO from EDGE: gate-F78 is registered as a witness and has NO bib entry in any of the 6 ledgers, so the supersession target is unfilable as an edge today. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): CONFIRMED BY CASE AND CONTROL, not inferred. mdstruct._hkey normalises a heading by stripping backticks, asterisks and underscores — but NOT apostrophes. Pandoc renders ASCII apostrophe as U+2019 while the raw source line keeps ASCII, _hkey leaves both untouched, so rendered text never compares equal to the raw line. spans() is a FORWARD CURSOR, so the first apostrophe-bearing heading drops that section AND every section after it. CONTROL: --spans 'the only non-mechanical step' (no apostrophe, same file) resolves to 50-85. CASE: --spans of THE OPERATOR-quote-S ACTUAL POINT returns 0 sections for a heading that exists in the file. This SUPERSEDES gate-F75, which blamed smart-quoting in the SOURCE — the source is ASCII and the divergence is introduced by pandoc's own rendering. Same class the docstring already records for backticks: the fix was applied to the markup characters and not to the punctuation pandoc also transforms, so a repair written to prevent the class is an instance of it.}
}

@misc{gate-F83-the-roster-is-anchored-by-adjacency,
  section  = {finding},
  from     = {gate-F82-hkey-apostrophe-confirmed-by-control},
  claim    = {The findings ledger cannot be drained roster-first, because register writes to __file__ and locates its insertion point by the source-text adjacency of the roster's closing brace to the next def.},
  check    = {unwitnessed},
  note     = {kind=finding by=substrate. MEASURED: module_outline reports 20 defs over 5833 lines, of which ~4700 are the WITNESSES dict — so the largest unit is DATA, not a responsibility. register() reads its own source, splices before the literal anchor with the roster terminator and the following def line, and os.replace's itself. pycodemod --literal finds exactly ONE site for that def line: the anchor string inside register. A source-text dependency between a writer and its neighbour, invisible to every import-graph and call-graph reader. Consequence: the drain order is FORCED and is the INVERSE of bibstruct's — the writer must stop naming its neighbour before the roster can move. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): [braces spelled ⟨lbrace⟩ / ⟨rbrace⟩] Ⓝ137′ ⟡findings-drain is NOT bibstruct's drain repeated, and sizing it that way is wrong. module_outline reports 20 defs over 5833 lines, but the code is only ~1100 of those (lines 97-450 kind machinery, 5131-5833 roster reader + register + CLI). The other ~4700 lines are the WITNESSES dict itself. So the largest unit is DATA, not a responsibility — and data relocates rather than decomposes. ⚑ EXCEPT IT CANNOT RELOCATE, because register() WRITES TO __file__: it reads its own source, splices the new entry before the literal anchor '⟨rbrace⟩\n\n\ndef _bib_keys():', and os.replace's itself. The insertion point is defined by the PHYSICAL ADJACENCY of the roster's closing brace to _bib_keys's def line. Moving WITNESSES to its own module breaks the anchor, and register refuses with 'cannot locate the WITNESSES terminator' rather than guessing. MEASURED: pycodemod --literal 'def _bib_keys():' finds exactly ONE site — the anchor string inside register — so the coupling is a source-text dependency between a writer and its neighbour, invisible to every import- and call-graph reader. The drain order is therefore FORCED: the writer must stop naming its neighbour by source text BEFORE the roster can move, which is the opposite of bibstruct's order (extract units, then swap).}
}

@misc{gate-F84-parse-and-anchor-agree-on-the-byte,
  section  = {finding},
  from     = {gate-F83-the-roster-is-anchored-by-adjacency},
  claim    = {A parse locates the findings roster's closing brace at the same byte the origin's text anchor does, so the writer can stop naming its neighbour without relocating any future entry.},
  check    = {unwitnessed},
  note     = {kind=finding by=substrate. substrate/dict_extent.py, 25/25, differential against the live ledger: the parse close offset EQUALS src.index of the origin anchor, the anchor occurs exactly once, and the span covers more than half the file (size control). Re-verified after --register mutated the roster, so the agreement holds across a real write rather than at one snapshot. ⚑ The equality had to be ASSERTED because a wrong insertion byte still PARSES — the corruption is invisible to syntax checks, round-trips and imports. ⚑⚑ The parse strictly dominates: a roster at END OF FILE has no following def, so the anchor refuses a legitimate write while the parse finds it. Refusals widened (absent, ambiguous naming both lines, non-dict, function-local, unparseable) and every failed splice is byte-identical to its input. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Ⓝ137-prime step 2 ⟡unanchor-the-writer, the precondition MEASURED rather than argued. substrate/dict_extent.py locates a module-level dict's closing brace by ast rather than by naming the following def. THE DIFFERENTIAL IS THE WHOLE CASE: against the live .claude/agents/findings.py, the parse's close offset EQUALS src.index of the origin's text anchor, the anchor occurs exactly once, and the located span covers more than half the file (a size control, so the equality cannot pass on a trivial dict). 25/25. ⚑ WHY THE EQUALITY HAD TO BE ASSERTED RATHER THAN ASSUMED: a wrong insertion byte produces a file that STILL PARSES, with the entry in the wrong place — no syntax check, no round-trip and no import would report it, so the swap would relocate every future witness silently. ⚑⚑ AND THE PARSE STRICTLY DOMINATES THE ANCHOR: a roster at END OF FILE has no following def, so the origin's anchor matches nothing and refuses a legitimate write, while the parse finds it (cased). Refusal paths kept and widened — absent name, two module-level bindings (naming both lines), non-dict binding, function-local dict, unparseable source — and every failed splice is asserted BYTE-IDENTICAL to its input, because a reason a caller ignores must corrupt nothing.}
}

@misc{gate-F85-step-3-is-blocked-and-misframed,
  section  = {finding},
  from     = {gate-F84-parse-and-anchor-agree-on-the-byte},
  claim    = {The anchor swap cannot land as an edit, because wiring a replacement into the ledger is itself an edit to the file the gate refuses — so extract-then-swap strands both new modules.},
  check    = {unwitnessed},
  note     = {kind=finding by=substrate. MEASURED: the per-file gate reports 8169 findings and refuses the two-line swap (95124 report lines withheld). The plan recorded 7451 earlier this session, so the count MOVED as the roster grew. ⚑ The refusal names this exact trap and I walked into it: witness_polarity and dict_extent are now two clean, differentially-verified modules with no consumer but their own suites — built-then-orphaned rungs. ⚑⚑ gate-F83 established that this drain's order is the INVERSE of bibstruct's, and I then followed bibstruct's order anyway. The unit is the DISPATCH: _selftest_suite 237 lines, main 137, register 117, _mode_undocumented 78 — 569 of ~1100 code lines. Nothing lands until those move out together and the origin is RETIRED. ⚑ NOT a mechanism gap: substrate is an editable install, so the ledger reaches substrate.dict_extent with no sys.path modification. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Ⓝ137-prime step 3 ⟡swap-the-anchor is BLOCKED, and the framing was wrong rather than merely optimistic. MEASURED: the per-file gate reports 8169 findings on .claude/agents/findings.py and refuses the two-line swap, with 95124 report lines withheld. The plan recorded 7451 earlier this session, so the count MOVED — the roster grew by four witnesses this turn, each adding lines the gate counts. ⚑ THE REFUSAL NAMES THE TRAP AND I WALKED INTO IT ANYWAY: 'if the ONLY consumer is inside this file, one extraction strands. Wiring the new module in is an edit to this file, so it is refused too — you are left with a clean module nothing imports.' That is now the literal state of BOTH step 1 (witness_polarity) and step 2 (dict_extent): two clean, differentially-verified modules with no consumer but their own suites. ⚑⚑ SO STEPS 1-3 WERE SEQUENCED AS extract-extract-swap, WHICH IS bibstruct's ORDER, AND gate-F83 ESTABLISHED THAT THIS DRAIN'S ORDER IS THE INVERSE. I filed that finding and then followed the old order anyway. The correct unit is the DISPATCH: module_outline reports _selftest_suite 237 lines, main 137, register 117, _mode_undocumented 78 — 569 of ~1100 code lines in four functions. Nothing lands until those move out together and the file is RETIRED, exactly as bibstruct was. ⚑ NOT A WALL: the import path is sound (substrate is an editable install, so a script in .claude/agents/ reaches it with no sys.path), and both replacement modules are built and verified. What is missing is the remaining extraction, not a mechanism.}
}

@misc{gate-F86-the-readers-take-the-roster,
  section  = {finding},
  from     = {gate-F85-step-3-is-blocked-and-misframed},
  claim    = {The ledger's readers drain by taking the roster as a PARAMETER rather than importing it, because the roster cannot move and an importing module would reach back into the origin.},
