@misc{gate-G268-the-suite-roster-and-git-hold-different-populations,
  section  = {finding},
  from     = {gate-G266-regenerating-the-roster-inverts-its-own-witness},
  claim    = {A roster derived from the filesystem and an index derived from git are two enumerations of one corpus with no common owner, so a suite can be declared and runnable locally while not existing for anyone who clones the repository.},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=substrate. The witness: selftest_mk declared 437 filesystem-discovered suites while git status --short --untracked-files=all reports many of those modules untracked, module_trim.py among them. Noticed only because staging its repair added a new file rather than staging a change. Same shape as the earlier git-versus-SKIP_TOP incident, which was closed by deleting that roster and did not reach this pair of readers. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Regenerating Selftest.mk declared 437 suites discovered on the FILESYSTEM, and git status shows a large share of those modules are UNTRACKED — module_trim.py itself among them, which I noticed only because staging the repair added a new file rather than staging a change. So the makefile references files git does not hold, and the two enumerations of the substrate corpus have no common owner: suite_discovery walks the filesystem while git reads its index. This is the Ⓑ19 shape recurring at a different pair of readers — that incident was git-vs-SKIP_TOP and was closed by deleting the roster, which did not reach this pair. Not a defect in either reader. A fact a reader weighing the roster needs, because a suite declared in the makefile and absent from git runs locally and does not exist for anyone cloning.}
}

@misc{gate-G269-G268-was-misframed-the-roster-already-has-one-owner,
  section  = {retract},
  from     = {gate-G268-the-suite-roster-and-git-hold-different-populations},
  rests-on = {gate-G262-three-wrong-cuts-before-reading-the-tree-and-the-ruling-does-not-yet-reach-its-case},
  claim    = {A structural resemblance to a defect already recorded is not evidence the defect is present, so asserting a two-owner condition from a status listing without opening the reader repeats the very error the reader's own docstring records having fixed.},
  check    = {unwitnessed},
  note     = {kind=unwitnessed by=substrate. The witness: suite_discovery.roots calls _ignored which shells git check-ignore as the sole authority, and both docstrings name the doubled-roster incident Ⓑ19 closed. Operator ruled the untracked-suite observation a staging-discipline gap rather than a roster defect. toolmodes --find untracked reports 3 hits none of which answers which declared suites are untracked. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): RETRACTION of my own gate-G268. I filed the suite roster and git as two enumerations with no common owner. Reading suite_discovery.roots and _ignored refutes it: Ⓑ19 already made git check-ignore the SOLE authority for exclusion and both docstrings record that repair, naming the doubled-roster incident it closed. There is no two-owner condition at the directory level and I asserted one from a git status listing without opening the reader. What I actually observed is narrower and real — check-ignore answers IS THIS IGNORED, which is not IS THIS TRACKED, so an untracked-but-unignored suite is walked and declared. Operator ruled that is a staging-discipline gap and not the roster's problem: the walker is right, peers copy from the working tree rather than git HEAD, and a walker skipping untracked files would hide every suite written in a session from its own runner. This arc's six modules are all staged. And toolmodes --find untracked reports no mode owning which declared suites are untracked, so that question has no reader today.}
}

@misc{gate-G270-the-gate-side-population-was-one-site-not-eighteen,
