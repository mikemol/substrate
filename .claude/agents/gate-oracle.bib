@misc{gate-F13-cycle-guard-bounds-forks-not-cpu,
  section  = {finding},
  claim    = {The ppid cycle guard bounds RE-ENTRY, not fan-out width, so a single legitimate pass of a roster-invoking suite still pins the box -- and its workers orphan to init when the launcher is killed.},
  check    = {standing},
  note     = {kind=finding by=selftest-standardize-r2. Witness -- worklist_gate --selftest gave exactly 1 run_selftests process (guard correct) while fanning to 40 workers and load 6 to 29 in 90s. Killing the launcher left all 40 reparented and alive. ⚑ pgrep -c -f selftest read 46 because the harness bash wrapper quotes the query, so the count matched its own instrument. The honest pattern was py --selftest. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): I LAUNCHED worklist_gate --selftest AFTER reading meta-F4, and it is a THIRD failure mode neither the amendment nor the guard covers. The cycle guard WORKED PERFECTLY -- pgrep showed exactly 1 run_selftests process, zero fan-out, no second generation. It bounds RE-ENTRY. It does not bound the COST OF ONE LEGITIMATE PASS: worklist_gate's suite runs the full 98-suite roster, which fanned to 40 concurrent workers and drove load 6 -> 29 in ninety seconds. ⚑ AND THE ORPHANING REPRODUCED EXACTLY: killing the launcher left all 40 leaf workers reparented to init, alive and burning CPU, so the pkill that 'worked' (exit 1 = no launcher left) measured nothing. Only pkill -9 -f 'py --selftest' cleared them. ⚑⚑ MY OWN COUNT WAS ALSO AN INSTRUMENT ARTIFACT -- pgrep -c -f selftest read 46, but the harness's bash wrapper QUOTES the query string, so my measurement matched itself. The honest count needed a pattern the wrapper cannot contain ('py --selftest' = 40). Same census-keyed-on-one-spelling shape, in the instrument used to assess an incident. THE RULE meta-F4 SHOULD CARRY: a roster-invoking suite is not made safe by the cycle guard, because the hazard is FAN-OUT WIDTH, not recursion depth. Read the declaration -- worklist_gate is the one tool DECLARED runs_roster=True, which says exactly this from source.}
}

@misc{gate-F14-mass-declaring-suites-is-unfalsifiable,
  section  = {finding},
  claim    = {A bare Selftest() on an already-discovered suite is unfalsifiable, so declaring the 93 undeclared tools would turn an honest UNDECLARED boundary into a green census that assessed nothing.},
  check    = {standing},
  note     = {kind=finding by=selftest-standardize-r2. Witness -- contract() bites only on none-without-why or a key/requires/tenant/runs_roster on a non-suite, none reachable for a bare suite record, and selftest_rows then tests only membership, true by construction for a discovered file. The two edge states are already complete: toolmodes --find selftest-demo-failure gives sppf_db alone, and the only other roster-invoker candidate, gate_status.py:345, is a temp-file fixture string testing the gates() parser. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): MASS-DECLARING THE 93 WOULD MANUFACTURE A FALSE GREEN, and the reason is readable from climode's own contract. Every one of the 98 is ALREADY a discovered suite -- discovery's predicate is an entry point PLUS evidence it does selftest work, so 'python <tool> --selftest' dispatches for all of them. A bare Selftest() is state='suite' with no other field, and contract() bites ONLY on none-without-why, a key/requires/tenant/runs_roster on a non-suite. None of those can be false for a bare suite record. selftest_rows then tests only 'tool in disc', TRUE BY CONSTRUCTION for a discovered file. So 93 bare declarations = 93 rows that CANNOT FAIL, converting an honest UNDECLARED boundary into a green census that assessed nothing -- census-green-is-a-fact-about-the-census, manufactured on purpose. ⚑ THE BRIEF'S PREMISE WAS THAT CLASSIFICATION WAS THE HARD PART. It is not: discovery already settles suite-vs-nothing for all 98, and the two edge states are settled and CORRECT -- sppf_db is the only suite-level fixture (toolmodes --find selftest-demo-failure = 1 dispatcher), and worklist_gate is the only real roster-invoker. gate_status.py:345 LOOKS like a second one and is a temp-file FIXTURE STRING testing the gates() parser -- the gate-F9 shape again, caught by reading not matching. The declared seed of 5 is already complete for everything a declaration can check. What is unread is the PRAGMA layer, which is why --pragmas was built instead of 93 rows.}
}

