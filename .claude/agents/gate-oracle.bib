}

@misc{gate-G272-md-lint-drained-and-my-fence-case-asserted-a-rule-the-origin-never-had,
  section  = {finding},
  from     = {gate-G271-eleven-of-28-drained-was-a-category-error},
  rests-on = {gate-G263-the-fixture-was-not-modelling-the-crash-it-was-named-for},
  claim    = {A sensitivity arm can assert a property the subject never claimed, so a failing arm is evidence about the case before it is evidence about the code.},
  check    = {selftest:python3,-m,substrate.md_lint_selftest},
  note     = {kind=selftest by=substrate. The witness: md_lint_selftest 21 of 21 after correcting a fence case that demanded MD041 be fence-exempt, which neither this module nor mdstruct.lint_shape ever claimed. The suite includes a differential over the live catalog reuse-index asserting every reported rule is one of the four. An unannotated sort key leaked Any in the same position it did in borrowed_root_census. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): First unit of the ruled mdstruct drain: substrate/md_lint.py replaces lint_shape, taking LINES rather than a path — which is the seam that made the origin untestable, since every case needed a real document and none could state a rule precisely. 21 of 21 including a differential against the live catalog reuse-index. Two findings from building it. My fence case asserted that a fenced block yields NOTHING and the module reported MD041 — my case was wrong and the module right: MD041 reads the body's first non-blank line as written, because a document opening with a code fence genuinely does not open with a heading, and the origin behaves the same. A sensitivity arm can assert a rule the subject never claimed. And the unannotated sort lambda leaked Any in exactly the position it did in borrowed_root_census earlier this arc, so the same defect refused the same shape twice.}
}

@misc{gate-G273-the-untestable-seam-is-why-two-termination-rules-survived,
  section  = {finding},
  from     = {gate-G272-md-lint-drained-and-my-fence-case-asserted-a-rule-the-origin-never-had},
  claim    = {A rule that can only be exercised against a real artifact is not merely untested but unfalsifiable at the unit level, so a wrong one survives until a reader runs past it by hand — which is how the same function carried two opposite termination errors in succession.},
  check    = {selftest:python3,-m,substrate.md_fixpoint_selftest},
  note     = {kind=selftest by=substrate. The witness: md_fixpoint_selftest 16 of 16 with arms for both historical errors, a round cap reading 1340 899 561 as divergent and strict decrease reading a plateau as a cycle. The replacement takes a normalizer so a case supplies the sequence, where the origin took a path and shelled to pandoc. The round guard now reports NOT a verdict about convergence rather than a bare false. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): substrate/md_fixpoint.py replaces mdstruct.fixpoint, taking a NORMALIZER rather than a path — 16 of 16. The origin's docstring records two termination rules that each produced a confident false verdict: a round cap called 1340 899 561 divergent when a decreasing delta is the signature of convergence, and strict decrease called a plateau a cycle when catalog plan.md descends in plateaus over twelve rounds to zero. Both are now suite arms with fixtures a case chooses. THE SEAM IS THE EXPLANATION. The origin opened the file and shelled to pandoc, so a plateau could only be exercised by finding a real document that plateaus — the rules were not merely wrong, they were unfalsifiable at the unit level, and each was corrected only after someone ran past the guard by hand. And the guard now says NOT a verdict about convergence in its own words, so I stopped looking is distinguishable from it does not converge, which is the distinction the cap defect collapsed.}
}

@misc{gate-G274-two-of-my-undrained-list-were-already-drained,
  section  = {finding},
