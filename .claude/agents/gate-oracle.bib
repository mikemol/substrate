@misc{gate-G180-a-named-population-makes-the-effect-predictable-rather-than-observed,
  section  = {finding},
  claim    = {paying from a named sole-blocked set makes the intake delta predicted rather than observed, which is different evidence from a run of matching numbers even when the figures agree},
  check    = {selftest:python3,-m,substrate.bib_edit_selftest},
  note     = {kind=finding by=substrate-session. Six more suites headered from the named set — bib_entry, bib_edit, bib_cli, bib_handlers, bib_write_handlers and bib_modes selftests. Intake 569 to 575, sole-blocked 101 to 95, no-header 904 to 898, both readers agreeing exactly for a second consecutive batch. THE PROPERTY IS THAT THE EFFECT IS PREDICTED RATHER THAN OBSERVED. Before --names I paid from the header-lacking set and read the manifest afterward to learn what happened, producing six one-for-one batches by luck of substrate's composition and one zero-effect batch in tests. Now the batch is drawn from files whose payment RELEASES a module by construction, so the delta is known before the edit and the manifest confirms rather than informs. A confirming measurement and an informing one are not the same evidence even when they print the same number. THE SUITES ARE THE RIGHT BATCH FOR A SECOND REASON — each guards a module whose header was already paid, so the pair COMPLETES rather than accumulating a new half-done unit, and gate-G179 measured that earlier batches created this population by touching one file of each pair. ⚑ VERIFIED THE TWO SUITES GUARDING THE FILING PATH SPECIFICALLY — bib_write_handlers 29 of 29 and bib_edit 33 of 33 — rather than a random sample, since every finding this session is written through those handlers and a break there would be silent until the next add refused. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Six more suites headered from the named sole-blocked set — bib_entry, bib_edit, bib_cli, bib_handlers, bib_write_handlers and bib_modes selftests. Intake 569 to 575, sole-blocked 101 to 95, no-header 904 to 898. BOTH READERS AGREE EXACTLY, SECOND CONSECUTIVE BATCH. THE PROPERTY IS THAT THE EFFECT IS NOW PREDICTED RATHER THAN OBSERVED, and that is a different state from a run of matching numbers. Before --names I paid from the header-lacking set and read the manifest afterward to learn what happened, which produced six one-for-one batches by luck of substrate's composition and one zero-effect batch in tests. Now the batch is drawn from the set of files whose payment RELEASES a module by construction, so the delta is known before the edit and the manifest confirms rather than informs. A CONFIRMING MEASUREMENT AND AN INFORMING ONE ARE NOT THE SAME EVIDENCE even when they print the same number. THE SUITES ARE THE RIGHT BATCH FOR A SECOND REASON. Each guards a module whose header I already paid, so the pair completes rather than accumulating a new half-done unit, and gate-G179 measured that my earlier batches created this population by touching one file of each pair. Paying suites retires that self-inflicted half rather than extending it. ⚑ AND I VERIFIED THE TWO SUITES THAT GUARD THE FILING PATH SPECIFICALLY — bib_write_handlers 29 of 29 and bib_edit 33 of 33 — rather than a random sample, because every finding this session is written through those handlers and a break there would be silent until the next --add refused.}
}

@misc{gate-G181-the-reader-everything-is-measured-against-now-has-cases,
  section  = {finding},
  claim    = {the intake reader has cases at last, and the gate refusing a literal turned an arithmetic assertion into a relational one that cannot expire},
  check    = {selftest:python3,-m,substrate.intake_manifest_selftest},
  note     = {kind=finding by=substrate-session. gate-G178 found intake_manifest had no selftest, by trying to run one, and I extended it twice more with byte-comparison as the only protection — which works once and cannot be repeated by anyone else. THE SUITE IS WRITTEN, 20 of 20 on first run, over the pure half. manifest shells out to two readers and is not casable, but blockers, ready, by_blocker, by_tree, sole_blocked and all three renderers take data and return data. THE FIXTURE IS EVERY COMBINATION RATHER THAN A SAMPLE — three independent booleans give eight modules, and the one that matters is the module blocked by two things, appearing in two TOTALs and no SOLE, exactly what an overlapping count cannot express. AND THE GATE REFUSED MY FIRST CUT FOR A LITERAL, WHICH IMPROVED THE CASE — PLR2004 fired on an assertion that a blocker's total equals four, a fact about a population the case itself builds, so the two can drift and the literal is the half that stops being true. Rewritten to COUNT THE FIXTURE and assert a strict inequality, pinning the RELATION that sole is strictly smaller than total rather than an arithmetic that held at fourfold on the fixture and ninefold on the corpus. A reach floor stated as a number expires when the reach changes, and the gate caught it before it shipped. ⚑ THE SUITE LANDS READY ON ARRIVAL — intake 575 to 576, total 1491 to 1492, because the header was written at creation. A new module arriving conforming adds to the corpus without adding to the debt, the opposite of what six earlier batches did by touching one file of each pair. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): gate-G178 found intake_manifest had no selftest, by trying to run one, and I extended it twice more across two ticks with byte-comparison as the only protection. That works once and cannot be repeated by anyone else. THE SUITE IS WRITTEN — 20 of 20 on first run, over the pure half of the module. manifest shells out to two readers and is not casable, but blockers, ready, by_blocker, by_tree, sole_blocked and all three renderers take data and return data. THE FIXTURE IS EVERY COMBINATION RATHER THAN A SAMPLE — three independent booleans give eight modules, and enumerating them is cheaper than arguing about which are interesting. The one that matters is the module blocked by two things, which appears in two TOTALs and no SOLE and is exactly what an overlapping count cannot express. AND THE GATE REFUSED MY FIRST CUT FOR A LITERAL, WHICH IMPROVED THE CASE. PLR2004 fired on an assertion that a blocker's total equals four — a fact about a population the case itself builds, so the two can drift and the literal is the half that stops being true. Rewritten to COUNT THE FIXTURE and assert a strict inequality, so the case pins the RELATION that sole is strictly smaller than total rather than an arithmetic that held at fourfold here and ninefold on the real corpus. A reach floor stated as a number expires when the reach changes, and the gate caught it before it shipped. ⚑ THE SUITE LANDS READY ON ARRIVAL — intake 575 to 576, total 1491 to 1492, because the licence header was written at creation. A new module that arrives conforming adds to the corpus without adding to the debt, which is the opposite of what six earlier batches did by touching one file of each pair.}
}

@misc{gate-F60-frontier-population-omits-two-trees,
  section  = {finding},
  claim    = {promote_frontier's four-tree population makes every module under tests/ and catalog/ read not-promotable by absence rather than by measurement, and intake_manifest inherits that as a blocker verdict},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, all 16 sole-blocked not-promotable modules live in tests/ and catalog/library/. ruff and mypy both exit 0 on five of them checked directly, while promote_frontier lists none of them. _TREES is the boundary. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): promote_frontier._TREES walks scripts/jea/scratch/substrate only, so every module under tests/ and catalog/ is absent from promotable_set() and intake_manifest scores it not-promotable by ABSENCE rather than by measurement. All 16 sole-blocked not-promotable modules live in those two trees, and ruff+mypy both exit 0 on them. Fifth spelling of the boundary-as-subject defect this file's own comment block records four times, sitting directly above the constant that carries it. Unwitnessed because no predicate distinguishes a module the frontier measured dirty from one it never walked.}
}

@misc{gate-F61-census-sync-verdicts-were-never-fetched,
  section  = {finding},
  claim    = {every census-sync gate's verdict was reachable in seconds and no reader was fetching it, so a genuinely refusing gate sat inside commit_refusal's UNMEASURABLE block unreported},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured with substrate/sync_verdict.py over the hook roster, 1 DRIFTED and 5 FRESH and 5 UNREACHED across 11 sync gates. The drifted one is selftest_mk --check reporting Selftest.mk STALE, reproduced directly. toolmodes --check measured at about 3s, so the bounded cost that justifies asking is measured rather than assumed. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): commit_refusal reports every census-sync gate UNMEASURABLE with the reason that such a gate answers with its own exit code, which names the answer while declining to fetch it, and no other reader was collecting it. Asking all 11 sync gates directly (substrate/sync_verdict.py) found 1 DRIFTED, 5 FRESH, 5 UNREACHED-because-they-write. The DRIFTED one is selftest roster current, reporting Selftest.mk STALE, so the tree's real refusing count was 10 rather than the 9 commit_refusal shows. Unwitnessed because the polarity depends on whether a paydown has landed, which is mutable state.}
}

@misc{gate-F62-a-required-generated-file-was-never-tracked,
  section  = {finding},
  claim    = {a generated file a blocking gate requires fresh was never tracked, so the gate cannot pass on any checkout and each paydown is discarded},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, git log on Selftest.mk returns nothing and git check-ignore exits 1, so it is untracked and not ignored while selftest_mk.py --check refuses without it. Regenerating moved sync_verdict from 1 DRIFTED to 0. Carries a correction, the build/lib rows in the stale diff were declared-but-not-discovered from an old on-disk copy rather than a live build/ population defect. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Selftest.mk is generated by substrate/selftest_mk.py, required fresh by the blocking gate selftest roster current, and has never been tracked by git per git log on that path. So the gate reads STALE or absent on every checkout and the paydown does not persist. Also correcting my own reading of its diff, the build/lib entries were have-minus-want from a stale on-disk copy being retired, NOT a live build/ population defect, since suite_discovery no longer walks build/. Reading a diff direction backwards turned a paid-down defect into a live one.}
}

@misc{gate-F63-the-sync-class-is-not-uniformly-bounded,
  section  = {finding},
  claim    = {bounded-ness is a property of an individual census-sync gate and not of the class, so a cost generalised from one member understated the whole by more than double},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured with time, substrate.sync_verdict takes about 42s in aggregate while law_motif_apex --check alone takes about 32s with sys time dominating, against the roughly 3s I had generalised from toolmodes --check. The repair is a per-gate budget whose overrun reports UNREACHED rather than a decision to fold or not fold. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): I generalised a bounded cost from one member. toolmodes --check measured about 3s and I carried that to the whole census-sync class as the argument for fetching their verdicts. Measured over all of them with time on substrate.sync_verdict, the aggregate is about 42s, and law_motif_apex --check alone is about 32s of it with sys time dominating because it walks the Agda tree. The remaining ten total about ten seconds. So bounded-ness is a property of individual gates rather than of the class, and a reader cannot know which member is cheap without asking. Folding these unconditionally into commit_refusal would attack the property that reader exists for, which is that a bounded reader is one people actually consult before committing.}
}

@misc{gate-F64-a-mapping-written-as-a-local-is-unassertable,
  section  = {finding},
  claim    = {a decision rule written as a function local is unreachable from any case, so the arm that most needs to exist is the one that cannot be written},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, mypy refused the arm with module has no attribute SYNC_STATE because I had written the sync-state mapping inside fold_sync. Hoisting it to module scope made it assertable and the suite went to 33/33. The fold itself moved commit_refusal --sync from 29 UNMEASURABLE to 24 with refusals unchanged at 9, while the default stays 29 at about 17s so the cost is opt-in. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The census-sync fold is now wired into commit_refusal behind an opt-in --sync flag, which moved UNMEASURABLE from 29 to 24 with refusals unchanged at 9 while the default run stays at 29 and about 17s. The durable finding is how the gate caught the test. I wrote the DRIFTED-to-OVER mapping as a local dict inside fold_sync, then wrote an arm asserting it, and mypy refused with module has no attribute SYNC_STATE. A mapping written as a function local is unreachable from any case, so the arm that matters most, that a drifted gate must become a refusal, could only have been checked by running the real survey, which this suite already records being killed at 143 for. Hoisting it to module scope is what made the rule assertable.}
}

@misc{gate-F65-apex-check-pays-for-a-counter-it-never-reads,
  section  = {finding},
  claim    = {a blocking gate spends three quarters of its class's cost concatenating the whole Agda corpus to build a counter its own check branch never reads},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured with time, law_motif_apex --check is about 30s of which sys is about 22s, consistent with quadratic string concatenation at line 150. corpus_text feeds only tok_count which feeds only the convergence line of the bare report, and the --check branch reads neither. Repair is a list plus a lazy join, verdict unchanged, and it is blocked by about ninety ruff findings under the all-or-nothing per-file gate. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): law_motif_apex --check costs about 30s with sys time at about 22s, three quarters of the whole census-sync class measured in gate-F63. Read the binding. The module body runs at import with no main, and the tree walk at line 145 accumulates every stripped agda source into one corpus_text string by repeated concatenation, which is quadratic. That string exists only to build tok_count at line 161, and tok_count feeds only the convergence line of the bare report. The --check branch at line 187 never reads it. So the blocking gate pays to concatenate the entire Agda corpus in order to compute a counter it does not use. The repair is to accumulate into a list and join lazily, changing no verdict, and it is BLOCKED because the file carries about ninety ruff findings behind the all-or-nothing per-file gate. Sixth instance in this arc of a correct one-line repair behind that gate after bibstruct --add and the mode polarity probe and the climode consumers and the shared_cache endpoint and the spelling-pair roster.}
}

@misc{gate-F66-the-origin-cannot-be-loaded-by-a-packaged-consumer,
  section  = {finding},
  claim    = {a drain's differential cannot run because the origin imports a sibling by bare name, so the module it replaces is unloadable from any packaged consumer},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, loading scripts/law_motif_apex.py by path raises ModuleNotFoundError on _agdatext because the origin reaches a scripts sibling by bare name and this tree forbids sys.path inserts. substrate/law_telescope.py is the drained parser at 22 cases and its differential arms report SKIPPED in their label rather than counting a green, since a skipped differential and a passing one are indistinguishable by arm count. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The first unit of the law_motif_apex drain is out as substrate/law_telescope.py with 22 cases, but its DIFFERENTIAL arms cannot run. The origin does import _agdatext, a scripts sibling by BARE name, which resolves only under a sys.path insert that this tree forbids. So the origin is unreachable from any properly packaged consumer and no differential against it can run until that import is repointed. The suite reports the skip in its label rather than counting a silent green, because a skipped differential and a passing one are byte-identical to anyone counting arms. This is the same bare-versus-dotted defect recorded for the fourteen climode consumers, arriving in a drain rather than in a promotion.}
}

@misc{gate-F67-the-one-import-was-a-two-level-packaging-arc,
  section  = {finding},
  claim    = {a symbol named for one import was a two-level packaging arc, because the module it would promote is itself a delegator to the tree's most-shared unpackaged module},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, module_importers reports scripts/_agdatext at 21 bare sites and 0 dotted, and scratch/agda_lex at 91 bare sites and 0 dotted across 63 files. attr_reads shows strip is reached by 10 of 18 consumers and is the only name law_motif_apex uses, and strip is a one-line delegator to agda_lex.mask_comments. Both modules are gate-dirty, so the chain from the 30s apex repair runs through four blockers rather than one. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): I sized repoint-agdatext as one import and it is not. module_importers reports 21 bare sites and 0 dotted for scripts/_agdatext across 21 files, four of them blocking gates. attr_reads shows strip is the most-shared name at 10 of 18 consumers and is the only name law_motif_apex reads, so it looked like a small promotion. But strip is a one-line delegator to scratch/agda_lex.mask_comments, described in its own comment as the one authority, and module_importers reports agda_lex at 91 bare sites and 0 dotted across 63 files including four pre-commit gates and eight tests. So the chain from a 30s gate repair runs through an unwritable file, then a differential that cannot load, then a module needing promotion, then the tree's most-shared unpackaged module. Both intermediate modules are also gate-dirty. The symbol named the top of that chain and priced it as the bottom.}
}

@misc{gate-F68-a-frame-mixing-case-asserted-cwd-dependence,
  section  = {finding},
  claim    = {a drained pure function inherits its origin's cwd dependence invisibly, because the case asserting the reconciliation looks like faithfulness rather than like a defect},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, substrate/agda_naming.py reached 22 of 23 with the failing arm being one I wrote, asserting that an absolute path against a relative root resolves. It cannot without the cwd, which the function's docstring says it avoids, and the origin uses abspath there. Case and docstring both corrected, suite 23/23 with differential arms passing over five real tree paths. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The second unit of the agda_lex promotion is out as substrate/agda_naming.py with 23 cases, differential arms included and passing over five real tree paths. One arm I wrote FAILED and it was the case rather than the code. I asserted that an absolute path against a RELATIVE root reconciles to a dotted name, which cannot hold without consulting the cwd, and the cwd is the exact dependence the function's own docstring says it avoids. The origin reaches for abspath at that point so it answers differently depending on where it was invoked. I corrected the case to assert an absolute pair and corrected the docstring, which had claimed the reconciliation. A mixed-frame pair now falls through un-rebased, which is visibly wrong at the call site rather than quietly cwd-dependent. Filed because a drained copy inheriting the origin's cwd dependence would have been indistinguishable from a faithful drain.}
}

@misc{gate-F69-a-runtime-membership-test-does-not-narrow-a-type,
  section  = {finding},
  claim    = {a roster checked at runtime cannot prove what a typed field admits, so the checker refuses the design rather than the spelling and the fix is to make the classifier return the type},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured twice while draining substrate/agda_statements.py. mypy refused a bare string kind tested against a tuple of names at the yield site, and refused an origin Protocol declaring its segmenter as returning object which forced an isinstance branch and a mis-targeted ignore. Returning the Literal directly and declaring an iterable of tuple rows removed both. Suite 25/25 with a live differential over five real tree files, and the sibling units hold at 24/24 and 23/23. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Third unit of the agda_lex promotion is out as substrate/agda_statements.py with 25 cases including a live differential over five real tree files, so segmentation is verified against the authority four gates read rather than against my fixtures. Two typing refusals are the durable part. First, I wrote the statement kind as a bare string checked against a roster tuple at the yield site, and mypy refused because a runtime membership test does not narrow a type, so it could not prove the value reaching the Stmt field was one the field admits. Making the classifier return the Literal type directly is both simpler and checkable. Second, I declared the origin Protocol's statements method as returning object, which forced an isinstance dance and an ignore comment that did not even cover the right code. Declaring it as an iterable of tuple-shaped rows removed all of it. In both cases the checker was refusing a design rather than a spelling.}
}

@misc{gate-F70-a-masked-comment-does-not-continue-a-header,
  section  = {finding},
  claim    = {a fixture built from a docstring's own example tested a shape the pipeline never receives, because the example describes the source while every reader sees masked text},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, a deep-header fixture made of nine comment lines failed the no-capability-bound arm while every differential arm passed. Comments mask to whitespace before the header walk, so a masked prose line is blank and does not continue a header, and header depth is therefore counted in parameter lines. Rebuilt from parameter groups and the suite reads 30/30 with a differential over five real tree files on both span and groups. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Fourth unit of the agda_lex promotion is out as substrate/agda_telescope.py with 30 cases including a live differential over five real tree files on both span and groups. One arm I wrote FAILED and it taught a property worth pinning. I built a deep-header fixture from nine comment lines, copying the origin's own docstring example which shows prose inside a header. That is true of the SOURCE and false of what every reader here sees, because comments are masked to whitespace first and a masked prose line is BLANK, and a blank line does not continue a header. So the depth of a header is measured in parameter lines rather than in source lines, and a fixture built from the documented example was testing a shape the pipeline never receives. The differential arms all passed while this one failed, which is the discriminator that made it obvious the case was wrong rather than the code.}
}

@misc{gate-F71-a-docstring-example-is-approximate-where-a-predicate-is-exact,
  section  = {finding},
  claim    = {generalising from a failed docstring example produces a second wrong claim rather than a correction, because the example states intent while the predicate states behaviour},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured twice on substrate/agda_tokens.py. I asserted a floor-bracket mixfix is delimiter-sectioned because the origin's docstring lists it, and the case failed. I generalised to unicode brackets are never selected and that failed too, because an angle form containing a comma is selected on the comma. The rule is a hole plus a character from BODY_DELIMS, which is ASCII only. Differential arms passed in both rounds so the drained copy was faithful throughout, and the suite now reads 30/30 over five real tree files. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Fifth unit of the agda_lex promotion is out as substrate/agda_tokens.py with 30 cases and a live differential over five real tree files. Two of my cases failed in sequence and the second correction was also wrong, which is the finding. The origin's docstring offers floor and angle brackets as examples of delimiter-sectioned mixfix names, so I asserted the floor bracket IS selected and it failed. I then generalised to unicode brackets are not selected and that failed too, because the angle form contains a COMMA which is in BODY_DELIMS and is selected for that reason rather than for its brackets. The predicate is a hole plus any character the splitter splits on, and BODY_DELIMS is ASCII only. Every differential arm passed throughout, so my copy was faithful in both rounds and only the cases were wrong. A docstring example describes intent while the predicate describes behaviour, and generalising from a failed example produced a second wrong claim rather than a correction.}
}

@misc{gate-F72-five-drained-units-and-no-consumer-moved,
  section  = {finding},
  claim    = {a promotion arc can produce five verified units and reduce nothing, because building a replacement and repointing a consumer are different acts and only the first was happening},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, module_importers on substrate.agda_mask returns five sites all internal to the drain while scratch/agda_lex holds at 91 bare and zero dotted. The highest-value consumer is a blocking gate that reimplements span_end privately, reaching two underscore names, one line below importing the module that exports it publicly, with ruff flagging SLF001 three times. span_end is now homed in substrate/agda_statements.py with three differential arms against the origin, suite 31/31, so the repoint shrinks to a call once that gate is drained. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Measured before continuing the promotion. module_importers on substrate.agda_mask reports five import sites and ALL FIVE are the drain's own siblings, while scratch/agda_lex is still at 91 bare sites and zero dotted. So five units are built, differentially verified and counted READY by intake, and not one origin consumer has moved. The arc has been producing clean replacements that nothing outside the arc uses, and a sixth unit would widen an unconsumed surface rather than reduce anything. Reading the highest-value consumer inverted the framing again. scripts/check_ban_ratchet.py is a BLOCKING gate that defines a private _span_end reaching agda_lex._depth_after and agda_lex._continues, one line below importing the module that already exports span_end publicly, and its own comment says span via the ONE authority not re-derived while re-deriving it. ruff flags the reach three times as SLF001. The gate carries 23 findings so the repoint needs a drain first, and span_end is now homed in substrate/agda_statements.py with three differential arms so that repoint becomes a one-line call.}
}

@misc{gate-F73-the-drained-census-is-byte-identical-to-the-live-gate,
  section  = {finding},
  claim    = {a gate's census can be drained into the package and proved safe by set equality against the live gate over the whole tree, which a count could not establish},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, substrate/ban_census.py produces a key set identical to scripts/check_ban_ratchet.py's census over every agda source, suite 13/13. The differential asserts set equality rather than size because two equal-sized sets with one key swapped would simultaneously refuse a commit for a phantom offender and un-bank a real one, and it carries a positive control that the gate's census is non-empty. The drained span comes from substrate.agda_statements.span_end, replacing a local copy that reached two underscore-prefixed names which ruff flagged as SLF001 three times. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): First consumer-side unit of the agda_lex promotion, answering gate-F72 where five drained units had zero external consumers. substrate/ban_census.py lifts the census half of the blocking ban gate, and its span now comes from substrate.agda_statements.span_end instead of a local reimplementation that reached agda_lex._depth_after and agda_lex._continues, which ruff flagged three times as SLF001. The gate's own comment claimed span via the ONE authority not re-derived while re-deriving it. The differential is stricter than the others in this drain because the key set is a contract with a committed baseline. It compares SET EQUALITY against the live gate's census over the whole Agda tree rather than a sample, reports invented and dropped keys as separate directions since they have opposite consequences, and carries a positive control asserting the gate's census is non-empty so agreement is not vacuous. Suite 13/13 with identical key sets. What stays behind is the ratchet machinery and the tree walk, both in unpackaged scripts modules, which is the same line drawn for agda_root_from and agda_files.}
}

@misc{gate-F74-the-deferral-was-half-right-for-the-wrong-reason,
  section  = {finding},
  claim    = {a function deferred as the filesystem half was portable all along, because taking a root as a parameter is a different shape from walking upward to guess one},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, substrate/agda_walk.py enumerates the same population as the live authority at 12 of 12 with a positive control, and its build-exclusion arm creates a real source under a real build directory because the live tree holds none and an arm over it would pass against a walk with no filter. Two queries re-sized the surrounding swap, module_importers on ratchet shows two of thirty-one sites already dotted so the packaged route exists, and module_importers on agda_files returned zero because it is a function rather than a module, which attr_reads answered at 23 reads across 12 files. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): I deferred agda_files twice as the filesystem half, grouping it with agda_root_from, and reading the binding showed those are different shapes. The root-finder walks UPWARD guessing a layout, which is what makes it the application's, while agda_files takes root as a PARAMETER and assumes nothing, so it is exactly as portable as the pure functions beside it. Promoted as substrate/agda_walk.py, 12 of 12, same population as the live authority with a positive control. Two other measurements re-sized the swap. module_importers on ratchet reports 31 sites of which TWO ARE ALREADY DOTTED, so the packaged route exists and the gate's sys.path insert is unmigrated rather than required. And module_importers on agda_files returned zero, which is a fact about the query since agda_files is a function not a module, answered correctly by attr_reads at 23 reads across 12 files including two blocking gates. The _build arm is cased against a real file created under a real build directory, because the live tree holds no agda source there and an arm over the live tree would pass against a walk with no filter at all.}
}

@misc{gate-F75-the-swap-landed-and-its-own-differential-weakened,
  section  = {finding},
  claim    = {a drain's differential becomes a tautology the moment the swap lands, because the origin it differences against now calls the replacement},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, the ban gate's output is byte-identical across the swap by diff of captured before and after runs, the file is now clean on both checkers where it carried 23 ruff findings and 4 mypy codes, and module_importers on agda_lex fell from 91 bare sites in 63 files to 90 in 62. ban_census_selftest still reads 13 of 13 but its differential arm now compares the package against a gate that calls the package, so agreement is by construction. The check did its work before the swap and a future census change has no independent verification unless one is rebuilt against the committed baseline. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The ban gate is swapped and the arc reduced for the first time. scripts/check_ban_ratchet.py now calls substrate.ban_census and substrate.agda_walk with a dotted scripts.ratchet import, its output is BYTE-IDENTICAL across the swap by diff of before and after captures, and the file went from 23 ruff findings and 4 mypy codes to zero on both checkers. module_importers on agda_lex fell from 91 bare sites in 63 files to 90 in 62, which is the number that had not moved for eight ticks. The per-file gate accepted a whole-file rewrite of a file it refuses to edit, which is the drain thesis at its own last step. AND THE VERIFICATION WEAKENED AS A CONSEQUENCE. ban_census_selftest differences against the live gate's census, but that gate now CALLS ban_census, so the two agree by construction rather than by measurement and the arm can no longer catch a divergence. It still reads 13 of 13. The honest reading is that the differential did its job BEFORE the swap and is now a tautology, so a future change to the census has no independent check unless one is rebuilt against the baseline file itself.}
}

@misc{gate-F76-a-constants-type-is-an-interface-and-i-changed-it,
  section  = {finding},
  claim    = {a module-level constant's type is a declared interface, so changing str to Path left the gate correct and blinded every reader that censuses it},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, ratchet_census.baseline_path narrows BASELINE with isinstance str and reports a non-string as no baseline, so commit_refusal rendered the ban ratchet as 7411 added of 7411 held while the gate's own output was byte-identical across the swap by diff. Restoring str returned it to 375 added of 7411 held. A second correction rides with it, my regrounded arm asserted containment in the baseline and failed, because the ratchet carries 375 genuinely added keys alongside its pending paydown, so the assertable property is overlap rather than containment. Suite 14 of 14. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Regrounding the ban differential on the committed baseline found a defect I had introduced and one I had misread. FIRST, my swap changed BASELINE from a str to a Path. The gate was unaffected because main stringifies it, and its output stayed byte-identical across the swap by diff. But ratchet_census.baseline_path narrows the attribute with isinstance str and reports a non-string as NO baseline, so commit_refusal read the baseline as EMPTY and rendered 7411 added of 7411 held, every key as a new offender. A module-level constant's TYPE is a declared interface between a gate and the readers that census it, and the narrowing is correct, its own docstring saying a gate declaring a non-path is reported as having none rather than reaching the filesystem with whatever it declared. Restoring str returned the reader to 375 added of 7411 held, the pre-swap figure. SECOND, my new arm asserted the census is CONTAINED in the baseline, reasoning that a paydown-only ratchet must hold everything found today. It is not: this ratchet is simultaneously paying down thousands and carrying 375 genuinely added keys, and reading the headline paydown figure as the whole story hid the second half. The assertable property is OVERLAP rather than containment, because a spelling defect breaks essentially every key while real offenders are a small tail.}
}

@misc{gate-F77-i-sized-a-swap-by-one-modules-reads,
  section  = {finding},
  claim    = {sizing a swap by what a consumer reads off ONE module answers about that module, so a fifth dependency in a sixth import line made a ready symbol blocked},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, attr_reads on agda_lex showed the discharge gate's four names all packaged, and reading the file showed def_index from agda_defs, which attr_reads reports at 10 reads across 6 files with no packaged route in a module of roughly 5900 lines. The ban gate's dependencies happened to sit in the modules I queried, so the method looked sound on an easy case. The pre-swap question is what a file imports, which is a read of the file, rather than what it reads off a subject I chose. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): swap-the-discharge-gate is BLOCKED and my sizing was wrong in a specific way. I measured its dependencies with attr_reads on agda_lex and found four names, all packaged, and concluded the swap was ready. Reading the file shows a FIFTH import on its own line, def_index from agda_defs, which attr_reads confirms at 10 reads across 6 files with no packaged route and which lives in a module of roughly 5900 lines. Asking one module what a consumer needs answers about that module, not about the consumer. The ban gate happened to have all its dependencies in the modules I had queried, so the method looked sound because the case was easy. The correct pre-swap question is what does this file IMPORT, which is a read of the file, not what does it read OFF a given module, which is a query I chose the subject of. Filed rather than ground on, since promoting a 5900-line module is a different arc from swapping a gate.}
}

@misc{gate-F78-the-statement-form-carries-what-the-module-string-cannot,
  section  = {finding},
  claim    = {an import's packaged-ness is a property of the statement form rather than of the module string, so a classifier keyed on dots called the packaged spelling unpackaged},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, substrate/swap_readiness.py returned NOT READY for the gate it was built to bless because from scripts import ratchet records the module as scripts undotted. Carrying the statement form into the classifier fixed it, and the reader now returns READY for the swapped gate and NOT READY naming agda_defs for the discharge gate whose fifth dependency hand-sizing missed. A survey of three further gates puts check_claims nearest, blocked only on ratchet and agda_lex which both have packaged routes. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Built substrate/swap_readiness.py to mechanize the sizing that gate-F77 got wrong by hand, and it caught its own defect on first live use. The reader walks a file's own import statements and classifies each as PACKAGED or UNPACKAGED or EXTERNAL or UNKNOWN, with UNKNOWN blocking as firmly as UNPACKAGED since a dependency nobody classified is not one nobody needs. Run against the gate it was built to bless it returned NOT READY, because from scripts import ratchet records the module as scripts with no dot and my rule keyed on dots alone called the packaged spelling unpackaged. The discriminator is whether the statement NAMES the package, which the form carries and the module string cannot supply, so import X.Y and from X import Y are both qualified while import Y is not. After the fix the swapped gate reads READY and the discharge gate reads NOT READY naming agda_defs, the dependency hand-sizing missed. Surveying three more gates shows check_claims is nearest with only ratchet and agda_lex blocking, both of which have packaged routes.}
}

@misc{gate-F79-the-verified-reader-found-a-one-line-swap,
  section  = {finding},
  claim    = {casing the sizing reader immediately surfaced a one-line swap that every hand method had missed, because a mechanical read of imports ranks a frontier that inspection cannot},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, swap_readiness reads 21 of 21 with both live arms, and surveying four ratchet gates shows check_rederive_ratchet blocked on ratchet alone, which is a re-export facade whose island is already packaged and reachable as from scripts import ratchet. Two further gates block on check_carrier_locality rather than a library, which is gate-to-gate coupling. The suite could not land before the module because each referenced the other and the per-file gate refuses a dangling write, so the hook was closed after both existed. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The readiness reader is cased at 21 of 21 including both live arms, and the import cycle that blocked its selftest hook is closed. The suite could not be written first because the module referenced it and it referenced the module, and the per-file gate refuses a write leaving either dangling, so the module landed without the hook and the hook followed once both existed. The two live arms are the load-bearing ones and a fixture cannot make them, because a fixture is written from the same model as the code and therefore agrees with a wrong model. These two files are what the model was wrong about. Using the verified reader immediately produced a finding no hand method had. check_rederive_ratchet blocks on ratchet ALONE, and ratchet is a pure re-export facade whose whole island already lives in substrate, reachable as from scripts import ratchet, so that gate is a ONE LINE swap. Two others block on check_carrier_locality rather than on a library, which is gate-to-gate coupling and a different repair. suite_gap_report names swap_readiness in a population of 24 uncased modules, which is how the gap was confirmed rather than assumed.}
}

@misc{gate-F80-import-reachability-is-not-editability,
  section  = {finding},
  claim    = {a readiness reader that answers only whether imports are followable produces a READY nobody can act on, because the per-file gate refuses the edit whatever the imports look like},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, swap_readiness ranked check_rederive_ratchet nearest on one blocking import and the edit was refused for 103 findings. The reader now delegates editability to editable.verdict_for, propagates that reader's third outcome so an unmeasured file is not swappable, and says NOT ASKED when the axis is omitted. The swapped gate reads SWAP READY and the one ranked first reads NOT SWAPPABLE with its count carried, suite 21 to 30, and the refused write left the gate byte-identical by diff. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The swap I ranked first was refused, and the refusal exposed a missing conjunct in the reader I had just verified. swap_readiness reported check_rederive_ratchet as blocked on ONE import, which is true and insufficient, because the edit was then refused for carrying 103 findings under a per-file gate with no partial credit. Import-reachability and editability are different questions and a swap needs BOTH, so a one-axis READY is a verdict nobody can act on. The reader now delegates the second axis to editable.verdict_for rather than re-deriving it, carries that reader's own third outcome so a file whose checkers could not run is NOT swappable, and renders NOT ASKED when the axis is omitted rather than letting a partial answer wear a whole verdict's clothes. Both live gates now differ on both axes, the swapped one reading SWAP READY and the one I ranked first reading NOT SWAPPABLE with its finding count carried. Suite 21 to 30. The refused write created no file and the gate's output diffs clean against its pre-attempt capture.}
}

@misc{gate-F81-two-readers-count-findings-under-one-label,
  section  = {finding},
  claim    = {two readers report findings on one file under one label and disagree by more than half, because one counts ruff alone while the other counts ruff plus mypy},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured on check_rederive_ratchet, promote_frontier gives 42 own and editable gives 103, and running the checkers directly gives ruff 42 plus mypy 61. The LEAF ordering promote_frontier publishes therefore understates every drain by its mypy half, which on this file is the larger half. The same survey found six gates all NOT SWAPPABLE on the editability axis at 127 and 190 and 300 and 585 findings, so import packaging was never the binding constraint and the one gate that swapped did so because it happened to be editable. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The first both-axes survey found every gate NOT SWAPPABLE for the SAME reason, and it is not the one the arc was organised around. Six gates measured with swap_readiness come back DIRTY at 127 and 190 and 300 and 585 findings, so the per-file gate refuses the edit whatever the imports look like. Import packaging was never the binding constraint, and the ban gate swapped because it happened to be editable rather than because I found the right dependency order. Resolving a second disagreement was necessary before ranking anything. promote_frontier reports check_rederive_ratchet at 42 own findings and swap_readiness via editable reports 103, both labelled findings on this file. Measured directly, ruff gives 42 and mypy gives 61, so 103 is the sum and promote_frontier counts ruff ALONE. Neither is wrong and both are honest about their own method, but the LEAF ordering that reader publishes understates every drain by its mypy half, and here the mypy half is the LARGER one. Any pick made from that ranking is made on the smaller number.}
}

@misc{gate-F82-a-lookalike-glyph-makes-a-fixture-test-nothing,
  section  = {finding},
  claim    = {a fixture built from a look-alike glyph contains no marker and tests nothing, and its failure presents as a defect in the reader rather than in the case},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, two declared-site arms failed while the whole-tree differential against the live gate passed, because I typed a helmet where the marker is a flag. The repair is a derived fixture rather than a corrected one, spelling the marker from the module's own DECLARED pattern. substrate/rederive_census.py is the first unit of the check_rederive_ratchet drain and reads 15 of 15 with a positive control that the gate's census is non-empty. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): First unit of the check_rederive_ratchet drain, chosen on the operator's ruling to drain one gate fully rather than keep promoting. substrate/rederive_census.py carries the motif patterns, the ordinal key and the contextual walk test, and its whole-tree differential against the live gate passes at 15 of 15 with a positive control. The finding is how two of my own cases failed while that differential passed. I typed a HELMET glyph where the marker is a FLAG, so the fixtures contained no marker at all and the declared-site arms failed. A fixture built from a character I recognised by SHAPE tests nothing, and the failure presented as a defect in the reader rather than in the case, which is the more expensive direction because the reader was correct. The repair is not a corrected glyph but a derived one, the fixture now spells the marker from the module's own DECLARED pattern so a look-alike cannot be introduced again. This also re-confirms that the differential is the discriminator, since it passed throughout and told me the drained census was faithful while my cases were not.}
}

@misc{gate-F83-the-differential-must-difference-the-pair,
  section  = {finding},
  claim    = {a drain's differential that rebuilds its own population compares the origin against the author's reading of its scope rather than against the units a swap will install},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, the census differential first held its own copy of the gate's roster and exclusions, and repointing it at the drained substrate/tool_walk.py makes it difference the pair, passing at 15 of 15 with the walk suite also 15 of 15. tool_walk is a separate module from agda_walk because that enumerates agda under one root while this enumerates py across several. Its exclusions each carry an incident, and jea and el-atlas are absent from the roots rather than excluded because a policy gate bars them from adopting the authorities at all. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Second unit of the check_rederive_ratchet drain. substrate/tool_walk.py enumerates this repo's own python tools, and it is a SEPARATE module from agda_walk rather than a reuse of it, because that one enumerates agda under one root while this enumerates py across several, so reaching for it on the strength of the name would be the shared-name-is-not-shared-authority defect. Every exclusion carries a measured incident, tests holds the broken forms as regression witnesses so censusing them would demand the tests stop testing, and edit-snapshots holds byte copies that once produced two keys for the gate's own file seconds after a guard run. jea and el-atlas are absent from the ROOTS rather than the exclusions, which is substantive, an exclusion says skip this while an absent root says this was never the population. The finding is about the differential rather than the walk. My first cut of the census differential rebuilt the population inline with its own copy of the gate's roster and skip-set, which would have compared the gate against MY reading of its scope rather than against the pair a swap installs, and would have left the walk's exclusions unexercised end to end. Repointing it at tool_walk means the arm differences the PAIR, and it passes at 15 of 15 with the walk suite also at 15 of 15.}
}

@misc{gate-F84-the-heading-defect-is-live-in-my-own-loaded-file,
  section  = {finding},
  claim    = {two readers disagree by one heading on this repo's always-loaded instruction file, and the section they disagree about carries an apostrophe},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, mdstruct --budget reports 9 headings on CLAUDE.md while --headers reports 8, and the absent one is the Observability section whose title contains an apostrophe. A peer's four-line reduction reproduces here at 3 of 4 with the preceding heading absorbing the dropped line, and its one-byte control yields 4 of 4, so the difference between our trees is not environmental. Their live claim about CLAUDE.md does not reproduce because their copy is vendored and differs from mine, which means the earlier disagreement was about two files under one name. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Ran the peer's four-line reduction rather than reporting it, and it REPRODUCES here. The apostrophe file yields 3 of 4 headings with Alpha absorbing the dropped line at 3-6 where its true extent is 3-4, and the one-byte control yields 4 of 4 with Alpha correctly at 3-4. So the difference between our trees is NOT environmental, which is the peer's own stated discriminator. Their live CLAUDE.md claim does not reproduce, they report a span 379-455 and a heading at 409, and my CLAUDE.md is 408 lines with no such headings, so we were reading different files under one name, theirs a vendored copy. The substantive result is worse than the disagreement. On MY CLAUDE.md the two readers disagree, --budget reports 9 headings and --headers reports 8, and the missing one is Observability slash OTLP the store is someone else's, which carries an apostrophe. The defect is live in this repo's always-loaded instruction file, and the swallowed section is one whose absence a --headers reader would never notice. I also guessed a --char mode from the peer's message and it does not exist, which cost a banner dump.}
}

@misc{gate-F85-a-key-differential-cannot-see-a-lost-case,
  section  = {finding},
  claim    = {a differential over output keys proves a drain reproduces its origin on the live population and never that it kept the origin's cases, so reading the origin's suite is a separate act},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, the origin's selftest holds four cases at 4 of 4 and three were already in the drained suite while the fourth, that a marker does not cover the line before it, was absent. The paired differential passed in both directions throughout, because a file with no marker yields identical keys under either coverage rule, so the two implementations agree everywhere the corpus can tell them apart. The recovered arms take the drained suite to 17 of 17, and their line numbers are derived from the fixture after the gate refused hardcoded literals. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Third unit of the check_rederive_ratchet drain, and it found a coverage loss the drain would otherwise have shipped. Reading the origin's own selftest showed four cases, of which three were already in my drained suite and one was NOT, the arm asserting a marker does not cover the line BEFORE it. That is the directional half of the coverage rule, and its absence matters because a marker covering lines above would silence a derivation it never declared while the silencing looked like a paydown. THE POINT IS THAT NO KEY DIFFERENTIAL COULD HAVE CAUGHT IT. My paired differential passes over the whole tree in both directions, because a file carrying no marker gives the same keys under either coverage rule, so the two implementations agree everywhere the corpus can distinguish them and disagree only on inputs the corpus does not contain. A differential proves the drain reproduces the origin on THIS population, never that it kept the origin's cases. Reading the origin's suite is a separate act from differencing its output. The gate also refused my first cut for hardcoded line numbers, and it was right beyond style, since a case that types 3 states a fact about a fixture the case itself builds, so the numbers are now derived from the fixture. Origin suite 4 of 4 and drained suite 17 of 17.}
}

@misc{gate-F86-a-borrowed-check-inherits-cases-only-if-someone-reads-them,
  section  = {finding},
  claim    = {a check that delegates to another tool inherits that tool's cases only if someone reads them, because differencing outputs agrees on every input the corpus happens to contain},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured across two sessions, a peer held a differential and never ran it under a recorded judgement that it was vacuous, while mine ran green and sound over a population that could not express the case. Theirs is repaired by running it and mine is not repairable by running it harder, so the remedy rather than the observation is what transfers. gate-F85 is not refiled as the second witness the peer invited, since it is already filed and paired here and the pairing census names double-filing as a re-key. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A peer sharpened gate-F85 into a distinction neither of our entries held, and it generalises past drains. Their failure was a differential IN HAND AND NEVER RUN, kept idle by a recorded judgement that it was vacuous, so a reason not to look was written once and inherited. Mine was a differential RUN AND GREEN AND SOUND whose population could not express the case, since a file carrying no marker yields identical keys under either coverage rule. Theirs is fixed by running it and mine is not fixable by running it harder, which is why the remedy is the load-bearing part rather than the observation. The generalisation is that a check delegating to another tool inherits that tool's CASES only if someone reads them, because differencing the outputs will agree on every input the corpus happens to contain. That reaches every borrowed check in this mesh and not only a drain. I am NOT refiling gate-F85 as a second witness despite the peer inviting it, because it is already filed and paired in this ledger and the pairing census names double-filing as a re-key rather than a second record. Also taking their correction on --char, they named the wrong owning tool in prose and I invoked a mode I had never seen in a banner, and an error in prose outlives an error in a command since my banner dump self-corrected within a turn while their message persists for the next reader.}
}

@misc{gate-F87-seventy-seven-origin-cases-unread-across-six-drains,
  section  = {finding},
  claim    = {six units were drained from one origin and verified by differential alone, leaving that origin's seventy-seven cases unread, on a sampled loss rate of one in four},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, scratch/agda_lex.py --selftest reports 77 of 77 and six modules were drained from it this session with no case read, while the one origin whose suite I did read carried four cases of which one was absent from the drained copy. Nothing here establishes that cases were lost in the six, and nothing so far establishes that they were not. The differentials stay sound about what they measure, which is output agreement over the live corpus. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Tested the gate-F86 generalisation against my own tree instead of accepting it, and it is live at scale. scratch/agda_lex.py --selftest reports 77 of 77, and I drained SIX units out of that module this session, agda_mask and agda_naming and agda_statements and agda_telescope and agda_tokens and agda_walk, verifying every one by differential against the origin's OUTPUT and reading none of its 77 cases. On the one drain where I did read the origin's suite, check_rederive_ratchet at 4 cases, one was missing from my copy. So the sampled rate of case loss is one in four on the only origin I checked, and the unchecked population is 77. This is not yet a claim that cases were lost in the six, which would need reading them, and it is a claim that nothing so far establishes they were not. The differentials remain sound about what they measure, which is that each drained unit reproduces the origin's output over the live corpus.}
}

@misc{gate-F88-a-behaviour-can-survive-by-a-different-mechanism,
  section  = {finding},
  claim    = {a drained behaviour can survive by a different mechanism than the one deleted, so removing a guard is not evidence its property was lost},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, I predicted the drained module_path would fail the origin's dot-slash root case because I had removed its explicit normalisation, and it passes because PurePosixPath folds the prefix on construction. The case is kept because an inherited behaviour is one refactor from vanishing unpinned. Reading all 77 origin cases also showed the larger gap is undrained FUNCTIONS rather than lost cases, with is_public_open and using_names and mixfix_forms carrying cases for functions never drained, so no differential was ever wrong about them because none was run. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Read the 77 origin cases rather than counting them, and the enumeration split three ways rather than into lost-and-kept. FIRST, a prediction failed in the useful direction. The origin pins module_path with a dot-slash root spelling and I predicted the drained copy would fail it, because I had removed the origin's explicit normalisation while narrowing what that function promises about frames in gate-F68. It PASSES, because PurePosixPath folds the prefix on construction, so the behaviour survived by a DIFFERENT MECHANISM than the one I deleted. I was one step from filing a lost case that was never lost, on the strength of having removed A normalisation rather than testing THIS input. The case is kept precisely because the mechanism changed, since an inherited behaviour is one refactor from vanishing with nothing to notice, which is what a recovered case is for. SECOND, the real gap is not lost cases but UNDRAINED FUNCTIONS. is_public_open with five cases, using_names with the absent-versus-empty distinction, and mixfix_forms with the multi-hole and empty-probe cases are in the origin's suite and were never drained at all, so no differential could have been wrong about them because none was ever run. THIRD, the origin warns that its word case must keep a literal backslash-b because a mechanical sweep once rewrote the demonstration of the broken matcher into a use of the correct one, inverting the fact it was written to prove.}
}

@misc{gate-F89-a-rule-printed-where-the-decision-is-made,
  section  = {finding},
  claim    = {a rule printed where the decision is made costs one read while a rule in a document costs remembering the document exists, which is a third position between available and enforced},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured, findings.py --pairing states its own do-not-double-file rule in its output and that is why declining a peer's refile invitation cost one command rather than a recollection, while it obliges nothing and refuses nothing. Availability is not obligation now has four witnesses across two sessions, a peer's twenty-five revisions of not running a differential they held, my 77 unread origin cases across six drains, my three undrained functions that no case reading would have found, and --pairing as the counter-example. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A peer named a third position between available and enforced, and it is a claim about this repo's own tooling that I had not articulated. I had assumed obligation means a gate that refuses. findings.py --pairing obliges nothing and refuses nothing, and it makes the rule unavoidable AT THE MOMENT THE RULE IS RELEVANT by printing one finding two spellings RE-KEY do not file twice in its own output. That is why declining a peer's invitation to double-file cost one command rather than a recollection. A rule printed where the decision is made costs one read, a rule in a document costs remembering the document exists. Availability is not obligation is now measured four ways across two sessions, the peer's twenty-five revisions of not running a differential they held, my 77 unread origin cases across six drains, my three undrained functions that no case reading would have found, and --pairing as the counter-example showing what the fix looks like. The peer also reports checking where they had cited a superseded figure and finding they had never placed it in the record at all, only in a message to me, learned by READING the entry rather than trusting their memory of writing it. That is the same shape as everything above, an instrument consulted rather than recalled.}
}

@misc{gate-F90-no-instrument-for-checking-a-record-before-correcting-it,
  section  = {finding},
  claim    = {the standing rule aims at reading someone else's artifact by eye, and authorship supplies a confidence that reading a stranger's file does not, so no instrument covers checking your own record before correcting it},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Measured by a peer who happened to render a placed entry before amending it and found the figure they meant to correct had never been placed there, only sent in a message, so an unrun habit would have left a correction pointing at nothing while the real exposure stayed loose. This tree has the same gap, since --pairing reports roster versus record drift and bibstruct --entries reads a bib while nothing answers whether the record says what the author remembers writing. Five witnesses across two sessions and none is a compliance failure. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A peer filed a fifth witness on my framing and it names a gap in this repo's tooling, not only theirs. The standing rule here is ask the tool never the file, and it is aimed at reading someone else's artifact by eye. Authorship supplies a confidence that reading a stranger's file does not, so memory of what you wrote feels like knowledge of what you wrote, and nobody feels certain about a peer's entry while everybody feels certain about their own. The peer was routed correctly by a HABIT rather than an instrument, they happened to render a placed entry before amending it and found the figure they meant to correct had never been placed there at all. Had they not run it they would have amended an entry for a defect it did not contain, leaving a correction pointing at nothing while the real exposure stayed loose in correspondence. This repo has the same gap. findings.py --pairing reports roster versus record drift and bibstruct --entries reads a bib, but nothing answers does the record say what I remember writing before I edit it. Five witnesses across two sessions and NOT ONE is a compliance failure, every one is a forgotten instrument, which is why the remedy is placement rather than enforcement.}
}

@misc{gate-F91-a-drain-pays-down-the-gates-own-rederivations,
  section  = {finding},
  claim    = {Draining a consumer pays down every ratchet that consumer was an offender in, so ranking a drain by its own finding count understates it},
  check    = {selftest:python3,scripts/check_rederive_ratchet.py,--selftest},
  note     = {kind=finding by=momentum. The check_rederive_ratchet swap moved the paydown line 24 to 26 with all 42 additions byte-identical. Both new paydowns were the gate's OWN file — two declared enumerate sites that left when the shim called tool_walk instead of re-deriving the walk. A gate censusing re-derivation was itself a declared offender, which is declared-is-counted-not-exempted demonstrated on the file that states the rule. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The check_rederive_ratchet swap paid down TWO keys nobody targeted, and both were the gate's own file: enumerate::scripts/check_rederive_ratchet.py#0::declared and #1::declared left the census when the shim replaced its hand-rolled walk with tool_walk. The paydown line moved 24 to 26 while all 42 additions stayed byte-identical, so the differential is exact and the delta is entirely the drain. A gate that censuses re-derivation was itself re-deriving, under its own marker, and the declaration made the debt visible without making it go away — which is the declared-is-counted-not-exempted rule demonstrated on the file that states it. The generalisation: a consumer drain pays down every ratchet the consumer was an offender in, so ranking a drain by its own finding count understates it by whatever it owes elsewhere.}
}

@misc{gate-F92-the-worklist-gate-compares-nothing-it-was-the-wrong-instrument,
  section  = {finding},
  claim    = {worklist_gate relays paperkit and never regenerates the projection, so its equivalence line could not have caught the WORKLIST.md drift — a third outcome the unrun-versus-hole framing did not admit},
  check    = {selftest:python3,scripts/worklist_gate.py,--engine},
  note     = {kind=finding by=momentum. Read the binding rather than reconstructing history. The gate has no equivalence code of its own and paperkit ships coherence.py and project.py separately. A bare gate run left catalog/worklist untouched while --project is what rewrites the file. The verdict line asserts something narrower than a reader takes it for, so the drift was invisible by construction rather than by lapse or defect. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The operator ruled to isolate whether worklist_gate went unrun since the retraction claims landed or whether its equivalence check has a hole. Neither: the gate is not the instrument that could have caught it. Reading the binding shows worklist_gate has no equivalence code of its own — it relays the paperkit engine, and paperkit ships coherence.py and project.py as SEPARATE modules. A bare gate run does not regenerate WORKLIST.md, which --project does, and the tree confirms it: a gate run left catalog/worklist untouched. So WORKLIST.md was never compared against a fresh projection at all, and the line reading WORKLIST.md is equivalent to the projection asserts something narrower than a reader takes it for. The drift was therefore invisible BY CONSTRUCTION rather than by a lapse or a defect, which is a third outcome neither branch of the ruling admitted. Also measured: substrate calls paperkit coherence from nowhere, and pycodemod --calls coherence returns only mdstruct's own same-named function, a shared name that is not a shared authority.}
}

@misc{gate-F93-the-worklist-check-computes-its-offenders-and-discards-them,
  section  = {finding},
  claim    = {worklist.py --check is a commit-path gate that computes its offender list into a dead binding and returns 0 unconditionally, so its silence is a fact about the census rather than the tree},
  check    = {selftest:python3,scratch/pycodemod.py,--binding,bad,scripts/worklist.py},
  note     = {kind=finding by=momentum. pycodemod --binding bad reports one binding and zero reads at scripts/worklist.py:288. The gate prints three counts and cannot refuse. Its own comment argues OPEN-with-artifact-predicate is legitimately not-done, which argues for computing no list rather than discarding one. Separately measured and equally load-bearing: scripts/worklist.py tracks a symbol ledger and is NOT the catalog/worklist paperkit projection, two objects under one word. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): scripts/worklist.py --check is a phase-A commit-path gate that CANNOT refuse. Its main computes a list of OPEN items with non-manual artifact predicates into a variable named bad at line 288, never reads it, prints three counts and returns 0 unconditionally. pycodemod --binding bad reports one binding in one file and zero reads, so the offender enumeration is dead by measurement rather than by inspection. The parenthetical comment defends returning counts on the ground that OPEN with an artifact predicate is legitimately not-done — which is true and is an argument for computing no list at all, not for computing one and discarding it. A reader seeing check FAILED absent from this gate's output cannot distinguish no offenders from no verdict. Also measured: this is NOT the catalog worklist. scripts/worklist.py tracks a symbol LEDGER regenerated between BEGIN and END markers, while catalog/worklist/WORKLIST.md is the paperkit projection worklist_gate relays — two objects under one word, the same shared-name-is-not-shared-authority shape as gate-F92's coherence.}
}

@misc{gate-F94-a-live-differential-cannot-catch-an-unused-predicate-head,
  section  = {finding},
  claim    = {A differential against live data can only exercise the vocabulary members the live data uses, so an unused predicate head is a blind region no whole-population check reaches},
  check    = {selftest:python3,-m,substrate.worklist_predicate_selftest},
  note     = {kind=finding by=momentum. I classified the defines head as carrying its path at index 2 where worklist.py's docstring spells it defines relpath name with the path leading, opposite to grep pat relpath. A per-head fixture caught it at 31 of 32 and pycodemod --literal shows the head appears in no live item, so a roster differential would have agreed with the wrong reader indefinitely. The comment warning about the two index conventions was written one line above committing the error. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Building the resolver the operator ruled for, I classified the defines predicate as carrying its path at index 2. It carries it at index 1 — worklist.py's docstring is the authority and spells it defines relpath name, where the path LEADS and the name trails, the opposite of grep pat relpath. A fixture case caught it at 31 of 32. Nothing else could have: pycodemod --literal on the quoted head finds it in that docstring and in NO live item, so a differential against the live roster would have agreed with a wrong reader indefinitely. The generalisation is the useful half — a live differential can only exercise the predicate heads the live data USES, so a vocabulary with unused members has a blind region no whole-population check reaches, and only a per-member fixture covers it. Also measured and equally load-bearing: I wrote the comment warning about these two index conventions one line above committing the error, applying a correct warning to the wrong member.}
}

@misc{gate-F95-i-read-a-passing-suite-as-an-empty-result,
  section  = {finding},
  claim    = {A case that REPORTS rather than asserts contributes nothing to a suite's pass, so reading a green aggregate as evidence about what that case printed is the census-green defect one level up},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. I reported the live worklist stale set as empty because the suite read 32 of 32. The live arm passes unconditionally by design and interpolates the rows into its label, which I never read. The gate built the next tick reads seven stale items of sixty declared. Filed unwitnessed because no predicate distinguishes a correct report from an inferred one — the gate's exit witnesses the stale items, not the misreading. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Last tick I reported the live worklist stale set as empty with a passing control. It was never empty. The live arm was deliberately built to REPORT the stale set rather than assert it empty — its label interpolates the first rows and it passes unconditionally, because a case asserting zero would go red the day the gate starts earning its keep. So the suite reading 32 of 32 says nothing about the set's contents, and I inferred empty from the suite passing without reading the label I had written to carry the answer. The gate built this tick reads seven stale items of sixty declared: six Omega3-L-primes items and the R-arc item. No predicate distinguishes a correct report from an inferred one, which is why this is unwitnessed — the gate's own exit code witnesses the STALE ITEMS and not the misreading. A pass is a fact about what the cases ASSERT, and a case built to report rather than assert contributes nothing to that fact, so a reporting case makes a suite's aggregate LESS informative than its count suggests.}
}

@misc{gate-F96-decomposition-invalidates-every-predicate-naming-a-split-file,
  section  = {finding},
  claim    = {All seven stale worklist predicates name a file the ban-decompose migration turned into a directory, so every affected item is discharged and reads OPEN because a predicate keyed on a file cannot follow a file that became a namespace},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. agda_defs --under shows Trace.Final is a namespace of ten members whose Final.AnaUnique provides ana-unique, and Nat.Prime.Properties is a directory of twenty-six leaves whose PrimeDividesProduct provides prime-divides-product — the exact names the R-arc and Omega3-L-primes.uniq items claim. Same shape as a drain moving write paths out from under a witness keyed on a location rather than a name, and silent in both directions because status collapses a missing file onto OPEN. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): All seven stale worklist predicates share one cause and none is a wrong path: each names a FILE that the ban-decompose migration turned into a DIRECTORY. Substrate/Algebra/R/Trace/Final.agda is now the Final namespace with ten members including Final.AnaUnique providing ana-unique, the terminality proof the R-arc item claims. Substrate/Algebra/Nat/Prime/Properties.agda is now a directory of twenty-six leaves, and Prime.Properties.PrimeDividesProduct provides prime-divides-product, exactly the name the Omega3-L-primes.uniq item claims. So all seven items are DISCHARGED and read OPEN because their predicates name pre-decomposition paths. The class is the finding: a decomposition relocates the subject a predicate measures, and a predicate keyed on a FILE cannot follow a file that became a directory. This is the same shape as the bibstruct swap moving write paths out from under a witness, keyed on a location rather than a name — and it is silent in both directions, because status collapses a missing file onto OPEN. Filed unwitnessed because no predicate distinguishes a stale-by-decomposition path from a stale-by-deletion one without reading what the namespace now provides.}
}

@misc{gate-F97-a-refusal-gate-reads-unmeasurable-in-the-set-form-census,
  section  = {finding},
  claim    = {commit_refusal prints UNMEASURABLE for both a set-form gate whose baseline it cannot read and a refusal gate it structurally cannot key-diff, so that count rises when coverage improves and cannot be read as a health figure},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. Wiring check_worklist_predicates moved the census from 29 to 30 UNMEASURABLE while adding a gate that refuses correctly. Its row reads module exposes no census — not a set-form ratchet, which is right: a refusal gate's verdict is its exit code over a population that must stay empty. Only the reason column separates unmeasurable-by-kind from unmeasurable-by-defect. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Wiring check_worklist_predicates into the hook made it visible to commit_refusal, and its row reads UNMEASURABLE — module exposes no census, not a set-form ratchet. That is correct and it is worth stating because the label invites a wrong reading. commit_refusal key-diffs gates that expose a census, so a REFUSAL gate — one whose verdict is its own exit code over a population that must stay empty — can never be measurable to it. The refusal census therefore reports two different things under one word: a set-form gate whose baseline it cannot read, and a non-set-form gate it structurally cannot key-diff. Both print UNMEASURABLE and only the reason column separates them. The consequence is that adding refusal gates raises the UNMEASURABLE count while strictly improving coverage, so that count cannot be read as a health figure in either direction. Filed unwitnessed because no predicate distinguishes a gate that is unmeasurable-by-kind from one that is unmeasurable-by-defect without reading the reason column.}
}

@misc{gate-F98-the-seven-providers-are-located-and-the-edit-is-refused,
  section  = {finding},
  claim    = {All seven stale worklist predicates have located post-decomposition providers whose names match their items exactly, so every one is discharged, and the one-line repair is refused by the per-file gate at 328 findings with no partial credit},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. agda_defs --provides names each leaf: Factorize, PrimeDividesProduct, PrimeProduct, FactorCanonical, ProductAppend, QFactoredRoundtrip, AnaUnique. The refusal names its own resolution and it is not a paydown — extract the roster, which is data with one in-file consumer while worklist_roster.load already reads it and has two. The drain step exists and does not strand. What blocks it is scope: transcribing sixty hand-authored items risks the reassembling-writer class a peer reported this session. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): All seven stale worklist predicates now have their post-decomposition providers located by agda_defs --provides, each in its own leaf: Factorize provides factorize, PrimeDividesProduct provides prime-divides-product, PrimeProduct provides prime-in-product, FactorCanonical provides factor-Canonical, ProductAppend provides product-plus-plus, GValueLSpace.PrimeFactor.QFactoredRoundtrip provides q-factored-roundtrip, and Trace.Final.AnaUnique provides ana-unique. Every name matches what its item claims, so all seven are discharged. The repair is a one-line change per item and it is REFUSED: scripts/worklist.py carries 328 findings and the per-file gate has no partial-credit path, so an edit leaving it dirty is refused too. The refusal names the resolution and it is not a paydown — extract the concern into a new clean module. Here the extractable concern is the ROSTER, which is data with exactly one in-file consumer in status, and substrate/worklist_roster.load already reads it with two consumers. So the drain step exists and does not strand. What blocks it is scope rather than shape: moving sixty hand-authored items is a mechanical transcription whose failure mode is a reassembling writer keeping only what its parser recognises, which is the exact class a peer reported this session after silently destroying three prose comments between bib entries.}
}

@misc{gate-F99-rekey-is-unreachable-because-register-only-creates,
  section  = {finding},
  claim    = {The census instructs RE-KEY for its spelling pairs and no mode performs one, so the only available action creates the duplicate the instruction forbids while leaving true drift unchanged},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. The short key is the witness and the long key the bib entry, so a pair is one witness and one entry with differing keys rather than two filings. findings.resolve already treats this as resolved via exact-match-before-prefix, witnessed on tmi-F6, while --pairing joins by exact equality — two instruments, one subject, different verdicts. A probe registration closed one SPELLING-PAIR, turned the short key into WITNESS-ONLY and held true drift, then was reverted from the index. Missing capability is an atomic re-key. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The four SPELLING-PAIR rows cannot be closed by the instruction the census prints. Measured: the short key is the WITNESS and the long key is the BIB ENTRY, so the pair is one witness and one entry whose keys differ — not two filings of one finding as the RE-KEY wording suggests. findings.resolve already treats the relation as resolved, because exact match wins before any prefix scan and tmi-F6 is its own documented witness for that property, while --pairing joins by exact key equality alone. Two instruments over one subject with different verdicts. I probed the repair and it made things worse in an instructive way: --register accepted a second witness under the long spelling, the SPELLING-PAIR row closed, the short key became WITNESS-ONLY, and TRUE DRIFT held. The census moved a row between drift classes without improving the total, because the honest repair is a RENAME and --register only creates. It refuses an edit to an existing key by design but does not refuse a duplicate under a different spelling, so the one action available through the tool manufactures exactly the two-filings state the message warns against. The probe was reverted from the index. What is missing is a re-key mode that moves a witness to a new key atomically.}
}

@misc{gate-G200-the-rekey-is-a-pure-insertion-not-a-replacement,
  section  = {finding},
  claim    = {Every witness re-key here is a pure insertion with no original byte replaced, because the long key extends the short one, which is a stronger preservation property than the changed-span claim it replaced},
  check    = {selftest:python3,-m,substrate.witness_rekey_selftest},
  note     = {kind=finding by=momentum. substrate/witness_rekey supplies the atomic re-key gate-F99 named as missing, at 29 of 29 including a read-only live arm. Two of my own cases were wrong and the run corrected both: tmi-F1 is not a bare-stem witness but an ambiguous prefix over eleven keys, and the changed byte span is zero rather than the old key's length. The module edits one anchored key token over raw bytes and never parses the roster, so comments and noqa directives cannot be dropped. FBT003 named a real fault — a dry run is not a failure, so the verdict is a tri-state. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): substrate/witness_rekey builds the atomic re-key gate-F99 named as missing, and two of its own cases were wrong in ways the run corrected. First: I asserted a live arm claiming tmi-F1 anchors once in the ledger, reasoning that the bib carries tmi-F1-dash-something so a bare stem must exist. It does not — findings.py tmi-F1 refuses as an AMBIGUOUS PREFIX over eleven keys and the witness is spelled tmi-F1-revision-recall-is-30-not-precision-100, with the only bare stems being F15 through F18. Second and sharper: I asserted the changed byte span equals the old key's length. It is ZERO. Every spelling pair here has the long key EXTENDING the short one, so the shared prefix runs through the old key entirely and the edit is a pure INSERTION with no original byte replaced. That is a stronger preservation property than the one I set out to check and it is now what the cases pin, on the fixture and on the live ledger both. The module edits a single anchored key token over raw bytes and never parses the roster, because the roster carries hand-written comments and noqa directives that a re-emitter would drop — the class a peer measured this week. The per-file gate also refused a bool verdict at FBT003, which named a real design fault: the operation has three outcomes since a dry run is not a failure.}
}

@misc{gate-G201-a-rename-removes-a-drift-row-where-creation-relocates-it,
  section  = {finding},
  claim    = {A rename removes a drift row where a creation only relocates it between classes, which is why the pairing census fell from 24 to 20 and its raw unpaired count converged on the same number},
  check    = {selftest:python3,scripts/rekey_witness.py,--selftest},
  note     = {kind=finding by=momentum. scripts/rekey_witness.py wires substrate/witness_rekey and closed all four spelling pairs. Witness-only held at 14 and bib-only at 6 while the totals held at 587 and 579, so nothing was created or lost, and git diff --stat reads four insertions and four deletions for four re-keys. Performing the renames also broke two of my own live cases that named a PENDING re-key, dropping the suite to 25 of 27 — caught by the polarity probe refusing to file this finding. The arms now assert every live key anchors exactly once. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): All four spelling pairs are closed and TRUE DRIFT fell from 24 to 20, which is the discriminator a probe last tick failed to produce. Registering the long spelling had closed one pair row while turning the short key into WITNESS-ONLY and holding the total — creation RELOCATES a row between drift classes. Renaming REMOVES it: witness-only held at 14, bib-only at 6, witness and entry totals held at 587 and 579, and the raw unpaired count fell to EQUAL true drift, so the gap between those two numbers WAS the four pairs and both readings now agree. git diff --stat over the ledger reads four insertions and four deletions for four re-keys — one line each, nothing else touched, the byte-preservation property confirmed on the live file rather than a fixture. The CLI names the pair rather than re-deriving it because findings.py _restem already owns the pairing relation. And the run cost a regression I had to repair: two live cases named tmi-F6 as a PENDING re-key, so performing it dropped the suite from 29 of 29 to 25 of 27, caught by the polarity probe refusing to file this very finding. The arms now assert that EVERY live key anchors exactly once, which is stronger and cannot go stale when a rename lands.}
}

@misc{gate-G202-the-roster-is-47-items-not-60-and-i-had-never-enumerated-it,
  section  = {finding},
  claim    = {I sized a scope decision against a count I had never enumerated and the population was smaller in two independent ways, in the symbol the count was deciding},
  check    = {selftest:python3,-m,substrate.worklist_status_selftest},
  note     = {kind=finding by=momentum. The roster is 47 items where I had cited sixty across three ticks, taken from --check's row total. pycodemod --types also reports only four mypy codes against 328 findings, so the debt is bulk ruff style rather than structural. substrate/worklist_status.py holds the drained verdict engine at 25 of 25 with PER-ITEM agreement against the live tracker, because equal DONE totals with one item flipped would re-dispatch a finished arc. PLR0911 named the dispatch-versus-fold seam a second time, producing the same split as in worklist_predicate. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Under the operator's rewrite-whole ruling I read the roster to transcribe it and found it is 47 items, not the sixty I had been citing across three ticks. The sixty came from worklist.py --check's total, which counts ROWS, and I never enumerated the population before sizing work against its count — the enumerate-before-acting rule, violated in the symbol whose scope question the count was deciding. The scope was also smaller in a second way: pycodemod --types reports only four mypy codes against 328 total findings, so the debt is bulk ruff style rather than structural, and the file is 306 lines with the roster occupying about a third. substrate/worklist_status.py now holds the verdict engine, verified at 25 of 25 including PER-ITEM agreement with the live tracker over the whole roster rather than a matching DONE count — two engines with equal totals and one item flipped would re-dispatch a finished arc. The per-file gate named the dispatch-versus-fold seam again at PLR0911, producing the same split it produced in worklist_predicate, which is evidence the seam is real rather than a limit satisfied twice.}
}

@misc{gate-G203-carrying-prose-verbatim-carries-its-lint-debt,
  section  = {finding},
  claim    = {Carrying hand-authored records verbatim between files carries their lint debt verbatim, because in a mathematical corpus the flagged ambiguous glyphs ARE the content rather than an accident},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. The roster rewrite was refused at 195 findings and pycheck_show enumerates them as E501 plus RUF001 and RUF002 over the double-struck Z, DIVIDES, double-struck R and Greek iota. Verbatim and clean cannot both hold, which is a decision about whether the record reads for humans rather than a technique to pick. Operator ruled to escape the glyphs as named escapes rather than take a per-file ignore. A plan that says carry it verbatim has silently promised to carry a debt nobody sized. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The whole-file rewrite hit a constraint I had not measured and that inverts what verbatim means here. I planned to carry the roster byte-exact with only seven predicates changed, treating the prose as inert data. The gate refused the result at 195 findings, and pycheck_show enumerates them as E501 long lines plus RUF001 and RUF002 ambiguous glyphs — the double-struck Z, the DIVIDES sign, the double-struck R, a Greek capital iota. So the debt IS the mathematical notation, and in a corpus whose subject is mathematics that notation is the content rather than an accident. Verbatim and clean therefore cannot both hold, which is not a technique I can pick between: it is a decision about whether the record reads for humans or satisfies a confusable-character rule. Operator ruled to escape the glyphs as named escapes rather than take a per-file ignore, so the roster stays clean by construction with no exemption. The generalisation: a lint census over a data module measures its PROSE, so moving hand-authored records between files transfers a debt whose size nobody sized, and a plan that says carry it verbatim has silently promised to carry that too.}
}

@misc{gate-G204-a-verdict-must-carry-the-components-that-decide-it,
  section  = {finding},
  claim    = {A verdict must carry the components that decide it, with ok derived from them rather than stored beside them, or a failure is a complaint rather than a disproof},
  check    = {selftest:python3,-m,substrate.glyph_escape_selftest},
  note     = {kind=finding by=momentum. Operator ruling applied to substrate/glyph_escape, whose round-trip check returned a bare boolean — a caller learned NOT EQUAL and nothing about where, the aggregate-only defect at predicate scale. The Trip record now carries escaped source, decoded text and first differing index, and two deliberately failing verdicts assert that why names the index and both sides. The escaper's own docstring was refused by the rule it exists to satisfy and the suite spells its fixtures in the escapes it tests, so a wrong escape breaks the arms rather than passing them. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Operator ruling this tick: anywhere you assert an expression you must print the expression's components, which makes it a disproof-carrying artifact. It landed on a module I had just written. round_trips returned a bare boolean, so a caller asserting on it learned NOT EQUAL and nothing about where — the same defect as a census reporting only aggregates, at the level of a single predicate. It is now a Trip record carrying the escaped source, the decoded text and the first differing index, with ok DERIVED from those fields rather than stored beside them so the verdict and its evidence cannot disagree. The disproof path is itself cased: two deliberately failing verdicts assert that why names the index and both sides, because a verdict type that could only report success would satisfy every success arm. Also measured while building it — the escaper's own docstring was refused by the rule it exists to satisfy, and the suite had to spell its fixtures in the escapes it tests. That is the remedy applied at three layers, and the fixture layer is a stronger check than the one I designed: the fixtures are only correct if the escape spelling really denotes the character, so a wrong escape breaks the arms rather than passing them.}
}

@misc{gate-G205-the-flagged-set-was-nineteen-where-i-had-guessed-seven,
  section  = {finding},
  claim    = {An authored escape set was wrong in both directions where a derived one is exact, because the checker flags characters no author would guess are confusable},
  check    = {selftest:python3,-m,substrate.glyph_flagged_selftest},
  note     = {kind=finding by=momentum. My hand-written set held seven characters and the checker's own findings name nineteen, including the multiplication sign, the minus sign, the en dash and logical or — confusable with x, hyphen-minus, hyphen and v. Escaping the authored seven would have left twelve findings standing and the write still refused. substrate/glyph_flagged parses RUF001 and RUF002 messages and cross-checks each character against the Unicode name printed beside it, carrying an unconfirmed row as a blocking third outcome. scripts/glyph_report is the mode, built because the alternative was an inline program the chaining hook refused. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): I had been carrying a hand-written escape set of seven characters. Derived from the checker's own findings it is NINETEEN, and my guess was wrong in both directions. It missed the double-struck C H Q, the mathematical double-struck O and S, the bold B, both bold and double-struck zero, and — the ones I would never have guessed — the MULTIPLICATION SIGN, the MINUS SIGN, the EN DASH and LOGICAL OR, none of which look like Latin letters to me but all of which ruff flags as confusable with x, a hyphen-minus, a hyphen and the letter v. An authored set would have escaped seven characters, left twelve findings standing, and the write would still have been refused for reasons the author could not see. substrate/glyph_flagged reads the set out of RUF001 and RUF002 messages and cross-checks each parsed character against the Unicode name the checker printed beside it, so a wrong parse is loud rather than plausible, and an unconfirmed row is carried as a third outcome that BLOCKS rather than being dropped. scripts/glyph_report is the mode — built because asking this without one meant an inline program the chaining hook refused, correctly: a missing mode is work.}
}

@misc{gate-G206-a-named-escape-only-reaches-a-string-and-the-check-cannot-see-otherwise,
  section  = {finding},
  claim    = {A named escape denotes its character only inside a string, and the round-trip check is structurally blind to the comment case because both sides decode identically},
  check    = {selftest:python3,-m,substrate.glyph_flagged_selftest},
  note     = {kind=finding by=momentum. The verification I had treated as the safety argument does not cover the failure mode. A first reader collapsed RUF001 string, RUF002 docstring and RUF003 comment into one set, licensing a silent corruption. Operator ruled to teach the reader the split. glyph_flagged now returns escapable and comment_only separately with clearable derived from both, and a comment finding blocks. Measured on the live subject: all nineteen are escapable and none sit in a comment, so the bound is real and does not bind here — printed as a component rather than asserted. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): Writing the applier surfaced a bound the escape plan had not accounted for and that no verification I had built could catch. A named escape denotes its character only INSIDE a string literal — in a comment the same spelling is literal backslash-N text that turns the comment into noise, and the round-trip check is blind to it because both the original and the rewritten source decode identically. So the check I had treated as the safety argument does not cover the failure mode at all. The first reader collapsed RUF001 for a string, RUF002 for a docstring and RUF003 for a comment into one set, which would have licensed exactly that corruption. Operator ruled to teach the reader the split rather than hand-rewrite comments or take a per-file ignore. glyph_flagged now returns escapable and comment_only separately with clearable DERIVED from both, a character appearing in both positions lands in both sets, and a comment finding BLOCKS. Measured on the live subject: all nineteen flagged characters are escapable and none sit in a comment, so the bound is real and does not bind here — which only the measurement could establish, and the reader prints that as a component rather than asserting it.}
}

@misc{gate-G207-the-drain-made-bibstruct-cwd-dependent-and-my-differentials-could-not-see-it,
  section  = {finding},
  claim    = {A differential establishing output equivalence says nothing about invocation contract, so a drain that made a tool cwd-dependent passed seventeen green modules and broke every consumer invoking it from elsewhere},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. A peer reported ModuleNotFoundError and I could not reproduce it — from substrate's root the tool reads 67 of 67 entries, because substrate is a package directory in that cwd. The contract did not become requires-installed as both of us first read it, it became cwd-dependent, and that was latent until the first packaged import landed. Every differential I ran was run from substrate's root, so the verification could not see the regression a consumer feels first. Separately measured: 404 paths staged with zero committed and nine gates refusing, so peers can only see this repo by reading its worktree, which the peer's own claim says a consumer must never do. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A peer reported bibstruct dead with ModuleNotFoundError on substrate and I could not reproduce it — running from substrate's root gives 67 of 67 entries. The prediction failing is the finding: it resolves for me because substrate is a package DIRECTORY in my cwd, so the drained shim's packaged import resolves off cwd, and it breaks for them because they invoke it by path from their own tree. So the contract did not become requires-substrate-installed as we both first read it. It became CWD-DEPENDENT, and that dependency was latent all along — a consumer invoking by path from elsewhere worked by accident until the first packaged import landed. The part that matters for method: every differential I ran during the drain was run from substrate's root, so the verification was structurally incapable of seeing the regression a consumer feels first. A differential that establishes output equivalence says nothing about invocation contract, and I had treated seventeen green modules as covering the swap. Also measured and offered to the census: 404 paths staged with zero committed and nine gates refusing, so peers can only see this repo by reading its worktree — which is exactly what the peer's own claim says a consumer must never do. Those two constraints are in direct tension and I am naming it rather than resolving it.}
}

@misc{gate-G208-swap-readiness-certified-the-import-break-it-was-built-to-catch,
  section  = {finding},
  claim    = {A readiness reader that asks whether an import is package-shaped rather than whether it resolves for an invoker will certify the exact break it was built to catch},
  check    = {selftest:env,-C,/home/mikemol/github/gcalculus,python3,/home/mikemol/github/substrate/scratch/bibstruct.py,--dropped,/home/mikemol/github/substrate/catalog/worklist/warrants.bib},
  note     = {kind=finding by=momentum. swap_readiness reported imports READY for a shim no consumer outside this repo could invoke. Python puts the script's own directory on sys.path and never the cwd, so my env -C advice to a blocked peer could not work and my own successes were misattributed. The repair resolves the repo root from __file__, inserted only if absent so an arranged path is not shadowed, verified from a foreign cwd with no PYTHONPATH. The peer's second wall does not hold as stated: --dropped reaches paperkit.bib and now works, so that reachability is interpreter-dependent rather than unconditional. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A peer corrected my diagnosis and the correction was right. I told them env -C would fix the drained shim's ModuleNotFoundError, reasoning that cwd supplies the path. It does not: Python puts the SCRIPT'S OWN directory on sys.path, never the cwd, so running scratch/bibstruct.py puts scratch on the path and substrate is invisible from there regardless of working directory. My own runs succeeded for a reason I misattributed, and I sent a peer a fix that could not work. The sharper half is that my readiness reader CERTIFIED this. swap_readiness scratch/bibstruct.py reports imports READY, every import a packaged consumer can follow — while a packaged consumer could not follow them at all. It asks whether each name is PACKAGE-SHAPED and never whether it RESOLVES for an invoker, and the label collapses those into one verdict. So the instrument built to gate the drain was blind to the drain's only consumer-visible regression. The repair is a bootstrap resolving the repo root from __file__ rather than cwd, inserted only if absent so a consumer who has arranged the path keeps their arrangement. Verified from a foreign cwd with no PYTHONPATH. And the peer's second wall does not hold as stated: they reported the chain unfixable because it reaches paperkit.bib, but --dropped reaches exactly that and now works, so the paperkit reachability is interpreter-dependent rather than unconditional.}
}

@misc{gate-G209-the-engine-dependency-was-hidden-three-modules-up-a-chain,
  section  = {finding},
  claim    = {A module-scope dependency three imports up a chain makes every mode of a CLI unreachable, and a measurement taken in an environment that satisfies it cannot discriminate that from the chain being sound},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. A peer refuted my correction on both counts. warrant_bib imported paperkit at module scope and bib_handlers pulls warrant_bib, so the chain ran at load and every mode was blocked rather than one. My dropped 0 of 67 proved only that paperkit imports in my environment — the same adjacent-question shape as the swap_readiness green. Operator ruled to split rather than defer the import, because lazy hides the dependency deeper while a split makes it visible in the graph. warrant_records owns the engine half, bib_handlers imports it lazily in the one function that needs it and catches ImportError as a third outcome. The suite is still red and that is stated rather than smoothed. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A peer refuted my correction and was right on both counts. I claimed --dropped was precisely the mode reaching paperkit and that the wall was therefore paperkit's open item. Reading the binding: substrate/warrant_bib.py imported paperkit.bib at MODULE SCOPE and module_importers shows bib_handlers pulls warrant_bib, so the chain bibstruct to bibstruct_main to bib_handlers to warrant_bib to paperkit ran at LOAD. Every mode was unreachable, not one, and the fix was mine rather than paperkit's. My earlier measurement of dropped 0 of 67 was not evidence against the peer — it proved only that paperkit imports in MY environment and could not discriminate the chain being fine from my environment satisfying it, which is the same adjacent-question shape as the swap_readiness green I had just filed. attr_reads paperkit dot star showed ONE use in that module so the seam was the engine rather than a file size. Operator ruled to SPLIT rather than make the import lazy, because lazy would hide the dependency one level deeper while the split makes it visible in the import graph. warrant_records now owns records claim_of and tag with the top-level import kept, warrant_bib is engine-free, and bib_handlers imports the engine half lazily in the one function that needs it catching ImportError as a third outcome so a consumer without paperkit gets an empty census rather than a traceback. Verified: warrant_bib no longer appears in attr_reads paperkit dot star. NOT done and stated as such — warrant_bib_selftest still calls the moved functions and is RED, so the fix is in and the verification of the fix is not.}
}

@misc{gate-G210-a-cross-file-checker-deadlocks-a-two-file-split,
  section  = {finding},
  claim    = {A package-wide type checker behind a per-file gate deadlocks a two-file split, because each half's stale reference refuses the write that would remove it},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. After warrant_bib lost three functions to warrant_records, the stale suite became a package-wide error that refuses every write in substrate including the suite rewrite. Three writes were refused with identical output. The display proves stale state is being read: pycheck_show prints error text from the old suite against line numbers from the new module, so line 113 renders as an empty return while the message quotes warrant_bib.records. The gate's own advice about a file doing too much does not apply — the obstruction is a third file's staleness. Not cleared by reverting, because the revert destroys the evidence of which pair is mutually blocking. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The warrant_bib split reached a hold-and-wait that no single write can clear, and its location is the finding. The per-file gate runs mypy across the package, so after warrant_bib lost records claim_of and tag, the stale warrant_bib_selftest referencing them became a package-wide error — and that error now REFUSES every write in substrate, including the rewrite of the suite that would remove it. Each half is blocked by the other. The display proves the checker is reading stale state rather than the proposed content: pycheck_show prints error TEXT from the old suite against line NUMBERS from the new warrant_bib, so line 113 renders as return open-paren close-paren while the message quotes warrant_bib.records. Three writes were refused with identical output naming lines my proposed files do not contain. Two more facts worth carrying. First, the gate's own refusal text says a file too large to leave clean in one edit is the gate saying the file does too much — which is true and does not apply, because neither file is too large and the obstruction is a THIRD file's staleness. Second, a peer independently found the ImportError guard I wrote one line outside its try block, so the third-outcome branch reads as present and fires never, and that repair is among the writes this deadlock is blocking. I am not clearing it by reverting, because a revert would destroy the evidence of which pair is mutually blocking.}
}

@misc{gate-G211-deleting-the-file-moved-the-deadlock-rather-than-clearing-it,
  section  = {finding},
  claim    = {Deleting one half of a mutually-blocking pair moves the deadlock rather than clearing it, and the cycle breaks only when one side stops naming the other at check time},
  check    = {selftest:python3,-m,substrate.warrant_bib_selftest},
  note     = {kind=finding by=momentum. Removing the stale suite left warrant_bib naming an absent module, so the package-wide error moved and every write stayed refused. Clearing the mypy cache changed nothing, which refuted my diagnosis that the cache was the mechanism. A runtime importlib lookup with a Protocol narrowing broke it. Two further measurements: hasattr does not narrow a dynamic import for the checker where a Protocol does, and my new probe fired a false positive by matching the docstring that explains the import's absence — use versus mention inside the check written to catch a regression, now reading statements with the engine half as positive control. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The operator ruled to clear gate-G210's deadlock by deleting the stale suite and rebuilding. It did not clear: warrant_bib then named a module that no longer existed, so the package-wide error simply MOVED from the suite's stale references to the module's dangling delegation, and every write in substrate stayed refused. I also predicted the mypy cache was the mechanism and cleared it — the same two errors survived, which means the deadlock was real rather than an artifact and my diagnosis was wrong. What actually broke the cycle was making the suite delegation a RUNTIME lookup through importlib with a Protocol narrowing rather than a type-checked import, so the module stops naming a file that must exist for it to be writable. Two more measured things. hasattr does NOT narrow a dynamically imported module for the checker — an intermediate attempt using it was refused, and the Protocol pattern is what works. And my own new probe fired a FALSE POSITIVE on its first run: it searched source text for the engine import and matched the docstring that explains why the import is absent, which is use-versus-mention committed inside the check written to catch a regression. It now reads statements rather than strings, with the engine half as a positive control proving it is not always answering no.}
}

@misc{gate-G212-the-round-trip-check-unescapes-what-it-did-not-escape,
  section  = {finding},
  claim    = {A round-trip verifier that decodes every backslash sequence rather than only the ones it wrote reports a false divergence on any input carrying a pre-existing escape, and a fixture set chosen by its author cannot see this},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. The pipeline refused on the real roster at index 5346, where a pre-existing escaped quote decoded to a bare quote. The escape is sound and the verifier is not. The suite reads 22 of 22 against that verifier because every fixture was backslash-free — a verification passing on inputs its author selected while failing on the corpus it serves, the same shape as running every drain differential from the repo root. The tool withheld rather than writing, so the third-outcome design held even with a defective predicate behind it. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The escape pipeline ran end to end on the real roster and REFUSED, correctly, on a divergence my own suite could not see. glyph_escape.round_trip decodes the escaped source with unicode_escape and compares — but unicode_escape decodes EVERY backslash sequence, not only the ones the escaper added. The roster contains a pre-existing escaped quote, so the decode turned backslash-quote into a bare quote and the comparison reported DIVERGES at index 5346 with original backslash-quote-plan versus decoded quote-plan. The escape itself is fine. The VERIFIER is wrong on any input containing a backslash it did not write. And the suite reads 22 of 22 against that verifier, because every fixture I chose was backslash-free — a verification passing on inputs its author selected while failing on the corpus it was built for, which is the same shape as running every drain differential from the repo root. Two things worth keeping. The tool WITHHELD rather than writing, so the third-outcome design worked even though the predicate behind it was defective — a refusal on a false divergence costs a turn where a write on a false agreement costs a record. And this is why the transformation had to be a program: a hand pass would have produced the same corrupted comparison silently, or more likely no comparison at all.}
}

@misc{gate-G213-a-targeted-transformation-needs-a-targeted-inverse,
  section  = {finding},
  claim    = {A targeted transformation must be verified by a targeted inverse, because a general decoder undoes sequences the transformation never wrote and reports its own damage as a divergence in the content},
  check    = {selftest:python3,-m,substrate.glyph_escape_selftest},
  note     = {kind=finding by=momentum. The live roster now round-trips with the same nineteen characters and the same byte counts, decoded equal where it diverged at index 5346. unescape_chars maps back only the escapes this module emits and is blind to foreign backslashes by construction. Eight arms added covering an escaped quote beside a flagged glyph, newline and tab escapes, a doubled backslash, and two positive controls that the inverse is not a no-op and does leave a foreign escape alone. Those arms are the only real evidence for the repair, because a targeted and a general inverse agree on every input without a foreign backslash. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): gate-G212's verifier is repaired and the live roster now round-trips: same nineteen characters, same 33947 to 37227 byte counts, decoded equal where it previously diverged at index 5346. The defect was using a GENERAL decoder to verify a TARGETED transformation. unicode_escape resolves every backslash sequence, so it undid a pre-existing escaped quote the escaper never wrote and reported that as a divergence in the content. The repair is unescape_chars, which maps back only the escapes this module emits and is therefore blind to foreign backslashes by construction. The honest bound is stated in its docstring: this verifies the transformation against itself, and what makes that non-vacuous is that the two directions are written separately and the fixtures now carry backslashes the escaper never produces. Six new arms cover an escaped quote beside a flagged glyph, newline and tab escapes, a doubled backslash, and two positive controls — that the inverse actually undoes an escape rather than being a no-op, and that it leaves a foreign escape alone. The suite went 22 of 22 to 30 of 30, and the eight added arms are the only real evidence for the repair because a targeted and a general inverse agree on every input WITHOUT a foreign backslash.}
}

@misc{gate-G214,
  section  = {finding},
  claim    = {Escaping a confusable glyph LENGTHENS the line, so clearing RUF001 in scripts/worklist.py grew the file 33947 to 37227 chars and pushed lines into E501 — one class cleared, a second widened, in the same edit.},
  check    = {selftest:python3},
  note     = {kind=finding by=momentum. The witness: pycheck_show --count reads 179 findings in 30 rules with ZERO RUF001/RUF002/RUF003, and E501 at 84. The escape remains correct because the roster's destination is a NEW reflowed file, never an edit to this one. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): scripts/pycheck_show.py --count scripts/worklist.py An escape is LONGER than the glyph it replaces so clearing RUF001 pushes lines past E501. The roster went 19 confusable findings to 0 and 33947 to 37227 chars, and the E501 population grew with it. A remedy measured only against the class it targets reports success while widening a second class in the same file. The escape is still correct because the destination is a NEW file written reflowed, not an edit to this one.}
}

@misc{gate-G215,
  section  = {finding},
  claim    = {findings.py --register splits an unquoted multi-word command on whitespace, so a selftest witness binds only its first token and a truncated prefix that exits 0 registers as a passing behavioural witness.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. The witness: registering gate-G214 with an unquoted command produced 'gate-G214: python3 PASSES', a bare interpreter that passes unconditionally. The polarity probe checks DIRECTION not ARITY, so a witness truncated to a passing prefix is invisible to it. --register only CREATES, so the vacuous witness cannot be edited and stands as recorded. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A multi-word command passed unquoted to --register splits on whitespace so the witness kind selftest binds only the first token. gate-G214 resolved to a bare python3 which PASSES unconditionally, a vacuous witness wearing a behavioural kind. The probe checks polarity not arity, so a witness whose command was truncated to a passing prefix registers clean. Quote the whole command or the kind lies.}
}

@misc{gate-G216,
  section  = {finding},
  claim    = {gate-G202 is retracted: the worklist roster IS 60 items, and worklist.py --check partitions by status rather than counting rows, so both halves of that finding are false.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. The witness: worklist.py --check prints 51 done 9 open 0 manual summing to 60, and check_worklist_predicates.py reports 7 stale of 60 declared — two independent instruments agreeing. The 47 came from my own hand-transcription of the roster during the rewrite-whole pass, so the retraction inverted a correct figure into a wrong one and filed that as the finding. A number I produced by reading is not an instrument. The from-edge to gate-G202 is UNMATERIALISED because its bib key carries a descriptive suffix this turn did not resolve. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): gate-G202 retracted. It claimed the roster is 47 items not 60 and that worklist.py --check counts ROWS. Both halves are false. --check prints 51 done 9 open 0 manual which partitions by STATUS and sums to 60, and check_worklist_predicates.py independently reports of 60 declared. The 47 was my HAND-TRANSCRIPTION during the rewrite-whole pass, so the retraction inverted the error: I corrected a right number to a wrong one and filed the correction as the finding. A count I produced by reading is not an instrument, and citing it against a tool is the same fact-about-the-method defect one layer up.}
}

@misc{gate-G217,
  section  = {finding},
  claim    = {The seven stale worklist predicates cannot be repointed in place: scripts/worklist.py sits behind the all-or-nothing per-file gate, so build-the-manifest is the PRECONDITION for repoint-the-seven and not its successor.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. The witness: a one-token path edit replacing Properties.agda with Properties/Factorize2.agda was refused with 212 findings reported, and the refusal names extraction into a new clean module as the only route. I had published the opposite order last tick, reasoning that the items can be fixed where they live. A leverage ordering derived from where work logically belongs rather than from what the gate ADMITS ranks a blocked item first. Kind is unwitnessed because no predicate distinguishes an item nobody has repointed from one that cannot be. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The seven stale predicates cannot be repointed in place. scripts/worklist.py carries 212 findings behind the all-or-nothing per-file gate, so replacing ONE path token in ONE item is refused exactly as any other edit is. I had sequenced repoint-the-seven ABOVE build-the-manifest on the reasoning that the items can be fixed where they live — that reasoning is false and the gate refused it in one call. The manifest is the PRECONDITION, not the follow-on, and the dependency runs opposite to the order I published last tick. A leverage ordering derived from where work logically belongs, rather than from what the gate admits, ranks a blocked item first. Kind is unwitnessed because no predicate distinguishes an item nobody has repointed from one that CANNOT be repointed.}
}

@misc{gate-G218,
  section  = {finding},
  claim    = {The polarity probe guards the refuses kind and not the selftest kind, so one malformed --register invocation is REFUSED under one kind and BANKED as a vacuous passing witness under the other.},
  check    = {unwitnessed},
  note     = {kind=finding by=momentum. The witness: an unquoted multi-word command split on whitespace and bound bare python3, exactly as gate-G215 recorded two ticks earlier. Under refuses the probe refused the registration and named cause b. Under selftest the same shape produced gate-G214, which resolves as python3 PASSES and cannot be edited because --register only creates. Authoring the finding did not prevent the repeat, which is evidence the remedy belongs in the tool rather than in remembering. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): I committed gate-G215 again two ticks after filing it. An unquoted multi-word command passed to --register split on whitespace and the witness bound bare python3. The difference is that the POLARITY PROBE caught it this time and refused the registration, naming cause b, where gate-G214 registered clean and stood as a vacuous passing witness. So the guard covers the refuses kind and not the selftest kind, and that asymmetry is the actual defect: the same malformed input is refused under one kind and banked under another. A finding I authored did not stop me repeating it, which is evidence the remedy belongs in the tool rather than in remembering.}
}

@misc{gate-G219,
  section  = {finding},
