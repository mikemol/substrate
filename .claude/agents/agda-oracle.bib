@misc{agda-F16-min-cut-needs-provenance,
  section  = {cycle detection},
  claim    = {A minimum feedback arc set has no canonical member, and choosing one by search alone picks working code. Equal-size minima differ in WHICH edges they name, and the search returns whichever it enumerates first. Measured on the TokiPona pair: it named LinearAlgebra to NimiSpace (present since HEAD) when NimiSpace to LinearAlgebra was the edge the sweep had just added, so cutting the minimum would have deleted working code. Provenance is the tiebreak the graph cannot supply and git can — but only WITHIN a size class. Applying fresh-only as a HARD constraint returned 5 cuts on the Lojban component where 2 sufficed, cutting three edges that did not need to go. Minimality outranks provenance, provenance orders within it.},
  check    = {unwitnessed},
  note     = {kind=finding by=agda-oracle of=agda_defs.cycle_cuts ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A minimum feedback arc set has no canonical member, so choosing one by search alone picks working code — equal-cost cuts are indistinguishable to the solver and only provenance about which edge was intended can rank them, which no reader currently supplies}
}

@misc{agda-F17-applied-import-is-not-bare,
  section  = {cycle detection},
  claim    = {An APPLIED import is not a bare edge, and a keyword-only bareness check cannot see it. 'open import M a b c' fills M's parameter telescope and carries no using/renaming/hiding/public keyword, so the first cut of agda_imports.drop_import passed it and DELETED 'open import Substrate.Groups.Coxeter.ListPresentation Gen Canonical-ex c-e insert insert-canonical-ex' — a deliberate, commented, five-argument rewire — as if it were a guessed edge. Recovered from the tool's own snapshot. The tell is ARGUMENTS AFTER THE MODULE NAME, which a keyword census does not read. Same shape as the census-keyed-on-one-spelling class: the guard answered the question asked, not the one meant.},
  check    = {standing},
  note     = {kind=finding by=agda-oracle of=agda_imports.drop_import ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): An APPLIED import is not a bare edge and a keyword-only bareness check cannot see it — 'open import M a b c' carries arguments the import ban's reader treats as absent, so a census of bare imports under-reports by exactly the applied population}
}

@misc{agda-F1-rekey,
  section  = {finding},
  claim    = {agda-F1 is keyed on worklist_gate, which is the back-edge and not the fan-out root — the root is run_selftests.py, and killing the named tool leaves the storm running.},
  check    = {standing},
  note     = {kind=finding by=dispatcher. MEASURED FROM A LIVE ps TREE 2026-08-24. The chain is gate_status --peaks then membudget gate:tool-selftests then run_selftests.py --quiet then membudget selftest:worklist_gate.py then worklist_gate.py --selftest then run_selftests.py --quiet again — SIX GENERATIONS observed, each carrying about five concurrent 30-minute selftests. run_selftests runs a 96-suite roster and worklist_gate is a MEMBER of it that also INVOKES it, so the roster contains its own caller. THE OPERATIONAL CONSEQUENCE OF THE MISKEYING IS MEASURED, NOT ARGUED: pkill on worklist_gate left 33 orphans and the total then ROSE from 68 to 100, because the roster root was untouched and kept forking. Only killing run_selftests.py stopped the growth. agda-F1's own text — a bare run melts the box, worklist_gate --project fans out per item — describes a REAL and SEPARATE hazard of that tool which this does not retire. What is wrong is the attribution of the RECURSION. Same census-keyed-on-one-spelling family: the name that appears at every level of the ps output is not the name that owns the defect. STANDING. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): agda-F1 names worklist_gate as the fan-out hazard. WRONG TOOL. The fan-out ROOT is scripts/run_selftests.py, which runs every tool's --selftest across a 96-suite roster. worklist_gate is a MEMBER of that roster that also INVOKES it, so it is the back-edge, not the origin. Measured from a live ps tree 2026-08-24: gate_status --peaks to run_selftests to worklist_gate --selftest to run_selftests, six generations, five concurrent 30-minute selftests each. Killing worklist_gate left 33 orphans and the count then ROSE to 100 because the roster root was still alive. A finding keyed on the child sends the next reader to kill the wrong process.}
}

@misc{gate-F9-fix-notinscope-has-a-suite-and-it-was-red,
  section  = {finding},
  claim    = {fix_notinscope.py DOES have a 56-case --selftest and it was RED at 55/56, on a case pinned to a literal SPPF-collision-index hash that regeneration removed — the resolver was correct and the case reported tree motion as a code defect.},
  check    = {standing},
  note     = {kind=finding by=mode-consolidation-r3. The brief said the tool has no selftest. Its own case comment had already been repointed once with the note 'repoint again', which schedules the false alarm instead of removing it. Fixed by deriving a uniquely-homed hash from the live index, with a non-empty precondition so an emptied index cannot make the case vacuously green. 55/56 to 57/57. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): TWO corrections to the round-3 brief, both meta-F1. (1) The brief said fix_notinscope.py has NO --selftest at all, and named that as the reason 'run the selftest after you change it' was unsatisfiable. It HAS one: a 250-line _selftest at line 1139 dispatching 56 cases, and it is in run_selftests' discovered roster. (2) It was RED at 55/56 before I touched anything — a live failure the brief's premise would have had me paper over by ADDING a second suite beside the one already failing. THE FAILING CASE WAS DATA-DRIFT, NOT A CODE DEFECT: alias_home_from_index('Step<c0e06c56>') pinned a literal hash from scratch/sppf_collision_index.md, and the index has since been regenerated so that hash has ZERO rows (FUSepQReduce/Step is now dd7bab21). The resolver was working correctly the whole time. ⚑ AND THE CASE'S OWN COMMENT PREDICTED THIS, TWICE: it had already been repointed once off Terminal<ac030497> with the note 'when THAT one is paid down, repoint again'. An instruction to hand-repoint on every tree motion SCHEDULES the false alarm rather than removing it — the case reports tree motion as a code defect. Fixed by DERIVING a uniquely-homed hash from the live index instead of pinning one, with a non-empty precondition asserted first so an emptied index cannot make the case vacuously green (the 0/0 shape). 55/56 RED -> 57/57.}
}

@misc{proc-F1-orphans-do-not-reparent-to-pid-1,
  claim    = {On this box orphans reparent to systemd --user (pid 1369), a child subreaper, NOT to pid 1 — so a ppid==1 orphan census reads ZERO over a tree full of orphans.},
  check    = {standing},
  note     = {kind=finding by=process-hygiene. Caught ONLY because procstruct.py --selftest CONSTRUCTS a real orphan (fork a grandchild, kill the middle process, poll the reparent) instead of fabricating a /proc tree — sql-F13 exactly, since a fixture would have been written asserting ppid 1 and would have passed forever. procstruct.reapers() DERIVES the adopting set from self's own ancestry (ancestors that are direct children of pid 1) rather than name-matching 'systemd --user', because a name test standing in for a kind test is the gate-F8 shape. WITNESS -- --reapers prints 1 and 1369. On the same live tree --orphans went 0 to 2 when the discriminator was corrected, over two membudget-run launchers whose subtrees held 534 and 470 CPU-seconds. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): On this box orphans reparent to systemd --user rather than to pid 1 because it is a child subreaper, so a ppid==1 orphan test finds nothing and reports a clean tree — caught only because procstruct --selftest CONSTRUCTS a real orphan rather than asserting over the live tree},
  section  = {finding}
}

@misc{proc-F2-an-orphan-cost-is-its-subtrees,
  claim    = {The cost of an orphan is its SUBTREE's CPU, never its own — a launcher burns ~0 by construction, so a self-CPU floor hides exactly the launcher-with-a-hot-worker shape that both the pkill incident and the fan-out incident produced.},
  check    = {standing},
  note     = {kind=finding by=process-hygiene. MEASURED on the live tree 2026-08-24. Three orphaned 'membudget run' launchers each showed 0.0 CPU seconds of their OWN while their children held 461 and 398 CPU-seconds at 90 percent of a core each, so a self-CPU census reported ZERO orphans while --tree showed the burn one and two layers below. This is the pkill incident seen from the other side -- there a kill reached the launcher and missed the worker, here a census reached the launcher and missed the worker's COST. Same layer boundary, same blind spot, opposite operations, which is why the fix is structural (walk the subtree) rather than a lower floor. procstruct.subtree_cpu sums the descendants and --kill signals leaves-first so no intermediate is re-orphaned mid-sweep. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): The cost of an orphan is its SUBTREE's CPU and never its own, because a launcher burns approximately zero by construction — so a self-CPU floor is anti-correlated with the thing it is meant to find, and measured on the live tree three orphaned launchers held leases while reading as idle},
  section  = {finding}
}

@misc{proc-F3-scratch-findings-py-hangs,
  claim    = {scratch/findings.py does not complete on a bare run or on --register within 120s, burning ~90 percent of a core throughout, so the prescribed 'findings.py --register THEN bibstruct --add' witness-first path cannot be walked today.},
  check    = {standing},
  note     = {kind=finding by=process-hygiene. Observed three times 2026-08-24 -- a bare run was moved to background and killed at 183s and 85.9 percent CPU, --help exited 144 (the harness-kill artifact), and a full --register invocation hit a 90s timeout. procstruct --cost independently caught a second agent's copy at 58s and 92 percent, so this is not one bad invocation. NOT DIAGNOSED -- this agent did not own the file and did not read it, so whether the cost is startup, a scan, or a hang is UNMEASURED and naming one would be an unestablished cause. Findings for this session were filed straight through bibstruct --add, which round-tripped. The separate reader .claude/agents/findings.py is fine and answers instantly. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): DIAGNOSED AND REPAIRED 2026-08-24. scratch/findings.py shares a name with .claude/agents/findings.py, the witness roster every agent is told to call. Three agents reached the wrong file by that name, ran it bare or with --help expecting a mode list, and got a full-corpus sweep at 90 percent of a core. THE HANG WAS NOT A BUG: main() rglobs about 3600 agda modules and runs simplex, triple, def-pair, orbit and coset analyses, by design. What made it a trap is that sys.argv appears ZERO times in the file, so --help, --register and every typo were silently ignored and a reader asking what it does was answered by it doing it — check_argv's founding defect in pure form. Fixed by requiring an explicit --sweep. A bare run now exits 2 instantly, states the cost, and NAMES THE FILE THE READER LIKELY MEANT, because the name collision is the actual hazard.},
  section  = {finding}
}

@misc{proc-F1-cpu-floor-cannot-see-abandonment,
  section  = {finding},
  claim    = {A CPU floor is anti-correlated with abandonment: the quieter an orphan leaks, the more invisible it is to a cost-sorted census, and the lease it holds is never GC'd because its owner pid is alive.},
  check    = {standing},
  note     = {kind=finding by=process-hygiene-r2. Measured 2026-08-24: query_registry and reconstruct orphan subtrees at 0.8s and 0.4s CPU over 163s elapsed were reported by --orphans as below the floor. Fixed as a second predicate on the AGE axis (procstruct --abandoned), never a lower cost floor. Demonstrated on a real constructed orphan reparented to pid 1369: --orphans read 0 and --abandoned read 1 in the same second. Selftest 31/31 to 44/44. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): A CPU floor answers 'what is costing me a core' and is STRUCTURALLY ANTI-CORRELATED with 'what has been abandoned' — the quieter the leak, the more invisible it is to the instrument. MEASURED 2026-08-24: after procstruct --kill --apply cleared two orphan subtrees at 534s and 470s CPU, --running still showed SIX processes; query_registry and reconstruct subtrees at 0.8s and 0.4s of CPU across 163 SECONDS elapsed, every one of them orphaned to the subreaper. --orphans reported them as 'below the floor' — a TRUE statement about their CPU and a FALSE one about their status, and the mode built to reclaim orphans could not see them. THE RESOURCE AT STAKE IS THE ONE THE WHOLE SEMAPHORE EXISTS TO RATION: an orphaned worker under membudget run holds its lease until it exits, and its launcher is already dead so nothing will reap it. The ledger's GC covers a lease whose OWNER PID IS GONE; this population's owner pid is very much alive, just parentless, so GC never fires. FIXED as a SECOND PREDICATE on a DIFFERENT AXIS (procstruct --abandoned, ABANDONED_AGE_S=30s elapsed, no cost floor), never as a lower CPU floor — lowering IDLE_CPU_S toward zero would report every detached shell AND would silently widen --kill. DEMONSTRATED on a REAL constructed orphan (sql-F13): a blocked grandchild reparented to pid 1369 read 'ORPHANED substrate work: 0' from --orphans and 'ABANDONED substrate work: 1 ... QUIET' from --abandoned, in the same second. procstruct selftest 31/31 to 44/44.}
}

@misc{proc-F2-times-is-not-a-read,
  section  = {finding},
