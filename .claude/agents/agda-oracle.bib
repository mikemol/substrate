@misc{agda-F13-reframe,
  section  = {finding},
  claim    = {pycodemod's flag-shaped-operand capability was never missing — the POSIX '--' terminator answers it and predates the finding. The defect was that a swallowed operand silently rebound the path and printed a confident zero instead of refusing.},
  check    = {standing},
  note     = {kind=finding by=mode-consolidation-r2. WITNESS: the check now REFUSES (exit 2) and names '--literal -- --builders scratch/pipeflow.py' as its successor, which returns pipeflow.py:2833. Before the fix the same command printed 0 literal sites in 0 of 824 files — a false zero that propagated two dispatches deep. meta-F1 instance: a COST (undiscoverable escape) briefed as a WALL (swallowed needle). ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): agda-F13 was MISDIAGNOSED as a missing capability / arity defect. pycodemod --literal '--builders' <path> does NOT lack a way to ask about a flag-shaped operand: the POSIX '--' terminator already answers it, was added 2026-08-18 for exactly this question, and is documented at length on _pycodemod_core.flagged_argv/operand_tail. WITNESS: 'pycodemod --literal -- --builders scratch/pipeflow.py' returns the correct site pipeflow.py:2833. The real defect is narrower and worse than briefed: the dispatch SILENTLY REBOUND the path as the needle and printed a confident zero, so the working escape was undiscoverable at the moment of need because the failure presented as a plausible ANSWER rather than an error. FIXED as a REFUSAL rather than a new parsing rule (pycodemod.py, after the OPT_OPERANDS strip): MODES[m].operand makes it decidable, optional operands spelled [x] are exempt, and the refusal names its successor by printing the exact '--' invocation. meta-F1 instance: a COST (undiscoverable escape) briefed as a WALL (swallowed needle).}
}

@misc{agda-F12-reframe,
  section  = {finding},
  claim    = {pycodemod --declare-modes does not mis-report a foreign file's roster — it and toolmodes --divergence measure DIFFERENT authorities (the MODES table vs the USAGE TEXT), so their rosters differ legitimately and both readings were correct.},
  check    = {standing},
  note     = {kind=finding by=mode-consolidation-r2. WITNESS: for pipeflow.py --declare-modes reports 11 of 11 and --divergence reports 5, overlapping in exactly one element (--rendered), because pipeflow has NO MODES table (so all 11 are undeclared by construction) while 6 of its modes ARE in its usage text. No defect in either tool. FIXED the real residue instead: --declare-modes now prints a basis line naming its own authority and disclaiming the --divergence comparison, and says explicitly when a foreign file's count is a tautology. meta-F1 instance: a TRUE READING briefed as a mis-report. ⚑ WITNESS NOTE, moved verbatim from findings.py WITNESSES (2026-09-26): agda-F12 MISDIAGNOSED. 'pycodemod --declare-modes mis-reports another file's roster, disagreeing with --divergence on nearly every element for pipeflow.py' — they disagree because they MEASURE DIFFERENT STATISTICS, and both readings are correct. --declare-modes reports modes DISPATCHED BUT ABSENT FROM THE MODES TABLE (11 of 11 for pipeflow, which has no MODES table at all, so all 11 are correctly undeclared). --divergence reports modes DISPATCHED BUT ABSENT FROM THE USAGE TEXT (5 for pipeflow: --builders --engine --help --no-builders --rendered). The 5 are a SUBSET-in-spirit of the 11 restricted to what a reader cannot see. Only --rendered appears in both because the other 6 dispatched modes ARE documented in pipeflow's usage. No defect found in either tool. meta-F1 instance: a TRUE READING briefed as a mis-report. Residue kept: the two modes' names invite the comparison, and neither output says which statistic it is — a one-line basis statement on --declare-modes would prevent the next reader making the same inference.}
}

