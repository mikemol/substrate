#!/usr/bin/env python3
"""cgroup-scope-touch <MiB> — allocate <MiB> and DIRTY one byte per 1 MiB chunk.

⚑ TOUCHING IS THE POINT. An untouched malloc is never charged to the cgroup, so a
probe that only allocates measures nothing and reports a cap as working when it is
not. Each chunk is written to, which forces the charge.

Held separately from the bash hog because the swap probe needs a SMALL, precisely
sized, promptly-charged allocation, while the 137 demo wants a big slow one.
"""
import sys

mib = int(sys.argv[1]) if len(sys.argv) > 1 else 64
chunks = []
for _ in range(mib):
    b = bytearray(1024 * 1024)
    b[0] = 1                      # dirty the page so the charge lands
    for off in range(0, len(b), 4096):
        b[off] = 1                # every page, not just the first
    chunks.append(b)
print(len(chunks))
