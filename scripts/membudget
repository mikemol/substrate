#!/usr/bin/env bash
# membudget — a recursion-aware concurrent-memory-budget SEMAPHORE over `systemd-run --scope`.
#
# WHY: `systemd-run --user --scope -p MemoryMax=N` caps ONE subprocess tree (kernel kills
# only that scope). This adds a shared cotype ledger so the SUM of concurrent trees stays
# within a global budget — and is RECURSION-AWARE so a membudget-launched job may itself
# call membudget without deadlock or double-counting:
#
#   * TOP-LEVEL run (no MEMBUDGET_PARENT): leases <MB> from the GLOBAL budget and launches
#     the command in a fresh `systemd-run --scope` with MemoryMax=<MB> (one cgroup for the
#     whole subtree).
#   * NESTED run (MEMBUDGET_PARENT set): SUBALLOCATES <MB> from its PARENT's reservation
#     (not the global pool the ancestor already consumed) and runs the command IN-SCOPE
#     (no new cgroup — nested `systemd-run --scope` would make a SIBLING cgroup, escaping
#     the parent's cap; staying in-scope keeps the top-level MemoryMax bounding the subtree).
#   * REFUSE (exit 3) if the relevant budget (global or parent) can't cover the request —
#     so over-subscription is blocked, not OOM'd. A child needed by its parent draws from
#     the parent's reservation (sized for the subtree), so it never deadlocks on the global
#     pool. Leases release on exit + cascade-GC when an owner (or its parent) dies.
#
# Usage:
#   membudget init [TOTAL_MB]              # create/reset ledger (default 70% RAM)
#   membudget status                       # TOTAL / top-level-leased / global-free + lease tree
#   membudget run <MB> <label> -- <cmd...> # lease MB (global or sub), run, release
set -euo pipefail

SELF="$(realpath "$0")"; SELFDIR="$(dirname "$SELF")"
case ":$PATH:" in *":$SELFDIR:"*) ;; *) export PATH="$SELFDIR:$PATH";; esac   # children can call `membudget`
FILE="${MEMBUDGET_FILE:-$HOME/.cache/membudget/budget.cotype}"
LOCK="$FILE.lock"
mkdir -p "$(dirname "$FILE")"
LOCK_TIMEOUT="${MEMBUDGET_LOCK_TIMEOUT:-10}"

# ───────────────────────── LOCK KERNEL — disruption-proof BY CONSTRUCTION ─────────────────────────
# The mutex must survive ANY way a holder can vanish (SIGKILL, the cgroup OOM-killer, session teardown,
# a crash) AND must never let one waiter block forever. Two invariants, enforced here so no other code
# can violate them:
#
#  1. THE LOCK FD NEVER CROSSES A FORK. with_lock OPENS the fd and unlock CLOSES it, so the descriptor
#     exists only inside a critical section — which never forks (pure file-IO). No child (agda, the
#     systemd scope, anything) can inherit it, so the KERNEL releases the lock the instant the holder's
#     last fd closes, i.e. the moment it dies, by any signal. There is no userspace cleanup to be skipped
#     because there is none — death-release is the kernel's job and we never defeat it by leaking the fd.
#     (The starvation bug was exactly this: a persistent fd was inherited by the long-lived child, so a
#     killed holder's lock stayed held by the child's copy → cross-repo deadlock.)
#  2. ACQUIRE IS BOUNDED. flock -w "$LOCK_TIMEOUT" never blocks forever. Because (1) makes a DEAD holder
#     auto-release, a timeout can only mean a LIVE, wedged holder (e.g. SIGSTOP) — with_lock returns
#     non-zero and the caller retries/aborts; it never hangs the machine.
#
# Critical sections must stay pure file-IO (never fork/sleep/wait while holding the lock) so the hold is
# microseconds and (2) effectively never fires in normal operation.
with_lock() {  # → 0 holding the lock (fd in $LKFD); → 1 on timeout, with no fd left open
  exec {LKFD}>"$LOCK"
  flock -w "$LOCK_TIMEOUT" "$LKFD" && return 0
  exec {LKFD}>&-; return 1
}
unlock() { flock -u "$LKFD" 2>/dev/null; { exec {LKFD}>&-; } 2>/dev/null; return 0; }   # brace-group the exec:
# a bare `exec {LKFD}>&- 2>/dev/null` makes the 2>/dev/null PERMANENT (exec+redirect, no command) → it
# silently swallowed the whole script's stderr (own messages, child stderr, tracebacks) for the rest of the
# run. The brace group keeps the fd-close but scopes the 2>/dev/null to the group (stderr preserved).

# Liveness, PID-REUSE-PROOF: a lease owner is "pid:starttime" (field 22 of /proc/pid/stat). A recycled
# PID has a different starttime, so a dead owner's lease can never be kept alive by an unrelated process.
_starttime() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
_alive() { local pid=${1%%:*} st=${1#*:}; kill -0 "$pid" 2>/dev/null && [ "$(_starttime "$pid")" = "$st" ]; }
_self_owner() { printf '%s:%s' "$$" "$(_starttime "$$")"; }

# Target top-level budget: 8 GiB, but never exceed 70% of RAM (safe on smaller boxes).
default_total() { awk '/MemTotal/{p=int($2*7/10/1024); print (p<8192)?p:8192}' /proc/meminfo; }
# ensure(): create the ledger if absent. MUST run UNDER the lock (every caller acquires it first) — the
# create is then serialised, so a cold `make -j` first wave cannot race concurrent `cat >` into a
# truncated/corrupt ledger (a half-written TOTAL_MB read as an empty budget).
ensure() { [ -f "$FILE" ] || cat > "$FILE" <<EOF
# membudget cotype — recursion-aware concurrent memory-budget semaphore (scripts/membudget).
# Global free = TOTAL_MB - Σ top-level LEASE mb; a nested lease draws from its PARENT's mb.
# LEASE <id> <mb> <pid:starttime> <epoch> <parent|-> <label>
TOTAL_MB $(default_total)
EOF
}

gc() { # drop leases whose owner pid died, then cascade-drop leases whose parent vanished
  local tmp chg=1
  while [ "$chg" = 1 ]; do
    chg=0; tmp=$(mktemp "$FILE.gc.XXXXXX")   # SAME dir as $FILE → mv is an atomic rename (never a cross-fs
                                             # copy that can partially fail under /tmp pressure and strand gc)
    while IFS= read -r line; do
      case "$line" in
        LEASE\ *) set -- $line   # $2=id $4=pid:starttime $6=parent
          if ! _alive "$4"; then chg=1; continue; fi                                  # dead owner (or reused PID)
          if [ "$6" != "-" ] && ! grep -q "^LEASE $6 " "$FILE"; then chg=1; continue; fi  # cascade: parent vanished
          printf '%s\n' "$line" >> "$tmp" ;;
        *) printf '%s\n' "$line" >> "$tmp" ;;
      esac
    done < "$FILE"
    # rewrite ONLY when this pass actually dropped a lease. Rewriting unconditionally turned every gc
    # into a ledger-change event → woke every blocked waiter → each ran gc → rewrote again: a self-
    # feeding churn storm that saturated the GLOBAL lock and starved other repos. No drop → no rewrite.
    if [ "$chg" = 1 ]; then mv "$tmp" "$FILE"; else rm -f "$tmp"; fi
  done
}
read_total()    { awk '$1=="TOTAL_MB"{print $2; exit}' "$FILE"; }
budget_of()     { [ "$1" = "-" ] && read_total || awk -v i="$1" '$1=="LEASE"&&$2==i{print $3; exit}' "$FILE"; }
claimed_under() { awk -v p="$1" '$1=="LEASE"&&$6==p{s+=$3} END{print s+0}' "$FILE"; }
_snapshot() {   # ONE awk pass → "<budget> <used>" for $parent (budget empty if the parent vanished). Halves
                # the fork count in the hot poll loop AND shortens the under-lock critical section.
  awk -v p="$1" '
    $1=="TOTAL_MB"            {tot=$2; haveTot=1}
    $1=="LEASE" && $2==p      {pmb=$3; havePmb=1}
    $1=="LEASE" && $6==p      {used+=$3}
    END { if (p=="-") {b=tot; haveB=haveTot} else {b=pmb; haveB=havePmb}
          if (haveB) printf "%s %s\n", b, used+0; else printf " %s\n", used+0 }' "$FILE"
}
_any_dead() {   # lock-free liveness probe: succeed (0) if ANY lease's owner pid is dead. The expensive
                # kill-0 scan must stay OFF the global lock — a blocked waiter only takes the lock for gc
                # when there is actually something to reap, else the herd's scans re-saturate the lock.
  local o
  for o in $(awk '$1=="LEASE"{print $4}' "$FILE" 2>/dev/null); do
    _alive "$o" || return 0
  done
  return 1
}
# release a lease. Best-effort: if the lock is wedged we just return — the lease is reaped later by gc
# (dead owner), so a failed release never leaks budget permanently. NEVER blocks unboundedly.
release()       { with_lock || return 0; grep -v "^LEASE $1 " "$FILE" > "$FILE.t" 2>/dev/null && mv "$FILE.t" "$FILE" || true; unlock; }

cmd_init() { with_lock || { echo "membudget: lock busy (init)" >&2; exit 1; }; rm -f "$FILE"; ensure; [ -n "${1:-}" ] && sed -i "s/^TOTAL_MB .*/TOTAL_MB ${1}/" "$FILE"; unlock; cmd_status; }

cmd_status() {
  with_lock || { echo "membudget: lock busy (status)" >&2; exit 1; }
  ensure; gc                                     # ensure UNDER the lock (serialised create — no init race)
  local t c; t=$(read_total); c=$(claimed_under "-"); unlock
  printf 'membudget: TOTAL=%sMB top-level-leased=%sMB global-free=%sMB\n' "$t" "$c" "$((t-c))"
  awk '$1=="LEASE"{p=($6=="-")?"top":("under "$6); printf "  [%s] %sMB pid=%s (%s) %s\n",$2,$3,$4,p,$7}' "$FILE" \
    | grep . || echo "  (no active leases)"
}

_wait_change() { # block up to $1 seconds for a ledger change (a release), then return to re-check. With
                 # inotify this wakes on the real event (the $1 is just a safety re-poll); without it, $1
                 # IS the poll period — the caller backs $1 off so a long-blocked herd doesn't busy-spin.
  local t="${1:-${MEMBUDGET_POLL:-0.5}}"
  if command -v inotifywait >/dev/null 2>&1; then
    inotifywait -qq -t "$t" -e modify,create,moved_to,delete,attrib "$(dirname "$FILE")" 2>/dev/null || true
  else
    sleep "$t"
  fi
}

_auto_mb() { # Ⓡ.autobudget: a right-sized lease (MB) for the module in "$@", from its peak-mem history.
  # Round the max recorded peak UP to the next POWER OF TWO (floor 64, cap AGDA_MB_MAX=1536 = 1.5GiB).
  # The power-of-2 step IS the safety margin — it sits 2^n ± 2^(n-1) around the need, so peak ∈
  # (2^(n-1), 2^n] leases 2^n with up to a 2^(n-1) headroom band; no extra fudge, no over-rounding
  # (900→1024, not 1536). A lease is a hard kill cap, so rounding UP keeps cap ≥ peak.
  # CEILING 1.5GiB: the full build runs every module at `+RTS -M1024m` and passes, so worst-case maxRSS
  # ≈ 1GB heap + ~0.1GB RTS ≈ 1.1GB < 1536 (measured AES/KAT/SBox hogs peak ~110MB after the round/table
  # decomposition); a peak that would round to 2048 is clamped to 1536, still ≥ the real peak. Default
  # (192) if no history — measured maxRSS tops ~120MB so 192 covers a typical cold module, and the
  # retry ladder 192→384→768→1536 lands exactly on the ceiling (1536 = 192·2³), so a heavy unseen
  # module still self-heals via retry-on-OOM.
  local a mod="" def="${AGDA_MB_DEFAULT:-192}" cap="${AGDA_MB_MAX:-1536}"
  for a in "$@"; do case "$a" in *.agda) mod="$a" ;; esac; done
  [ -n "$mod" ] || { echo "$def"; return; }
  local led; led="$(dirname "$mod")/.agda-times.tsv"
  [ -f "$led" ] || { echo "$def"; return; }
  awk -F'\t' -v m="$(basename "$mod")" -v def="$def" -v cap="$cap" '
    $1==m && $3 ~ /^[0-9]+$/ { if ($3+0>pk) pk=$3+0 }
    END { if (pk<=0) { print def; exit }
          v = 64; while (v < pk) v = v*2          # smallest power of two >= peak (floor 64)
          if (v > cap) v = cap; print v }' "$led" 2>/dev/null || echo "$def"
}

# --- scope backend (D2-prime) -------------------------------------------------
# `systemd-run --user --scope` needs a systemd USER SESSION (a DBus bus). In a
# container whose PID 1 is not systemd it exits 1 with "Failed to connect to bus",
# and that propagates SILENTLY through membudget -> agda-shim -> make.
#
# systemd-run is only a CLIENT of the kernel memory controller. Where that
# controller is directly usable, the same cap is one mkdir and two writes, so we
# create the scope ourselves via scripts/cgroup-scope. Probed on this host:
#   cgroup2 /sys/fs/cgroup/unified -> controllers "cpuset hugetlb" (NO memory)
#   cgroup v1 /sys/fs/cgroup/memory (rw) -> usable; 64MiB cap SIGKILLs a 256MiB hog
#
# _scope_backend picks: systemd (unchanged when a bus exists) | cgroup | none.
# `none` REFUSES rather than running uncapped -- an uncapped agda is the OOM this
# whole mechanism exists to prevent. Override with MEMBUDGET_BACKEND=.
_scope_backend() {
  if [ -n "${MEMBUDGET_BACKEND:-}" ]; then printf '%s' "$MEMBUDGET_BACKEND"; return; fi
  if systemd-run --user --scope --quiet /bin/true >/dev/null 2>&1; then printf 'systemd'; return; fi
  if [ -x "$SELFDIR/cgroup-scope" ] && "$SELFDIR/cgroup-scope" 64 -- /bin/true >/dev/null 2>&1; then
    printf 'cgroup'; return
  fi
  printf 'none'
}

# _launch_scope <mb> <id> -- <cmd...>
# Runs <cmd> under MemoryMax=<mb>M with swap off, exporting MEMBUDGET_PARENT=<id>,
# and propagates the child's exit code VERBATIM (cgroup-kill 137 included -- the
# retry-on-OOM contract keys on 137).
_launch_scope() {
  local mb="$1" id="$2"; shift 2; [ "${1:-}" = "--" ] && shift
  case "$(_scope_backend)" in
    systemd) systemd-run --user --scope --quiet --setenv=MEMBUDGET_PARENT="$id" \
               -p MemoryMax="${mb}M" -p MemorySwapMax=0 "$@" ;;
    cgroup)  "$SELFDIR/cgroup-scope" "$mb" --setenv "MEMBUDGET_PARENT=$id" -- "$@" ;;
    *)       echo "membudget: REFUSED -- no memory-cap backend (no systemd bus; no writable cgroup memory controller)." >&2
             return 3 ;;
  esac
}

cmd_run() {
  local mb="$1" label="$2"; shift 2; [ "${1:-}" = "--" ] && shift
  [ "$mb" = auto ] && mb=$(_auto_mb "$@")          # Ⓡ.autobudget: lease from peak-mem history
  local parent="${MEMBUDGET_PARENT:--}"
  local id; id=$(printf '%04x%04x' "$RANDOM" "$RANDOM")
  local where; [ "$parent" = "-" ] && where="global" || where="parent $parent"
  trap "release $id" EXIT                       # prompt cleanup; if it can't take the lock the lease is still
                                                # reaped by gc (dead owner) — and on hard kill the KERNEL frees
                                                # the lock anyway, so cleanup is guaranteed regardless of the trap.
  # BLOCKING acquire (WaitForSingleObject-style): block while transiently short, wake on a
  # release, re-attempt; REFUSE only the impossible (mb > the level's TOTAL — would block forever).
  with_lock && { ensure; unlock; }              # serialized create, once before the loop (no init race)
  local start announced=0 lastgc=0 backoff; start=$(date +%s); backoff="${MEMBUDGET_POLL:-0.5}"
  while true; do
    # OPTIMISTIC, LOCK-FREE probe. A genuinely-blocked waiter must NOT touch the global lock every poll —
    # that is what starved other repos. Ledger writes are atomic (append a line; gc/release rename-in-
    # place), so a lock-free read sees a consistent-enough snapshot; a stale read only ever UNDER-counts
    # free budget (conservative). The lock is taken ONLY to actually CLAIM (with an authoritative re-check)
    # or for a rate-limited gc — never just to look.
    local budget used free; read budget used < <(_snapshot "$parent")
    if [ -z "$budget" ]; then echo "membudget: REFUSED [$label] — parent lease $parent is gone" >&2; exit 4; fi
    if [ "$mb" -gt "$budget" ]; then            # impossible at this level → refuse, never block
      echo "membudget: REFUSED [$label] — IMPOSSIBLE: need ${mb}MB > ${budget}MB ($where total). Raise the $([ "$parent" = "-" ] && echo 'global budget (membudget init)' || echo 'parent reservation')." >&2
      exit 3
    fi
    free=$((budget-used))
    if [ "$mb" -gt "$free" ]; then              # doesn't fit on the cheap read → before blocking, try to reclaim
      local now; now=$(date +%s)                # DEAD-owner leases (rate-limited; this is the ONLY blocked-path lock,
      if [ $(( now - lastgc )) -ge "${MEMBUDGET_GC_INTERVAL:-2}" ]; then  # at most 1/GC_INTERVAL
        lastgc=$now
        if _any_dead && with_lock; then          # liveness scan is LOCK-FREE; take the lock ONLY to reap
          gc; unlock
          read budget used < <(_snapshot "$parent"); free=$((budget-used))
          [ -z "$budget" ] && { echo "membudget: REFUSED [$label] — parent lease $parent is gone" >&2; exit 4; }
        fi
      fi
    fi
    if [ "$mb" -le "$free" ] && with_lock; then  # looks like it fits → LOCK, re-check authoritatively, then claim
      read budget used < <(_snapshot "$parent"); free=$((budget-used))
      if [ -n "$budget" ] && [ "$mb" -le "$free" ]; then
        printf 'LEASE %s %s %s %s %s %s\n' "$id" "$mb" "$(_self_owner)" "$(date +%s)" "$parent" "$label" >> "$FILE"
        unlock; break
      fi
      unlock                                     # raced — another waiter took it; fall through to block
    fi
                                                 # transiently short → block (or fail-fast / time out)
    if [ -n "${MEMBUDGET_NOBLOCK:-}" ]; then
      echo "membudget: REFUSED [$label] (noblock) — need ${mb}MB, free ${free}MB of ${budget}MB ($where)." >&2; exit 3
    fi
    if [ -n "${MEMBUDGET_TIMEOUT:-}" ] && [ $(( $(date +%s) - start )) -ge "$MEMBUDGET_TIMEOUT" ]; then
      echo "membudget: GAVE UP [$label] after ${MEMBUDGET_TIMEOUT}s — need ${mb}MB, free ${free}MB ($where)." >&2; exit 3
    fi
    [ "$announced" = 0 ] && { echo "membudget: BLOCKED [$label] — need ${mb}MB, free ${free}MB of ${budget}MB ($where); waiting for a release…" >&2; announced=1; }
    _wait_change "$backoff"                       # exponential backoff (cap MEMBUDGET_POLL_MAX): a long-blocked
    backoff=$(awk "BEGIN{b=$backoff*1.6; c=${MEMBUDGET_POLL_MAX:-3}; print (b>c)?c:b}")  # herd polls progressively
  done                                            # less often → fewer racy reads/spurious lock-takes, less CPU
  export MEMBUDGET_PARENT="$id"
  # genlop-style timing: measure ONLY the post-lease run (not the semaphore wait above), record it to
  # the module's per-dir ledger, and PROPAGATE the real exit code (cgroup-kill 137 included). The
  # recording is best-effort and never alters rc.
  local rc=0 rstart rend tf=""
  [ -x /usr/bin/time ] && tf=$(mktemp 2>/dev/null || echo "")   # capture peak-mem (maxRSS) if available
  rstart=$(date +%s.%N)
  if [ "$parent" = "-" ]; then
    echo "membudget: TOP lease ${mb}MB [$label] (global free was ${free}MB) → MemoryMax=${mb}M scope" >&2
    if [ -n "$tf" ]; then
        _launch_scope "$mb" "$id" -- /usr/bin/time -v -o "$tf" "$@" || rc=$?
    else
        _launch_scope "$mb" "$id" -- "$@" || rc=$?
    fi
  else
    echo "membudget: SUB lease ${mb}MB [$label] under $parent (parent free was ${free}MB) → in-scope" >&2
    if [ -n "$tf" ]; then /usr/bin/time -v -o "$tf" "$@" || rc=$?; else "$@" || rc=$?; fi
  fi
  rend=$(date +%s.%N)
  if [ "$rc" = 0 ]; then _record_time "$rstart" "$rend" "$tf" "$@"; fi   # only learn from SUCCESSFUL runs
  [ -n "$tf" ] && rm -f "$tf"
  # RETRY-ON-OOM: a cgroup MemoryMax breach terminates the scope by signal — SIGKILL (rc 137) from the
  # kernel cgroup OOM-killer, OR SIGTERM (rc 143) from systemd's scope-OOM handling; which one fires
  # depends on the systemd version (measured: 143 on systemd-run --user --scope here).  Both are the
  # too-small-lease kill, so retry on either.  (Only TOP leases have their own hard cap.)  If the action
  # is idempotent (MEMBUDGET_RETRY_OOM — the agda shim sets it; an agda compile re-runs cleanly) and
  # there's room to grow, RELEASE the too-small lease and re-enter at the next power-of-2 bucket.
  # Self-corrects a too-tight autobudget guess (then the success records the real peak → history fixes it).
  if { [ "$rc" = 137 ] || [ "$rc" = 143 ]; } && [ "$parent" = "-" ] && [ -n "${MEMBUDGET_RETRY_OOM:-}" ] \
     && [ "$mb" -lt "${AGDA_MB_MAX:-1536}" ]; then
    release "$id"
    local nb=$((mb*2)); [ "$nb" -gt "${AGDA_MB_MAX:-1536}" ] && nb="${AGDA_MB_MAX:-1536}"
    echo "membudget: OOM-killed at ${mb}MB [$label] — retrying at ${nb}MB (idempotent)…" >&2
    export MEMBUDGET_PARENT="$parent"                   # re-enter at the original level (TOP), bigger bucket
    exec "$0" run "$nb" "$label" -- "$@"
  fi
  exit "$rc"
}

_record_time() { # genlop: append <module>\t<seconds>\t<peak_mb> to the module's per-dir .agda-times.tsv
  local rstart="$1" rend="$2" tf="$3"; shift 3
  local a mod=""
  for a in "$@"; do case "$a" in *.agda) mod="$a" ;; esac; done   # the compiled module (last .agda arg)
  [ -n "$mod" ] || return 0
  local dur; dur=$(awk "BEGIN{d=$rend-$rstart; printf \"%.2f\", (d<0?0:d)}" 2>/dev/null) || return 0
  local peak="" kb=""
  [ -n "$tf" ] && [ -f "$tf" ] && kb=$(awk '/Maximum resident set size/{print $NF}' "$tf" 2>/dev/null)
  case "$kb" in ''|*[!0-9]*) ;; *) peak=$(( kb / 1024 )) ;; esac      # KB → MB (the lease unit)
  printf '%s\t%s\t%s\n' "$(basename "$mod")" "$dur" "$peak" >> "$(dirname "$mod")/.agda-times.tsv" 2>/dev/null || true
}

cmd_shell() { # open an interactive shell INSIDE a top-level scope (cgroup auto-contains the
              # whole hierarchy); the membudget-shrc auto-wrap is loaded for per-command sub-budgeting.
  local total; with_lock && { ensure; total=$(read_total); unlock; }   # ensure UNDER the lock
  local mb="${1:-$total}"; shift 2>/dev/null || true; [ "${1:-}" = "--" ] && shift
  local rc; rc="$(mktemp "${TMPDIR:-/tmp}/membudget-rc.XXXXXX")"
  { echo '[ -f ~/.bashrc ] && source ~/.bashrc'; printf "source %q\n" "$SELFDIR/membudget-shrc"; } > "$rc"
  if [ "$#" -gt 0 ]; then cmd_run "$mb" "shell" -- bash --rcfile "$rc" -ic "$*"
  else                    cmd_run "$mb" "shell" -- bash --rcfile "$rc" -i; fi
  rm -f "$rc"
}

case "${1:-}" in
  init)   shift; cmd_init "${1:-}";;
  status) cmd_status;;
  run)    shift; cmd_run "$@";;
  shell)  shift; cmd_shell "$@";;
  *) echo "usage: membudget {init [MB]|status|run <MB> <label> -- <cmd...>|shell [MB] [-- cmd]}" >&2; exit 2;;
esac
