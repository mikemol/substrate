@misc{res-inferred-channel,
  section  = {retract},
  rests-on = {bz-warrants},
  claim    = {An ecosystem-wide conclusion was inferred from a git status: staged-not-committed was read as invisible-to-peers, when the peers had been told to copy from the working tree},
  check    = {traces:../../../linux-sources/docs/gate-ecosystem-comparison.md#prose cannot outlive its sources},
  note     = {kind=retraction by=momentum. WHAT IT RETRACTS lived only in this session's prose, never as a filed claim -- I read git status --short, saw staged-never-committed, and concluded a session staging thirty modules had shipped nothing. The operator corrected it: peers copy from the working tree because commits are not yet green. NO from EDGE, DELIBERATELY. Reuse-search against cassian's DART model settled this: reference-before-declare is REJECTED there rather than placeholder-minted, supersession is a STATE on a node rather than an edge between two, and they hit this exact case and minted nothing. Filing the superseded claim retroactively just to have a target is the entries-whose-only-purpose smell. THE JUSTIFICATION IS THE SIDEWAYS EDGE and it does the work: the warrants discipline holds that prose cannot outlive its sources, which is why an inference recorded only in prose has no anchor and had to be corrected by someone who knew the channel. THE SHAPE OF THE ERROR: a fact about the INDEX reported as a fact about DISTRIBUTION.}
}

@misc{res-inferred-absence,
