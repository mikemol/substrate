% S19/◇10/A116 — one warrant per co-sign subject (a checked claim), plus a closure
% warrant over the whole set. A subject added to host/preparable.tsv without a warrant
% here fails coverage; a warrant with no registry row fails it the other way.

@misc{pb-sysctl,
  section = {playbooks},
  claim   = {The sysctl co-sign playbook is a fresh projection of host/preparable.tsv AND a valid ansible play: regenerating it from the registry reproduces the committed ansible/sysctl.yml byte-for-byte (determinism), and ansible-playbook --syntax-check accepts it (correctness) — the two independent oracles a projected artifact needs},
  check   = {playbook:sysctl}
}
