@misc{g-retry-inverted,
  section  = {distributed-systems},
  term     = {retry budget / thundering herd},
  names    = {vi-microsegmentation vi-drop-not-reject},
  verdict  = {NEARLY},
  rests-on = {r-sre-cascading},
  claim    = {\textbf{Retry budgets and thundering herds --- inverted here, and that is worth saying.} The lexicon's concern is retries OVERWHELMING a system, and the standard remedies cap or randomize them. The DROP-not-REJECT choice engineers FOR the retry instead: dropping rather than refusing lets TCP's own retransmit absorb a conntrack replication race that a REJECT would surface to the application. Same primitive, opposite direction --- so the term is the right one to reach for and the wrong one to claim flat},
  check    = {grounding:g-retry-inverted}
}

