@misc{g-component-focus,
  section  = {method},
  rests-on = {r-heath-coordination-neglect},
  claim    = {\textbf{Component focus, a named sub-mechanism of coordination neglect.} Heath and Staudenmayer argue that organisations attend to PARTITIONING work and PERFECTING COMPONENTS, and systematically under-attend the INTERCONNECTIONS --- not from incompetence, but because lay theories of organizing make division of labour salient and integration invisible. That is "each loop was correct, instrumented, and separately owned, and their interaction was regulated by nothing", stated as a research finding twenty-five years earlier. \textbf{It is also the register-safe term:} it names a general cognitive bias in how humans organise, so it describes a structural condition without characterising any person},
  check    = {grounding:g-component-focus},
  names    = {google-reshape-starvation,google-conjunctive-deadline},
  term     = {coordination neglect / component focus},
  verdict  = {APPLIES}
}

@misc{g-fail-static,
  section  = {sre},
  rests-on = {r-gcp-19009},
  claim    = {\textbf{Fail static, and a public instance of the same two shapes.} The vendor postmortem for the 2019-06-02 networking incident records an automated allocator that "created a list of jobs to deschedule in that physical location, which included the logical clusters running network control jobs" --- descheduling beyond its intended scope --- and debugging "significantly hampered by failure of tools competing over use of the now-congested network", the instruments degraded by the failure they exist to diagnose. Its remediation extended "fail static" mode duration: keep serving the last known good state when the control plane is unavailable, which is a design for surviving a change you cannot complete. \textbf{Cited because it is public and checkable:} the same two mechanisms, in the vendor own words, without resting on any account of an internal programme},
  check    = {grounding:g-fail-static},
  names    = {google-reshape-starvation},
  term     = {fail static},
  verdict  = {APPLIES}
}

@misc{g-error-budget-contrast,
  section  = {sre},
  rests-on = {r-sre-error-budget-policy},
  claim    = {\textbf{Error budget --- and the difference is the whole argument.} Structurally it is the closest thing the field has: a rationed quantity that gates change, where exhaustion stops releases. \textbf{What differs:} an error budget is denominated in reliability, derived from a declared SLO, and deliberately made visible so the change-versus-reliability tradeoff is NEGOTIATED. Change-rate capacity was denominated in machine slots and set implicitly as a byproduct, with no owner, no meter and no feedback. So the sharpest statement of the finding is that \textbf{change capacity was functioning as an error budget nobody had declared, measured, or assigned} --- and the error budget is the existence proof that this class of quantity becomes manageable once it is named. ⚠ Do not claim an error budget was in use; none was},
  check    = {grounding:g-error-budget-contrast},
  names    = {google-change-rate-capacity,google-reshape-starvation},
  term     = {error budget},
  verdict  = {NEARLY}
}

@misc{g-lag-remedies,
  section  = {networking},
  rests-on = {r-rfc7424},
  claim    = {\textbf{What the literature actually recommends --- and it is NOT "change the fabric".} RFC 7424 S4.4 offers alternative placement of large flows onto lightly-loaded members, and redistribution of small flows away from congested ones. Every remedy KEEPS the Ethernet fabric. So moving storage transport off it was not what the standards recommend, and the honest framing is that the recommended remedies were REJECTED FOR A STATED REASON rather than agreed with. \textbf{The RFC supplies that reason itself:} rebalancing is imperfect because "flows arrive and depart at different times", moved flows "may experience momentary packet reordering", and S6.1 states his own TCP argument nearly verbatim --- "reordering is a concern for TCP flows with even a few packets because three out-of-order packets would trigger sufficient duplicate ACKs to the sender, resulting in a retransmission [RFC5681]". So the choice was between an imbalance and a rebalancer that trades it for reordering TCP reads as loss. \textbf{Claim the reasoning, not alignment with the recommendation}},
  check    = {grounding:g-lag-remedies},
  names    = {vi-lag-hashing-limit},
  term     = {large-flow placement and small-flow redistribution},
  verdict  = {NEARLY}
}

@misc{g-knowledge-vaporization,
  section  = {method},
  rests-on = {r-knowledge-vaporization},
  claim    = {\textbf{Architectural knowledge vaporization --- the established term for the neighbourhood, and the distinction survives it.} Jansen and Bosch name the loss of architectural decisions that were never documented and cannot be derived from the models, existing only as tacit knowledge that dissipates when its holders leave. Being unaware of the term is the risk; the term is not the same claim. \textbf{Vaporization is loss of the RECORD:} the artifacts survive, the rationale was never written down, and every remedy the literature offers --- decision records, rationale capture --- presupposes that writing it down AT THE TIME would have preserved it. \textbf{This is loss of the PREMISES.} Both sides of the derivation were replaced at once, each inheriting a system whose reasoning lived in nobody head, so the derivation became UNDERIVABLE rather than merely forgotten: no decision record written at the time would have saved it, because the inputs that made it derivable are gone too. One is recoverable in principle by better practice. The other is not. \textbf{Gloss it against the standard term rather than adopting it}},
  check    = {grounding:g-knowledge-vaporization},
  names    = {google-n-plus-two},
  term     = {architectural knowledge vaporization},
  verdict  = {NEARLY}
}
