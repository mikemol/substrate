  claim    = {\textbf{Hedged requests.} A conjunctive deadline surfaces the tail rather than the mean, so the lever is not making each instance faster but removing the requirement that every one answer --- which is precisely the hedged-request technique. The corpus identifies the lever that breaks the conjunction; Dean and Barroso name it, alongside the tail-at-scale framing for the amplification itself},
  check    = {grounding:g-hedged-requests}
}

@misc{g-bulkhead,
  section  = {distributed-systems},
  term     = {bulkhead pattern},
  names    = {eic-flakeflir eic-concurrency-origin},
  verdict  = {APPLIES},
  rests-on = {r-release-it, r-azure-bulkhead},
  claim    = {\textbf{Bulkhead pattern.} Each unstable vendor ActiveX control was moved into its OWN operating-system process, with data and commands marshalled across a named pipe, so that a control crashing took down a partition rather than the application. That is the bulkhead pattern precisely --- partition the system so a failure cannot consume what the other partitions need --- reached independently on VC6-era Windows, years before the pattern was named and catalogued},
  check    = {grounding:g-bulkhead}
}

@misc{g-crash-only,
  section  = {distributed-systems},
