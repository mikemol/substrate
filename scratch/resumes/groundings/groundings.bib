}

@misc{g-metastable-failure,
  section  = {distributed-systems},
  term     = {metastable failure},
  names    = {google-n-plus-two google-reshape-starvation},
  verdict  = {APPLIES},
  rests-on = {r-metastable-hotos, r-metastable-wild},
  claim    = {\textbf{Metastable failure --- and the corpus has BOTH STATES of the machine, which is the part worth saying.} Bronson decomposes it as stable to vulnerable to metastable, where LOAD moves a system into the vulnerable state, a TRIGGER pushes it to metastable, and a SUSTAINING EFFECT holds it there. The two are distinct claims here and conflating them would overclaim one and lose the other. \textbf{The fleet sizing is a VULNERABLE-STATE claim:} steady state permanently spent the slot planned for transient work, so the fleet sat at effective n+1 against mechanics requiring n+2, and a hardware failure was the trigger. No feedback loop --- a standing condition, and the paper is explicit that systems "choose to run in the vulnerable state all the time because it has much higher efficiency", for years, with the threshold implicit and invisible. \textbf{The reshape starvation is the METASTABLE FAILURE proper,} because the sustaining effect is identifiable: the reshape cannot skip ahead, so tasks ahead of its frontier go stalest, which is exactly what the oldest-first data roller selects --- the lag manufactures the demand that blocks the reshape, and removing the trigger does not clear it. \textbf{And the analytic move the paper prescribes was performed:} refusing to root-cause the incident to the failed hardware, and naming the standing capacity condition instead. Bronson holds that the root cause is the sustaining loop, not the trigger},
  check    = {grounding:g-metastable-failure}
}

@misc{g-hedged-requests,
