@misc{g-gray-failure,
  section  = {distributed-systems},
  term     = {gray failure / differential observability},
  names    = {vi-lag-hashing-limit},
  verdict  = {APPLIES},
  rests-on = {r-gray-failure},
  claim    = {\textbf{Gray failure, and its mechanism, differential observability.} The LAG bad-pair case is the textbook instance: the link is up, health checks are green, and a stable tuple-selected subset of traffic is permanently broken. The system's own observers and its users disagree about whether it is working --- which is the definition, and the reason the condition survives every check built to catch a hard failure},
