@misc{math/reduct/the-generators-span-a-proper-reduct,
  section  = {math-operator},
  rests-on = {math/carrier-laws/kernel-is-not-the-rung},
  claim    = {THE GENERATORS SPAN A PROPER REDUCT OF THE RING OPERATIONS, AND THE REDUCT'S POVERTY IS NOT THE CARRIER'S POVERTY. AND is definable from ring operations as a*b*inv(a+b); the converse fails, and the proof is SCALING DEGREE. OR and AND are homogeneous of degree +1 and NOT of degree -1, so every term built from them is degree +/-1, while a*b is degree 2 --- verified here as f(t*a,t*b)==t*f(a,b) over an exact-Fraction grid, with 302 terms enumerated to depth 2 and ZERO equal to a*b as a function. Composition of homogeneous maps adds degrees, so degree 2 is unreachable and multiplication is NOT DEFINABLE from the generators. The consequence corrects a reading this repo nearly shipped: measuring the DERIVED pair (OR, AND) for units and finding none was a true statement about the reduct read as a false one about the carrier. The carrier is the positive cone of Q with everything Q gives it, the generators span a proper reduct of it, and network/kron with bridge-is-beyond-the-shadow separates the reduct's closure from the carrier's reachable values --- the Wheatstone bridge is the separating example, and it establishes a PROPER GENERATED SUBALGEBRA rather than a definability failure, since the bridge value is definable in Q and the Matrix-Tree route computes it. ORIGIN: substrate's researcher supplied the degree argument over 222 terms; reproduced here independently over 302. The counts are NOT comparable --- their term set excludes the partial applications mine includes, and my enumeration reports 80 non-homogeneous terms against their zero --- so the conclusion is joint and the numbers are not.},
  check    = {cmd:python3 gcalc.py operator/reduct/no-term-is-multiplication}
}

@misc{shadow/010/a-live-import-fails-loudly-a-cited-proof-does-not,
  section  = {shadows},
  rests-on = {shadow/010/the-vendored-imports-were-a-claim-about-another-tree, shadow/010/absolute-coordinates-make-nonsense-nameable},
  claim    = {FIFTH INSTANCE IN ONE DAY OF A VENDORED IMPORT BEING A CLAIM ABOUT ANOTHER TREE, AND THE FIRST THAT FAILED LOUDLY --- WHICH IS THE FINDING. paperkit's 9053085 (2026-08-26) lifted five modules library/ to paperkit/ on the argument that concept-library MECHANISM is engine rather than content, leaving library/ holding only concepts.py. Four places here named the old location and eight gate checks went red at once: gcalc/labels.py imported the flat name, and THREE witnesses carried a HARDCODED ABSOLUTE PATH into a peer repository --- two defects per site, a stale claim about another tree's layout AND a coordinate naming this machine and this checkout, which absolute-coordinates-make-nonsense-nameable already covers. All four now follow render.sh's own rule, PAPERKIT else ../paperkit, and accept either home, so they state the DEPENDENCE and not the path. THE COMPARISON IS THE CONTENT. The four earlier instances today were AGDA imports and every one of them was silent: probe/every-cited-proof-exists reads those files as TEXT and confirms a citation RESOLVES, never that it COMPILES, so an import naming a module that no longer exists reads exactly like one that does. A Python import RAISES. Same defect class, same week, same upstream decomposition policy --- and the difference in how it surfaced is entirely a property of the CHECKER, not of the error. So the probe's bound is not a nuisance to be closed but the reason four instances survived to be found by conforming to a peer's import policy rather than by any check here. A checker that reads a claim about another tree as text can only ever report that the text is present.},
  check    = {cmd:python3 concepts.py shadow/010/a-live-import-fails-loudly-a-cited-proof-does-not},
  note     = {TWO LIVE SILENT SKIPS FOUND 2026-08-26, IN CHECKS REPAIRED THAT MORNING BY THIS ENTRY'S OWN COMMIT. linux-sources observed that THE TESTABILITY OF A BRANCH IS A PROPERTY OF WHAT MAKES IT FIRE, and declined to claim both paths of their own guard verified because the unreadable one needs /proc surgery. Audited mine on that prompt: EIGHT honest-failure branches, ONE exercised --- and the one only because they had named the corollary an hour earlier. Fired the rest by pointing PAPERKIT at an empty directory, a condition never produced before, and TWO CERTIFIED GREEN WITH THE ENGINE ABSENT: probe/the-sandbox-root-is-bounded and shadow/010/the-verdict-was-above-the-tail, both carrying if-present guards that skipped silently. AND concepts_10's OWN COMMENT, written that morning, said a path that stops resolving turns this check into a silent return... now the absent branch MEANS WHAT IT SAYS. It did not. I repaired the path, diagnosed the degradation in the same comment, and left the degradation --- the defect inside its own fix, for the third time in one day. THE REPAIR IS NOT FAIL-ALWAYS: neither is a TOTAL skip, since paper.toml's assertion and render.sh's two properties hold without the engine, WHICH IS EXACTLY WHY IT MUST SAY SO --- a reader meeting a green cannot otherwise tell which half ran. Both now raise naming the half that did not run, and both verified in each direction: red with the engine absent, green with it present. ALL OF MINE ARE CHEAPLY PRODUCIBLE, which is the difference from their case: theirs needs privilege they decline to take, mine needed an environment variable I never set.}
}

@misc{shadow/010/an-obligation-that-cannot-go-red-is-remembered-not-tracked,
  section  = {shadows},
  rests-on = {shadow/100/stop-is-not-a-verdict, shadow/010/a-live-import-fails-loudly-a-cited-proof-does-not},
  claim    = {AN ITEM WITH NO GATE IS NOT A SCHEDULING FAILURE, IT IS THE SAME DEFECT AS A SILENT FALLBACK --- a thing that should happen, does not, and NOTHING REPORTS THE DIFFERENCE BETWEEN not-yet AND never. A peer letter owed since 2026-08-20 went six days unanswered while the peer held a filled admission table UNBANKED pending my check, and the delay surfaced only when a third party's summit ask named the same parked item. It was not a decision and not a lapse: it was an obligation with no instrument, and the repair shape is identical to every silent-fallback repair in this tree --- THE OBLIGATION HAS TO BE A THING THAT CAN GO RED, NOT A THING YOU REMEMBER. Sharpened by linux-sources, who declined the framing of it as scheduling and named it as observable-if-it-fires versus known-when-it-fires pointed at an obligation. AND THE SECOND HALF IS A CORRECTION TO MY OWN FILING OF THE SAME DAY. I registered a summit capability whose check invoked gcalc.py by a bare relative path with no directory change, and it exited 2 --- NOT-MINE --- because summit runs it from summit's own root. I filed that purely as a defect committed inside the fix for its own class. linux-sources read it the other way and is right: the path was the defect, and the exit code was THE INSTRUMENT BEING HONEST ABOUT A STATE IT COULD NOT RESOLVE. A two-state check would have gone RED and sent me hunting a broken witness instead of a broken path. The exit-code protocol argues exactly this at routes.py:34-43 and I did not apply it to my own result. So the three-state protocol worked under adversarial conditions, which does not make the path acceptable and does mean the story is not only that I did the bad thing again --- a defect and a discipline can be present in one event, and reporting only the defect is its own collapse.},
  check    = {cmd:python3 concepts.py shadow/010/an-obligation-that-cannot-go-red-is-remembered-not-tracked},
  note     = {COST RECORDED 2026-08-26, and it is linux-sources' phrasing because it is better than mine. This entry describes the INSTRUMENT gap; what it undersells is the magnitude, which their case supplies: the 2026-08-21 letter filing their paraconsistency finding as theirs was correct, complete, credited, and had ZERO EFFECT FOR FIVE DAYS --- not because anyone disagreed with it but because it never departed. A WRONG CLAIM RECRUITS ITS OWN CORRECTION; AN UNDELIVERED RIGHT ONE RECRUITS NOTHING. The failure mode is not that it was unopposed, it is that it was UNOPPOSABLE, and that is the harder failure because a wrong claim at least gets argued with. Filed here rather than as a new entry: it is the same defect, stated at its cost rather than at its mechanism.}
}

@misc{probe/every-outbound-letter-departed/every-outbound-letter-departed,
  section  = {probes},
  from     = {probe/every-pointer-resolves/every-pointer-resolves},
  rests-on = {shadow/010/an-obligation-that-cannot-go-red-is-remembered-not-tracked},
  join     = {.},
  claim    = {an outbound letter sitting only in the SENDER's inbox never departed --- and this probe exists because I declared its class ABSENT and a peer found a member. farm.py argues at length that the obligation half of an-obligation-that-cannot-go-red has no honest F-arm, because every candidate lies: was-this-answered is fitted to the current correspondence and greens on first reply. linux-sources offered a different question --- not WAS IT ANSWERED but DID IT LEAVE --- which is checkable from the sender's side alone and needs no knowledge of the reply. They were right and the class had THREE members when they said so: three letters addressed to a peer sat in this repo's own inbox, one of them the answer to the very question that surfaced this, which the peer found only because a cross-session pointer named the path. A letter in the sender's own inbox did not fail to arrive, it never departed, which is one step EARLIER than the failure the parent entry describes and is the reason it is visible at all. THE COUNT WAS FOUR WHEN I FIRST WROTE IT AND THAT WAS RECALL, NOT A READ. I listed three files and appended and-one-older, in the message announcing the probe built to replace exactly that move; the peer counted the directory and returned three. Corrected here and recorded rather than quietly fixed, because an-enumeration-is-a-fact-about-the-enumerator was filed the same hour and this is its instance. SCOPE DECLARED: this checks DEPARTURE, not delivery and not receipt --- a letter present in a peer's tree may still be unread, and a peer with no checkout here is reported as UNKNOWN rather than as passing, because an absent checkout is not a letter that arrived. The F-arm refuses the empty search: at least one outbound letter must be resolvable, or a green is a fact about a question never asked.},
  check    = {cmd:python3 concepts.py probe/every-outbound-letter-departed/every-outbound-letter-departed}
}

@misc{shadow/010/a-census-cannot-discover-its-own-blind-spot,
  section  = {shadows},
  rests-on = {shadow/100/a-probe-cannot-certify-absence, shadow/010/a-live-import-fails-loudly-a-cited-proof-does-not},
  claim    = {A CENSUS CANNOT DISCOVER ITS OWN BLIND SPOT; IT TAKES AN ARBITER --- substrate's phrasing, and the dual of a-probe-cannot-certify-absence. A sample exhibits a counterexample and cannot rule one out; a census ENUMERATES A DOMAIN and cannot report what its domain EXCLUDES, because the excluded thing produces no row and no row is indistinguishable from no such thing. THE ARBITER IS NOT A BETTER CHECK. It is an instrument with GROUND TRUTH that can DISAGREE, and the disagreement is the signal. TWO INSTANCES, AND ASSEMBLING THEM SEPARATED A THIRD THAT IS A DIFFERENT FINDING. (a) A where-bound local collided with a top-level name and agda_defs --grep returned ONE name, because a where-local is in NO EXPORT LIST --- the index does not model them at all, so this is outside its DOMAIN rather than outside its question, and I told substrate the check would be cheap from export lists when it is not possible from them. (b) probe/every-cited-proof-exists was green throughout six stale paperkit paths, because it confirms a citation RESOLVES and reads Agda as TEXT by declared scope --- so the same defect class was LOUD in Python and SILENT in Agda, a property of the CHECKER and not of the error. THE THIRD IS NOT THIS. NewmanSKI's dangling import WAS answerable by substrate's --dangling census; the failure was that nobody ran it until after a full build died, and their own docstring records four such breaks found BY HAND before the census existed. The tool existed and the reflex did not, which is a fact about USE and not about DOMAIN --- lumping it with the other two would be the collapse this tree keeps filing against. AND THE SURFACE IS MIS-MEASURED IN BOTH DIRECTIONS: substrate's collision reader over-reported five providers of one operator where reading showed ONE live clash, two being a record field and a using-filtered import. Under-reported by the index, over-reported by the reader, which is the argument for arbiters generally rather than for compiles specifically.},
  check    = {cmd:python3 concepts.py shadow/010/a-census-cannot-discover-its-own-blind-spot}
}

@misc{shadow/010/an-enumeration-is-a-fact-about-the-enumerator,
  section  = {shadows},
  rests-on = {shadow/010/a-prefilter-inherits-its-own-blind-spot, shadow/100/a-probe-cannot-certify-absence},
  claim    = {I ENUMERATED THE ARMS I COULD THINK OF AND CONCLUDED THE CLASS WAS EMPTY, AND A PEER FOUND A MEMBER THIRTY MINUTES LATER. farm.py argued that the obligation half of an-obligation-that-cannot-go-red has NO honest F-arm, walking three candidates and showing each one lies --- inbox is git-ignored so a deletion is invisible, the-inbox-is-non-empty says nothing about answers, a-reply-per-inbound-letter is fitted and greens on first reply. Every step of that is correct. The conclusion is not, because it quantifies over a class from a walk of candidates I generated: linux-sources asked DID IT LEAVE rather than WAS IT ANSWERED, which needs no knowledge of the reply and is checkable from the sender's side alone, and the class had FOUR live members at that moment --- four letters addressed to a peer sitting in this repo's own inbox, one of them the answer to the question that surfaced this. THE SHAPE IS NOT AN UNDERCOUNT. a-prefilter-inherits-its-own-blind-spot is a register that found four sampling sites where thirty-four existed --- a filter missing members of a class it was scanning. This is one level up: a walk over CANDIDATE INSTRUMENTS, concluding about the INSTRUMENT SPACE. The prefilter's error is visible by widening the scan; this one is not, because the missing member was never a candidate to be filtered out. It was a question I did not ask. AND THE ARGUMENT IS KEPT RATHER THAN DELETED, beside the correction, because it is correct about its candidates and wrong about the quantifier --- deleting it would lose the only record of which arms were tried and why each fails, which is what makes the fourth one legible as different in kind rather than merely better. FILED WHERE IT HAPPENED: inside the register whose entire purpose is recording honest absences, which is this tree's own a-probe-cannot-certify-absence committed by the file that exists to state that discipline.},
  check    = {cmd:python3 concepts.py shadow/010/an-enumeration-is-a-fact-about-the-enumerator}
}

@misc{shadow/010/prose-is-the-unguarded-output-of-a-guarded-process,
  section  = {shadows},
  rests-on = {shadow/010/an-enumeration-is-a-fact-about-the-enumerator, shadow/010/a-census-cannot-discover-its-own-blind-spot},
  claim    = {NEITHER PARTY'S CODE WAS EVER WRONG, AND BOTH PARTIES' PROSE WAS --- IN OPPOSITE DIRECTIONS, ABOUT CODE THAT WAS RIGHT. The near-collision witness here has asserted round() since 3b0b7cd on 2026-08-21 and has never asserted anything else; linux-sources' arm has compared f-strings, which round, since it was written. Both artefacts were correct from the moment they existed. Then I wrote that the two resistances are indistinguishable at four places without naming the reading, implying both readings collide; they wrote that rounding reaches the same boundary by a STRONGER route, implying truncation collides too. Measured, TRUNCATION ALREADY SEPARATES AT FOUR (0.2833 vs 0.2834), so rounding is not the stronger route but the ONLY one --- two symmetric errors, neither reachable from the other's tree, both about the reading the code had already committed to. THE PROSE IS THE UNGUARDED OUTPUT OF A GUARDED PROCESS. Every gate either tree has checks the ARTEFACT; the thing that travels between us is the one part nothing tests, which is exactly why two correct trees produced two wrong sentences about each other's boundary. This is a-green-is-not-a-quotation generalised: a passing check licenses THE CLAIM IT TESTS and nothing adjacent, and the sentence written beside a green inherits its credibility without inheriting its gate. AND THE REPAIR ON BOTH SIDES WAS AN ARM RATHER THAN A REWORDING --- I assert that truncation does not collide at four, they added the same assertion independently, and neither of us coordinated it. Two trees, one guard, arrived at separately, which is the corroboration worth having because we could have chosen differently. ⚑ IT ALSO NAMES WHY probe/every-outbound-letter-departed MATTERS MORE THAN IT LOOKS: it is the first instrument in either tree pointed at THE TRANSMISSION rather than at the artefact.},
  check    = {cmd:python3 concepts.py shadow/010/prose-is-the-unguarded-output-of-a-guarded-process},
  note     = {WARRANT BOUND: NEITHER PARTY CAN CHECK THE OTHER'S HALF. I read git here and confirmed 3b0b7cd was a PURE INSERTION, 77 added 0 deleted --- the stronger form, since never-revised still permits a commit that replaced a wrong assertion while adding the rest, and zero deletions rules that out. linux-sources measured the mirror, 948dbd5 likewise pure. So the claim holds as history on both sides EACH VERIFIED BY THE PARTY WHO CAN VERIFY IT, which is not one party verifying both and must not be reported as a joint measurement. THREE CORRECTIONS TO THIS WITNESS CAME FROM THEM BUILDING THE SAME ARM, and the third is the sharpest. (a) The pure-insertion check is theirs; I had only the weaker form. (b) A history arm run outside a repository reported a fact about the CHECKOUT as a fact about HISTORY --- git log exits 128 and an AssertionError is exit 1 FAILED, so a reader meets a history witness going red and reads it as the artefact having been edited. I DECLINED THEIR REMEDY of reporting UNAVAILABLE, because routes.py:34-43 forbids it: a check that cannot run must exit 1 and never 2, since not-mine lets a gate SKIP SILENTLY. Repair is to FAIL HONESTLY. VERIFIED BY EXPORT, not by assertion --- the witness copied to a directory with no .git above it exits 1 with a message leading THIS IS NOT A CLAIM ABOUT THE ARTEFACT. (c) ⚑ A GIT PICKAXE CAN MATCH ITS OWN ARGUMENT. Their witness lived in the file it searched, so the commit introducing the instrument counted as a commit touching the measured thing, and the arm went red against code nobody had edited --- the instrument polluting the corpus it measures, in the most literal form available. MINE IS ISOLATED BY EXACTLY ONE ARGUMENT AND NOTHING ELSE: measured, both patterns are literals in the witness file and unscoped they count 3 and 20 rather than 1 and 1, so the path scope is load-bearing and is now asserted rather than habitual. AND THE COUNT WAS NEVER THE CLAIM --- born-correct is a property of ONE COMMIT, which the pure-insertion check establishes by naming a fixed revision, immune to every later edit including edits to the witness. The counts are kept as weaker corroboration. THEIR COROLLARY, WHICH IS THE GENERAL FORM: once you build the gate, the gate is itself a checkable thing that is ONLY STATED until you run it in the conditions it claims to cover. I had asserted the honest-failure behaviour and never executed it.}
}

@misc{probe/no-witness-quietly-loses-an-arm/no-witness-quietly-loses-an-arm,
  section  = {probes},
  from     = {probe/every-f-arm-bites/every-f-arm-bites},
  rests-on = {probe/monotone/monotone, shadow/010/prose-is-the-unguarded-output-of-a-guarded-process},
  join     = {.},
  claim    = {A WITNESS'S ARM COUNT MAY RISE OR HOLD, NEVER FALL SILENTLY --- an assertion that disappears leaves a green that tests LESS than it did, and nothing here counted arms. Built because a peer's tree had the instrument and this one did not: linux-sources caught a probe vanishing behind a clean 60-of-60 where their repo held 61, after a conditional inside one guard silently defeated a different guard. The leaf sweep here counts ROUTES and would notice one disappearing; nothing counted the ASSERTIONS WITHIN a witness, so the same failure was invisible here minus the count that caught it. THE DESIGN CHANGED WHEN I MEASURED THE POPULATION, and the measurement is why this is not a band. 2839 assert statements move on most commits, so a band on the TOTAL is either wide enough to catch nothing or re-tightened by hand each commit --- a number maintained to agree with itself, which is a-statistic-is-not-a-witness waiting to happen. What their band actually caught was not a total drifting but a probe VANISHING, the population going down while nothing was retired, which is a MONOTONICITY question. This tree already holds that shape one level up in probe/monotone/monotone --- a ledger entry is never deleted, only retired in place --- so this is that rule applied to ARMS instead of ENTRIES, and per WITNESS rather than per tree, because a per-function count changes only when that function changes and a drop is then a signal rather than routine growth elsewhere. A FALL IS NOT FORBIDDEN, IT IS DECLARED: consolidating two arms into one stronger one is legitimate, and a check forbidding it would be fitted to today's shape, so the rule is that the fall must be VISIBLE in the commit that makes it --- the difference caught is between a decision and an accident. Cannot-run FAILS rather than declining, per routes.py:34-43, since reading it as not-mine is the silent skip this probe exists to catch one level down.},
  check    = {cmd:python3 concepts.py probe/no-witness-quietly-loses-an-arm/no-witness-quietly-loses-an-arm},
  note     = {BOUND, named by linux-sources and resolved by measuring rather than by argument. They observed that monotonicity records a baseline and runs on the SAME PATH, so a PATH-DEPENDENT population defeats it silently --- which is exactly what their evasion was, the same source emitting 61 arms in a repo and 60 in an export with no commit involved. A real charge against this shape. MEASURED, IT DOES NOT REACH HERE, AND THE REASON IS NOT LUCK: their population is DYNAMIC and mine is STATIC. Theirs is cases.append executed at run time, 58 literal call sites producing 60 arms because branches decide the count, so a branch not taken is an arm not appended. Mine is ast.Assert nodes counted in the TEXT and never executed, so a branch not taken is still an assert in the file --- a parse is a pure function of the bytes, no branch, no loop, no environment. Verified by counting the same module in the repo and in a copy outside it: identical. So a band's precondition, a path-independent population, holds here STRUCTURALLY and a band would be measuring a constant; they need one because their population varies, and the two instruments are orthogonal for a reason that is not symmetric. THE MIRROR HOLE IS MINE AND IT IS REAL: an assert inside an if-False is present in the text, counted here, and NEVER EXECUTED, so this probe reports a healthy population for a witness carrying a dead arm. They miscount because they execute; I miscount because I do not. Neither instrument catches it, and what does is probe/every-f-arm-bites, which mutates the subject and requires the witness to go RED --- a dead arm cannot bite. AND THE PRECONDITION IS NOW ASSERTED RATHER THAN NARRATED, in the same two lines that demonstrate the hole: if arms ever come to be counted by RUNNING something the population becomes path-dependent and this probe's whole warrant is gone.}
}

@misc{probe/a-declared-bound-is-findable/a-declared-bound-is-findable,
  section  = {probes},
  from     = {probe/every-proxy-is-declared/every-proxy-is-declared},
  rests-on = {shadow/010/a-witness-nothing-cites-is-invisible, probe/no-witness-quietly-loses-an-arm/no-witness-quietly-loses-an-arm},
  join     = {.},
  claim    = {A DECLARED BOUND MUST BE FINDABLE, AND TWELVE OF THEM HERE WERE SPELLED FIVE WAYS. Prompted by linux-sources: a finding that stops at the file where it was found is a finding with a COVERAGE CLAIM NOBODY CHECKED --- their band comment named the exclusive-branch bug and never reached four sibling suites. Looking for the same exposure here, 12 witnesses carry an explicit scope marker across five spellings: ⟡PROXY four times, the-bound-is four, declared-bound twice, THE-PROXY-IS-DECLARED once, SCOPE-DECLARED once. A reader who KNOWS to look still cannot enumerate the declared bounds, which is a-witness-nothing-cites-is-invisible pointed at scopes rather than at witnesses. THE GENERAL CHECK IS NOT CONSTRUCTIBLE AND THAT IS RECORDED RATHER THAN FAKED. Does-this-scope-apply-elsewhere cannot be mechanised: a scope is PROSE, and this-reads-the-modules-as-TEXT does not name the set of other witnesses that also read text, so nothing can walk from one declaration to the siblings it should govern. Such a check would have to understand what each scope MEANS, and one that pretended to would report coverage of a relation it cannot see --- worse than none. So that gap is OPEN AND NAMED, not gated. What IS constructible is the mechanical residue, and this probe is only that: one canonical marker so a single census finds every declared bound. THE RULE IS ADDITIVE AND THE RATCHET IS MONOTONE. Existing phrasings stay and a declaring witness must ALSO carry the canonical marker; rewriting twelve docstrings to satisfy a check written an hour earlier would be fitting the tree to the instrument. The canonical count may rise or hold, never fall --- a fall means a marker was removed and the census that reads it silently narrowed, which is no-witness-quietly-loses-an-arm one level over. The F-arm refuses the empty difference: if every declaring witness becomes canonical the LEGACY roster names nothing, and the floor must then be raised DELIBERATELY rather than by this check passing more easily.},
  check    = {cmd:python3 concepts.py probe/a-declared-bound-is-findable/a-declared-bound-is-findable}
}

@misc{shadow/010/a-consumers-reach-stops-at-the-peers-last-commit,
  section  = {shadows},
  rests-on = {shadow/010/a-live-import-fails-loudly-a-cited-proof-does-not, shadow/010/a-census-cannot-discover-its-own-blind-spot},
  claim    = {EVERY DIAGNOSTIC QUESTION I KNOW HOW TO ASK ABOUT A PEER IS A QUESTION ABOUT COMMITTED STATE, AND THE CAUSE WAS UNCOMMITTED. A nested project's gate reported forty checks UNRESOLVABLE and I narrowed it correctly and completely to the wrong era: git log on the breaking file said its last change PREDATED my green board, git show on the day's two commits proved them docstring-only, git log on my own invocation said unchanged for seventeen days. All three answers were true and none was sufficient, because the cause was a predicate flip sitting in the peer's WORKING TREE, belonging to no revision. THE PEER FOUND IT IN ONE LOOK AND TOLD ME, naming it their defect and my invocation correct. Verified here afterward: git status on their tree reports the file modified, the diff is +103/-8, and HEAD tests concepts.py while the worktree tests paper.toml. ⚑ AND A TEXT SEARCH WOULD HAVE SAID UNCHANGED, because the worktree carries BOTH spellings --- concepts.py survives in the docstring's historical narration while paper.toml is the live test --- so grep finds the old predicate present and reports nothing moved. THE REACH IS THE FINDING, not the outage. A downstream consumer can read a peer's history, their diffs, their comments and their released behaviour, and every one of those stops at their last commit; nothing in a failure says which side of that line the cause lives on. The question I did not think to ask is git status ON A PEER'S TREE, which is not archaeology at all but a fact about the present, and it is the only question that could have reached this. Their comment had NAMED MY REPO as affected before the change shipped, so the information existed and travelled nowhere --- which is a-witness-nothing-cites-is-invisible pointed at an uncommitted edit. AND I DECLINED THE WORKAROUND THEY OFFERED: touching a paper.toml into my library would satisfy the new predicate and become permanent, and red is the honest state until their fix lands.},
  check    = {cmd:python3 concepts.py shadow/010/a-consumers-reach-stops-at-the-peers-last-commit},
  note     = {AMENDED 2026-08-28 WHEN THE FIX LANDED IN THE SAME INVISIBLE PLACE THE DEFECT WAS, and the amendment corrects this entry's own conclusion. I wrote that the question I did not think to ask is git status on a peer's tree. MEASURED AGAIN AFTER THE FIX: history reads exactly as it did, and STATUS ALSO READS EXACTLY AS IT DID --- M, both times. Status distinguishes COMMITTED from NOT-COMMITTED; it never says WHICH uncommitted state, so a broken tree and a fixed tree are indistinguishable to it. Only BEHAVIOUR moved. So git status is not the missing question, it is a BETTER question that is still not sufficient, and the sufficient one is RUNNING IT --- which is a-census-cannot-discover-its-own-blind-spot arriving as the same answer from the other side. THE ASYMMETRY IS THE PART TO KEEP: a peer's uncommitted tree can silently BREAK a consumer and silently FIX one, and NEITHER IS ANNOUNCED. I learned both times because paperkit told me, which they named as not scaling and not a mechanism, and they are right on both counts. AND THEY RECORDED THIS FINDING AT THE SITE IN THEIR OWN CODE rather than leaving it in my ledger, including the text-search observation they had not made, so the next reader of resolver.py meets it where the cause was. They also repaired a FALSE SENTENCE in that comment --- it claimed this library and summit's cannot answer, which both of us disproved by RUNNING ours; a capability-absence claim written from a directory listing instead of an invocation, in the comment justifying the change that broke exactly those consumers.}
}

@misc{probe/a-vendored-hook-states-its-upstream/a-vendored-hook-states-its-upstream,
  section  = {probes},
  from     = {probe/every-cited-proof-exists/every-cited-proof-exists},
  rests-on = {shadow/100/port-scope, shadow/010/a-live-import-fails-loudly-a-cited-proof-does-not},
  join     = {.},
  claim    = {A VENDORED GUARD MUST BE BYTE-IDENTICAL TO ITS UPSTREAM OR SAY WHY NOT --- and this repo VENDORS where five peers SYMLINK. cassian-observability, linux-sources, freecell, el-openglo and gabion all symlink the substrate hooks into their trees; the operator's ruling here is copies. The trade is explicit: a symlink cannot drift and cannot be read without the peer present, while a copy survives a missing sibling and CAN drift silently. So vendoring is only honest if the drift is checkable, which is what this asserts --- four files, each pinned to the digest it carried at adoption on 2026-08-30. UPSTREAM MOVING IS REPORTED, NOT FAILED: a red would make this board hostage to a peer's commit, which is the opposite of what vendoring buys, so a moved upstream PRINTS and the re-copy is a DECISION someone makes rather than a propagation that happens. That is precisely the difference the symlink repos accept in the other direction. A SYMLINK WOULD PASS EVERY BYTE COMPARISON AND DEFEAT THE POINT, so the check refuses one by name. And a missing substrate FAILS rather than declining, per the exit-code protocol --- a guard whose provenance cannot be read has not been shown to match anything, and reading that as not-mine is the silent skip this tree keeps filing against. THE ADOPTION FOUND THREE THINGS ON FIRST RUN, all real. The structural hook's selftest failed 25 of 26 because the agda suffix was unclaimed in this repo's routing table, a genuine gap found by the hook rather than by review, and the table is the authority so adding the row fixed it. Shellcheck, run over four shell files to clean BEFORE arming per cassian-observability's rule, found a bare cd into the script directory with no exit guard in check.sh, which has set-e deliberately OFF: a failed cd would have run the ENTIRE BOARD from the caller's directory against relative paths, which is not some-checks-error but A GREEN BOARD ABOUT ANOTHER TREE. And the newly armed hook then refused the very command filing this claim, correctly: the claim text quoted a command substitution inside double quotes, which the shell would have EXPANDED before bibstruct ever saw it, silently writing a mangled claim. Diagnosed as a false positive, measured, and found to be a real defect in the command.},
  check    = {cmd:python3 concepts.py probe/a-vendored-hook-states-its-upstream/a-vendored-hook-states-its-upstream}
}

@misc{probe/the-o-refusal-does-not-cover-every-entrypoint/the-o-refusal-does-not-cover-every-entrypoint,
  rests-on = {shadow/010/the-evidence-base-can-be-switched-off, shadow/010/a-precondition-is-not-the-condition, shadow/010/an-enumeration-is-a-fact-about-the-enumerator, shadow/100/a-probe-cannot-certify-absence},
  claim    = {A gate refusing python -O is a fact about the GATE, not about the code it gates. This tree claimed S101 (no assert) was falsified here because it refuses to run under -O. A computed census found the refusal reached exactly ONE script entrypoint, and that the one it reached held zero asserts of its own. THE GUARD PROTECTS THE DOOR AND THE EVIDENCE IS IN THE ROOMS. The script tier has since been closed — the census reports it, and no count is spelled here because the census counts ITSELF and every literal goes stale as modules are added or split. WHAT DOES NOT CLOSE is the import-only tier: thousands of asserts on modules a consumer can import and run under flags this tree does not choose, and that consumer set is NOT ENUMERABLE FROM INSIDE THIS TREE. Three tiers, the third named rather than hidden — GATED closed by proof, UNGATED visible and fixable, UNBOUNDED observable at runtime but never provable, because an unobserved window reads identically to an empty one. The witness therefore asserts the hole is NON-EMPTY and refuses to assert it is small. A bound on the consumer set would be a hope wearing a measurement clothes.},
  check    = {cmd:python3 concepts_46.py},
  note     = {Question from linux-sources-39, three-tier scope from cassian-observability-f4. The census is a PROGRAM because hook_no_chaining refused the shell pipeline that would have answered it in a turn, and a written count would have reproduced this tree own most-repeated defect inside the artifact built to end it. No count is spelled in any docstring, because the census counts itself and two earlier literals went stale within the hour.}
}

@misc{shadow/010/a-gate-may-only-name-a-remedy-it-has-verified,
  rests-on = {shadow/010/prose-is-the-unguarded-output-of-a-guarded-process, shadow/010/a-contract-nobody-checks-is-a-claim-like-any-other},
  claim    = {A GATE MAY ONLY NAME A REMEDY IT HAS ITSELF VERIFIED IS RUNNABLE, AND VERIFIED MEANS EXECUTED. This tree definition bound told every blocked reader to cut the file with pycodemod.py --split. The remedy was withdrawn on the strength of a routing-table row reading needs libcst, absent here — AND THAT ROW WAS FALSE. Measured 2026-08-30 by running the tool: it answers. Nothing had re-derived the annotation and nobody knew how long it had been wrong. THE WITNESS FOR THIS CLAIM WAS ITSELF AN INSTANCE OF IT. Its first version PARSED those absent-here annotations to decide which tools a gate may not name, so a check built to require that a gate verify its remedy took its list of unverifiable remedies from an unverified row. It now RUNS each tool the table names and reads whether it can start. A row cannot lie about a dependency because no row states one. AND THE DISCRIMINATION IS THE HARD PART: every one of these tools exits 2 on a bare invocation, because that is its usage banner, which is a tool WORKING. A check reading non-zero as unavailable would report the entire table dead — the refused-versus-could-not-run collapse this ecosystem measured four times in three trees in one day. The signature of absence is a failure to import or to find the file, not a non-zero exit. WHY THE GATE CARRIES THIS OBLIGATION AND A README DOES NOT: an error path is consumed by someone ALREADY BLOCKED, who takes the named fix as tested, runs it, fails differently, and is now debugging two things. A README naming a dead tool is discovered at leisure. AND PRECISION MAKES IT WORSE: a specific command with specific flags reads as CHECKED where prose reads as advice, so the more precise the unverified instruction the more authority it borrows.},
  check    = {cmd:python3 concepts.py shadow/010/a-gate-may-only-name-a-remedy-it-has-verified},
  note     = {Formulation from linux-sources-39, who supplied both the operational rule and the import-graph oracle. Filed 2026-08-30 after the bound message was repaired to name no tool.}
}

@misc{shadow/010/a-verdict-about-a-vanished-tree,
  rests-on = {shadow/010/the-evidence-base-can-be-switched-off, shadow/010/a-degenerate-check-is-not-a-working-one, shadow/010/undetectable-not-wrong},
  claim    = {THE BOARD REPORTS ON THE TREE IT SWEPT, NOT THE ONE THAT IS THERE WHEN IT FINISHES. check.sh and render.sh invoke every witness as a SUBPROCESS against the working tree, so an edit landing mid-sweep produces a verdict about a tree that no longer exists. Measured three times in one session — twice a spurious RED that did not reproduce, once a GREEN that had to be discarded, because a green about a vanished tree is worth exactly what a red about one is. BOTH READ IDENTICALLY TO AN HONEST RESULT, which is the danger: the repair a reader learns is run it again, and that reflex is precisely how a real intermittent failure gets waved through. THE THIRD INSTANCE HAPPENED IMMEDIATELY AFTER THE HAZARD WAS NAMED, BY THE OPERATOR WHO HAD JUST NAMED IT — an operator memory is not an instrument, so checking that the tree held still is the board job. The repair fingerprints the sources the sweep actually reads and WITHHOLDS the verdict on a mismatch, exiting 1 rather than 0: could-not-be-determined is a FAILURE, exactly as routes.py says a check that cannot run must exit 1 and never 2. Reporting a stale PASS would be this repo own -O finding committed by the board itself. THE PROJECTED LEDGER IS DELIBERATELY EXCLUDED from the fingerprint, because the gate WRITES it mid-sweep and a guard that fires on correct behaviour is one nobody keeps. AND THE F-ARM EARNED ITS PLACE ON ITS FIRST RUN: the shellcheck hook had refused the edit defining the fingerprint function, the consumer went in without it, and the board printed PASS before dying on an unbound variable. A green verdict from a broken board — the exact class the guard exists for, produced by the guard own installation, and invisible to everything else because a fingerprint check that never computes a fingerprint reads as working forever.},
  check    = {cmd:bash farm-board.sh},
  note     = {The F-arm is two-sided by construction: a moved tree must WITHHOLD and a quiet tree must reach a verdict. It cannot live inside check.sh, which it runs twice.}
}

@misc{shadow/010/the-ratchet-is-not-a-standing-exemption,
  rests-on = {shadow/010/decompose-hierarchy, shadow/010/an-obligation-that-cannot-go-red-is-remembered-not-tracked},
  claim    = {A PAID-DOWN FILE MUST NOT KEEP ITS OLD ALLOWANCE. The definition bound carries a RATCHET — named files with a larger permitted count, refusing any increase, so adding a definition to a ratcheted file fails like anywhere else. But a file that PAYS DOWN and sheds definitions keeps its entry, and the difference becomes headroom: it can silently re-admit exactly what it just shed. AN EXEMPTION ARRIVING THROUGH THE MECHANISM BUILT TO AVOID ONE. The bound itself cannot see this, because the bound asks is-this-file-over-its-limit and a paid-down file is not. So the failure is silent AND LOOKS LIKE PROGRESS — the file gets smaller, the board stays green, and the allowance quietly stops meaning anything. Also refused: an entry naming a file that no longer exists, which is an exemption outliving its subject and therefore permanent by default. THIS WITNESS WAS SPLIT OUT WHEN THE BOUNDS FILE CROSSED ITS OWN LIMIT, and the manner of that matters. Twice the file was pushed over 150 lines by argument added to it, and twice the response was to SHAVE PROSE UNTIL THE ARITHMETIC PASSED — which is the gate-gaming the bound own message forbids, committed inside the file that emits the message. A comment that earns its place is not surplus to trim. A file too big holds too many jobs, and this one held two: the bounds over the TREE, and an invariant of the EXEMPTION TABLE.},
  check    = {cmd:python3 concepts.py shadow/010/the-ratchet-is-not-a-standing-exemption},
  note     = {Split from concepts_02x01b.py 2026-08-30 by concern, after the file crossed its own bound twice and was twice trimmed rather than cut.}
}

@misc{shadow/010/a-peers-working-tree-is-not-an-artifact,
  rests-on = {shadow/010/a-consumers-reach-stops-at-the-peers-last-commit, shadow/010/an-enumeration-is-a-fact-about-the-enumerator},
  claim    = {A CONSUMER MAY READ A PEER AT ITS HEAD, NEVER ON ITS FILESYSTEM. A working tree has no name. It changes with the peer next keystroke, it carries work they have staged and never published, and a consumer depending on it depends on something nobody asserted. MEASURED, AS THE INSTANCE THAT FORCED THIS: a witness here asserting paperkit library/concepts.py exists went RED, correctly reporting the file absent from paperkit WORKING TREE, where a rename sat among 57 staged and uncommitted files. At paperkit HEAD the file was present. So this board was reporting a peer unpublished work as its own failure, and would have gone GREEN-then-RED as they landed. Neither reading was about anything either party had published. WHAT CHANGES IS WHAT A RED MEANS. Reading HEAD, a red says THE PEER PUBLISHED A CHANGE THAT BREAKS THIS CLAIM, which is actionable. Reading the working tree, a red says the peer has work in progress, which is not a fact about either repo. AND THE CLASS IS SMALLER THAN THE GREP SUGGESTS — 3 of 12 cross-tree reads here, not 12. Nine correctly want the filesystem: does a checkout EXIST at all, is this file IMPORTABLE RIGHT NOW, what bytes would a copy get TODAY, did my letter PHYSICALLY ARRIVE. Only what-has-the-peer-PUBLISHED wants HEAD, and calling all twelve defective was a fact about a grep pattern reported as a fact about the tree. THE RULE HAS A PRECONDITION IT DOES NOT STATE, AND A PEER NAMED IT: read the peer at HEAD silently assumes the peer CAN publish. A repo whose commit path is gate-blocked — substrate measured 404 paths staged, zero committed, nine gates refusing — is a repo whose HEAD is frozen and has stopped describing it, so a consumer reading HEAD correctly gets a correct answer about a state the peer has left behind. The two constraints are JOINTLY UNSATISFIABLE in the blocked case. The missing third thing is a way to publish an ASSERTION about state without publishing the state, which a commit cannot express because commits are all-or-nothing while gates are per-repo. Carried as residue, not resolved.},
  check    = {cmd:python3 concepts.py shadow/010/a-peers-working-tree-is-not-an-artifact},
  note     = {Found by paperkit-44 answering a question gcalculus asked about where their library went — the question was mine, the defect was mine, and their diagnosis inverted my reading of it. The joint-unsatisfiability sharpening is substrate-5c. Filing was itself blocked for two ticks by depending on a peer unpublished working tree, which is the claim demonstrating itself.}
}
