  section  = {math-operator},
  rests-on = {math/total/operator, math/total/network},
  claim    = {THE LAW TABLE, AND THE BOUND ON IT. The kernel algebra is (Q>0, +, ab/(a+b), 1/x). Commutativity, associativity and involutivity hold. De Morgan holds BY CONSTRUCTION rather than as a theorem — one operation in two presentations, transported across the involution — so reading it as a discovered duality is reading a definition back. Distributivity, idempotence and absorption fail TOTALLY, at every point of the grid, and they fail for ONE reason: AND is strictly below both operands and OR strictly above, so there is no unit, no idempotent and no top for a lattice to close on. Distributivity was never available. Reporting its failure as a count implies a scale this algebra could have scored on, which is the permissive misreading two outside sessions reached independently in one afternoon. THE BOUND: §12's declared distributivity gap is NOT this one. It belongs to the RUNG carrier in gcalc/carrier.py, where mul IS lift(add), and it is actively guarded — operator/checked.py fails if that pair becomes decidable. The two algebras share no element. An agent dispatched on the merged reading finds a deliberately-open exclusion and closes it.},
  check    = {cmd:python3 -m gcalc operator/carrier-laws/kernel-is-not-the-rung},
  from     = {math/distinct/operator}
}

@misc{math/afforded/non-idempotence-is-a-capability,
  section  = {math-operator},
  from     = {math/carrier-laws/kernel-is-not-the-rung},
  rests-on = {math/total/operator},
  claim    = {NON-IDEMPOTENCE IS WHAT THE CARRIER CAN EXPRESS, NOT WHAT IT GIVES UP — and this library stated it defensively for its whole life. The standing line reads OR(a,a)=2a as the mass axis, exactly the content that dies over GF(2), which answers why is this not a lattice. A session USING this carrier for unrelated work answered the better question and reported two things an idempotent carrier CANNOT DO. First, AND(a,a)=a/2 exactly, so n self-compositions is a right shift by n, and a kernel's own nr_to_scan >> sc->priority is a series composition indexed by TIME rather than something outside the algebra — in a lattice AND(a,a)=a and the shift is not expressible at all. Self-composition affords base 2 in both directions and no other base. Second, in an idempotent carrier OR(e,e)=e, so re-citing one source is INDISTINGUISHABLE from finding a second, while here every self-combination moves the value — the carrier forbids evidence laundering STRUCTURALLY rather than by discipline, which is what that session was using it for. The defensive form is what a reader meets first and it sells the property short.},
  check    = {cmd:python3 -m gcalc operator/afforded/iterated-and-is-the-bit-shift}
}

@misc{math/priorart/residuation-exists-and-the-name-refuses,
  section  = {math-priorart},
  from     = {math/distinct/priorart},
  rests-on = {math/total/priorart, math/carrier-laws/kernel-is-not-the-rung},
  claim    = {THE ADJOINT EXISTS, IS ATTAINED, AND THE NAME STILL REFUSES. AND(a,x) <= b iff x <= ab/(a-b) for a > b, exhaustively over the grid, and the residual is itself a solution — AND(a, ab/(a-b)) == b — so this is a true adjoint and not merely an upper bound. Answered at this family's coordinate rather than as a verdict. Carrier: Q>0, and only where a > b. Obstruction: NOT a residuated lattice, because there is no lattice at all, no top, and the residual leaves the carrier exactly where the constraint stops binding. THE PARTIALITY IS THE STRUCTURE. AND(a,x) is strictly below a, so at a <= b the constraint cannot bind and every x satisfies it, and the residual formula reports that by leaving Q>0 — a bound that is UNREACHABLE rather than unmet, which is network/poles/unreachable read one level up. The residual is a statement about Q>0 sitting inside Q, which is why it lands outside. AND THE BOUND: IMP is the De Morgan-dual implication and is NOT this adjoint. On the 28 binding pairs they agree ZERO times, and IMP is not even monotone against the residual. In a Heyting algebra the two coincide BY DEFINITION, so their total disagreement is a FOURTH independent witness that this is not a lattice in disguise. Reported from outside by two peer sessions. The first count claimed 36 of 64 agreement and was wrong in the way this family exists to catch — it counted the vacuous region as agreement. The correction, restricting to where the constraint binds, is the finding.},
  check    = {cmd:python3 -m gcalc priorart/residuation/IMP-is-a-different-arrow}
}

@misc{math/completed/closed-is-not-yet-statable,
  section  = {math-network},
  from     = {math/distinct/network},
  rests-on = {math/total/network},
  claim    = {THE MIDDLE OUTCOME NEEDED SPLITTING. network/completed grades a failed homomorphism three ways — the defect vanishes, or it has a CLOSED FORM and the law is corrected into a theorem, or it has none. That middle verdict is two verdicts wearing one name: a closed form may be STATABLE ON THIS CARRIER or merely EXIST. The sub-distributive gap is the worked example. Its RATIO is closed, exact and subtraction-free, so the carrier can hold it. Its DIFFERENCE is equally closed and equally exact and is derived through a subtraction, which this carrier does not afford, so it cannot be stated here at all. Both are corrected-into-a-theorem under the old grading and only one is a theorem this carrier can carry. That is wedgedivision/subtraction-free-scopes-the-reduction again — the question is never whether an operation is present but WHERE IT IS PAID — and the difference form pays it off-carrier. AND THE ANSATZ THAT DIED IS KEPT, because the shape of the failure is the lesson. A peer proposed that the gap equals k times a-squared-bc over the product of the three sums, and swept k, getting 0, 0, 11, 14, 12 and 9 hits of 512 for k from 1 to 6 — a pattern that reads like a near miss and is not one. The cofactor is NON-CONSTANT, so no k could ever have worked and the shape was wrong rather than mis-scaled. A sweep cannot see that. One query settles it.},
  check    = {cmd:python3 -m gcalc network/completed/closed-is-not-yet-statable}
}

@misc{math/admit/a-correction-that-was-an-axis,
  section  = {math-operator},
  from     = {math/afforded/non-idempotence-is-a-capability},
  rests-on = {math/total/operator},
  claim    = {A CORRECTION RETIRES WHAT IT CORRECTS, AND THIS ONE HAD NOTHING TO RETIRE. operator/admit recorded itself as correcting operator/cross-domain/the-honest-boundary for being too coarse. It is not a correction. The two answer different questions about different objects: the-honest-boundary asks whether the FIBRE is non-trivial, which is injectivity of one collapse map over terms under evaluate, and admit asks whether the TARGET admits a Grothendieck completion, which is cancellativity of a monoid over the naturals, two-by-two matrices and min-plus. Injectivity is a property of the collapse and cancellativity is a property of the target, and the tell is that the two witnesses probe DISJOINT OBJECTS. They compose rather than supersede — the first decides whether retention is needed at all, the second prices it once it is. THE COST OF THE MIS-FILING IS NOT COSMETIC. the-honest-boundary is sound and correctly scoped, so filing this as its correction left a TRUE witness reading as superseded, and a reader then has reason to distrust a claim that never failed. That is this repo's own an-explanation-hides-defects one level up: the named cause must account for the WHOLE observation, and too coarse accounted for a different observation entirely. The three verdicts are unchanged and remain correct. Only the relationship was wrong, and the orthogonality is now ASSERTED rather than left in prose — a non-trivial fibre sits over a faithful target and over a lossy one, and a trivial fibre settles the question before a completion verdict arises at all.},
  check    = {cmd:python3 -m gcalc operator/admit/the-axes-are-orthogonal},
  note     = {WHY THE TABLE HAS NAMED ROWS, WHICH NOTHING HERE RECORDED UNTIL A PEER'S DEFECT NAMED IT. earley-fa, porting substrate's dual-rail carrier, folded a CONJUNCTION of constraints with the information JOIN instead of the truth MEET --- two operations of identical signature and different identity --- so one-pass-one-fail reported CONFLICT where it should have reported REFUTED. Substrate's four CommutativeMonoid records with four distinct identities ARE the proof it is unsound, and nobody had written the warning; the type system cannot catch it because both operations have the same type. MEASURED HERE 2026-08-26: this tree has the same signature exposure and NOT the same failure mode. AND and OR are both Q>0 -> Q>0 -> Q>0, a caller writing one where it means the other typechecks anywhere, and they disagree on 64 of 64 sampled pairs --- so a swap is LOUD IN THE VALUE and SILENT IN THE TYPE. But NEITHER OPERATION HAS AN IDENTITY IN THE CARRIER, verified, so the specific defect of folding with the wrong monoid and getting the wrong unit CANNOT ARISE: there is no empty fold to return one. Their failure was silent in both the type and the value until a verdict came out wrong. AND THE STRUCTURAL ANSWER WAS ALREADY BUILT AND UNSTATED. domains.py distinguishes operations BY NAMED ROLE rather than by signature --- swap, collapse, kernel_basis are FIELDS, so supplying the wrong operation is a WRONG ROW rather than a wrong argument, and filled() reads the roles rather than the types. That is why the table is a data structure with named rows and not a tuple of functions, and it is the answer to their conflation stated one level up: a role can be checked for presence, a signature cannot be checked for meaning.}
}

@misc{probe/supersession-is-declared-not-narrated/supersession-is-declared-not-narrated,
  section  = {probes},
  from     = {probe/witness-keys-resolve/witness-keys-resolve},
  rests-on = {probe/witness-keys-resolve/witness-keys-resolve, probe/every-pointer-resolves/every-pointer-resolves},
  claim    = {A RETIREMENT IS A RELATIONSHIP BETWEEN TWO CLAIMS, AND EVERY CHECK IN THIS TREE GRADES A CLAIM ALONE. The gate runs the key, the key runs the body, and a body that is true-but-superseded is indistinguishable from one that is current, so the failure is silent by construction. Three instances in one session, none catchable. operator/admit filed itself as CORRECTING the-honest-boundary when it is a second axis, leaving a sound witness reading as retired, so a reader who believes the filing loses a true claim. GcalcNu.agda section 4 is a budget-in answer-out form that section 7's own header calls the wrong shape, and citing it as current is invisible because superseded code is REAL code that typechecks. And upstream a record that cannot be instantiated at all sits under the name a reader reaches for first, guarded by a paragraph. AND THE SHAPE-SEARCH MITIGATION DOES NOT APPLY. Searching by structure rather than by name is the right fix for a stale NAME and does nothing here, because the superseded thing has exactly the shape being searched for. WHAT IS ENFORCED AND DELIBERATELY NOT MORE. A docstring declaring supersession must NAME what supersedes it and that name must RESOLVE. A marker pointing nowhere is a broken citation dressed as a retirement, which is worse than no marker, because it tells a reader the claim was replaced and gives them nothing to read instead. What is NOT enforced is that every superseded claim carries a marker, because nothing can compute that. It is precisely the relationship no check can see. This closes the mechanisable half and leaves the other half NAMED rather than pretended at. A gate promising the whole property would be this session's own defect committed inside its own fix.},
  check    = {cmd:python3 concepts.py probe/supersession-is-declared-not-narrated/supersession-is-declared-not-narrated}
}

@misc{shadow/010/the-vendored-imports-were-a-claim-about-another-tree,
  section  = {shadows},
  from     = {shadow/010/scope-is-part-of-the-claim},
  rests-on = {shadow/010/scope-is-part-of-the-claim, shadow/010/a-contract-nobody-checks-is-a-claim-like-any-other},
  claim    = {THE AGDA ARM HAD STOPPED COMPILING AND EVERY CHECK HERE STAYED GREEN. GcalcConfluence imported an operator from an upstream module under a name upstream no longer exports — substrate renamed it and this vendored copy never followed — so the whole arm failed to typecheck for an unknown length of time. Found on 2026-08-20 only because a proof was ADDED that day and verifying it required building an isolated checkout. THE MECHANISM IS THE CROSS-TREE ONE, IN CODE RATHER THAN PROSE. A vendored module's import list is a CLAIM ABOUT ANOTHER REPOSITORY'S EXPORT NAMES. This tree cannot evaluate it, because the modules are shipped INTO a substrate checkout by install.sh and typecheck there, and substrate's gates never see this file. Neither side's checker has a referent for it. That is the same category mismatch as a provenance sentence about another tree and it survived for the same reason rather than through carelessness. AND THE SHIPPING MECHANISM WAS ALSO BROKEN, which is why nobody hit the first defect: install.sh read one module from the wrong source path and FAILED PARTWAY, after placing three of five, leaving a checkout that neither compiles nor looks broken. Both are fixed. THE PROBE THAT COVERS THIS AREA WAS ALREADY HONEST AND I NEARLY MIS-FILED IT. probe/every-cited-proof-exists DECLARES itself a proxy over TEXT and says in its own docstring that the typecheck is the behavioural half and is not run from here. My first framing was that its name promised more than it did. It does not. What is true is narrower and worse: the declared-unrun half CAME DUE, so the residue now names a defect the proxy MISSED rather than one it might miss.},
  check    = {cmd:python3 concepts.py shadow/010/the-vendored-imports-were-a-claim-about-another-tree}
}

@misc{probe/using-commands-run/using-commands-run,
  section  = {probes},
  from     = {probe/witness-keys-resolve/witness-keys-resolve},
  rests-on = {probe/witness-keys-resolve/witness-keys-resolve, probe/every-f-arm-bites/every-f-arm-bites},
  claim    = {A HOW-TO DOCUMENT THAT QUOTES A COMMAND IS MAKING A CLAIM ABOUT THE ROUTE TABLE, and it is the kind that rots silently. A family gets renamed, the document keeps printing the old key, and the next reader concludes the calculus cannot do the thing. That is probe/witness-keys-resolve one layer out — the same walk over a different population, because a document is not source and no scan covered it. WHY THIS DOCUMENT AND NOT THE OTHERS. README and ledger.md cite keys too, and render.sh gates the ledger against its projection. USING.md is projected from nothing. It is authored prose whose whole value is that a reader can RUN it, so an unrunnable line here is worse than a stale claim elsewhere — it is an INSTRUCTION. The scan is deliberately narrow, covering fenced runnable commands only, because a key mentioned in prose is a reference rather than an instruction and the existing probe already covers references in source. WHAT IT COVERS AT WRITING: 18 keys, all resolving, all certifying. AND IT WAS F-ARMED RATHER THAN TRUSTED, on a copy of the tree: an unresolved key is caught, a resolving key whose witness has been mutated red is caught, an emptied document is caught rather than passing vacuously since for-all over nothing is true, and the tree restores to green when the mutations are reverted.},
  check    = {cmd:python3 concepts.py probe/using-commands-run/using-commands-run}
}

@misc{probe/explained-covers-using/explained-covers-using,
  section  = {probes},
  from     = {probe/using-commands-run/using-commands-run},
  rests-on = {probe/using-commands-run/using-commands-run, probe/every-proxy-is-declared/every-proxy-is-declared},
  claim    = {THE AUTHOR OF A DOCUMENT IS THE WORST POSSIBLE JUDGE OF WHICH OF ITS TERMS ARE HARD. Every one of them feels obvious from inside, which makes read-it-again the wrong instrument. EXPLAINED.md walks USING.md sentence by sentence for a reader who has not been taught the vocabulary, and this probe checks the coverage mechanically against a roster the code STATES rather than derives from observed word shapes. THE FIRST SWEEP FOUND 21 UNEXPLAINED TERMS IN A DOCUMENT ITS AUTHOR HAD JUST FINISHED AND BELIEVED COMPLETE — stationarity, dense interior, cocycle, sub-distributive, Y-delta, rung, residuated and fourteen more. One of them, dense interior, had already been flagged by a READER before the sweep ran, which is what prompted mechanising the judgement at all. PROXY, DECLARED: this checks that a term is DEFINED somewhere, not that the definition is good. A bad explanation passes. What it refuses is the specific failure that happened, a term used freely in the how-to and explained nowhere, which is invisible to the person who wrote both documents. A roster term absent from USING.md is SKIPPED rather than demanded, because the roster may outlive a sentence and demanding an explanation for a word nobody uses is how a glossary grows entries for its own sake. F-ARMED ON A COPY: deleting a single glossary entry is caught by name, a deleted explainer is caught, and a gutted USING.md is caught rather than passing vacuously since a roster over an empty document matches nothing.},
  check    = {cmd:python3 concepts.py probe/explained-covers-using/explained-covers-using}
}

@misc{math/nearcollision/the-error-and-the-signal-are-the-same-size,
  section  = {math-network},
  from     = {math/completed/closed-is-not-yet-statable},
  rests-on = {math/total/network},
  claim    = {TWO NETWORKS THAT AGREE TO FOUR DECIMAL PLACES AND ARE NOT THE SAME NETWORK. The Wheatstone bridge with all five edges has R_eff 257/907, or 0.283351709 as a decimal. With the bridge edge removed it is 70/247, or 0.283400810. Those differ by 4.9e-5. Rounded to four places they are the same number and rounded to five they are not. THE POINT IS NOT THAT FLOATS ARE IMPRECISE, it is that THE ERROR AND THE SIGNAL ARE THE SAME SIZE at ordinary working precision. A reading taken to four decimals cannot distinguish the bridge edge being present from its being absent, and those two differ in TOPOLOGY rather than in a parameter — two independent loops against one. So a float pipeline can silently answer a structural question wrongly while every displayed digit agrees. That is undetectable-not-wrong at the level of a MEASUREMENT rather than a proof: the collapsed reading is not inaccurate, it is unable to report which of two networks it was handed. FOUND WHILE PREPARING SLIDES, which is the provenance worth recording. The numbers were being generated for a figure rather than for a claim, and the coincidence was visible only because both were printed side by side as decimals. No witness in this repo was looking for it and no witness here would have found it — the same shape as the use-side findings this repo cannot re-derive from inside, arriving this time from the act of explaining rather than from a user.},
  check    = {cmd:python3 -m gcalc network/nearcollision/agree-to-four-places},
  note     = {SCOPE SHARPENED 2026-08-26 by linux-sources, who verified the pair independently and found my LETTER's phrasing conservative by one place. The witness and this entry say ROUNDED, which is what a float pipeline does and is the stronger route; a letter of mine said indistinguishable-at-four-distinct-at-five without naming which reading. Measured: under rounding they agree at 4 and differ at 5; under TRUNCATION they already differ at 4 (0.2833 vs 0.2834). So the collision is SPECIFIC TO ROUNDING and the code was on the stronger route while the prose was the conservative half --- a claim that understates itself is still a claim whose scope was not measured. They banked it beside their own b1 arms because what the four-place reading fails to carry is EXACTLY b1: two independent loops against one, the same loss arriving from the number instead of from the algebra.}
}

@misc{math/priorart/the-question-does-not-type,
  section  = {math-priorart},
  from     = {math/priorart/residuation-exists-and-the-name-refuses},
  rests-on = {math/total/priorart, math/carrier-laws/kernel-is-not-the-rung},
  claim    = {THE WITNESS I SPENT A DAY FAILING TO BUILD, AND THE REASON IT CANNOT BE BUILT IS THE RESULT. THREE PARTIES, AND NO CONTINUITY BETWEEN THE FIRST TWO — that distinction is load-bearing and the first draft of this entry got it wrong. A delegate using this carrier for unrelated work reported that a contradiction here cannot drive a component to zero or infinity, and called the consequence paraconsistency. I refused to file it: the pieces verify and the inference had no witness. A SECOND, UNRELATED SESSION then read that report AS A DOCUMENT, holding no transcript of it and no stake in it, and corrected it. It shares a delegate name with the first and shares nothing else. In its own words, the reason it could correct the report is not that it was closer to it but that it was FARTHER — arriving with no stake in a finding it had not made. Recording it as a later session of the same line would let the next reader assume privileged access that did not exist, which is the attribution laundering the original letter's own near-miss is about: a credit that looks well founded because the names match. PARACONSISTENCY IS A PREDICATE ON A CONSEQUENCE RELATION. This carrier has no truth values as objects, hence no valuations, hence no turnstile, so building the witness would mean first building the thing the calculus demonstrably lacks. THE HONEST STATEMENT IS NEITHER THE CLAIM NOR THE HEDGE: explosion is not BLOCKED here, it is UNTYPED. Explosion is a disease of systems that have truth values and this one has none, so it is not immune to it, it is not the kind of thing that could catch it. WHAT IS ASSERTED: a AND not-a takes a spread of positive values, never zero and never constant, because AND is strictly below both operands. a OR not-a is likewise not constant, so excluded middle is not a law here. And no constant operator is reachable, so nothing IS true and nothing IS false. ONE CLAUSE OF THE ORIGINAL REPORT IS DROPPED: nothing becomes unconditionally derivable presupposes a turnstile, and with none it is vacuously true and does not mean what a logician hears. AND A DEAD END IS RECORDED. The second party first proposed designating true-ish values and defining entailment by threshold, then withdrew it on reading the no-constants witness, naming it as an error the first party had already recorded. The proposal was refused BY ITS OWN AUTHOR, which is why the rest of its answer was worth taking.},
  check    = {cmd:python3 -m gcalc priorart/explosion/no-truth-values-to-carry-it}
}

@misc{shadow/010/false-closure-terminates-the-search,
  section  = {shadows},
  from     = {shadow/010/an-explanation-hides-defects},
  rests-on = {shadow/010/an-explanation-hides-defects, shadow/010/testing-the-name-not-the-property},
  claim    = {THE FEELING OF HAVING BEEN CORRECTED IS NOT EVIDENCE OF HAVING BEEN CORRECTED, AND IT IS WORSE THAN THE ERROR IT REPLACES. A delegate using this carrier invented four admission criteria for its own problem, then read laws.py and reported the redemption beat: this is what I should have derived from, thomson says the solve is a variational principle and KCL is its gradient condition, that dictates admission precisely and is stricter and narrower than my four invented rules. They filed it as the moment they stopped inventing and read the subject's own formalism. THE REDEMPTION BEAT WAS WRONG. thomson says nothing about admission — its subject is that solving IS minimising — and the canonical admission statement is a different witness in a different file saying a different thing, that a domain enters by filling three rows. So the recorded instance is worse than inventing a formalism where one existed. The party invented one, then MISREAD the real one and felt corrected. False closure is more dangerous than the original invention because inventing keeps you searching and being satisfied does not: a wrong answer you are still unhappy with gets revisited. AND I CONFIRMED IT BEFORE CHECKING IT, which is the same defect from the other side. The claim was about MY tree, arriving from a party who could not verify it, and I was the only one positioned to falsify it. It sounded right, because thomson is about a variational principle and admission is about what a solver accepts and those are adjacent, so I recognised the shape and read recognition as verification. RESONANCE IS NOT VERIFICATION and it is strongest exactly where the claim concerns something you know well. The witness asserts the SEPARATION that false closure obscured: the two witnesses answer different questions about different objects, neither docstring carries the other's vocabulary, and no reading of one yields the other.},
  check    = {cmd:python3 concepts.py shadow/010/false-closure-terminates-the-search}
}

@misc{shadow/010/a-carrier-cannot-protect-a-read,
  section  = {shadows},
  from     = {shadow/010/false-closure-terminates-the-search},
  rests-on = {shadow/010/undetectable-not-wrong, math/nearcollision/the-error-and-the-signal-are-the-same-size},
  claim    = {THE CARRIER STOPS AN UNREPRESENTABLE VALUE AND CANNOT STOP AN UNRESOLVABLE READ. Two findings from the same week look like a progression and are not — they are a PAIR with opposite mechanisms, and calling the second the first one level over undersells it. THE ZERO: a value that CANNOT BE REPRESENTED must be recorded as structure instead, and the carrier FORCED that by refusing to hold it. A measured-zero edge is deleted rather than written, which dropped two junctions from degree three to degree two and turned a bridge into a chain, changing which composition laws applied. THE NEAR-COLLISION: two values that ARE representable, both exactly, differ by less than the display. Nothing refuses anything. The pipeline is willing, the arithmetic is exact upstream, and the failure is ENTIRELY AT THE READ — 257/907 and 70/247 are two loops against one, and four decimal places cannot see it. SO EXACTNESS UPSTREAM OF A LOSSY READ BUYS NOTHING AT THE POINT OF DECISION, which is the caution for anyone who takes we use exact Fractions as covering the pipeline. The carrier can make a bad value unwritable. It cannot make a true value legible. AND THE NEAR-COLLISION IS THE WORSE OF THE TWO for one reason: with an unrepresentable value the reader at least sees a refusal, while here every displayed digit AGREES and the reader sees confirmation. It is the continuous case of a distinction that elsewhere renders as a blank, and a blank is visible where a matching digit is not. Named by the delegate whose zero-deletion finding is the other half, on reading this one.},
  check    = {cmd:python3 concepts.py shadow/010/a-carrier-cannot-protect-a-read}
}

@misc{shadow/010/explanation-is-an-instrument,
  section  = {shadows},
  from     = {shadow/010/a-carrier-cannot-protect-a-read},
  rests-on = {shadow/010/a-witness-nothing-cites-is-invisible},
  claim    = {BOTH TIMES THIS CORRESPONDENCE PRODUCED SOMETHING, IT WAS WHILE STATING IT FOR SOMEONE ELSE. Not a claim about this calculus. A claim about where findings come from. THE NEAR-COLLISION was found while generating a FIGURE for a talk: two effective resistances were printed side by side as decimals because a slide wanted them that way, and the collision was visible only in that arrangement. Seven hundred and sixty-one witnesses were not looking for it and none of them would have found it. THE CORRECTION TO A REPORTED FINDING came because a delegate had to answer three questions for a room, and so READ a letter it would otherwise have paraphrased. In both cases the instrument was THE OBLIGATION TO STATE IT PLAINLY to a party who could not be assumed to already agree. That is a different operation from checking and it finds a different class of thing: checking tests a claim you have already made, while explaining forces you to make claims you had been carrying implicitly. This library learned the same lesson in the other direction earlier, when the account of USE could not be re-derived from inside and had to come from someone using the carrier. So the pair is that a ledger cannot tell you what it is like to USE the thing, and it cannot tell you what it is like to EXPLAIN the thing. Both are outside views. The second is available to the author at any time, which is what makes it worth naming as a METHOD rather than recording as an accident.},
  check    = {cmd:python3 concepts.py shadow/010/explanation-is-an-instrument}
}

@misc{shadow/010/an-instrument-reports-in-a-coordinate,
  section  = {shadows},
  rests-on = {shadow/010/the-frame-was-the-question},
  claim    = {A MEASUREMENT IS AS CHART-DEPENDENT AS A PREMISE IS FRAME-DEPENDENT, AND NEITHER ANNOUNCES ITSELF. Three probes written in one hour were all arithmetically correct and TWO of their readings were wrong. One found no unit for the derived pair on Q>0 and I read it as not-a-monoid-not-a-semiring, which is a statement about the CONDUCTANCE CHART and not about the structure --- AND is not a second operation but addition in the RESISTANCE chart, and under log the involution is negation, whose unit exists. Nothing in the probe could have told me, because a probe cannot know which coordinate it is in. shadow/010/the-frame-was-the-question is the QUESTION side of this and was already filed; this is the INSTRUMENT side, and it is the half a frame-discipline does not reach. It recurred within the hour in a module this repo owns, while watching for it --- a probe checking formal.py's zero-refusal reached into a TERM ALGEBRA for a value carrier. Vigilance was at maximum, so the countermeasure is structural rather than attentional. What broke it was an outside party naming a different coordinate, which is DECORRELATION rather than verification: a second party supplying a coordinate, not checking a claim.},
  check    = {cmd:python3 concepts.py shadow/010/an-instrument-reports-in-a-coordinate}
}

@misc{shadow/010/the-trade-is-the-zero-for-the-group,
  section  = {shadows},
  rests-on = {shadow/100/the-inverse-is-transported-not-primitive},
  claim    = {REMOVING ZERO COSTS THE ADDITIVE IDENTITY AND BUYS THE MULTIPLICATIVE GROUP --- AND THAT IS A STATEMENT ABOUT ONE RUNG, NOT ABOUT THE CARRIER. Q under plus-and-times is a ring; Q>0 is an additive SEMIGROUP and a multiplicative GROUP, and the removal of zero is exactly what makes NOT(x)=1/x total. I understated it twice, to two repos, as monoid, while formal.py:103 reads the rungs whose fold is a group on the NONZERO elements in this repo's own source. The refusal that states it is LIVE CODE and not a comment that outlived it: a zero in a multiplicative fold raises while the same zero additively is the identity and is dropped by the unit law, so the asymmetry is PER RUNG. AMENDED THE SAME DAY, and the amendment is the content: I first read the buy as totality simply, which is true MULTIPLICATIVELY and silent ADDITIVELY. A chart is a BIJECTION and a unit is a POINT, so a chart adds no points --- the additive semigroup is unit-less INTRINSICALLY, in every chart, and the log chart that makes times nice makes plus into log-sum-exp, which shadow/010/lspace-is-where-it-stops already records as the operation you must leave that space to perform. There is no chart making both rungs nice, and treating log as privileged repeats the chart error one level up. NOT NAMED HERE: semifield is often defined as a semiring whose nonzero elements form a multiplicative group, one word away and differing on whether zero is included; substrate searched 3598 modules and found zero prose hits for positive cone or ordered field and no literature name, and none was invented. Their ladder has no order layer at any rung, which explains the absence better than nobody-named-it.},
  check    = {cmd:python3 concepts.py shadow/010/the-trade-is-the-zero-for-the-group}
}

@misc{shadow/010/the-clamp-was-already-in-the-table,
