@dataclass(frozen=3DTrue)
class Grade:
    transition: str
    purity: str
    locality: str
    effect: str
    @staticmethod
    def _meet_by_rank(a, b, rank):
        return a if rank[a] &lt; rank[b] else b
    @staticmethod
    def _meet_effect(a, b):
        if a =3D=3D EFFECT_INAPPLICABLE and b =3D=3D EFFECT_INAPPLICABLE:
            return EFFECT_INAPPLICABLE
        if a =3D=3D EFFECT_INAPPLICABLE:
            return b
        if b =3D=3D EFFECT_INAPPLICABLE:
            return a
        return Grade._meet_by_rank(a, b, _EFFECT_RANK)
    def meet(self, other: 'Grade') -&gt; 'Grade':
        return Grade(
            transition=3DGrade._meet_by_rank(self.transition, other.transit=
ion, _TRANSITION_RANK),
            purity=3DGrade._meet_by_rank(self.purity, other.purity, _PURITY=
_RANK),
            locality=3DGrade._meet_by_rank(self.locality, other.locality, _=
LOCALITY_RANK),
            effect=3DGrade._meet_effect(self.effect, other.effect),
        )
