def _verify_state(c, r: StateReceipt) -&gt; VerificationResult:
    codeword_fail =3D _check_codeword_consistency(c, r)
    if codeword_fail: return codeword_fail
    instance_fail =3D _check_chart_instance(c, r)
    if instance_fail: return instance_fail
    digest_fail =3D _check_digests(c, r)
    if digest_fail: return digest_fail
    spec =3D get_state_op_spec(r.op_name)
    if spec is None:
        return VerificationResult.fail(
            f"no StateOpSpec for {r.op_name!r}; cannot verify obligation"
        )
    # v12: spec.obligation_level caps the effect_level. All v12 specs say
    # EFFECT_RECEIPT_DECLARED max; v13 with spec.replay() would unlock
    # EFFECT_REPLAY_VERIFIED.
    eff =3D spec.obligation_level
    reason =3D (
        f"codeword {r.codeword:05b} matches op {r.op_name!r}; "
        f"spec.obligation_level=3D{spec.obligation_level}; "
        f"state digests declared"
    )
    return VerificationResult.address_ok(
        locality=3DCHART_LOCAL, effect_level=3Deff, reason=3Dreason,
    )
def _verify_observation(c, r: ObservationReceipt) -&gt; VerificationResult:
    codeword_fail =3D _check_codeword_consistency(c, r)
    if codeword_fail: return codeword_fail
    instance_fail =3D _check_chart_instance(c, r)
    if instance_fail: return instance_fail
    digest_fail =3D _check_digests(c, r)
    if digest_fail: return digest_fail
    # Observations are passive; address verification only.
    return VerificationResult.address_ok(
        locality=3DCHART_LOCAL, effect_level=3DEFFECT_INAPPLICABLE,
        reason=3Df"observation op {r.op_name!r} address-verified (no effect=
 to verify)",
    )
def verify_trace(c, start: int, final: int, receipts: List[Receipt], *,
                 allow_extending: bool =3D False) -&gt; VerificationResult:
    """v12: dispatches on receipt type. Term cursor advances ONLY on
    TermReceipt. allow_extending propagates through."""
    cur =3D start
    overall =3D GRADE_TOP
    total_cells_allocated =3D 0
    counts =3D {REPLAY_VERIFIED: 0, SEMANTIC_REPLAY_VERIFIED: 0, ADDRESS_VE=
RIFIED: 0}
    n_term =3D n_state =3D n_obs =3D 0
    for i, r in enumerate(receipts):
        is_term =3D isinstance(r, TermReceipt)
        if is_term:
            if not c.eq(r.before, cur):
                return VerificationResult.fail(
                    f"chain break at receipt {i}: before #{r.before} !=3D c=
ursor #{cur}"
                )
        step =3D verify_receipt(c, r, allow_extending=3Dallow_extending)
        if not step.ok:
            return VerificationResult.fail(
                f"receipt {i} ({r.op_name}): {step.reason}",
                purity_level=3Dstep.purity_level,
                locality=3Dstep.locality,
                effect_level=3Dstep.effect_level,
                cells_allocated=3Dtotal_cells_allocated + step.cells_alloca=
ted,
            )
        overall =3D overall.meet(step.grade)
        total_cells_allocated +=3D step.cells_allocated
        if step.transition_level in counts:
            counts[step.transition_level] +=3D 1
        if is_term:
            cur =3D r.after
            n_term +=3D 1
        elif isinstance(r, StateReceipt):
            n_state +=3D 1
        else:
            n_obs +=3D 1
    if not c.eq(cur, final):
        return VerificationResult.fail(
            f"final term mismatch: cursor #{cur} !=3D final #{final}"
        )
    return VerificationResult(
        ok=3DTrue,
        transition_level=3Doverall.transition,
        purity_level=3Doverall.purity,
        locality=3Doverall.locality,
        effect_level=3Doverall.effect,
        reason=3D(
            f"{n_term} term ({counts[REPLAY_VERIFIED]} replay, "
            f"{counts[SEMANTIC_REPLAY_VERIFIED]} sem_replay), "
            f"{n_state} state, {n_obs} observation; "
            f"{total_cells_allocated} cell(s) allocated by verifier"
        ),
        cells_allocated=3Dtotal_cells_allocated,
    )
