    binding: Optional[Tuple[Tuple[int, int], ...]] =3D None
    table: Optional[int] =3D None
    registry_digest: Optional[str] =3D None
    op_address_digest: Optional[str] =3D None
    chart_instance_nonce: Optional[str] =3D None
    def __post_init__(self):
        if self.op_name not in _TERM_OPS:
            raise ValueError(
                f"TermReceipt with non-term op_name {self.op_name!r}; "
                f"expected one of {sorted(_TERM_OPS)}"
