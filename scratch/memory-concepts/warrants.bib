@misc{verify-staged-index,
  section = {shared-state},
  tier    = {git probe (scratch repo)},
  claim   = {The pre-commit hook gates the staged INDEX, not the working tree, so a green
             working-tree check proves nothing about what will be committed. The sneakiest
             divergence is STAGE-THEN-EDIT: `git add f` then keep editing f leaves the index
             holding the OLD blob while the working tree holds the new --- the working-tree check
             is green, the staged snapshot is stale, the hook refuses. Verify the staged blob
             (`git show :f`), not the file on disk, after `git add`},
  origin   = {verify-the-staged-index-not-the-working-tree},
  specimen = {a scratch repo (mktemp -d + git init): stage f=v1, then overwrite f=v2 without re-adding},
  evidence = {`git show :f` returns v1 (the staged blob) while `cat f` returns v2 (the working tree)
              --- they DIVERGE, so a check reading the working tree sees v2 and the commit would carry
              v1. NEGATIVE CONTROL: a file staged and left untouched has `git show :g` == `cat g`, so
              the divergence is the stage-then-edit gap, not an artifact of the probe},
  verdict  = {HOLDS},
  check    = {witness:git/staged-index}
}

@misc{git-stash-pop-rewrites-index,
  section = {shared-state},
  tier    = {git probe (scratch repo); the push -- <path> variant is git-version-dependent},
  claim   = {`git stash` snapshots and, on pop, restores the whole INDEX state --- not just the
             files it changed. A default `git stash push` RESETS the index to HEAD, silently
             un-staging a concurrent session's `git add`ed work that the stash never named; the
             window between the reset and the pop is where a peer's commit fails "no changes added
             to commit". So a path-limited stash is not a courtesy to concurrent sessions; the
             index is shared mutable state with no serializer. (The original bite was a
             `stash push -- <onefile>` on 2026-08-19; that path-limited variant is git-version-
             dependent, but the whole-index snapshot on a DEFAULT stash is the durable mechanism.)},
  origin   = {git-stash-pop-rewrites-the-whole-index-not-just-its-file},
  specimen = {a scratch repo: stage a NEW peer.txt, then `git stash push` (default) an unrelated WT change},
  evidence = {after `git stash push` the index is reset to HEAD --- peer.txt, which the stash never
              named, is UN-staged; `git stash pop` restores it. NEGATIVE CONTROL: `git stash push
              --keep-index` leaves peer.txt staged, proving the whole-index reset is a real
              distinguishing property of the default stash and not every stash churns the index},
  verdict  = {HOLDS},
  check    = {witness:git/stash-index}
}

