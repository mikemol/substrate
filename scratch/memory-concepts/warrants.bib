@misc{replayed-measurement-is-fabrication,
  section = {measurement},
  tier    = {code specimen},
  claim   = {A replayed event is a FABRICATED measurement at the wrong time --- so a store
             being down does NOT always mean "buffer and replay when it is back", not for a
             MEASUREMENT/EVENT stream. A replay is worse than a dropped
             one, which is honestly UNMEASURED. A deliberate NO-SPOOL is a correctness stance, not
             a gap to fix. The discriminator: a stream is safe to spool only if delayed delivery
             carries the ORIGINAL timestamp (a metric: value-at-a-stamp, replay re-delivers the same
             point); it must NOT spool if delayed delivery implies the DELIVERY time (an event: the
             value is inseparable from WHEN it was taken). Never add buffering "to help" across a
             migration without confirming the stream's stance, and never assert "resumable" from
             recall},
  origin   = {a-replayed-measurement-is-a-fabrication-not-recovery},
  specimen = {two lanes over an outage window --- a metric lane (stamped) and an event lane (implies delivery time) --- both spooled-and-replayed, in concepts.py},
  evidence = {replaying the metric lane re-delivers the SAME (stamp, value) point, so the replayed
              record equals the original --- honest recovery; replaying the event lane stamps the
              re-send with the delivery time, so the replayed event's time differs from when it
              happened --- a fabricated measurement. The two lanes DIVERGE under the identical
              spool-and-replay operation, and a drop control (unmeasured, not re-stamped) shows the
              honest alternative to the fabrication},
  verdict  = {AGREES},
  check    = {witness:replayed-measurement-is-fabrication}
}

