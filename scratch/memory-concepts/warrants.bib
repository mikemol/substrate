@misc{success-byte-identical-to-failure,
  section = {lie-green},
  tier    = {code specimen},
  claim   = {When your OWN success value and your OWN failure value are the SAME bytes, the
             interface reading that value cannot report which state you are in --- a poll that reads
             it passes in BOTH. A186's oneshot polls cpu.weight for its own 10, but 10 survives in
             tmpfs across a k3s restart, so "my write stands" and "kubelet has not clobbered yet"
             are byte-identical; the file cannot carry the distinction. The fix is to poll the value
             you do NOT own (the racer's signature, whose presence proves the race is over), or
             --- when still indistinguishable --- label the tie AMBIGUOUS (never success), act
             idempotently, and lean on a LATER, differently-timed check as the backstop. Two checks
             at different times beat one that cannot tell the states apart},
  origin   = {success-state-can-be-byte-identical-to-failure-state},
  specimen = {a cpu.weight file reading 10 in both the my-write-stands and pre-clobber states, polled for own-value vs the racer's value, in concepts.py},
  evidence = {the own-value poll (reads 10 throughout) passes IDENTICALLY whether my write stands or
              kubelet is about to land 391 --- it cannot discriminate my success from my failure; the
              out-of-band poll (wait for the racer's 391 to appear, or label the timeout AMBIGUOUS)
              separates them --- so the own-value reading and the racer-signature reading DIVERGE on
              the losing case, and a later differently-timed check catches the loss the first poll
              called success},
  verdict  = {AGREES},
  check    = {witness:success-byte-identical-to-failure}
}

