@misc{nearest-artefact-seductive-wrong,
  section = {claims},
  tier    = {practice},
  claim   = {When a question has several artefacts that could answer it, the one CLOSEST TO
             HAND is the seductive wrong one --- both the easiest to reach and the most likely
             to be about a DIFFERENT referent than the one you need (the crash report over the
             abort path; the hierarchical memory.events counter over memory.events.local; the
             pool-mode docs over the server-release call site; the k3s precedence argument over
             `startKubelet` read straight through; the manifest over /configz; a file's
             birth-time over whether the write actually happened). The discipline that wins is
             NOT "read source" --- that is the frequent INSTANCE; the invariant is refusing to
             answer from the nearest artefact and going to the one that DETERMINES the
             behaviour (the consumer's live view, the call site that sets the flag, the counter
             with the right scope). The TELL you are on the near artefact: you can build a
             confident argument about precedence / merge-vs-replace / which-wins WITHOUT having
             read the thing that does the deciding --- reasoning harder about the near pair will
             not surface the determining one; reading the producer straight through will. Cuts
             both ways: a peer reading source is not immune (a birth-time miss called a correct
             result unfounded), so it is "name the determining artefact, whoever is reading".
             Subsumes read-the-running-system-vs-producer, climb-to-the-authoritative-source,
             and make-the-basis-observable --- each is this invariant in one domain},
  origin   = {the-nearest-artefact-is-the-seductive-wrong-one},
}

@misc{this-box-cutover-unmonitored-read-lane,
  section = {this-box},
  tier    = {practice ruling},
  claim   = {A service cutover (a store moving quadlet -> k8s, host-loopback -> NodePort,
             socket -> TCP) EXPOSES which lanes have no reachability check --- because at the
             cutover BOTH the producer AND the consumer can lose the target and NEITHER side
             would notice. The WRITE lane is typically instrumented (an ingest counter, a
             consumer-verify, a push-bridge reporting rows landed); the READ lane is typically
             BARE (nothing reddens if the store becomes unreachable to a reader). cassian's
             tsdbprobe owns :8428 metrics reachability, but the LOGS store and pg had NO reader
             probe (substrate filed vlogs-has-no-reader, pg-has-no-reader). Why the cutover
             surfaces it: in steady state a working read lane and an unmonitored one look
             identical (both just answer queries); the cutover is the perturbation that would
             break a reader, so it is the moment the missing check would have fired IF it
             existed --- this is each-tier-refutes applied to time. So before a cutover ask not
             just "will producers still reach it" but "would anything go red if a CONSUMER lost
             reach", and if the honest answer is no, SAY SO OUT LOUD rather than let it pass as
             covered. The gap is symmetric and both repos own their half: the store owner adds
             a read-reachability probe, the consumer adds a standing check that reddens when its
             store is unreachable --- do not count the other side's instrumentation as yours},
  origin   = {a-cutover-reveals-the-unmonitored-read-lane},
}

@misc{this-box-rehearse-destructive-on-fixture,
  section = {this-box},
  tier    = {practice ruling},
  claim   = {Before an IRREVERSIBLE / destructive data operation on sacred data (a move, an
             in-place migration, a bulk delete, a schema change), do ONE of: (a) REHEARSE it on
             a throwaway fixture reproducing the real topology (mount layout, ownership,
             sizes-in-miniature); (b) PROVE the load-bearing precondition on a 1-byte probe.
             The cheapest validation tier (a fixture rehearsal) refutes what production cannot
             afford to discover, and skipping it to go straight to the store of record is the
             defect EVEN WHEN every guard you DID build is green. The A193 incident: an UNTESTED
             `find ... -exec mv` across a hostPath<->PVC boundary ran on the live 97G PostgreSQL
             cluster; the paths were different MOUNTS despite one `df` device, so `mv` fell back
             to per-file copy-then-unlink, filled the disk toward ENOSPC, and aborted mid-move
             GUTTING the source. `df`-same-DEVICE is a checkable proxy for the WRONG thing ---
             `rename(2)` needs same-MOUNT --- so prove atomicity on a probe (`mv /a/probe
             /b/probe`; instant = rename, copies = cross-mount), NEVER infer it from df. Prefer
             the safe form copy-ALL -> verify -> delete-source (source intact until verified),
             never per-file mv you might interrupt. Name which hazard CLASS each guard covers
             (two green guards on the wrong hazard is worse than one on the right), and gate
             large transient disk ops on staying BELOW the kubelet eviction threshold (~85% on
             this k3s node) throughout --- crossing it evicts the cleanup that would relieve it},
  origin   = {rehearse-destructive-ops-on-a-fixture-first},
}
