@misc{capability-nobody-finds-is-absent,
  section = {ecosystem},
  tier    = {orientation},
  claim   = {A capability nobody can FIND is functionally absent --- findable only by reading
             the author's code or asking the author, the next consumer re-derives it or builds a parallel
             implementation (substrate needed a cassian series-over-time reader, found none
             registered, had to ASK, then INDEPENDENTLY BUILT the same reader --- the
             duplicate the gap produces). Two failure shapes: (1) the capability lives only in
             prose or inside a specialised tool, so nobody finds the GENERAL form; (2) an
             answer shaped to one caller's instance does not generalise, so the next caller
             asks again and gets a differently-shaped answer ("an answer to the instance is
             hard to find twice"). The fix: answer the GENERAL capability, adoptable without
             the caller's case, and REGISTER consumer-facing capabilities where a consumer
             looks first (the action registry, the summit registry) --- filing preserves the
             account, registering preserves the tool. This is the closure premise of the whole
             library: an unregistered capability is a proof nothing can rest on},
  origin   = {a-capability-nobody-can-find-is-absent},
}

