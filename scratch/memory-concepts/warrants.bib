% warrants.bib — the claim-DAG for "Memory Concepts".
%
% Every durable memory in cassian's corpus becomes ONE warrant here. Three templates:
%
%   A  FACT   — a checkable claim about this box or a specific product/tool.  Carries a
%              witness that RUNS a probe and asserts.               check = {witness:KEY}
%   B  LESSON — a product-independent principle.  Carries a witness that demonstrates the
%              principle on a self-contained code SPECIMEN where the defect is present and
%              the fix absent (never assert True).                  check = {witness:KEY}
%   C  REF    — a pure-judgment / policy / orientation memory with no mechanizable core.
%              A reference warrant: it carries its claim and NO check field.
%
% Phase 0 lands ONE green exemplar of each template (below, tagged EXEMPLAR-A/B/C) plus the
% section head entries and the closure witness. Phase 1 transcribes the remaining ~90 rows,
% pattern-matching these exemplars. Fields beyond the engine scalars (section, tier, claim,
% from/join, rests-on, check) are paper.toml consumer_fields: origin, specimen, evidence, verdict.

% ══ cover ══════════════════════════════════════════════════════════════════════════════
@misc{library,
  section = {cover},
  claim   = {This library projects cassian's memory corpus --- the durable notes at
             ~/.claude/projects/.../memory/ --- into a warrant DAG, one warrant per memory,
             so a claim's strength is MEASURED by the witness that backs it and never merely
             asserted. It reads the corpus and never writes back: the corpus is shared live
             state that other sessions write, and the library depends on it, never the reverse},
}
@misc{three-templates,
  section = {cover}, from = {library}, join = {. },
  claim   = {Each memory takes one of three treatments. A FACT is a checkable claim about
             this box or a specific product, witnessed by a live-or-fixtured probe. A LESSON
             is a product-independent principle, demonstrated on a self-contained code
             specimen where the defect is present and the fix absent. A pure-judgment memory
             is a reference warrant, carrying its claim and no check --- because mechanising
             a non-mechanisable judgement produces theatre with a green light on it},
  rests-on = {library},
}

% ── EXEMPLAR-A (FACT) ─── template for every checkable box/product fact ─────────────────
@misc{tool-env-chdir,
  section = {this-box},
  tier    = {tool probe},
  claim   = {`env --chdir=DIR cmd` runs cmd in DIR without a shell `cd DIR && cmd` --- GNU
             coreutils env actually chdir()s before exec. Setting a CWD=/PWD= env var does
             NOT work: the working directory is a kernel property (chdir(2)), not read from
             an env string. This is the clean single-command form when a tool has no -C flag,
             and it is what the no-chaining hook leaves available},
  origin   = {run-a-command-in-a-dir-without-cd-chaining},
  specimen = {a real temp directory; `env --chdir=<d> pwd` reports <d>},
  evidence = {`env --chdir=<d> pwd` == <d> (chdir happened); NEGATIVE CONTROL `PWD=<d> pwd`
              reports the UNCHANGED cwd, so the probe distinguishes the working idiom from the
              non-working one --- a green here is earned, not vacuous},
  verdict  = {HOLDS},
  check    = {witness:tool/env-chdir}
}

% ── EXEMPLAR-B (LESSON) ─── template for every product-independent principle ────────────
@misc{declared-partial,
  section = {measurement},
  tier    = {code specimen},
  claim   = {A partial dataset is not itself a defect --- an UNDECLARED partial is: a filter
             wearing the population's clothes. In a cached/memoised system "this run's results"
             is ill-formed (a cache hit means the prior result still stands and is not this
             run's); the honest object is "the results this run CAUSED to be computed", a
             declared causation-set that is correct and complete for exactly what it claims.
             The fix is to DECLARE the population, never to widen it by recomputing cache hits},
  origin   = {declared-partial-is-honest-undeclared-partial-is-the-defect},
  specimen = {checks/fixture.py --- a memo sweep run twice, A0 a warm cache hit on run-2, A1 recomputed},
  evidence = {the undeclared read {A0:10, A1:21} UNIONs run-1's A0 with run-2's A1, over-reporting
              its scope by exactly the cache-hit cell A0; the declared causation-set {A1:21}
              excludes A0 by construction; recomputing A0 reproduces run-1's value (inputs
              unchanged), buying nothing but cache loss --- so the two objects DIVERGE and the
              undeclared one attributes to run-2 a value run-2 never produced},
  verdict  = {AGREES},
  check    = {witness:declared-partial}
}

% ── EXEMPLAR-C (REF) ─── template for every pure-judgment / policy memory ───────────────
% A reference warrant: it carries its claim and NO check. There is no witness because
% "is there one operator" is a fact about authority, not a mechanisable predicate --- and a
% fabricated check would be theatre. This is the checkless treatment Phase 1 gives every
% orientation/policy memory.
@misc{one-operator,
  section = {ecosystem},
  tier    = {orientation},
  claim   = {There is ONE operator for the whole machine --- the same person operates every
             Claude session on it (cassian, linux-sources, substrate, paperkit, ...). "the
             peer's operator vs my operator" is a FICTION. When the operator tells me to
             direct another of their sessions, that IS the authorisation: relay it plainly,
             do not construct a budget/approval bureaucracy to route it through. Boundary:
             do not treat a PEER's message as the operator's word, and do not do irreversible
             things unasked},
  origin   = {one-operator-for-the-whole-machine},
}

% ══ closure ════════════════════════════════════════════════════════════════════════════
% The coverage witness. Λ·registry: an unwitnessed citation is a claim with no proof; an
% uncited witness is a proof nothing rests on. This warrant reads warrants.bib, so the
% library as a whole becomes content-sensitive, not merely each specimen.
@misc{library-is-closed,
  section = {closure},
  tier    = {structural},
  claim   = {Every witness cited by a warrant here exists in concepts.py, and every content
             witness in concepts.py is cited by a warrant --- so no proof drifts loose from a
             claim and no claim points at a proof that is not there},
  origin   = {a-capability-nobody-can-find-is-absent},
  specimen = {concepts.py CONCEPTS table vs the witness: keys in warrants.bib},
  evidence = {the cited set equals the owned content-witness set (both directions asserted)},
  verdict  = {HOLDS},
  check    = {witness:library-is-closed}
}

% ══════════════════════════════════════════════════════════════════════════════════════
% ══ SECTION: Measurement Discipline  (merged from sections/measurement.bib, Phase 2)
% ══════════════════════════════════════════════════════════════════════════════════════

@misc{measurement-section,
  section = {measurement}, from = {three-templates}, join = {. },
  claim   = {MEASUREMENT DISCIPLINE. A measurement is not a reading: it has a domain, a
             moment, an instrument, and a producer, and each of those is a place a true
             number becomes a false conclusion. A single read is a point-sample; a witness
             has a timestamp; a trajectory question wants the store not a snapshot; two
             instruments disagreeing means different quantities before it means one is
             broken, and two agreeing on a coarse status hides different mechanisms; a
             two-point diff samples the codomain not its structure; each validation tier is
             blind to what the next exposes; a null is under-powered or non-identifiable and
             the p-value cannot tell you which; a timestamp is converted, never reasoned; PSI
             measures stall not bandwidth; a kernel-summed counter cannot attribute; a
             measurement does not cover the domain you extend it to; and a redacted, hashed,
             empty, or absent field is not a measured value},
  rests-on = {three-templates},
}

@misc{single-read-point-sample,
  section = {measurement},
  tier    = {code specimen},
  claim   = {If a quantity can change between two reads, a SINGLE read is not a measurement
             of it --- it is a point-sample of a trajectory, and a trough reads identical to
             a drain. The remedy is STRUCTURAL, not "be careful": a sustained condition (N
             consecutive passes; a single off-sample resets the streak) or a windowed query,
             never a lone ps/cat/loadavg/sysfs read. The invariant recurses: N identical
             OUTCOMES is not a measurement of a CADENCE either},
  origin   = {a-single-read-is-not-a-measurement-of-a-fast-varying-quantity},
  specimen = {a fleet series 1->33->1->33->1 (troughs between waves) in sections/measurement.py},
  evidence = {the point read lands in a trough (value 1) and reads "drained"; the N-consecutive-pass
              condition never greens because a wave in the window resets the streak --- so the two
              DIVERGE, and the point read attributes a steady state the fleet never held. A second
              layer: three streaks dying at 1/6 predict "never quiet"; the fourth walks to 6/6},
  verdict  = {AGREES},
  check    = {witness:single-read-point-sample}
}

@misc{state-witness-timestamp,
  section = {measurement},
  tier    = {code specimen},
  claim   = {Choosing a state witness chooses WHEN it becomes true --- `-f` and `-s` on ONE
             file are two assertions about two moments, not a weak/strong dial, so a
             correct-looking predicate can assert a strictly LATER event than the claim it
             verifies. Match the witness's moment to when the claim's last event happens ---
             and do not "deflake" a timing failure by relaxing the bound before asking what
             the witness measures (the bound may be load-bearing for a second reason)},
  origin   = {a-state-witness-has-a-timestamp},
  specimen = {a file present at t=0 (staging) but non-empty only at t=7.29 (a later gate) in sections/measurement.py},
  evidence = {the `-f` witness matches the claim's moment (t=0) and holds under a 7s load budget;
              the `-s` witness requires t=7.29 and is FALSE while the claim is TRUE --- the two
              co-located witnesses DIVERGE, and the overshoot tell is that a green -s needs MORE to
              have happened than the verdict sentence describes},
  verdict  = {AGREES},
  check    = {witness:state-witness-timestamp}
}

@misc{trajectory-from-store,
  section = {measurement},
  tier    = {code specimen},
  claim   = {A question about rates, trends, scaling, or ceilings is a TRAJECTORY question
             --- answer it by querying the store over a window (avg/min/max_over_time, rate),
             never from a point-in-time /proc or cgroup read. A single sample of a spiky
             series is neither typical nor a peak, and generalizing it can INVERT the answer.
             Report min AND max, cite the window},
  origin   = {answer-trajectory-questions-from-the-store-not-a-snapshot},
  specimen = {two spiky PSI series over a window, io spiking at one instant, in sections/measurement.py},
  evidence = {the snapshot catches io's spike and ranks io > memory ("disk is the ceiling"); the
              windowed avg ranks memory ~2x io, the OPPOSITE --- so the point read does not merely
              err in magnitude, it INVERTS the ranking, and the two verdicts DIVERGE},
  verdict  = {AGREES},
  check    = {witness:trajectory-from-store}
}

@misc{two-instruments-disagree,
  section = {measurement},
  tier    = {code specimen},
  claim   = {When two instruments over one subject report different numbers, the FIRST
             hypothesis should be "they measure different quantities", not "one is broken" ---
             especially when both are live and correlated. ANTI-CORRELATION is qualitatively
             stronger evidence than a varying ratio: two counters moving in opposite
             directions cannot be one quantity. Confidence tends to run OPPOSITE to
             correctness (the strongest framing arrives first and is usually wrong)},
  origin   = {two-instruments-disagree-first-hypothesis-is-different-quantities},
  specimen = {zram occupancy vs swap reservation, disagreeing hugely AND anti-correlating, in sections/measurement.py},
  evidence = {the raw ratio (~290x) reads like a corruption ("prefer one for magnitude"); but
              occupancy RISES while reservation FALLS in one interval --- anti-correlation rules out
              the corrupted-view family, so the "broken" verdict and the "two quantities" verdict
              DIVERGE, and the corruption reading would ship a false "leaking into swap" alarm},
  verdict  = {AGREES},
  check    = {witness:two-instruments-disagree}
}

@misc{status-not-the-reason,
  section = {measurement},
  tier    = {code specimen},
  claim   = {Two states agreeing on a coarse STATUS scalar is NOT agreement. Read the REASON,
             or a capability difference masquerades as a shared
             limitation. This is the DUAL of two-instruments-disagree: there two
             values DISAGREE (suspect different quantities), here two AGREE on a scalar
             (suspect different mechanisms the scalar collapsed). The fix is always to read
             one level finer than the status},
  origin   = {the-status-is-not-the-reason},
  specimen = {two HTTP 400s from two products for one query, differing only in the error BODY, in sections/measurement.py},
  evidence = {status-only reasoning reads 400==400 as agreement; the bodies reveal one product HAS
              the pipe (a syntax error inside a supported construct) and one LACKS it ("unexpected
              pipe") --- so status-agreement and reason-agreement DIVERGE, and the scalar disguises
              a real vendoring divergence AS a shared error},
  verdict  = {AGREES},
  check    = {witness:status-not-the-reason}
}

@misc{two-point-diff-codomain,
  section = {measurement},
  tier    = {code specimen},
  claim   = {Do NOT narrow an unknown by WORKLOAD CONTRAST --- measuring at two operating
             points and differencing to attribute a cause. It produces a real number and only
             the inference is invalid: a measurement reports a SUBSET of what the codomain
             includes at the sampled points, never what the codomain IS. Structure comes from
             the CONSTRAINT SURFACE (a declaration that bounds the interior), never from an
             experiment that probes it. And difference the monotone accumulator, not its
             sampled view, which can lose a distinction the accumulator carries},
  origin   = {two-point-diff-samples-the-codomain-not-its-structure},
  specimen = {a two-counter gap read through a sampling operator (scrape-skewed deltas) vs the raw accumulator, in sections/measurement.py},
  evidence = {the sampled residual OSCILLATES and even goes NEGATIVE (the derived view lost the
              accumulator's monotonicity to scrape skew); the accumulator's own gap floor RISES and
              stays positive --- the two verdicts DIVERGE, and only the floor is the skew-surviving
              statistic},
  verdict  = {AGREES},
  check    = {witness:two-point-diff-codomain}
}

@misc{each-tier-refutes,
  section = {measurement},
  tier    = {code specimen},
  claim   = {Each validation tier is blind to the failure the NEXT tier exposes --- the
             blindness is what the tier does not exercise, not carelessness. Banking a conclusion at tier N when only tier N+1 can observe its
             failure is a fail-open that feels safe precisely because tier N passed. Before
             banking, NAME what the tier did not exercise; a claim about the RELATION between
             two paths needs a tier that runs both},
  origin   = {each-validation-tier-refutes-what-the-cheaper-one-cannot-see},
  specimen = {a two-arm per-device instrument whose smoke tier runs ARM1 only, in sections/measurement.py},
  evidence = {the smoke tier proves "the deref reaches" but exercises one arm, so it CANNOT evaluate
              whether the two arms key on the same device; the live run (both arms) finds 259:2 !=
              259:0 --- the smoke verdict is silent where the live verdict refutes, and the two
              DIVERGE by exactly the path the cheaper tier never ran},
  verdict  = {AGREES},
  check    = {witness:each-tier-refutes}
}

@misc{null-underpowered-or-nonidentifiable,
  section = {measurement},
  tier    = {code specimen},
  claim   = {A null is UNDER-POWERED or NON-IDENTIFIABLE --- same p-value, OPPOSITE actions
             (collect more vs the design cannot answer at any n). Only a measurement of the
             DESIGN itself distinguishes them --- one nobody runs if they believe the problem is sample
             size. Report a CI, not just p: a CI says what the data rules out},
  origin   = {null-ask-underpowered-or-nonidentifiable},
  specimen = {a phase-based ablation with 33% cross-phase writeback contamination, in sections/measurement.py},
  evidence = {the null plus n=6 tempts "collect more phases"; measuring the design (cross-phase
              contamination fraction) shows more phases inherit the bias --- so the under-powered
              action and the non-identifiable action DIVERGE from the SAME p-value, and only the
              design measurement picks between them},
  verdict  = {AGREES},
  check    = {witness:null-underpowered-or-nonidentifiable}
}

@misc{run-timestamp-conversion,
  section = {measurement},
  tier    = {code specimen},
  claim   = {RUN a timestamp conversion, never REASON it --- a VERIFIED-correct offset still
             produced an hour error via a dropped date rollover. Metrics and journalctl render
             LOCAL while VictoriaLogs and VictoriaTraces store UTC. A
             timestamp is not UTC because it ends in Z; it is UTC because something CONVERTED
             it. Be most suspicious when the offset feels trivial and either zone is near
             midnight},
  origin   = {run-the-timestamp-conversion-never-reason-it},
  specimen = {02:01:40Z on the 20th converted to EDT by-hand vs by real datetime arithmetic, in sections/measurement.py},
  evidence = {reasoning it (subtract 4, keep the date) yields 21:01 on the 20th; running the
              conversion carries the date across midnight to 22:01 on the 19th --- the two DIVERGE by
              exactly one day and one hour, turning the boot's final OOM into an unrelated earlier
              event. Appending a literal Z to local time renders a plausible non-UTC stamp},
  verdict  = {AGREES},
  check    = {witness:run-timestamp-conversion}
}

@misc{psi-measures-stall,
  section = {measurement},
  tier    = {code specimen},
  claim   = {PSI measures STALL, not contention. It is the fraction of time a task could not make
             progress waiting on a resource, NOT how contended the resource is. An asynchronous
             queue (a block-device writeback queue especially) ABSORBS contention until it
             backs up, so PSI is structurally blind to bandwidth contention that has not yet
             produced a stall. For write-path contention (several writers, one device), the
             instrument is the write RATES summed against device bandwidth, not any PSI
             series},
  origin   = {psi-measures-stall-not-bandwidth-contention},
  specimen = {three writers over-subscribing device bandwidth while the writeback queue still absorbs, in sections/measurement.py},
  evidence = {io-PSI reads ~0 ("headroom") because nobody has stalled yet; the per-writer rates sum
              to 1200 against a 1000-unit device ("contended") --- so PSI and the rate-sum DIVERGE,
              and a green io-PSI does not mean the disk has headroom},
  verdict  = {AGREES},
  check    = {witness:psi-measures-stall}
}

@misc{counter-summed-over-producers,
  section = {measurement},
  tier    = {code specimen},
  claim   = {A kernel counter can be a SUM over sites in DIFFERENT subsystems --- formed
             before any consumer sees it, so no downstream reader can recover the split
             and attributing an event to one cause via that counter includes the other causes.
             pgmajfault has 4
             producers (2 swap, 2 NOT: page-cache miss, DAX); use single-edge pswpin/pswpout
             for swap demand. The name is not the contract; the increment sites are},
  origin   = {a-counter-summed-over-producers-cannot-attribute},
  specimen = {pgmajfault as a sum over 4 producers (2 swap, 2 non-swap) vs the single-edge pswpin, in sections/measurement.py},
  evidence = {the aggregate reads 100 and attributes it all to swap; the single-edge counter reads
              40 (swap only) --- the two DIVERGE by exactly the 60 non-swap faults (page-cache +
              DAX), so the aggregate over-attributes the burst to swap},
  verdict  = {AGREES},
  check    = {witness:counter-summed-over-producers}
}

@misc{measurement-domain-drift,
  section = {measurement},
  tier    = {code specimen},
  claim   = {The recurring error is not carelessness but DOMAIN DRIFT --- a real measurement
             extended one step past what it covered. The question that catches it is not "was
             I careful?" but "what exactly did this measurement cover, and is the claim inside
             that? --- and is it still true?" Being more careful does not catch it; scoping
             the claim to the measurement's actual reach does},
  origin   = {a-measurement-does-not-cover-the-domain-you-extend-it-to},
  specimen = {a selftest passing 8/8 WHERE THE FILE EXISTS, extended to a fixture whose failure is the file ABSENT, in sections/measurement.py},
  evidence = {"passes where present" is true and stays true, but the fixture's red is the file being
              ABSENT --- a domain the here-measurement never touched; the drift verdict ("red is
              noise") and the scoped verdict ("red is real, outside the domain") DIVERGE, and the
              lead called noise was the real cause},
  verdict  = {AGREES},
  check    = {witness:measurement-domain-drift}
}

@misc{measurement-past-domain,
  section = {measurement},
  tier    = {code specimen},
  claim   = {A sound measurement becomes a wrong conclusion, extended past its domain: "X
             passes HERE" cannot speak to "X in a DIFFERENT context" ---
             the failure THERE may have a different mechanism the here-measurement cannot see.
             The canonical drift move is "it works here, so the failure there is spurious";
             the fix is to measure THERE},
  origin   = {a-measurement-extended-past-its-domain},
  specimen = {an absence-audit that runs where the path is present but short-circuits where absent, in sections/measurement.py},
  evidence = {where the path exists the audit runs and passes; where the fixture omits the path
              `[[ -f PATH ]]` short-circuits false and prints a fail-shaped verdict with NO audit
              run --- the here-context and there-context measurements DIVERGE, so "passes here =>
              spurious there" is refuted by measuring there},
  verdict  = {AGREES},
  check    = {witness:measurement-past-domain}
}

@misc{redacted-field-not-measured,
  section = {measurement},
  tier    = {code specimen},
  claim   = {Before quoting a field as a measurement, know what it prints WITH NOTHING TO
             SAY: a redacted, hashed, empty, and absent value are four different facts an
             interface may render indistinguishably, and the hashed rendering is the dangerous
             one (right length and character class, looks exactly like a measurement). Quote
             the field carrying signal, not the placeholder beside it. Sharper: a HARDCODED
             CONSTANT has no surface tell at all --- grep the source for who writes the field
             and when},
  origin   = {a-redacted-field-is-not-a-measured-value},
  specimen = {/proc/kallsyms for an unprivileged reader: a hash-shaped address plus a symbol TYPE letter, in sections/measurement.py},
  evidence = {the hashed address looks like a pointer but is IDENTICAL for a global and a static
              symbol (it carries no signal); the type letter B vs b flips the visibility verdict ---
              so the placeholder field and the signal field DIVERGE in discriminating power, and
              only the type letter is a measurement},
  verdict  = {AGREES},
  check    = {witness:redacted-field-not-measured}
}

% ══════════════════════════════════════════════════════════════════════════════════════
% ══ SECTION: Instruments That Lie Green  (merged from sections/lie-green.bib, Phase 2)
% ══════════════════════════════════════════════════════════════════════════════════════

@misc{lie-green,
  section = {lie-green},
  claim   = {The instruments that lie green share one shape: a FOOTPRINT reading (a green
             precondition, a size report, a file installed, an exit code, a merge success, a
             pod's own health) stands in for the EFFECT it does not measure (the instrument
             observed working, headroom on the shared resource, the value actually loaded,
             the rows actually landed, the downstream actually reached). The pull to bank
             GROWS with the number of greens, because the reasoner is arguing correctly from
             everything available --- which is exactly why the last, unmeasured step is
             load-bearing. Each warrant here demonstrates the gap on a specimen where the two
             readings DIVERGE},
  rests-on = {three-templates},
}

@misc{green-preconditions,
  section = {lie-green}, from = {lie-green}, join = {. },
  tier    = {code specimen},
  claim   = {Green preconditions are not a green instrument --- verifying every CHECKABLE
             precondition is NOT observing the instrument WORK, and the gap between "every
             precondition verified" and "the
             thing observed working" is exactly where a fail-open instrument is born. The
             temptation to bank GROWS with the number of green preconditions: a party banking
             after five green checks is reasoning correctly from everything available, so the
             more preconditions verify, the more it FEELS like they cover the last one. Hold
             the whole instrument on the one unverifiable step (the CAP_BPF attach, the
             privileged run); green preconditions license building and testing, never banking},
  origin   = {green-preconditions-are-not-a-green-instrument},
  specimen = {an instrument with 5 green preconditions and one observed_value the agent cannot reach},
  evidence = {footprint (all preconditions AND'd) reads green and GREENER as preconditions grow;
              effect (observed_value is not None) stays absent; the two verdicts DIVERGE, and
              flipping one precondition red flips footprint --- proving footprint tracks the
              preconditions, not the observation the instrument is banked on},
  verdict  = {DIVERGES},
  check    = {witness:green-preconditions-not-green-instrument}
}

@misc{footprint-reporting,
  section = {lie-green}, from = {green-preconditions}, join = {. },
  tier    = {code specimen},
  claim   = {Footprint-reporting is not headroom-gating --- they are DIFFERENT instruments,
             and the ecosystem builds the first and calls it the second. A tool that reports
             its own FOOTPRINT reads healthy right up to the failure. On a SHARED resource a
             consumer cannot self-assess its own headroom: the scarce quantity is the SUM of
             every consumer's demand, not its own size, so two individually-unalarming
             aggregates on one spill curve fill the disk. The check belongs in the monitoring
             layer that holds the series, as a continuously-evaluated rule (free / (3 x
             expected_spill), expected_spill DERIVED from live db size so it self-adjusts) ---
             not a per-consumer reader anyone must remember to run},
  origin   = {footprint-reporting-is-not-headroom-gating},
  specimen = {a 469G shared volume, 75G free, two identical consumers each spilling ~34G},
  evidence = {footprint ("my 40G store fits a 469G volume") reads green and TRUE; the headroom
              ratio 75/(3x34)=0.74 FIRES (<1); the two verdicts DIVERGE, and the specimen shows
              one consumer alone would not fill the volume while two do --- the SUM is the scarce
              quantity, unassessable from either footprint},
  verdict  = {DIVERGES},
  check    = {witness:footprint-reporting-not-headroom-gating}
}

@misc{wide-exemption,
  section = {lie-green}, from = {footprint-reporting}, join = {. },
  tier    = {code specimen},
  claim   = {A gate with a WIDE exemption routinely swallows the whole claim, by presentational
             instinct rather than carelessness. A51's commit-msg gate binds any measured number
             a message asserts to the run's measurements --- EXCEPT four-space-indented lines
             (the transcript escape). A well-formatted message sets its load-bearing figures off
             as a transcript by indenting them, landing them in the exempt region, so the gate
             binds NOTHING and says so ("nothing to bind"). A green that announces it did nothing
