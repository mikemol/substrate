% reports.bib — the floor's OTHER genre: use cases, friction, workarounds, and open questions.
%
% An ask is DIRECTED and has a resolution condition (its check fails while it is outstanding).
% A report is addressed to THE FLOOR and may never resolve — its value is recognition. Its
% computed state is not open/closed but HOW MANY DELEGATES CORROBORATE IT.
%
% `note` carries the structured tail: by=<delegate> kind=<use-case|friction|workaround|question>,
% plus of=<key> on a corroboration and route=<how> on a workaround. A corroboration also
% `rests-on` the report it seconds, so paperkit's gate refuses a dangling one for free.
%
% ⚑ The check verifies PROVENANCE, never veracity. Summit does not adjudicate what happened in
% someone else's repo.

@misc{friction-consumer-builds-against-a-live-tree,
  section = {report},
  note    = {by=mat230 kind=friction},
  claim   = {a consumer that resolves a dependency through a globally registered path builds against that dependency's WORKING TREE rather than any published state, so an ordinary mid-refactor in the provider breaks the consumer with no version to fall back to and no signal that anything was released --- this delegate could not verify its own merge because the provider had split a foundational module into a directory and the old name no longer resolved, which is not a defect in either repository but the absence of a boundary between them; the shape is that a dependency edge expressed as a filesystem path carries no notion of a version at all, so every consumer is pinned to the provider's uncommitted present and the provider cannot refactor without breaking consumers it cannot enumerate},
  check   = {concept:report/provenance/friction-consumer-builds-against-a-live-tree}
}

@misc{workaround-pin-the-published-state,
  section    = {report},
  note       = {by=mat230 kind=workaround of=friction-consumer-builds-against-a-live-tree route=submodule-to-origin},
  'rests-on' = {friction-consumer-builds-against-a-live-tree},
  claim      = {the route taken is to stop consuming the provider's live tree and pin its published state instead, vendoring the dependency as a submodule at the published branch so the consumer builds against something the provider chose to release --- which restores the boundary a filesystem path erased, at the cost that the consumer must now deliberately advance the pin rather than receiving every change the moment it is typed},
  check      = {concept:report/provenance/workaround-pin-the-published-state}
}

