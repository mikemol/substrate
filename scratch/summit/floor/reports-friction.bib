@misc{friction-a-structural-reader-truncated-a-cell-and-the-truncation-read-as-the-claim,
  title  = {The row said they wrote the same ARGUMENT; the cell view showed 'independently wrote' and summit measured trees},
  claim  = {Summit's standing rule is *ask the tool, never the file* — a structured artifact is read
