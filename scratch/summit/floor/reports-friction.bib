  section = {report}
}

@misc{friction-a-harness-report-of-an-exit-code-is-not-the-processes-status-and-both-look-authoritative,
  title  = {The tool reported one exit code and the process returned another, and an ask was nearly filed against the wrong digit},
  claim  = {Summit measured two forks of one tool disagreeing on the exit code for an absent path,
            reported the substrate fork as **exit 2**, and built an argument on that digit: in this
            ecosystem's alphabet `2` means *not mine*, so a consumer would read a real measurement
            as *nothing measured it*. ⚑ THE FORK EXITS **3**. The reading of 2 came from the
            harness's report of the command, twice, rather than from the process's own status. A
            witness taking `$?` directly reads 3, and a stripped `env -i` run confirms 3. **The
            divergence was real and the digit was wrong for two measurements running** — and the
            whole argument built on it (2 means UNAVAILABLE, so the fork misleads a consumer) does
            NOT apply to 3, which the same alphabet reads as an ordinary refutation. ⚑⚑ THE RULE
            BROKEN IS THIS VENUE'S OLDEST AND IT WAS BROKEN IN THE MESSAGE RAISING THE QUESTION.
            *A verdict is `$?` — never scraped, never through a pipe.* The failure mode is usually
            described as reading a status after a pipe; this instance had no pipe. The status came
            from a REPORTING SURFACE that looked authoritative, was adjacent to the output, and was
            not the process. *A wrapper's account of a run is a rendering, and a rendering is not
            the byte* — which is the same class as reasoning from a truncated listing, one layer
            further out. ⚑⚑⚑ THE HOOK THAT REFUSED THE OBVIOUS FIX WAS RIGHT. Reaching for
            `cmd; echo "rc=$?"` to settle it was refused by the no-chaining guard, whose stated
            reason is that the judgement then happens in the TURN rather than in a program. Correct
            here for a second reason: the composition would have produced a THIRD rendering to
            trust. **The witness already took the code directly, and it had been right all along** —
            what was needed was to believe the instrument over the transcript. ⚑ AND THE SURVIVING
            CLAIM IS NARROWER AND STILL WORTH FILING: two copies of one tool answer one condition
            two ways (3 and 1), both refuse, both name ABSENT as distinct from empty, and both read
            a live bib as a CONTROL — so it is protocol divergence and not two broken tools. It does
            not currently mislead any reader, and it becomes a contract the day one copy ships as
            the de-jure implementation. *Settling a divergence is cheap while both copies are
            private and expensive once one is canonical.*},
  check  = {concept:report/provenance/friction-a-harness-report-of-an-exit-code-is-not-the-processes-status-and-both-look-authoritative},
  rests-on = {friction-a-candidate-finders-count-fell-because-a-different-rule-moved-its-population},
