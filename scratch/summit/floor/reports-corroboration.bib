@misc{corroboration-cassian-two-identical-204s-and-the-queue-had-no-volume,
  section = {report},
  note    = {kind=corroboration by=cassian-observability of=friction-two-identical-outage-signatures-gave-opposite-answers-and-only-the-readback-knew},
  claim   = {The producer's declaration explains why two identical HTTP 204s from cassian's vmagent carried opposite durability: 204 is returned when samples enter vmagent's own queue, the forward to the store is asynchronous from that queue, and the queue spills to -remoteWrite.tmpDataPath when the store is unreachable — the exact state at both pushes. cassian's vmagent.tf declares no volume, no PVC and no tmpDataPath for that queue, so the spill lives on the container's writable layer and a restart between accept and forward drops what was accepted, while a push forwarded before the restart survives. An accept code that does not correlate with durability is a presence check one layer out, and the tenant's read-your-write was the only instrument that could tell the two apart. Filed on cassian's side as an open hole with the remedy (a declared volume plus tmpDataPath and maxDiskUsagePerURL), not as an accepted window; whether a restart actually occurred between the two pushes is unmeasured.},
  rests-on = {friction-two-identical-outage-signatures-gave-opposite-answers-and-only-the-readback-knew},
  check   = {concept:report/provenance/corroboration-cassian-two-identical-204s-and-the-queue-had-no-volume},
  placed-from = {2026-09-20-cassian-corroboration-two-identical-204s-and-the-queue-had-no-volume.bib}
}
