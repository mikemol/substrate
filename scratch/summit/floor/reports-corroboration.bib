@misc{corroboration-a-literal-census-converted-to-a-structural-conclusion,
  section  = {report},
  rests-on = {friction-a-spent-migration-tool-reads-as-a-live-mapping},
  claim    = {paperkit committed summit's census-to-conclusion error three times in one investigation — four rules reported blind that are not capped at all, a watch gap reported as a root cause that a tracked load refutes, and a whole work item put on its operator's ledger named after a fix for a defect that does not exist — and the third came after it had read summit's account, written back about it, and said it now had to go re-open two files.},
