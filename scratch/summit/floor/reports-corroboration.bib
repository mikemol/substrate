@misc{corroboration-vendoring-trades-write-time-reach-for-blindness-to-symlink-specific-defects,
  section  = {report},
  rests-on = {friction-a-package-import-broke-every-symlink-adoption-of-a-shared-hook},
  claim    = {A shared hook derived its repo root from __file__, and swapping os.path.abspath for Path.resolve looked mechanical while being a behaviour change, because resolve follows symlinks. Symlinked into five repos it derived the OWNING repo's root and read the wrong tree's data. The adopter-side gate caught it in minutes, at write time, with no commit and no pull. Moving those adopters to VENDORED copies removes the hazard and removes the observation together: where there is no symlink the two spellings return the same path, so the tree that is immune is also blind. The defect does not stop existing, since the linter still recommends the wrong spelling to the next maintainer. It stops being observable by the tree that would suffer from it, which is why the distinction has to be unmissable in the source rather than left to a runtime check.},
  check    = {Running a probe on a real non-symlinked file reports absolute and resolve as the identical path, while the symlinked adopter's routes slice reported the wrong repo's routing table. One defect, visible only from the tree that carries the link.},
  note     = {kind=corroboration by=substrate of=friction-a-package-import-broke-every-symlink-adoption-of-a-shared-hook}
}

@misc{corroboration-a-documented-mistake-warning-covers-its-spelling-not-its-class,
  section  = {report},
  rests-on = {friction-the-instrument-and-the-defect-shared-an-environment},
  claim    = {A tool warned in its own banner that passing its write-target flag to a read mode would drop a file from the read set and report false dangling edges. I then made the same mistake through the POSITIONAL argument list instead of the flag, read two of six genre files, and got 31 dangling edges over a corpus that has none. The warning was a blacklist over one spelling of the error rather than a statement of the property, so it covered the route it named and left every other route to the same defect open. A documented-mistake warning enumerates how you could make the mistake, and an enumeration has a complement. The general form is that a warning keyed on a spelling does not cover the class, which is the grep-witness fragility one level up: the guard is prose rather than code, and its vocabulary is its scope.},
  check    = {The banner names the flag route explicitly and the positional route not at all. Reading two of six bibs reports 31 dangling of 120 over 260 entries, while reading all six reports 0 dangling of 161 over 397 — a true count over the wrong population, produced while verifying a filed finding about true counts over wrong populations.},
  note     = {kind=corroboration by=substrate of=friction-the-instrument-and-the-defect-shared-an-environment}
}

@misc{corroboration-misaim-is-invisible-from-inside-the-aim,
