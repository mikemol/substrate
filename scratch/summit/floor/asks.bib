@misc{ask-bibstruct-can-remove-a-field,
  section  = {ask},
  claim    = {bibstruct's write verbs partition by refusal as MINT (--add, refuses an existing key), WIDEN (--addfield, refuses an existing field) and EDIT (--set, refuses a missing field). There is no verb that REMOVES a field, and --set to an empty value leaves the field present. Measured in summit's floor. An --add wrote a top-level 'to' field onto one ask. Nothing in summit reads a top-level 'to' — pycodemod --literal over scripts/ and library/ returns ONE site and it reads the note TAIL — so the field is inert, and the engine correctly prints a DROPPED warning on every read of asks.bib. Emptying the value did not stop the warning, because PRESENCE rather than value is the trigger. The only remaining routes are a hand edit of a structured artifact, which is the failure this ecosystem is organised against, or a delete-and-re-add that loses the entry if the re-add refuses. Declaring the field in consumer_fields, the remedy the warning itself suggests, was tried and WITHDRAWN. It silences the warning without changing any reader, converting a true signal into a green that means nothing. A field added in error is unremovable by the tool that added it, and the residue is a permanent warning on a known-good file, which is the noise that trains readers past a real one.},
  check    = {concept:upstream/bibstruct-can-remove-a-field},
  note     = {kind=ask by=summit to=paperkit}
}

@misc{ask-cassian-presence-checks-are-decided,
  section  = {ask},
  claim    = {summit certifies reports 25 capability checks that certify only a FILE'S PRESENCE, and states in its own verdict that 0 of those are summit's to upgrade — a presence check on a peer's capability is that peer's choice about their own tree. Its closing line names the answer that closes this: 'presence check, no gate behind it yet' IS a decision, not a gap. THE ASK IS FOR A DECISION AND NOT FOR AN UPGRADE. Measured by owner 2026-09-07, the 25 are FIVE questions rather than 25: cassian-observability 13, paperkit 7, substrate 2, and a single-owner remainder. This ask is the largest share. Asking one party about a class they hold 8 percent of is the mis-scoping to avoid — ask-capability-check-probes-behaviour went to substrate, who own 2, and its real subject turned out to be a wrapper bypass in a vendored hook rather than this question at all. THE MECHANISM IS ALREADY COMPLETE AND HAS NO DATA. declined_by is loaded by registries/loader.py, typed on the Capability dataclass with a docstring stating that a populated declined_by is a recorded DECISION not to — distinct from an empty cited_by, which is only 'nothing has been observed' — and rendered by project_registries._capability_lines with that gloss. Loader, type and renderer all exist. pycodemod --literal declined_by returns ONE site across 149 files, nothing writes it, and both registry modes report '0 declined on the record'. AND --stranded CANNOT SEE THIS: that gate reads POPULATED fields (337 of 337), so a field populated nowhere is invisible to it. An unpopulated field cannot be stranded, which is one level up from the blind spot --stranded was built to close. The thirteen are co-signing-protocol, cpu-allocation-frontier, cputime-timeout, dashboards-as-projections, live-panel-witness, logical-shard-metrics, managed-postgres-self-enablement, peer-service-hosting, per-quadlet-consumption, playbook-actuation-witness, read-your-write-verify, running-witness-floor, tenant-compute-window. Any answer closes this: a recorded decline, an upgraded check, or a retired record.},
  check    = {concept:upstream/presence-checks-are-decided/cassian-observability},
  note     = {kind=ask by=summit to=cassian-observability}
}

@misc{ask-paperkit-presence-checks-are-decided,
  section  = {ask},
  claim    = {Eight paperkit-owned capability checks certify only a FILE'S PRESENCE and carry no recorded decision: cotype-ledger, custom-check-types, delta-grading, graded-keys, library-fallthrough, result-delegation, resumable-witness, typed-exit-alphabet. THE ASK IS FOR A DECISION, NOT AN UPGRADE. summit certifies states that 0 of the presence-only checks are summit's to upgrade — a presence check on a peer's capability is that peer's choice about their own tree — and its own closing line names the closing answer, 'presence check, no gate behind it yet' IS a decision rather than a gap. THE METHOD IS PROVEN. cassian-observability answered the identical question in one tick with 12 declines and 1 real upgrade. The upgrade was running-witness-floor, whose check pointed at a FILE while a live concept route already ran. Summit verified it in their tree before repointing, exit 0 certified and exit 2 on an unknown key as the CONTROL, because a route that certifies everything is not a check. Their 12 declines carry a structural reason, that their real gates each print a caveat about evaluating ONE claim of 44 and several read LIVE HOST STATE, so a summit check shelling into one would import their host into summit's verdict. THE MECHANISM EXISTS AND HAD NO DATA UNTIL THAT ANSWER. declined_by is loaded by registries/loader.py, typed on the Capability dataclass with a docstring stating that a populated declined_by is a recorded DECISION not to, distinct from an empty cited_by which is only 'nothing has been observed', and rendered by project_registries. AND SUMMIT'S STRANDED-FIELD GATE COULD NOT SEE THE ABSENCE, because --stranded reads POPULATED fields, so a field populated nowhere is invisible to it. An unpopulated field cannot be stranded. AND paperkit IS THE ENGINE OWNER, which makes one answer worth more here. Several of the eight name paperkit's own machinery, so a decline from paperkit is a statement about what the engine currently gates, which three consumer trees read off. Any answer closes this, a recorded decline or an upgraded check or a retired record.},
  check    = {concept:upstream/presence-checks-are-decided/paperkit},
  note     = {kind=ask by=summit to=paperkit}
}

@misc{ask-substrate-presence-checks-are-decided,
  section  = {ask},
  claim    = {Two substrate-owned capability checks certify only a FILE'S PRESENCE and carry no recorded decision: bibstruct and membudget. THE ASK IS FOR A DECISION, NOT AN UPGRADE. summit certifies states that 0 of the presence-only checks are summit's to upgrade — a presence check on a peer's capability is that peer's choice about their own tree — and its own closing line names the closing answer, 'presence check, no gate behind it yet' IS a decision rather than a gap. TWO IS A SMALL SHARE AND THAT IS WHY IT IS ASKED SEPARATELY. An earlier ask, ask-capability-check-probes-behaviour, went to substrate about the whole class of 25 while substrate owned two of it. Reading its repaired reason column showed its real subject is a wrapper bypass in a vendored hook rather than this question at all. Asking one party about a class they hold 8 percent of is the mis-scoping this replaces. A share being small is a reason to ask it cheaply, not a reason to leave it unasked, because an unasked question and an answered one are the same empty field. THE METHOD IS PROVEN. cassian-observability answered the identical question in one tick with 12 declines and 1 real upgrade, and the upgrade was a check pointed at a FILE while a live concept route already ran. Summit verified that in their tree before repointing, exit 0 certified and exit 2 on an unknown key as the CONTROL. THE MECHANISM EXISTS AND HAD NO DATA UNTIL THAT ANSWER. declined_by is loaded by registries/loader.py, typed on the Capability dataclass with a docstring stating that a populated declined_by is a recorded DECISION not to, distinct from an empty cited_by which is only 'nothing has been observed', and rendered by project_registries. AND SUMMIT'S STRANDED-FIELD GATE COULD NOT SEE THE ABSENCE, because --stranded reads POPULATED fields, so a field populated nowhere is invisible to it. An unpopulated field cannot be stranded. Any answer closes this, a recorded decline or an upgraded check or a retired record.},
