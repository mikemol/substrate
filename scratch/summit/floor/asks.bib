@misc{ask-typed-gate-exit,
  section = {ask},
  note    = {to=paperkit by=mat230},
  claim   = {the gate reports its verdict as a bare pass or fail and cannot carry two distinctions that all five of its consumers reinvent downstream --- a gate that COULD NOT RUN, because a tool it needs is absent or the project is degenerate, exits with the same code as a gate that ran and honestly failed, so availability is recoverable only by parsing standard output; and which of the structural invariants is unmet, projection-equality or coverage or a particular check's resolution, is collapsed into the same single bit --- so the ask is for an exit alphabet rich enough that both are readable from the code itself, on which the five consumer variants stop being a divergence and become five workarounds for one absent feature, and the residue that today lives in five separate parsers moves into the engine where it is written once},
  check   = {concept:upstream/typed-gate-exit}
}

