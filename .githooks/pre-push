#!/usr/bin/env bash
# Versioned pre-push hook (enabled via: git config core.hooksPath .githooks).
#
# The shared check lives in mtools' `mikemol-githook-pre-push` (mikemol-hooks, installed into this
# repo's venv from pyproject.toml): it reads stdin once, refuses a push while a git operation is in
# flight, then runs `.githooks/pre-push.local` with the same arguments and stdin. substrate's own
# post-commit-marker check lives in that local file.
#
# ⚑ The venv is found from THIS FILE's real path, not the pushing repo's top level, so a repo that
# still reaches this hook through a symlink runs substrate's installed copy rather than failing
# for want of its own. The script then runs THAT repo's pre-push.local, if it has one.
exec "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../.venv/bin/mikemol-githook-pre-push" "$@"
