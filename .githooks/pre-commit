#!/usr/bin/env bash
# Versioned pre-commit hook (enabled via: git config core.hooksPath .githooks)
#
# Enforces repo invariants that are cheap to check and expensive to let
# regress. Currently:
#   * def/proof separation (load-bound memory policy) —
#     scripts/check_def_proof_separation.sh
#   * UP non-vacuity (no ⊤-collapse universal properties) —
#     scripts/check_up_nonvacuity.sh
#   * build-makefile tree in sync — scripts/gen_build_makefiles.py --check
#
# Each check prints its own diagnostics and returns non-zero on failure;
# a failing check aborts the commit. To bypass in an emergency:
#   git commit --no-verify
set -euo pipefail

# --- Fold the gate output into the commit message (transparency: the gates'
# results become part of the commit record). Re-exec this hook with its output
# teed to a report file; the prepare-commit-msg hook then appends that report to
# the message. The pipeline is SYNCHRONOUS (tee finishes writing the report
# before we read its exit status) — no background-process race — and live
# terminal output is preserved. Guarded by _PRECOMMIT_TEE so the gates run
# exactly once (in the re-exec'd child). On failure the report is deleted, so an
# aborted commit never leaves a stale report for the next commit to pick up.
if [ -z "${_PRECOMMIT_TEE:-}" ]; then
  export _PRECOMMIT_TEE=1
  _pcm_report="$(git rev-parse --absolute-git-dir)/precommit-report.txt"
  set +e
  "$0" "$@" 2>&1 | tee "$_pcm_report"
  _pcm_st=${PIPESTATUS[0]}
  if [ "$_pcm_st" -ne 0 ]; then rm -f "$_pcm_report"; fi
  exit "$_pcm_st"
fi

ROOT="$(git rev-parse --show-toplevel)"
fail=0

run() {
  local name="$1"; shift
  if ! "$@"; then
    echo "pre-commit: FAILED — $name" >&2
    fail=1
  fi
}

run "def/proof separation" "$ROOT/scripts/check_def_proof_separation.sh" --quiet \
  || true   # --quiet is silent; re-run verbose on failure for the message
if [ "$fail" -ne 0 ]; then
  "$ROOT/scripts/check_def_proof_separation.sh" || true
fi

# UP non-vacuity: no ⊤-collapse universal properties outside the sanctioned
# trivial-UP / PlaceholderUP. Hard gate (tree at 0 since the 2026-06-03
# audit/fix); --quiet stays silent on success but prints offenders on failure.
run "UP non-vacuity" "$ROOT/scripts/check_up_nonvacuity.sh" --quiet

# Build-makefile tree must stay in sync with the source tree (new/removed
# .agda files or directories require regenerating the per-dir makefiles).
run "build makefiles in sync" python3 "$ROOT/scripts/gen_build_makefiles.py" --check

# Shape-node collision index must stay current (names are vacuous; the visible
# name→shape map disambiguates for the reader). Regenerate: sppf_node_index.py
run "shape-node index current" python3 "$ROOT/scripts/sppf_node_index.py" --check

# Import-shape ratchet: no NEW bare imports of genuinely-ambiguous names — a
# colliding name must be specialized by shape (renaming). Count may only drop.
run "import-shape ratchet" python3 "$ROOT/scripts/check_import_shape.py" --quiet

# Decl-site shape tags: every genuinely-ambiguous declaration carries a visible
# ⟦shape:…⟧ tag so the reader sees which node. Regenerate: decl_shape_tag.py --fix
run "decl-site shape tags" python3 "$ROOT/scripts/decl_shape_tag.py"

# Carrier locality: a canonical operator over a globally-unique carrier must be
# defined in that carrier's home (never forked into another carrier's dir), and
# may not be buried in a generic multi-operator bucket file. Prevents the
# fork-by-reimplementation class (e.g. _+ℤ_ re-defined under Algebra/Q/).
run "carrier locality" python3 "$ROOT/scripts/check_carrier_locality.py" --quiet

# Apex gate: every relational law-motif (≥3 instances) must have a parametric apex
# (a parameterizable module — NOT an index, which forces concurrent building). No
# baseline: a new cluster blocks until its apex is built, snowballing leverage early.
run "apex gate" python3 "$ROOT/scripts/law_motif_apex.py" --check

# Δ-G2: jea-regression gate. If any scripts/jea_*.py is staged, run the jea correctness suite (fast subset) and
# block on a FAIL -- converting "run the jea modules" from a discipline I must remember into a non-skippable gate
# (would have caught the Δ-Ψ-dag leaf-code collision + the eval_aligned_planes contiguity bug). Fires ONLY on jea
# changes (never blocks the Agda/Q subtree); self-skips if no GPU. Full suite: jea_regression_gate.py --full.
if git diff --cached --name-only | grep -qE '^jea/jea_.*\.py$'; then
  run "jea regression (Δ-G2)" python3 "$ROOT/jea/jea_regression_gate.py" --check
fi

# Σ6: metalanguage / Σ-instrument regression gate. The cross-language correspondence apparatus (the
# metalanguage front-ends + readouts, ~11 modules) had no regression net -- an edit could silently break
# the mat260 OMML→Octave pipeline. Fires on staged jea/metalanguage/*.py OR the two root Σ modules
# (jea_oneforest, jea_omml_domain); asserts each instrument's structural invariant (pure modules run,
# toolchain ones self-skip). The G9 escalation from the 2026-06-17 Σ build-out arc.
if git diff --cached --name-only | grep -qE '^jea/(metalanguage/.*|jea_oneforest|jea_omml_domain)\.py$'; then
  run "Σ metalanguage regression (Σ6)" python3 "$ROOT/jea/metalanguage/jea_metalanguage_gate.py"
fi

# Λ8: scratch-independence. If anything under a promoted project (jea/, el-atlas/) is staged, assert it
# makes NO LIVE scratch/ reference (a path-string or import in executable code; comments/docstrings/.md
# prose exempt). Converts "is jea independent of scratch?" from a hand-grep I answered wrong twice into a
# non-skippable invariant (the G9 escalation from the 2026-06-17 scratch-dissolution arc).
if git diff --cached --name-only | grep -qE '^(jea|el-atlas)/'; then
  run "scratch-independence (Λ8)" python3 "$ROOT/scripts/check_scratch_independence.py" --quiet
  # Λ8b (import-tier): the RUNTIME complement to Λ8's static scan — imports the 5 coupling-surface
  # modules under a sys.addaudithook, catching a module-level DYNAMIC scratch reach (computed path /
  # dynamic import) the AST scan can't see. ~3s (import-only; the heavy GPU/agda DEMO surface is NOT
  # the coupling surface). Self-skips without cupy. Full in-function sweep: check_scratch_runtime.py --full.
  run "scratch-runtime (Λ8b)" python3 "$ROOT/scripts/check_scratch_runtime.py" --quiet
fi

# Full build: prove EVERY module typechecks (scripts/full_build_check.py — one agda
# process per file, RAM-capped, skips the OOM Substrate.All). EXPENSIVE, so it runs at
# most weekly: a successful run touches "$STAMP"; while that stamp is younger than a
# week the build is skipped for fast commits. Only attempted when the cheap gates above
# already passed (no point building on an otherwise-doomed commit). Force a run by
# deleting the stamp; bypass everything with `git commit --no-verify`.
STAMP="$ROOT/.full-build-stamp"
WEEK=$((7 * 24 * 3600))
if [ "$fail" -eq 0 ]; then
  age=$WEEK
  if [ -f "$STAMP" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$STAMP") ))
  fi

  # Ε(b′): a STRUCTURAL change forces the full build regardless of the 7-day
  # throttle. Such a change can break a module NOT in this commit's changed set
  # (the "modules rot silently" hazard), so the time-throttle alone is an INVALID
  # precheck for it. (Policy: main is CI-gated; CI must reflect current state, or
  # the throttle masks breakage for up to a week.) Three robustly-detectable
  # signals over the staged .agda set:
  #   (a) a module added / renamed / deleted (file-level structure);
  #   (b) an import / module / re-export (public / renaming) line changed;
  #   (c) a top-level type-SIGNATURE line changed (col-0 `name : Type`).
  # Comments (`--`) and indented lines (record fields, locals) are excluded by
  # construction; false positives only ever over-run CI (safe), never skip it.
  structural=""
  if git diff --cached --name-status --diff-filter=ADR | grep -qE '\.agda$'; then
    structural="module add/rename/delete"
  fi
  if [ -z "$structural" ]; then
    for f in $(git diff --cached --name-only --diff-filter=M -- '*.agda'); do
      diffout="$(git diff --cached -U0 -- "$f")"
      if printf '%s\n' "$diffout" | grep -E '^[+-]' | grep -vE '^[-+]{3}' \
           | grep -qE '^[+-][[:space:]]*(open import|import |module |public|renaming)'; then
        structural="import/re-export change ($f)"; break
      fi
      if printf '%s\n' "$diffout" | grep -E '^[+-]' | grep -vE '^[-+]{3}' \
           | grep -qE '^[+-][^[:space:]+-].*[[:space:]]:[[:space:]]'; then
        structural="signature change ($f)"; break
      fi
    done
  fi

  if [ -z "$structural" ] && [ "$age" -lt "$WEEK" ]; then
    echo "pre-commit: full build skipped (last $((age / 86400))d ago, < 7d, no structural change; rm $STAMP to force)."
  else
    if [ -n "$structural" ]; then
      echo "pre-commit: full build FORCED — Ε(b′) structural change: $structural — running, this may take a while…"
    else
      echo "pre-commit: full build (every module; >7d since last) — running, this may take a while…"
    fi
    if python3 "$ROOT/scripts/full_build_check.py" -j6; then
      touch "$STAMP"
      echo "pre-commit: full build OK — stamp refreshed."
    else
      echo "pre-commit: FAILED — full build (a module does not typecheck)" >&2
      fail=1
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: one or more checks failed; commit aborted (use --no-verify to override)." >&2
  exit 1
fi
exit 0
