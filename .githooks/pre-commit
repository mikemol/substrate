#!/usr/bin/env bash
# Versioned pre-commit hook (enabled via: git config core.hooksPath .githooks)
#
# Enforces repo invariants that are cheap to check and expensive to let
# regress. Currently:
#   * def/proof separation (load-bound memory policy) —
#     scripts/check_def_proof_separation.sh
#   * UP non-vacuity (no ⊤-collapse universal properties) —
#     scripts/check_up_nonvacuity.sh
#   * build-makefile tree in sync — scripts/gen_build_makefiles.py --check
#
# Each check prints its own diagnostics and returns non-zero on failure;
# a failing check aborts the commit. To bypass in an emergency:
#   git commit --no-verify
set -euo pipefail

# --- Fold the gate output into the commit message (transparency: the gates'
# results become part of the commit record). Re-exec this hook with its output
# teed to a report file; the prepare-commit-msg hook then appends that report to
# the message. The pipeline is SYNCHRONOUS (tee finishes writing the report
# before we read its exit status) — no background-process race — and live
# terminal output is preserved. Guarded by _PRECOMMIT_TEE so the gates run
# exactly once (in the re-exec'd child). On failure the report is deleted, so an
# aborted commit never leaves a stale report for the next commit to pick up.
if [ -z "${_PRECOMMIT_TEE:-}" ]; then
  export _PRECOMMIT_TEE=1
  _pcm_report="$(git rev-parse --absolute-git-dir)/precommit-report.txt"
  set +e
  "$0" "$@" 2>&1 | tee "$_pcm_report"
  _pcm_st=${PIPESTATUS[0]}
  # ⚑ FEATURE BRANCHES COMMIT; main STAYS GATED (operator 2026-11-16, W352/W353; transcript uuid
  # 9b009522-d030-44e2-a4a1-48a966726eb6). Off main the gate still RUNS and its output is still
  # recorded, but a red verdict does not refuse the commit. main is guarded separately by the ORIGINAL
  # gate (771283c's closure) through mtools:W2582, never by this file, which a branch can edit.
  # Fail-safe: an undeterminable branch (detached HEAD, unreadable ref) is treated as main.
  # The commit's git environment is UNSET for this read: mikemol-commit exports GIT_DIR and the index
  # into the hook (mtools:W2549, gcalculus:W278), and an inherited GIT_DIR makes `git -C` read the
  # WRONG repository's HEAD. The isolated snapshot has no .git of its own, so the real root's HEAD is
  # the commit's branch; with MIKEMOL_REAL_ROOT unset, "." is the real repo.
  _pcm_branch="$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX git -C "${MIKEMOL_REAL_ROOT:-.}" symbolic-ref --short -q HEAD || true)"
  if [ "$_pcm_st" -ne 0 ] && [ -n "$_pcm_branch" ] && [ "$_pcm_branch" != "main" ]; then
    echo "pre-commit: ADVISORY on branch '$_pcm_branch' — the gate is red (rc=$_pcm_st) and the commit proceeds; main admits only a green original gate." >&2
    exit 0   # the red report is KEPT, so prepare-commit-msg folds it into the branch commit
  fi
  if [ "$_pcm_st" -ne 0 ]; then rm -f "$_pcm_report"; fi
  exit "$_pcm_st"
fi

ROOT="$(git rev-parse --show-toplevel)"
# ⚑ THE PROJECT INTERPRETER, NAMED ONCE (operator, 2026-09-23). The makefile generator is being drained
# into `substrate/` modules, which the system python3 cannot import from a script path; the venv has
# `substrate` installed. So the generator's callers here run on the venv rather than the generator
# editing sys.path. No fallback to python3: a missing venv must fail the gate loudly, not quietly run
# an interpreter that cannot see the code it is checking.
# ⚑ HOST STATE IS LOOKED UP UNDER `tools`, NOT UNDER THE TREE BEING GATED (mtools:W891, W954).
# `mikemol-commit` runs this hook in a SNAPSHOT of the index (/var/tmp/mikemol/gate/<repo>/tree) where the
# .venv and every other untracked host path do not exist, and it isolates ONLY a hook whose text names
# MIKEMOL_REAL_ROOT; otherwise it silently falls back to the plain commit path. Reference idiom: mtools'
# own .githooks/pre-commit. Outside isolation the variable is unset and `tools` is just the tree.
tools="${MIKEMOL_REAL_ROOT:-$ROOT}"
PY="$tools/.venv/bin/python"
# ⚑ THE REAL .venv HAS substrate-tooling INSTALLED EDITABLE, pointing at the REAL checkout: a venv python
# run from the snapshot would import `substrate` and `scripts` from the working tree, so the gate would
# judge bytes that are not the index. Putting the snapshot first on the path makes the snapshot win
# (the editable finder is appended to sys.meta_path, so ordinary path entries are tried before it).
if [ -n "${MIKEMOL_REAL_ROOT:-}" ]; then
  export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
fi
# ⚑ EVERY GATE BELOW SAYS `python3`, AND THE SYSTEM python3 CANNOT IMPORT `substrate` (see the PY note above).
# One function routes them all to the project interpreter instead of 40 hand edits, and a missing venv still
# fails loudly (command not found) rather than quietly running an interpreter that cannot see the code.
python3() { "$PY" "$@"; }
fail=0

# ⚑ THE COMMIT PATH IS THE ONLY PLACE A RATCHET BASELINE MAY BE REWRITTEN.
# `ratchet.set_ratchet` is read-only unless this is set (scripts/ratchet.py).  Running
# a gate by hand — or from an audit, an editor, or a pipeline pre-flight — must never
# bank debt: a transient census dip would lower the baseline PERMANENTLY, and the keys
# it "paid down" could never return without the gate refusing.  MEASURED twice: a plain
# `check_sumtype_ratchet.py --quiet` rewrote its baseline 48 -> 45, once during an audit
# that was explicitly forbidden to write.  Here, at the promotion gate, recording is
# exactly what we want.
export SUBSTRATE_RATCHET_WRITE=1

# ⚑ `run` is the UNIVERSAL CAPTURE POINT for gate outcomes: every gate flows
# through it, so instrumenting here measures all of them at once (the same
# reason membudget is where build times are captured — instrument the funnel,
# not each caller).  The ledger feeds `gate_ledger.py --order`, which ranks
# gates by MEASURED failure rate so the fail-fast ordering tracks the current
# tree instead of a hand-chosen guess.  Recording is best-effort and never
# alters the gate's exit status: the instrument must not become a new failure
# mode for the thing it measures.
run() {
  local name="$1"; shift
  local _t0=$SECONDS _st=0
  if ! "$@"; then
    echo "pre-commit: FAILED — $name" >&2
    fail=1; _st=1
  fi
  # ⚑ AN `if`, NOT `A && B || C` (SC2015). The chain reads as if-then-else and is not one:
  # `local _res=pass` succeeds, so the `|| local _res=fail` arm is unreachable here — correct
  # today by accident of what `local` returns, and a defect the moment B can fail. The gate
  # refuses the SHAPE rather than waiting for the instance, which is why it fired on a line
  # that currently works.
  local _res=fail
  if [ "$_st" -eq 0 ]; then _res=pass; fi
  python3 "$ROOT/scripts/gate_ledger.py" --record "$name" "$_res" \
    "$((SECONDS - _t0))" 2>/dev/null || true
}

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 0 — ⟡census-sync.  SYNC the SELF-MEASURING censuses, then FAIL IF THE SYNC
# CHANGED ANYTHING.  Runs BEFORE every gate below.
#
# ⚑ THE PROBLEM IS ORDERING, NOT A BROKEN GATE.  `sql_lift --check-census` interns EVERY `.py`
# in the repo, so its figures MEASURE THE CORPUS THEY LIVE IN — editing repo tooling moves the
# count.  Measured in a single working session 2026-08-24: 1129 -> 1161 -> 1162 -> 1166.  An
# agent synced it, edited four more files, and it was stale again BEHIND A GATE THAT HAD
# ALREADY PASSED.  The gate did its job every time: exit 1, a diff, the sync command named.
# What is wrong is checking a self-measuring census MID-RUN, while the tree it measures is
# still moving.  `toolmodes --check` (each tool's own bare output + AST across ~90 tools) and
# `gate_census --check` (this hook + the baselines this hook rewrites) have the same shape.
#
# ⚑⚑ THE VERDICT IS THE DIFF THE SYNC PRODUCED — NEVER A RE-CHECK AFTERWARDS.  This is the
# load-bearing property and it is the easy thing to get wrong.  A phase that repairs and then
# CONTINUES makes the census gate UNABLE TO FAIL: a third vacuity mechanism beside the ABSENT
# and EMPTY baselines `check_baseline_health` already tracks.  A census that fixes itself
# asserts nothing.  Failing on "the sync changed something" keeps the whole signal: the drift
# is REPORTED, the artifact is ALREADY CORRECT, and the recovery is ONE re-run.  The successor
# is named AND already executed — which is the strongest form of `refusal-names-its-populator`.
#
# ⚑ DETECTED BY CONTENT, NEVER BY EXIT CODE.  A `--sync` mode may exit 0 whether or not it
# wrote; only the bytes know.  Hash before, hash after.
#
# ⚑ NOTHING IS `git add`ed.  A hook that stages files into a commit the author has not read is
# a different failure; the RE-RUN is what picks the artifact up.  ⚑⚑ All four census artifacts
# under .claude/skills/ are currently UNTRACKED, so a synced artifact does not enter the commit
# at ALL until someone stages it.  That is a separate finding, deliberately not fixed here.
#
# ⚑ `--check` STAYS IN THE GATE LIST BELOW.  It must remain independently runnable and
# meaningful outside this hook — agents used it three times in one session to detect drift they
# had themselves caused mid-round.  ⚑ But note what a green census gate now ASSERTS: "the sync
# found nothing", which is NARROWER than "the census is correct on its own".  Phase 0 already
# made it so.
#
# ⚑ `gen_build_makefiles --check-census` IS DELIBERATELY NOT HERE.  Criterion: does the census
# SELF-MEASURE — does editing repo tooling move its figures?  CHECKED, not assumed: after four
# edits to scripts/gate_census.py that moved sql_lift 1166 -> 1170, `--check-census` still read
# FRESH.  Its figures are the agda DAG, MEM_CAP, the membudget leases and this hook's gate
# roster.  It is sensitive to a HOOK edit — a one-shot change its author is reviewing — not to
# the continuous drift Phase 0 exists for, so it should not pay the cost.
_sync_dirty=""
_sync_one() {
  local label="$1" artifact="$2"; shift 2
  local before after out
  before="$(md5sum "$artifact" 2>/dev/null || echo absent)"
  # ⚑ THE SYNC'S OUTPUT IS CAPTURED FROM THE RUN THAT DID THE WORK.  A second invocation to
  # "show what it said" reports `already current` — the first sync just fixed it — so the
  # diagnostic would contradict the verdict beside it.  Run once; keep what it printed.
  out="$("$@" 2>&1 || true)"
  after="$(md5sum "$artifact" 2>/dev/null || echo absent)"
  if [ "$before" != "$after" ]; then
    echo "pre-commit: ⟡census-sync — $label DRIFTED and was re-synced:" >&2
    echo "    artifact: $artifact" >&2
    printf '%s\n' "$out" | sed 's/^/    /' >&2
    _sync_dirty="$_sync_dirty $label"
  fi
}

_sync_one "sql census"       "$ROOT/.claude/skills/sql-relalg/SKILL.md" \
  python3 "$ROOT/jea/metalanguage/sql_lift.py" --sync-census
_sync_one "tool mode census" "$ROOT/.claude/skills/struct-tools/SKILL.md" \
  python3 "$ROOT/scratch/toolmodes.py" --sync
_sync_one "gate census"      "$ROOT/.claude/skills/precommit-gates/SKILL.md" \
  python3 "$ROOT/scripts/gate_census.py" --sync

if [ -n "$_sync_dirty" ]; then
  echo "" >&2
  echo "pre-commit: FAILED — ⟡census-sync: a self-measuring census was STALE:$_sync_dirty" >&2
  echo "pre-commit:   The artifact(s) above are NOW CORRECT — the sync already ran." >&2
  echo "pre-commit:   RE-RUN your commit; it should pass this phase." >&2
  echo "pre-commit:   (Nothing was staged. If the artifact is tracked, \`git add\` it first.)" >&2
  exit 1
fi
# ─────────────────────────────────────────────────────────────────────────────

# ⚑ THE TOOL TESTS RUN FIRST, AND THEY ARE CHEAP.  Every gate below parses Agda text
# with the shared helpers; if those are broken, every census downstream is wrong and the
# failure reads as an Agda problem rather than a tooling one.  Milliseconds — pure
# functions, no Agda, no I/O.
#
# ⚑ The `--selftest` suites encode ~100 MEASURED incidents (the 33-file gutting, the
# self-import class, the span rule, the def-index false positives) and NOTHING RAN THEM:
# `grep -c selftest .githooks/pre-commit agda/Makefile` was 0 and 0.  A regression in the
# exact machinery that records past damage was shipping silently.  run_selftests.py
# DISCOVERS the suites rather than listing them, so a new tool is covered by existing.
# ⚑⚑ THE RUNNER IS pytest AS OF Ⓝ73″ ⟡the-tests-seam, AND THE REWIRE WAS MANDATORY RATHER
# THAN OPTIONAL.  `tests/__init__.py` used to insert `scratch/` and `scripts/` onto
# `sys.path` at import time — the shape the operator refused outright (2026-08-31: *"NOO.
# No sys.path modification."*).  Retiring it moved that reach into
# `[tool.pytest.ini_options] pythonpath` in `pyproject.toml`, which ONLY pytest reads, so
# `unittest discover` now fails to import every suite with `ModuleNotFoundError: agda_lex`.
# ⚑ A migration that left this line naming the retired runner would have turned a green
# gate red at the next commit, which is strictly worse than a slower one.
#
# ⚑ BOTH THE ROOT AND THE PATH ARE EXPLICIT, AND NEITHER IS INHERITED FROM THE CWD.  A
# git hook's cwd is the worktree root BY CONVENTION, and this repo has measured the
# wrong-root class three times over (the wrong-tenant read, the wrong-root
# `WorkingTree()`, the ambient interpreter) — each time a fact about the INVOCATION,
# resolved ambiently, whose wrong value is SILENT.  `--rootdir` is where pytest resolves
# `pyproject.toml` and its `pythonpath` from; the operand is what it collects.  VERIFIED
# from a foreign cwd, not assumed: the same 54 cases run from `/tmp`.
#
# ⚑ THE OPERAND DUPLICATES `testpaths = ["tests"]` AND THAT IS THE ONE ACCEPTED
# REDUNDANCY.  `testpaths` is the authority for a BARE `pytest` (what a developer types);
# the operand is what makes this gate independent of the cwd it is handed.  They can only
# disagree by someone pointing this line at a different directory, which is a visible
# edit — as against a silent cwd, which is not.
# ⚑⚑⚑ THE GATE BECOMES A BAZEL BUILD, ONE ROW AT A TIME (substrate:W377; operator 2026-11-16, host
# L179677: "fix the bazel build aspect first, because that will help accelerate the check fixes").
# Every row converted to a named target in BUILD.bazel's //:precommit runs HERE, through bazel, and its
# bash line below is deleted in the same commit: each row runs exactly once, and bazel's cache serves an
# unchanged row's verdict instead of re-running it. The remaining bash rows keep running after this.
#
# ⚑ OVER mikemol-commit's ISOLATED SNAPSHOT there is no `.git`, and @tracked asks git for the file
# list. The pattern is gcalculus's (gcalculus:W254), adopted, not reinvented: a throwaway repository
# whose index is refreshed every run (`-A` records deletions) is the commit's file list; the `.venv`
# link is excluded so it is never a tracked file. The commit's own GIT_* is unset for bazel, so
# @tracked reads THIS tree's index, never the commit's private one.
if [ -n "${MIKEMOL_REAL_ROOT:-}" ] && [ "$MIKEMOL_REAL_ROOT" != "$ROOT" ]; then
  if [ ! -e "$ROOT/.git" ]; then
    env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX git -C "$ROOT" init -q .
  fi
  env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX \
    git -C "$ROOT" add -A -f -- . ':(exclude).venv'
fi
run "bazel //:precommit" env -C "$ROOT" -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX \
  bazel test //:precommit --ui_event_filters=-debug,-warning --show_result=0
run "tool unit tests" python3 -m pytest --rootdir "$ROOT" -q "$ROOT/tests"
# ⚑⚑⚑ THE ROSTER'S CURRENCY IS A PRECONDITION FOR THE RUN THAT CONSUMES IT (⟡roster-currency-
# ungated, 2026-09-01).  Selftest.mk is GENERATED from suite_discovery, and nothing checked the
# committed copy against what discovery finds now — so a newly-written suite could sit
# discovered-but-undeclared and simply never run.  MEASURED: discovery 236, declared 235, the
# missing one being a suite written minutes earlier.
#
# ⚑⚑ AND THE SESSION THAT LOST IT HAD "VERIFIED" THE ROSTER.  It ran `gen_selftest_mk.py
# --check` and read exit 0 — but that module is a pure RENDERER with no main and no CLI, so it
# accepts any flag and exits 0 having done nothing.  **A flag a program does not implement is
# byte-identical to one it satisfies.**  The mode now lives in selftest_mk.py, which owns the
# file, and this line is what makes it reachable: declared_indexes shipped a diagnosis with no
# gate and the next writer reintroduced the defect it described.
run "selftest roster current" python3 "$ROOT/substrate/selftest_mk.py" --check
run "tool selftests" python3 "$ROOT/scripts/run_selftests.py" --quiet
# "feature coverage" runs in bazel: //:feature_coverage in //:precommit (W377, W357).

run "def/proof separation" "$ROOT/scripts/check_def_proof_separation.sh" --quiet \
  || true   # --quiet is silent; re-run verbose on failure for the message
if [ "$fail" -ne 0 ]; then
  "$ROOT/scripts/check_def_proof_separation.sh" || true
fi

# UP non-vacuity: no ⊤-collapse universal properties outside the sanctioned
# trivial-UP / PlaceholderUP. Hard gate (tree at 0 since the 2026-06-03
# audit/fix); --quiet stays silent on success but prints offenders on failure.
run "UP non-vacuity" "$ROOT/scripts/check_up_nonvacuity.sh" --quiet

# The generated build makefiles must stay in sync with the source tree: a new/removed .agda
# file changes the explicit MODULES list and the import DAG, so agda/Flat.mk (one flat
# import-DAG makefile — NOT per-directory; those 280 were deleted) and the thin agda/Makefile
# must be regenerated. Regenerate: python3 scripts/gen_build_makefiles.py --parameterized
# "build makefiles in sync" runs in bazel: //:check_makefiles in //:precommit (W377, W359).

# Build census (⟡build-census) must match the build: the `build-census` block inside
# .claude/skills/build-system/SKILL.md is generated from the tools that OWN each figure — the
# import DAG and MEM_CAP from gen_build_makefiles, the lease defaults PARSED from membudget, the
# ledger schemas from buildtime/proofcost, the gate roster from THIS hook's own `run` call sites.
# It exists because this surface's constants rotted: MEM_CAP was restated as 256m in three files
# while its authority said 128m. Only the STRUCTURAL block is gated — the measured block reads
# gitignored, hardware-specific ledgers and would fail on every machine.
# Regenerate: python3 scripts/gen_build_makefiles.py --sync-census
run "build census in sync" "$PY" "$ROOT/scripts/gen_build_makefiles.py" --check-census

# Gate census (⟡gate-census) must match THIS hook: the `gate-census` block inside
# .claude/skills/precommit-gates/SKILL.md is derived from the `run`/`|| true` call sites below
# and from each ratchet's own baseline declaration. It owns what build_census --gates cannot
# see — blocking-vs-advisory, ratchet-vs-census-vs-violation, and BASELINE HEALTH.
# ⚑ It exists because a green gate here is routinely a fact about the census: a baseline that
# is ABSENT makes its gate exit 0 whatever it measured, and one that is ZERO BYTES makes every
# census member read as a NEW key. `scripts/gate_census.py --baselines` is the only reader.
# ⚑ This census measures the gate roster, so adding a gate moves it — a failure right after a
# hook edit is the instrument working. Regenerate: python3 scripts/gate_census.py --sync
run "gate census in sync" python3 "$ROOT/scripts/gate_census.py" --check

# ⟡baseline-health: every OTHER gate here measures the tree; this one measures the GATES —
# whether each ratchet's baseline can support the verdict its gate returns. `set_ratchet`'s
# no-baseline branch RETURNS 0 whatever it measured, so a ratchet with no baseline file prints
# a green line while reporting real debt (measured: check_mypy_ratchet exits 0 at 116 type
# errors). That is census-green-as-a-fact-about-the-census, in five gates at once.
# ⚑ AN EMPTY BASELINE IS THE OPPOSITE AND IS ACCEPTED: zero bytes reads as the empty set, so
# every offender is a NEW key — a ZERO-TOLERANCE ratchet that forgives nothing and cannot
# lower itself. ABSENT is a free pass and is refused; EMPTY is the strong setting and is not.
# Paydown is to mint the baseline on THIS path. Enumerate: scripts/gate_census.py --baselines
run "baseline health" python3 "$ROOT/scripts/check_baseline_health.py" --quiet

# Compiled-query cache (⟡qinfra) must match the builders: query_sql.py is generated from query_defs.py's
# INTERN_BUILDERS; the runtime (query_builders.py) executes it with NO SQLAlchemy. A stale cache would run
# outdated SQL. Regenerate: python3 jea/metalanguage/query_defs.py --compile
run "query cache in sync" python3 "$ROOT/jea/metalanguage/query_defs.py" --check

# Tool mode census (⟡modecensus) must match the tools: the `mode-census` block inside
# .claude/skills/struct-tools/SKILL.md is generated by toolmodes.py --sync from each tool's
# OWN bare output plus its AST, and is the only place a reader can see the ~30 flags that
# dispatch while appearing in no usage line. Regenerate: python3 scratch/toolmodes.py --sync
#
# ⚑ THE GATE IS THE HALF THAT MAKES THE BLOCK SAFE TO TRUST, so it ships with it and not
# later. The skill tells every reader "run the tool bare, that output is the authority" —
# a pointer that was already wrong for 30 modes. Replacing it with a block nobody
# regenerates would not fix that, it would relocate it: a stale generated table reads as
# MORE authoritative than the incomplete thing it replaced, because it looks derived.
# Same shape as `query cache in sync` above (--compile/--check), and the same reason.
run "tool mode census in sync" python3 "$ROOT/scratch/toolmodes.py" --check

# SQL/relalg census (⟡sql-oracle) must match the tree: the `sql-census` block inside
# .claude/skills/sql-relalg/SKILL.md is generated by sql_lift.py --sync-census from the tools
# that OWN each figure — the lift map from sql_lift.build, the builder count from query_defs,
# the relations/tiers from schema_decl. Regenerate: python3 jea/metalanguage/sql_lift.py --sync-census
#
# ⚑ THE THIRD MEMBER OF THE SAME FAMILY (query cache / mode census / this), and it exists
# because the SQL surface was the one that had NO such gate while being the fastest-moving:
# a research sweep read the compiled-query cache STALE and minutes later the same command
# read FRESH. A hand-written map would have frozen whichever reading it caught. The gate is
# what makes the block safe to trust — a stale generated table reads as MORE authoritative
# than the incomplete prose it replaced, because it looks derived.
run "sql census in sync" python3 "$ROOT/jea/metalanguage/sql_lift.py" --check-census

# Worklist tracker integrity (Ⓥ): the derived-status tracker must PARSE and RUN
# end-to-end — every entry well-formed, every predicate evaluating without crashing.
# A tracker that can't execute is not tracking: a dropped comma once made worklist.py
# unparseable for ~10 commits, invisible because NO gate ran it (and ad-hoc runs piped
# stderr to /dev/null). This closes that instrument↔execution residue.
run "worklist tracker integrity" python3 "$ROOT/scripts/worklist.py" --check

# Worklist PREDICATE resolution: an item must point at something that still EXISTS.
# ⚑ THIS IS A DIFFERENT QUESTION FROM THE LINE ABOVE, and the split is the whole point.
# `worklist.py --check` asserts the tracker PARSES AND RUNS; it cannot assert an item is
# still checkable, because its `status()` collapses every failure onto False = OPEN — its
# `_defines`/`_grep` return False on OSError, so "the file is gone" and "the file is present
# and lacks the name" are ONE answer (gate-F93: it computed an offender list into a dead
# binding and exited 0 regardless).
# ⚑⚑ IT REFUSES ON A NARROWER CLASS THAN "OPEN", deliberately. An OPEN item with a LIVE
# artifact predicate is the ordinary state of a work list; only an UNRESOLVABLE predicate
# refuses. `manual` and `cmd0` items are UNDECIDABLE and never reported — blocking a commit
# over a human judgement, or over a shell exit that cannot tell "not yet" from "gone", is the
# false refusal the narrow class exists to avoid.
# ⚑ NOT A RATCHET, AND THAT IS DELIBERATE. A baseline here would make the FIRST stale
# predicate permanent by construction. The population must be empty; paydown is to re-point
# the item. Enumerate: scripts/check_worklist_predicates.py
run "worklist predicate resolution" python3 "$ROOT/scripts/check_worklist_predicates.py" --quiet

# Shape-node collision index must stay current (names are vacuous; the visible
# name→shape map disambiguates for the reader). Regenerate: sppf_node_index.py
run "shape-node index current" python3 "$ROOT/scripts/sppf_node_index.py" --check

# Import-shape ratchet: no NEW bare imports of genuinely-ambiguous names — a
# colliding name must be specialized by shape (renaming). Count may only drop.
run "import-shape ratchet" python3 "$ROOT/scripts/check_import_shape.py" --quiet

# Decl-site shape tags: every genuinely-ambiguous declaration carries a visible
# ⟦shape:…⟧ tag so the reader sees which node. Regenerate: decl_shape_tag.py --fix
run "decl-site shape tags" python3 "$ROOT/scripts/decl_shape_tag.py"

# Carrier locality: a canonical operator over a globally-unique carrier must be
# defined in that carrier's home (never forked into another carrier's dir), and
# may not be buried in a generic multi-operator bucket file. Prevents the
# fork-by-reimplementation class (e.g. _+ℤ_ re-defined under Algebra/Q/).
run "carrier locality" python3 "$ROOT/scripts/check_carrier_locality.py" --quiet

# ⚑ A GATE IS NOT SHIPPED UNTIL IT IS WIRED.  These five existed with baselines and ran
