if git diff --cached --name-only | grep -qE '^(jea|el-atlas)/'; then
  run "scratch-independence (Λ8)" "$PY" "$ROOT/scripts/check_scratch_independence.py" --quiet --root "$ROOT"
  # Λ8b (import-tier): the RUNTIME complement to Λ8's static scan — imports the 5 coupling-surface
  # modules under a sys.addaudithook, catching a module-level DYNAMIC scratch reach (computed path /
  # dynamic import) the AST scan can't see. ~3s (import-only; the heavy GPU/agda DEMO surface is NOT
  # the coupling surface). Self-skips without cupy. Full in-function sweep: check_scratch_runtime.py --full.
  run "scratch-runtime (Λ8b)" python3 "$ROOT/scripts/check_scratch_runtime.py" --quiet

fi

# Full build: prove EVERY module typechecks via `make -C agda -j` — the SINGLE build path.
# make routes through the agda-shim → membudget, and TWO DIFFERENT CAPS apply (⚑ they are
# different KINDS, not two numbers): membudget's cgroup LEASE bounds maxRSS and OWNS
# retry-on-OOM (a too-small guess is killed at 137 and re-entered at the next power-of-two
# bucket until it fits or the ladder is exhausted, at which point the make recipe fails, never
# masked), while `+RTS -M$(MEM_CAP)` caps the GHC HEAP and is a hard GATE (exit 251 → the
# cap-ratchet's signal). Both values live in their own authorities — gen_build_makefiles.py for
# MEM_CAP, scripts/membudget for the lease defaults — and are deliberately NOT restated here.
# Substrate.All is excluded from FILES (OOM by design);
# stop-at-first-failure (iterate incrementally; `make -C agda/Substrate/<dir>` for detail). EXPENSIVE, so it runs at
# most weekly: a successful run touches "$STAMP"; while that stamp is younger than a
# week the build is skipped for fast commits. Only attempted when the cheap gates above
# already passed (no point building on an otherwise-doomed commit). Force a run by
# deleting the stamp; bypass everything with `git commit --no-verify`.
STAMP="$ROOT/.full-build-stamp"
WEEK=$((7 * 24 * 3600))
if [ "$fail" -eq 0 ]; then
  age=$WEEK
  if [ -f "$STAMP" ]; then
    age=$(( $(date +%s) - $(stat -c %Y "$STAMP") ))
  fi

  # Ε(b′): a STRUCTURAL change forces the full build regardless of the 7-day
  # throttle. Such a change can break a module NOT in this commit's changed set
  # (the "modules rot silently" hazard), so the time-throttle alone is an INVALID
  # precheck for it. (Policy: main is CI-gated; CI must reflect current state, or
  # the throttle masks breakage for up to a week.) Three robustly-detectable
  # signals over the staged .agda set:
  #   (a) a module added / renamed / deleted (file-level structure);
  #   (b) an import / module / re-export (public / renaming) line changed;
  #   (c) a top-level type-SIGNATURE line changed (col-0 `name :` — including a
  #       MULTI-LINE signature whose `:` ends the line, type on the next).
  # Comments (`--`) and indented lines (record fields, locals) are excluded by
  # construction; false positives only ever over-run CI (safe), never skip it.
  structural=""
  if git diff --cached --name-status --diff-filter=ADR | grep -qE '\.agda$'; then
    structural="module add/rename/delete"
  fi
  if [ -z "$structural" ]; then
    for f in $(git diff --cached --name-only --diff-filter=M -- '*.agda'); do
      diffout="$(git diff --cached -U0 -- "$f")"
      if printf '%s\n' "$diffout" | grep -E '^[+-]' | grep -vE '^[-+]{3}' \
           | grep -qE '^[+-][[:space:]]*(open import|import |module |public|renaming)'; then
        structural="import/re-export change ($f)"; break
      fi
      if printf '%s\n' "$diffout" | grep -E '^[+-]' | grep -vE '^[-+]{3}' \
           | grep -qE '^[+-][^[:space:]+-].*[[:space:]]:([[:space:]]|$)'; then
        structural="signature change ($f)"; break
      fi
    done
  fi

  if [ -z "$structural" ] && [ "$age" -lt "$WEEK" ]; then
    echo "pre-commit: full build skipped (last $((age / 86400))d ago, < 7d, no structural change; rm $STAMP to force)."
  else
    if [ -n "$structural" ]; then
      echo "pre-commit: full build FORCED — Ε(b′) structural change: $structural — running, this may take a while…"
    else
      echo "pre-commit: full build (every module; >7d since last) — running, this may take a while…"
    fi
    # ⟡agda-jobs: the -j width comes from ONE authority (gen_build_makefiles.AGDA_JOBS, env
    # AGDA_JOBS overrides). Hardcoding it here would be the second spelling the constant exists
    # to prevent. Falls back to a bare -j only if the reader is unavailable — the pre-⟡agda-jobs
    # behaviour, which is safe (membudget's semaphore still throttles by RAM) rather than absent.
    AGDA_J="$("$PY" "$ROOT/scripts/gen_build_makefiles.py" --jobs 2>/dev/null)"
    if [ -n "$AGDA_J" ]; then set -- -j "$AGDA_J"; else set -- -j; fi
    if make -C "$ROOT/agda" "$@"; then
      touch "$STAMP"
      echo "pre-commit: full build OK — stamp refreshed."
      # Ⓓ.gate(-graph/-render-from-db): the .agdai cores are now fresh — rebuild the relational
      # store catalog.db from a SINGLE shim decode pass and RENDER every discoverability catalog
      # off it, staging the committed renders so none can rot behind a structural change.
      # gen_catalog.py runs the shared walk ONCE (scripts/reuse_catalog.py) then renders: the
      # reuse-INDEX (name->home + parallels), reuse-GRAPH (refinement edges + degree census),
      # reuse-SITEMAP (flat discovery manifest), and USAGE-STATS (reuse distribution). catalog.db
      # itself is a gitignored derived cache — only the renders are staged. Advisory: a regen
      # failure NEVER blocks the commit.
      if msg=$(python3 "$ROOT/scripts/gen_catalog.py" 2>&1); then
        git add "$ROOT/catalog/reuse-index.md" "$ROOT/catalog/reuse-graph.dot" \
                "$ROOT/catalog/reuse-graph.md" "$ROOT/catalog/reuse-sitemap.xml" \
                "$ROOT/catalog/usage-stats.md" "$ROOT/catalog/import-graph.dot" \
                "$ROOT/catalog/import-graph.md" 2>/dev/null || true
        echo "pre-commit: ${msg//$'\n'/; } (+ staged)"
      else
        echo "pre-commit: catalog regen skipped (advisory; gen_catalog.py failed)." >&2
      fi
    else
      echo "pre-commit: FAILED — full build (a module does not typecheck)" >&2
      fail=1
    fi
  fi
fi

# ⟡gqs-precommit-reorder: the CORE-READING gates run AFTER the full build (freshness-
# authoritative). On a STRUCTURAL commit the build above recompiled the changed modules
# (fresh .agdai cores) and gen_catalog rebuilt the full catalog.db projection + renders, so
# these gates now measure the state BEING COMMITTED — not a lossy pre-build proxy. The old
# pre-build order read STALE cores: set1_ratchet could FALSE-PASS a Set₁ increase (the new
# record's .agdai not yet rebuilt), caught only on the NEXT commit; reuse_sweep read a stale
# projection. On a non-structural commit the build was skipped and the cores/catalog.db are
# unchanged, so these read the same valid state. Guarded by fail==0: no point measuring a
# commit already doomed by a cheap gate or a failed build.
if [ "$fail" -eq 0 ]; then
  # Set₁ ratchet (ELABORATED): Set₁ is POLICY DEBT — a record must not FIELD a Set-valued
  # carrier or relation; PARAMETERIZE it (module _ (V : Set) (_≈_ : V → V → Set) where …),
  # as Substrate.Category.Lawvere's carrier-generic atoms do. The measure is a SORT, which
  # only exists after elaboration: an earlier version grepped source tokens, a DIFFERENT
  # quantity (one `record R : Set₁` token = ~4 Set₁ core definitions; Set₁-typed functions
  # carry none). So it reads the .agdai cores. RATCHET: count may only drop. If the cores
  # are absent or undecodable it FAILS — cannot measure is not no-debt. Its own incremental
  # freshen is a no-op here (gen_catalog already rebuilt catalog.db from the fresh cores).
  run "Set₁ ratchet (elaborated)" python3 "$ROOT/scripts/set1_ratchet_cores.py" --quiet

  # ⟡cap-ratchet: per-module elaboration PEAK over the TARGET is MEMORY DEBT — the census that
  # lets MEM_CAP (gen_build_makefiles.py owns the value; do NOT restate it here) descend
  # MECHANICALLY instead of by a flag day. Paydown-only, like its three sibling set-ratchets: a
  # NEW module crossing the cap is
  # REFUSED (shard the elaboration unit at an associative boundary and seal the parts — cf.
  # KAT.Full's fold-++ shards — or split def/proof, or seal the heavy neutral `opaque`; never raise
  # the cap), a paid-down module auto-lowers the baseline. It reads the per-dir .agda-times.tsv
  # peaks membudget captured, so like set1_ratchet it MUST run here (post-build): the build above
  # just re-elaborated the changed modules, so the LATEST peak row measures the state being
  # committed. Existing offenders are grandfathered at the baseline.
  run "cap ratchet (128MB)" python3 "$ROOT/scripts/check_cap_ratchet.py" --quiet

  # ⟡reuse-gate-wire: reuse-before-write ADVISORY. reuse_sweep --gate exits nonzero when a
  # consolidation opportunity touches CHANGED code — now reading the FRESH catalog.db projection
  # (gen_catalog rebuilt it above), so a structural commit's new code is checked against the
  # current interned structure, not a stale one. Bare `|| true` — NOT via `run` (run BLOCKS;
  # --gate is nonzero on any opportunity = common for real edits → would spuriously block). The
  # [ -f ] guard suppresses reuse_sweep's clean self-abort when catalog.db is absent.
  if [ -f "$ROOT/catalog/catalog.db" ]; then
    python3 "$ROOT/scripts/reuse_sweep.py" --gate || true
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: one or more checks failed; commit aborted (use --no-verify to override)." >&2
  exit 1
fi
exit 0
