#!/usr/bin/env bash
# Versioned post-commit hook (enabled via: git config core.hooksPath .githooks)
#
# Runs the ADVISORY reports AFTER the commit lands. Rationale (the 2026-06-12
# G9 / correct-by-construction discussion): an advisory must FIRE to be consulted
# — a `make advise` you have to remember to run is barely above a passive memory
# note — but it must NOT block (advisories have real false positives; see
# check_file_sizes.sh and check_categorical_grounding.sh). Post-commit is exactly
# that binding layer: it auto-fires on every commit yet can never abort one (git
# ignores the post-commit exit status). Gates live in pre-commit; advisories live
# here. By design.
#
# It also FOLDS its advisory output into the just-made commit's message, by
# amending (the post-commit complement to prepare-commit-msg, which folds in the
# pre-commit gate report). Together: every commit records both its gate results
# and its advisory in its own message. The amend uses --no-verify (no gate
# re-run) and is guarded so it never recurses (the amend re-fires post-commit)
# and never rewrites a commit mid-rebase/merge/cherry-pick.
set -uo pipefail

# Guard: the amend below re-fires post-commit — exit immediately so we neither
# re-print nor re-amend (no recursion).
[ -n "${_POST_COMMIT_AMENDING:-}" ] && exit 0

ROOT="$(git rev-parse --show-toplevel)"
GITDIR="$(git rev-parse --git-dir)"

# Run the advisory, capturing its output (shown live AND folded into the message).
advisory="$(
  echo "── post-commit advisory (non-blocking; gates ran pre-commit) ──"
  bash "$ROOT/scripts/check_categorical_grounding.sh" 2>/dev/null || true

  # Tautology advisory: signatures whose conclusion is `X ≡ X` (LHS syntactically
  # identical to RHS) prove nothing — the sibling shape to check_up_nonvacuity.sh's
  # ⊤-collapse. 3 findings (Category/{Coequalizer,Pushout}) predate the check.
  python3 "$ROOT/scripts/tautology_advisory.py" 2>/dev/null || true
  python3 "$ROOT/scripts/untethered_disjunct_advisory.py" 2>/dev/null || true
)"
printf '%s\n' "$advisory"

# Amend the just-made commit to append the advisory — but NOT mid-rebase/merge/
# cherry-pick/revert (would rewrite the wrong commit). git ignores post-commit
# status and the amend is `|| true`, so a failed amend never harms the commit.
for m in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  [ -e "$GITDIR/$m" ] && exit 0
done

# Idempotent: don't append the advisory twice (e.g. a manual --amend).
if git log -1 --format=%B | grep -q 'post-commit advisory (auto-captured)'; then
  exit 0
fi

if [ -n "$advisory" ]; then
  msg="$(git log -1 --format=%B)

post-commit advisory (auto-captured):
$(printf '%s\n' "$advisory" | sed 's/^/    /')"
  _POST_COMMIT_AMENDING=1 git commit --amend --no-verify -F - <<<"$msg" >/dev/null 2>&1 || true
fi

# ⟡membudget-otlp-wire: push the fresh proof-cost ledger to cassian's VictoriaMetrics over
# OTLP — an advisory SIDE-EFFECT (not folded into the message; runs after the amend). Fires
# only when a full build actually RAN this commit (STAMP touched <120s ago) — i.e. per
# STRUCTURAL commit, when the .agda-times.tsv ledger changed — never per module, never on a
# trivial commit. Self-skips silently: opt out with MEMBUDGET_NO_OTLP=1, or if `uv` is absent
# or cassian's :8428 is unreachable. Never blocks (post-commit; git ignores the exit). Manual
# push any time: `uv run --with opentelemetry-sdk --with opentelemetry-exporter-otlp-proto-http
# python3 scripts/membudget_otlp.py`.
_OTLP_STAMP="$ROOT/.full-build-stamp"
if [ -z "${MEMBUDGET_NO_OTLP:-}" ] && [ -f "$_OTLP_STAMP" ] \
   && [ "$(( $(date +%s) - $(stat -c %Y "$_OTLP_STAMP") ))" -lt 120 ] \
   && command -v uv >/dev/null 2>&1 \
   && curl -sf -m 3 'http://127.0.0.1:8428/api/v1/query?query=up' -o /dev/null 2>/dev/null
then
  echo "── membudget-otlp: full build ran; pushing proof-cost ledger to cassian (advisory) ──"
  ( cd "$ROOT" && timeout 90 uv run --with opentelemetry-sdk --with opentelemetry-exporter-otlp-proto-http \
      python3 scripts/membudget_otlp.py 2>&1 | grep -E 'membudget-otlp:|✓ ingested|✗ ' ) || true
fi
exit 0
