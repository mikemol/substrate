#!/usr/bin/env bash
# Versioned post-commit hook (enabled via: git config core.hooksPath .githooks)
#
# Runs the ADVISORY reports AFTER the commit lands. Rationale (the 2026-06-12
# G9 / correct-by-construction discussion): an advisory must FIRE to be consulted
# — a `make advise` you have to remember to run is barely above a passive memory
# note — but it must NOT block (advisories have real false positives; see
# check_file_sizes.sh and check_categorical_grounding.sh). Post-commit is exactly
# that binding layer: it auto-fires on every commit yet can never abort one (git
# ignores the post-commit exit status). Gates live in pre-commit; advisories live
# here. By design.
#
# The post-commit advisory IS the per-commit "is judgment required?" surface, and
# it prints IN FULL — never summarized, never filtered (that hides the magnitude).
# ONLY the categorical-grounding advisory fires here: it is small, and it is the
# priority. File-size pressure is a standing list, on demand via `make -C agda
# advise`; it does not belong in the per-commit view and is not gated on a baseline.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
echo "── post-commit advisory (non-blocking; gates ran pre-commit) ──"
bash "$ROOT/scripts/check_categorical_grounding.sh" 2>/dev/null || true
