# jea/metalanguage — build the .agdai shim (Agda Interface → JSON core nodes).
#
# The shim links Agda's OWN version-matched serialiser (EmbPrj): the linked Agda MUST be the SAME
# build that produced the .agdai you decode (interface hashes must match exactly), else the shim
# errors "decode Nothing (stale/wrong-version)".
#
#   make -C jea/metalanguage shim
#   make -C jea/metalanguage clean-shim
#
# ⚑ PINNED TO 2.8.0, AND THE STRADDLE IS GONE (2026-08-06). This read "used under BOTH Agda 2.6.3
# and 2.8.0" with `AGDA_PKG ?= Agda` plus three documented overrides — an unpinned default that
# resolved to whatever the ghc package db happened to call current. It was correct only by
# accident: 2.6.3.1 sits in the cabal store but is not registered, so `-package Agda` could not
# reach it. Register it and every rebuild would silently link the wrong serialiser.
#
# ⚑ THE FIX IS DELETION, NOT A BETTER FLAG (user). 2.6.3 is no longer supported — the formerly
# 2.6.3-only environments can take a statically-linked 2.8.x release binary — so the straddle is
# not a case to handle, it is a case to REMOVE. A configurable version is exactly the infra a
# fresh session bypasses, because using it correctly requires knowing the conditional exists.
# One version, no choice, nothing to get wrong.

GHC ?= ghc
AGDA_PKG := Agda-2.8.0
GHCFLAGS ?= -package $(AGDA_PKG) -O0
SHIM := agdai_shim

.PHONY: shim clean-shim
shim: $(SHIM)

# ⚑ `AgdaiReflect.hs` IS A COMPILE-TIME DEPENDENCY, not a runtime one: the shim's walkers
# are generated by a Template Haskell splice over Agda's own type declarations, so the
# splice module must be on the search path and the shim rebuilds when it changes.
$(SHIM): $(SHIM).hs AgdaiReflect.hs
	$(GHC) $(GHCFLAGS) -i. -o $@ $<

clean-shim:
	rm -f $(SHIM) $(SHIM).hi $(SHIM).o
